@page "/entry"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>ورود عملیات — انبار آمل</PageTitle>

<h1 class="h-page-title">ورود عملیات</h1>
<p class="h-lead mb-4">ثبت رسید / حواله / تعدیل موجودی.</p>

<div class="h-card h-card-pad">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label" for="type">نوع حرکت</label>
            <select id="type" class="form-select" @bind="MoveType">
                <option value="Receipt">رسید (ورود کالا)</option>
                <option value="Issue">حواله (خروج کالا)</option>
                <option value="Adjustment">تعدیل موجودی</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="item">کالا</label>
            <select id="item" class="form-select" @bind="ItemId">
                <option value="0">— انتخاب کالا —</option>
                @foreach (var it in Items)
                {
                    <option value="@it.ItemId">@it.ItemTitle (@it.ItemCode) — موجودی: @it.StockQty.ToString("N0")</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="wh">انبار</label>
            <select id="wh" class="form-select" @bind="WarehouseId">
                <option value="0">— بدون انبار —</option>
                @foreach (var w in Warehouses)
                {
                    <option value="@w.WarehouseId">@w.Title</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="date">تاریخ</label>
            <input id="date" type="date" class="form-control" @bind="MoveDate" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="qty">تعداد</label>
            <input id="qty" type="number" step="0.001" min="0" class="form-control" @bind="Qty" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="price">فی</label>
            <input id="price" type="number" step="1000" min="0" class="form-control" @bind="UnitPrice" />
        </div>
        <div class="col-md-8">
            <label class="form-label" for="desc">شرح</label>
            <input id="desc" class="form-control" @bind="Description" placeholder="اختیاری" />
        </div>
        <div class="col-12 d-flex gap-2">
            <button class="btn btn-hermes" @onclick="SaveAsync" disabled="@Busy">ثبت حرکت</button>
            @if (Message.Length > 0)
            {
                <div class="alert alert-success mb-0 py-1 px-3">@Message</div>
            }
        </div>
    </div>
</div>

@code {
    List<ItemRow> Items = new();
    List<WarehouseRow> Warehouses = new();
    string MoveType = "Receipt";
    int ItemId;
    int WarehouseId;
    DateTime MoveDate = DateTime.Today;
    decimal Qty = 1;
    decimal UnitPrice;
    string Description = "";
    string Message = "";
    bool Busy;

    protected override async Task OnInitializedAsync()
    {
        Items = await Request.Request<ItemRow>("ItemList", new { }) ?? new();
        Warehouses = await Request.Request<WarehouseRow>("WarehouseList", new { }) ?? new();
    }

    async Task SaveAsync()
    {
        if (ItemId == 0) { await Alert.ShowErrorAsync("انبار", "کالا را انتخاب کنید"); return; }
        if (Qty <= 0) { await Alert.ShowErrorAsync("انبار", "تعداد نامعتبر است"); return; }
        Busy = true;
        Message = "";
        try
        {
            await Request.Request<object>("MovementInsert", new
            {
                MovementType = MoveType,
                ItemId,
                WarehouseId = WarehouseId == 0 ? (int?)null : WarehouseId,
                Qty,
                UnitPrice,
                MovementDate = MoveDate,
                Description = string.IsNullOrWhiteSpace(Description) ? null : Description,
                CreatedBy = Request.UserToken
            }, isExec: true);
            Message = "حرکت ثبت شد و رویداد InventoryMovement انتشار یافت.";
            Qty = 1;
            UnitPrice = 0;
            Description = "";
            await ReloadItemsAsync();
        }
        catch (Exception ex)
        {
            await Alert.ShowErrorAsync("انبار", ex.Message);
        }
        finally { Busy = false; }
    }

    async Task ReloadItemsAsync() => Items = await Request.Request<ItemRow>("ItemList", new { }) ?? new();
}
