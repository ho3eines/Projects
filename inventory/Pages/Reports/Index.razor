@page "/reports"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>گزارشات — انبار آمل</PageTitle>

<h1 class="h-page-title">گزارشات انبار</h1>
<p class="h-lead mb-4">کارتکس کالا و موجودی کالاها.</p>

<div class="h-card h-card-pad mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="rep">گزارش</label>
            <select id="rep" class="form-select" @bind="Report">
                <option value="balance">موجودی کالاها (ارزش)</option>
                <option value="card">کارتکس کالا</option>
            </select>
        </div>
        @if (Report == "card")
        {
            <div class="col-md-3">
                <label class="form-label" for="item">کالا</label>
                <select id="item" class="form-select" @bind="ItemId">
                    <option value="0">— انتخاب کالا —</option>
                    @foreach (var it in Items)
                    {
                        <option value="@it.ItemId">@it.ItemTitle</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="from">از تاریخ</label>
                <input id="from" type="date" class="form-control" @bind="From" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="to">تا تاریخ</label>
                <input id="to" type="date" class="form-control" @bind="To" />
            </div>
        }
        <div class="col-md-2">
            <button class="btn btn-hermes w-100" @onclick="LoadAsync">اجرا</button>
        </div>
    </div>
</div>

<div class="h-card">
    @if (Report == "balance")
    {
        <table class="h-table">
            <thead>
                <tr><th>کد</th><th>کالا</th><th>واحد</th><th>موجودی</th><th>فی</th><th>ارزش</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Balance)
                {
                    <tr>
                        <td>@r.ItemCode</td><td>@r.ItemTitle</td><td>@r.Unit</td>
                        <td>@r.StockQty.ToString("N0")</td><td>@r.UnitPrice.ToString("N0")</td>
                        <td>@r.StockValue.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <table class="h-table">
            <thead>
                <tr><th>تاریخ</th><th>شماره</th><th>نوع</th><th>تعداد</th><th>فی</th><th>مبلغ</th><th>شرح</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Card)
                {
                    <tr>
                        <td>@r.MovementDate.ToString("yyyy/MM/dd")</td>
                        <td>@r.MovementNumber</td>
                        <td>@r.MovementType</td>
                        <td>@r.Qty.ToString("N0")</td>
                        <td>@r.UnitPrice.ToString("N0")</td>
                        <td>@r.TotalValue.ToString("N0")</td>
                        <td>@r.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    List<ItemRow> Items = new();
    List<StockBalanceRow> Balance = new();
    List<StockCardRow> Card = new();
    string Report = "balance";
    int ItemId;
    DateTime From = DateTime.Today.AddMonths(-1);
    DateTime To = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        Items = await Request.Request<ItemRow>("ItemList", new { }) ?? new();
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        try
        {
            if (Report == "balance")
            {
                Balance = await Request.Request<StockBalanceRow>("StockBalanceReport", new { }) ?? new();
            }
            else
            {
                if (ItemId == 0) { await Alert.ShowErrorAsync("گزارش", "کالا را انتخاب کنید"); return; }
                Card = await Request.Request<StockCardRow>("StockCardReport", new { ItemId, FromDate = From, ToDate = To }) ?? new();
            }
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("گزارش", ex.Message); }
    }
}
