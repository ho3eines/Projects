@page "/dashboard"
@inject IRequestService Request

<PageTitle>داشبورد — انبار آمل</PageTitle>

<h1 class="h-page-title mb-1">نمای کلی انبار</h1>
<p class="h-lead mb-4">خلاصه وضعیت موجودی، حرکات و رزروها.</p>

<div class="row g-3">
    <div class="col-lg-3 col-sm-6">
        <div class="h-card h-stat">
            <div><div class="k">حرکات امروز</div><div class="v">@S.TodayMovements</div></div>
            <div class="h-stat-ico">⇄</div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="h-card h-stat">
            <div><div class="k">اقلام کالا</div><div class="v">@S.TotalItems</div></div>
            <div class="h-stat-ico">📦</div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="h-card h-stat">
            <div><div class="k">ارزش موجودی</div><div class="v" style="font-size:1.1rem;padding-top:.4rem">@S.StockValue.ToString("N0")</div></div>
            <div class="h-stat-ico">﷼</div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="h-card h-stat">
            <div><div class="k">رزروهای فعال</div><div class="v">@S.ActiveReservations</div></div>
            <div class="h-stat-ico">🔒</div>
        </div>
    </div>
</div>

@code {
    DashboardSummaryRow S = new();

    protected override async Task OnInitializedAsync()
    {
        S = (await Request.Request<DashboardSummaryRow>("DashboardSummary", new { }))?.FirstOrDefault() ?? new();
    }
}
