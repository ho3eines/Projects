@page "/special"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>عملیات ویژه — انبار آمل</PageTitle>

<h1 class="h-page-title">عملیات ویژه</h1>
<p class="h-lead mb-4">انبارگردانی: ثبت شمارش و تعدیل خودکار موجودی.</p>

<div class="h-card h-card-pad">
    <div class="row g-3">
        <div class="col-md-5 col-sm-12">
            <label class="form-label" for="item">کالا</label>
            <select id="item" class="form-select" @bind="ItemId">
                <option value="0">— انتخاب کالا —</option>
                @foreach (var it in Items)
                {
                    <option value="@it.ItemId">@it.ItemTitle — موجودی فعلی: @it.StockQty.ToString("N0")</option>
                }
            </select>
        </div>
        <div class="col-md-3 col-sm-6">
            <label class="form-label" for="counted">تعداد شمارش‌شده</label>
            <input id="counted" type="number" step="0.001" min="0" class="form-control" @bind="CountedQty" />
        </div>
        <div class="col-md-4 col-sm-6 d-flex align-items-end">
            <button class="btn btn-hermes w-100" @onclick="RunAsync" disabled="@Busy">ثبت شمارش و تعدیل</button>
        </div>
        @if (Message.Length > 0)
        {
            <div class="col-12"><div class="alert alert-success mb-0">@Message</div></div>
        }
    </div>
</div>

@code {
    List<ItemRow> Items = new();
    int ItemId;
    decimal CountedQty;
    string Message = "";
    bool Busy;

    protected override async Task OnInitializedAsync()
        => Items = await Request.Request<ItemRow>("ItemList", new { }) ?? new();

    async Task RunAsync()
    {
        if (ItemId == 0) { await Alert.ShowErrorAsync("انبارگردانی", "کالا را انتخاب کنید"); return; }
        Busy = true;
        Message = "";
        try
        {
            await Request.Request<object>("StocktakeRun", new { ItemId, CountedQty }, isExec: true);
            Message = "شمارش ثبت شد؛ موجودی تعدیل و رویداد InventoryMovement منتشر شد.";
            Items = await Request.Request<ItemRow>("ItemList", new { }) ?? new();
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("انبارگردانی", ex.Message); }
        finally { Busy = false; }
    }
}
