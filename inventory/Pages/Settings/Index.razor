@page "/settings"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>امکانات — انبار آمل</PageTitle>

<h1 class="h-page-title">امکانات و جداول پایه</h1>
<p class="h-lead mb-4">تعریف کالا و انبار.</p>

<div class="row g-3">
    <div class="col-lg-7 col-12">
        <div class="h-card h-card-pad">
            <h5 class="h-section-title">کالاها</h5>
            <div class="h-table-wrap">
                <table class="h-table">
                    <thead>
                        <tr><th>کد</th><th>عنوان</th><th>دسته</th><th>واحد</th><th>موجودی</th><th>فی</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Items)
                        {
                            <tr>
                                <td>@i.ItemCode</td><td>@i.ItemTitle</td><td>@i.Category</td>
                                <td>@i.Unit</td><td>@i.StockQty.ToString("N0")</td><td>@i.UnitPrice.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="row g-2 mt-3">
                <div class="col-md-3 col-sm-4"><input class="form-control" @bind="NewItemCode" placeholder="کد کالا" /></div>
                <div class="col-md-4 col-sm-8"><input class="form-control" @bind="NewItemTitle" placeholder="عنوان کالا" /></div>
                <div class="col-md-2 col-sm-6"><input class="form-control" @bind="NewCategory" placeholder="دسته" /></div>
                <div class="col-md-3 col-sm-6">
                    <button class="btn btn-hermes w-100" @onclick="AddItemAsync">افزودن کالا</button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5 col-12">
        <div class="h-card h-card-pad">
            <h5 class="h-section-title">انبارها</h5>
            <div class="h-table-wrap">
                <table class="h-table">
                    <thead>
                        <tr><th>کد</th><th>عنوان</th><th>موقعیت</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var w in Warehouses)
                        {
                            <tr><td>@w.WarehouseCode</td><td>@w.Title</td><td>@w.Location</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="row g-2 mt-3">
                <div class="col-md-3 col-sm-4"><input class="form-control" @bind="NewWhCode" placeholder="کد انبار" /></div>
                <div class="col-md-5 col-sm-8"><input class="form-control" @bind="NewWhTitle" placeholder="عنوان انبار" /></div>
                <div class="col-md-4 col-sm-12">
                    <button class="btn btn-hermes w-100" @onclick="AddWarehouseAsync">افزودن انبار</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    List<ItemRow> Items = new();
    List<WarehouseRow> Warehouses = new();
    string NewItemCode = "";
    string NewItemTitle = "";
    string NewCategory = "";
    string NewWhCode = "";
    string NewWhTitle = "";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    async Task ReloadAsync()
    {
        Items = await Request.Request<ItemRow>("ItemList", new { }) ?? new();
        Warehouses = await Request.Request<WarehouseRow>("WarehouseList", new { }) ?? new();
    }

    async Task AddItemAsync()
    {
        if (string.IsNullOrWhiteSpace(NewItemTitle)) { await Alert.ShowErrorAsync("امکانات", "عنوان کالا الزامی است"); return; }
        try
        {
            await Request.Request<object>("ItemUpsert", new
            {
                ItemId = 0,
                ItemCode = string.IsNullOrWhiteSpace(NewItemCode) ? null : NewItemCode,
                ItemTitle = NewItemTitle,
                Category = NewCategory,
                Unit = "عدد",
                UnitPrice = 0,
                IsActive = true
            }, isExec: true);
            NewItemCode = ""; NewItemTitle = ""; NewCategory = "";
            await ReloadAsync();
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("امکانات", ex.Message); }
    }

    async Task AddWarehouseAsync()
    {
        if (string.IsNullOrWhiteSpace(NewWhTitle)) { await Alert.ShowErrorAsync("امکانات", "عنوان انبار الزامی است"); return; }
        try
        {
            await Request.Request<object>("WarehouseUpsert", new
            {
                WarehouseId = 0,
                WarehouseCode = NewWhCode,
                Title = NewWhTitle,
                Location = (string?)null,
                IsActive = true
            }, isExec: true);
            NewWhCode = ""; NewWhTitle = "";
            await ReloadAsync();
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("امکانات", ex.Message); }
    }
}
