@page "/edit-project-modal"
@using WebApi.Models
@using WebApi.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Dapper
@using Microsoft.Data.SqlClient
@inject IModalService ModalService
@inject IConfiguration Config
@inject IJSRuntime JS

<div class="p-4" dir="rtl">
    <h4 class="mb-3">@(isNew ? "➕ ایجاد پروژه جدید" : "✏️ ویرایش پروژه")</h4>

    <EditForm Model="this" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">نام پروژه</label>
                <InputText class="form-control" @bind-Value="Name" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">SessionTimeout (دقیقه)</label>
                <InputNumber class="form-control" @bind-Value="SessionTimeoutMinutes" />
            </div>
            <div class="col-md-6">
                <label class="form-label">ApiKey</label>
                <InputText class="form-control" @bind-Value="ApiKey" required />
            </div>
            <div class="col-12">
                <label class="form-label">ConnectionString</label>
                <InputText class="form-control" @bind-Value="ConnectionString" required
                           placeholder="Server=localhost;Database=MyProject;User Id=sa;Password=***" />
            </div>
            <div class="col-12">
                <label class="form-label">DatabaseName</label>
                <InputText class="form-control" @bind-Value="DatabaseName" required />
            </div>
            <div class="col-12">
                <label class="form-label">آدرس کلاینت (URL)</label>
                <InputText class="form-control" @bind-Value="ClientUrl" required
                           placeholder="https://localhost:65218/" />
            </div>
            <div class="col-12">
                <label class="form-label">AutoBackupEnabled</label>
                <InputCheckbox class="form-check-input" @bind-Value="AutoBackupEnabled" />
            </div>
            <div class="col-12">
                <label class="form-label">Description</label>
                <InputTextArea class="form-control" @bind-Value="Description" />
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-secondary" @onclick="Cancel">لغو</button>
            <button type="submit" class="btn btn-success" disabled="@isSubmitting">
                @(isSubmitting ? "در حال ذخیره..." : (isNew ? "ایجاد" : "ذخیره"))
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public ProjectRow? Project { get; set; }

    private bool isNew => Project == null;
    private bool isSubmitting = false;
    private string? _error;

    private string Name { get; set; } = "";
    private int SessionTimeoutMinutes { get; set; } = 10;
    private string ApiKey { get; set; } = "";
    private string ConnectionString { get; set; } = "";
    private string DatabaseName { get; set; } = "";
    private bool AutoBackupEnabled { get; set; } = true;
    private string? Description { get; set; } = "";
    private string ClientUrl { get; set; } = "";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (!isNew && Project != null)
        {
            Name = Project.Name;
            SessionTimeoutMinutes = Project.SessionTimeoutMinutes;
            ApiKey = Project.ApiKey;
            ConnectionString = Project.ConnectionString;
            DatabaseName = Project.DatabaseName;
            AutoBackupEnabled = Project.AutoBackupEnabled;
            Description = Project.Description ?? "";
        }
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        _error = null;

        try
        {
            await SaveProject();
            await ModalService.CloseAsync();
            await JS.InvokeVoidAsync("eval", "window.location.reload()");
        }
        catch (Exception ex)
        {
            _error = $"خطا در ذخیره پروژه: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task SaveProject()
    {
        var connStr = Config.GetConnectionString("DefaultConnection")!;
        using var conn = new SqlConnection(connStr);
        await conn.OpenAsync();

        if (isNew)
        {
            var sql = @"
INSERT INTO dbo.Projects (
    Name, ProjectGuid, LoginTokenHash, EncryptionKey, ApiKey,
    SessionTimeoutMinutes, IsActive, ConnectionString, DatabaseName,
    DatabaseProvider, AutoBackupEnabled, AutoBackupIntervalMinutes,
    AutoBackupTimeUtc, MaxBackupRetention, Description, ClientUrl, CreatedAtUtc
)
VALUES (
    @Name, NEWID(), NEWID(), NEWID(), @ApiKey,
    @SessionTimeoutMinutes, @IsActive, @ConnectionString, @DatabaseName,
    'SqlServer', @AutoBackupEnabled, 1440, '02:00:00', 7, @Description, @ClientUrl, GETUTCDATE()
);";

            await conn.ExecuteAsync(sql, new
            {
                Name,
                ApiKey,
                SessionTimeoutMinutes,
                IsActive = true,
                ConnectionString,
                DatabaseName,
                AutoBackupEnabled,
                Description,
                ClientUrl
            });
        }
        else
        {
            // Not needed for creation-only flow
        }
    }

    private async Task Cancel() => await ModalService.CloseAsync();
}