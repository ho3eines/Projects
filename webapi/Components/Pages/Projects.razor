@page "/projects"
@using WebApi.Models
@using WebApi.Services
@using Share
@inject ProjectService ProjectService

<PageTitle>مدیریت پروژه‌ها</PageTitle>

<div class="h-page-header">
    <div>
        <h1 class="h-page-title">🗂️ مدیریت پروژه‌ها</h1>
        <p class="h-lead">هر پروژه یک آدرس کلاینت دارد — از ستون لینک وارد همان اپ شوید.</p>
    </div>
    <a href="/create-project" class="btn btn-hermes">➕ ایجاد پروژه</a>
</div>

@if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-lg-4 col-sm-6">
            <div class="h-card h-stat">
                <div><div class="k">کل پروژه‌ها</div><div class="v">@_projects.Count</div></div>
                <div class="h-stat-ico">▣</div>
            </div>
        </div>
        <div class="col-lg-4 col-sm-6">
            <div class="h-card h-stat">
                <div><div class="k">فعال</div><div class="v">@_projects.Count(p => p.IsActive)</div></div>
                <div class="h-stat-ico">◉</div>
            </div>
        </div>
        <div class="col-lg-4 col-sm-12">
            <div class="h-card h-stat">
                <div><div class="k">دارای لینک</div><div class="v">@_projects.Count(p => !string.IsNullOrWhiteSpace(ResolveUrl(p)))</div></div>
                <div class="h-stat-ico">🔗</div>
            </div>
        </div>
    </div>

    <div class="h-card">
        @if (_isLoading)
        {
            <div class="h-card-pad placeholder-glow">
                <div class="placeholder col-12" style="height:2.6rem"></div>
                <div class="placeholder col-12 mt-2" style="height:2.6rem"></div>
                <div class="placeholder col-12 mt-2" style="height:2.6rem"></div>
            </div>
        }
        else if (_projects.Count == 0)
        {
            <div class="h-card-pad text-muted">پروژه‌ای ثبت نشده است.</div>
        }
        else
        {
            <div class="h-table-wrap">
                <table class="h-table">
                    <thead>
                        <tr>
                            <th>پروژه</th>
                            <th>اسکیما</th>
                            <th>آدرس / لینک ورود</th>
                            <th>Timeout</th>
                            <th>وضعیت</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _projects)
                        {
                            var url = ResolveUrl(p);
                            <tr>
                                <td>
                                    <strong>@(string.IsNullOrWhiteSpace(p.Icon) ? "◈" : p.Icon) @p.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(p.Description))
                                    {
                                        <div class="h-lead">@p.Description</div>
                                    }
                                </td>
                                <td><code>@p.Schema</code></td>
                                <td class="h-project-url">
                                    @if (string.IsNullOrWhiteSpace(url))
                                    {
                                        <span class="text-muted">بدون آدرس</span>
                                    }
                                    else
                                    {
                                        <a href="@url" target="_blank" rel="noopener">@url</a>
                                    }
                                </td>
                                <td>@p.SessionTimeoutMinutes دقیقه</td>
                                <td>
                                    <span class="h-badge @(p.IsActive ? "live" : "wait")">
                                        @(p.IsActive ? "فعال" : "غیرفعال")
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(url))
                                    {
                                        <a class="btn btn-sm btn-hermes" href="@url" target="_blank" rel="noopener">ورود</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">لینک نیست</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private List<ProjectRow> _projects = new();
    private string? _error;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjectsAsync();
    }

    private async Task LoadProjectsAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            _projects = await ProjectService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _error = $"خطا در بارگذاری پروژه‌ها: {ex.Message}";
            _projects = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string ResolveUrl(ProjectRow p)
    {
        if (!string.IsNullOrWhiteSpace(p.ClientUrl))
            return p.ClientUrl.Trim();
        return HermesApps.ForSchema(p.Schema);
    }
}
