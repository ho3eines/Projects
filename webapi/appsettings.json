    "AccessTokenMinutes": 480
  },
  "Outbox": {
    "PollIntervalSeconds": 3,
    "MaxAttempts": 5,
    "BatchSize": 50,
    "Routes": [
      {
        "EventType": "OrderPlaced",
        "Consumers": [ { "Schema": "store", "Script": "ReserveStockForOrder" } ]
      },
      {
        "EventType": "StockReserved",
        "Consumers": [ { "Schema": "accounting", "Script": "SalesInvoiceFromOrder" } ]
      },
      {
        "EventType": "StockRejected",
        "Consumers": [ { "Schema": "store", "Script": "MarkOrderRejected" } ]
      },
      {
        "EventType": "InvoiceCreated",
        "Consumers": [ { "Schema": "treasury", "Script": "CashEntryFromInvoice" } ]
      },
      {
        "EventType": "PayrollFinalized",
        "Consumers": [
          { "Schema": "accounting", "Script": "GLPostFromPayroll" },
          { "Schema": "treasury", "Script": "CashMoveFromPayroll" }
        ]
      },
      {
        "EventType": "GoldPriceUpdated",
        "Consumers": [
          { "Schema": "accounting", "Script": "RefreshGoldPrice" },
          { "Schema": "store", "Script": "RefreshGoldPrice" }
        ]
      },
      {
        "EventType": "InventoryMovement",
        "Consumers": [
          { "Schema": "accounting", "Script": "ApplyInventoryMovement" },
          { "Schema": "goldshop", "Script": "ApplyInventoryMovement" },
          { "Schema": "store", "Script": "ApplyInventoryMovement" }
        ]
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
