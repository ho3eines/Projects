{
  "Tarazin": {
    "AppName": "ترازین — مدیریت هوشمند کسب‌وکار",
    "BootstrapAdminUser": "admin"
  },
  "CredentialBroker": {
    "CredentialLifetimeMinutes": 5,
    "SessionLifetimeMinutes": 30,
    "RequestTimestampWindowSeconds": 90
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
