@page "/"
@namespace Tarazin.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <title>ترازین — مدیریت هوشمند کسب‌وکار</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link href="_content/Tarazin.Ui/css/app.css" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="_content/Tarazin.Ui/brand/logo.svg" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body dir="rtl">
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            خطایی رخ داد؛ برنامه ممکن است تا بارگذاری مجدد پاسخ ندهد.
        </environment>
        <environment include="Development">
            خطای مدیریت‌نشده رخ داد. جزئیات را در DevTools مرورگر ببینید.
        </environment>
        <a href="" class="reload">بارگذاری مجدد</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="@Assets["_framework/blazor.server.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>
