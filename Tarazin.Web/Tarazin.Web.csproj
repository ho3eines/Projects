<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tarazin.Web</RootNamespace>
    <Description>ترازین — مدیریت هوشمند کسب‌وکار (هاست وب Blazor Server)</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- MudBlazor referenced directly so its static assets flow to the web app -->
    <PackageReference Include="MudBlazor" Version="9.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared core: modules, models, services, scripts, layout -->
    <ProjectReference Include="..\Tarazin.Ui\Tarazin.Ui.csproj" />
  </ItemGroup>

</Project>
