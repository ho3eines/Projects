<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tarazin.Web</RootNamespace>
    <Description>ترازین — مدیریت هوشمند کسب‌وکار (هاست وب Blazor Server)</Description>
    <!--
      .NET 10 only ships blazor.server.js when the project has a .razor file
      or this flag is set. Tarazin.Web is a thin host — all components live
      in Tarazin.Ui — so without this, /_framework/blazor.server.js is 404
      and the login page never becomes interactive.
    -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <!-- MudBlazor referenced directly so its static assets flow to the web app -->
    <PackageReference Include="MudBlazor" Version="9.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      صریح و نه ضمنی: appsettings.json باید همیشه کنار خروجی برنامه باشد،
      وگرنه ConnectionStrings:DefaultConnection خوانده نمی‌شود و برنامه با
      «رشتهٔ اتصال پیدا نشد» بالا نمی‌آید.
    -->
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" DependentUpon="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared core: modules, models, services, scripts, layout -->
    <ProjectReference Include="..\Tarazin.Ui\Tarazin.Ui.csproj" />
  </ItemGroup>

</Project>
