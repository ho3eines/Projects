@page "/reports"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>گزارشات — حقوق و دستمزد</PageTitle>

<h1 class="h-page-title">گزارشات حقوق</h1>
<p class="h-lead mb-4">فیش حقوق یک دوره.</p>

<div class="h-card h-card-pad mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-6 col-sm-8">
            <label class="form-label" for="run">دوره</label>
            <select id="run" class="form-select" @bind="RunId">
                <option value="0">— انتخاب دوره —</option>
                @foreach (var r in Runs) { <option value="@r.RunId">@r.Period — @r.NetTotal.ToString("N0")</option> }
            </select>
        </div>
        <div class="col-md-3 col-sm-4">
            <button class="btn btn-hermes w-100" @onclick="LoadAsync">نمایش فیش‌ها</button>
        </div>
    </div>
</div>

<div class="h-card">
    <div class="h-table-wrap">
        <table class="h-table">
            <thead>
                <tr><th>کد</th><th>پرسنل</th><th>خالص پرداختی</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Slips)
                {
                    <tr><td>@r.EmployeeId</td><td>@r.EmployeeName</td><td>@r.NetPay.ToString("N0")</td></tr>
                }
            </tbody>
            @if (Slips.Count > 0)
            {
                <tfoot>
                    <tr><th colspan="2">جمع دوره</th><th>@Slips[0].NetTotal.ToString("N0")</th></tr>
                </tfoot>
            }
        </table>
    </div>
</div>

@code {
    List<PayrollRunRow> Runs = new();
    List<PaySlipRow> Slips = new();
    int RunId;

    protected override async Task OnInitializedAsync()
        => Runs = await Request.Request<PayrollRunRow>("DailyRuns", new { SkipRows = 0, TakeSize = 50 }) ?? new();

    async Task LoadAsync()
    {
        if (RunId == 0) { await Alert.ShowErrorAsync("گزارش", "دوره را انتخاب کنید"); return; }
        try
        {
            Slips = await Request.Request<PaySlipRow>("PaySlipReport", new { RunId }) ?? new();
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("گزارش", ex.Message); }
    }
}
