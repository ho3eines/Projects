@page "/"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>دوره‌های حقوق — حقوق و دستمزد</PageTitle>

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h-page-title">دوره‌های حقوق</h1>
        <p class="h-lead">آخرین دوره‌های محاسبه و نهایی‌شده.</p>
    </div>
    <a class="btn btn-hermes" href="/special">محاسبه و نهایی‌کردن دوره</a>
</div>

<div class="h-card">
    @if (Loading)
    {
        <div class="h-card-pad placeholder-glow">
            <div class="placeholder col-12" style="height:2.6rem"></div>
            <div class="placeholder col-12 mt-2" style="height:2.6rem"></div>
        </div>
    }
    else if (Rows.Count == 0)
    {
        <div class="h-card-pad text-muted">دوره‌ای ثبت نشده است.</div>
    }
    else
    {
        <table class="h-table">
            <thead>
                <tr>
                    <th>دوره</th><th>تعداد پرسنل</th><th>خالص پرداختی</th><th>وضعیت</th><th>تاریخ ثبت</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Rows)
                {
                    <tr>
                        <td>@r.Period</td>
                        <td>@r.EmployeeCount</td>
                        <td>@r.NetTotal.ToString("N0")</td>
                        <td><span class="h-badge live">@r.Status</span></td>
                        <td>@r.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    List<PayrollRunRow> Rows = new();
    bool Loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Rows = await Request.Request<PayrollRunRow>("DailyRuns", new { SkipRows = 0, TakeSize = 50 }) ?? new();
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("حقوق", ex.Message); }
        finally { Loading = false; }
    }
}
