@page "/entry"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>ورود عملیات — حقوق و دستمزد</PageTitle>

<h1 class="h-page-title">ورود عملیات</h1>
<p class="h-lead mb-4">ثبت پرسنل و اقلام حقوق یک دوره.</p>

<div class="row g-3">
    <div class="col-lg-6 col-12">
        <div class="h-card h-card-pad">
            <h5 class="h-section-title">پرسنل جدید</h5>
            <div class="row g-2">
                <div class="col-md-4 col-sm-6"><input class="form-control" @bind="NewCode" placeholder="کد پرسنلی" /></div>
                <div class="col-md-8 col-sm-6"><input class="form-control" @bind="NewName" placeholder="نام و نام خانوادگی" /></div>
                <div class="col-md-6 col-sm-6"><input class="form-control" @bind="NewDept" placeholder="واحد" /></div>
                <div class="col-md-6 col-sm-6"><input class="form-control" type="number" @bind="NewBase" placeholder="حقوق پایه" /></div>
                <div class="col-12">
                    <button class="btn btn-hermes" @onclick="AddEmployeeAsync">افزودن پرسنل</button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6 col-12">
        <div class="h-card h-card-pad">
            <h5 class="h-section-title">قلم حقوق (برای دوره)</h5>
            <div class="row g-2">
                <div class="col-md-5 col-sm-6">
                    <select class="form-select" @bind="SalaryEmployeeId">
                        <option value="0">— پرسنل —</option>
                        @foreach (var e in Employees) { <option value="@e.EmployeeId">@e.FullName</option> }
                    </select>
                </div>
                <div class="col-md-3 col-sm-6"><input class="form-control" @bind="SalaryPeriod" placeholder="دوره، مثل 1405-05" /></div>
                <div class="col-md-2 col-sm-4"><input class="form-control" @bind="SalaryTitle" placeholder="عنوان" /></div>
                <div class="col-md-2 col-sm-4"><input class="form-control" type="number" @bind="SalaryAmount" placeholder="مبلغ" /></div>
                <div class="col-md-4 col-sm-4">
                    <select class="form-select" @bind="IsDeduction">
                        <option value="false">مزایا</option>
                        <option value="true">کسور</option>
                    </select>
                </div>
                <div class="col-md-8 col-sm-12">
                    <button class="btn btn-hermes w-100" @onclick="AddSalaryItemAsync">افزودن قلم حقوق</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    List<EmployeeRow> Employees = new();
    string NewCode = "";
    string NewName = "";
    string NewDept = "";
    decimal NewBase;
    int SalaryEmployeeId;
    string SalaryPeriod = "";
    string SalaryTitle = "";
    decimal SalaryAmount;
    bool IsDeduction;

    protected override async Task OnInitializedAsync()
        => Employees = await Request.Request<EmployeeRow>("EmployeeList", new { }) ?? new();

    async Task AddEmployeeAsync()
    {
        if (string.IsNullOrWhiteSpace(NewName)) { await Alert.ShowErrorAsync("حقوق", "نام پرسنل الزامی است"); return; }
        try
        {
            await Request.Request<object>("EmployeeUpsert", new
            {
                EmployeeId = 0,
                EmployeeCode = string.IsNullOrWhiteSpace(NewCode) ? null : NewCode,
                FullName = NewName,
                Department = NewDept,
                BaseSalary = NewBase,
                IsActive = true
            }, isExec: true);
            NewCode = ""; NewName = ""; NewDept = ""; NewBase = 0;
            Employees = await Request.Request<EmployeeRow>("EmployeeList", new { }) ?? new();
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("حقوق", ex.Message); }
    }

    async Task AddSalaryItemAsync()
    {
        if (SalaryEmployeeId == 0 || string.IsNullOrWhiteSpace(SalaryPeriod) || string.IsNullOrWhiteSpace(SalaryTitle))
        {
            await Alert.ShowErrorAsync("حقوق", "پرسنل، دوره و عنوان را وارد کنید");
            return;
        }
        try
        {
            await Request.Request<object>("SalaryItemUpsert", new
            {
                SalaryItemId = 0,
                EmployeeId = SalaryEmployeeId,
                Period = SalaryPeriod,
                Title = SalaryTitle,
                Amount = SalaryAmount,
                IsDeduction
            }, isExec: true);
            SalaryTitle = "";
            SalaryAmount = 0;
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("حقوق", ex.Message); }
    }
}
