@page "/audit"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>حسابرسی رویدادها — Hermes</PageTitle>

<h1 class="h-page-title">حسابرسی (AuditLog)</h1>
<p class="h-lead mb-4">همه فراخوانی‌های تغییردهنده با زنجیره هش ثبت می‌شوند (ADR-002).</p>

<div class="h-card h-card-pad mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-3 col-sm-6">
            <label class="form-label" for="schema">اسکیمه</label>
            <input id="schema" class="form-control" @bind="Schema" placeholder="همه" />
        </div>
        <div class="col-md-3 col-sm-6">
            <label class="form-label" for="script">اسکریپت</label>
            <input id="script" class="form-control" @bind="Script" placeholder="همه" />
        </div>
        <div class="col-md-2 col-sm-6">
            <label class="form-label" for="from">از تاریخ</label>
            <input id="from" type="date" class="form-control" @bind="From" />
        </div>
        <div class="col-md-2 col-sm-6">
            <label class="form-label" for="to">تا تاریخ</label>
            <input id="to" type="date" class="form-control" @bind="To" />
        </div>
        <div class="col-md-2 col-sm-12">
            <button class="btn btn-hermes w-100" @onclick="LoadAsync">اجرا</button>
        </div>
    </div>
</div>

<div class="h-card">
    <div class="h-table-wrap">
        <table class="h-table">
            <thead>
                <tr><th>#</th><th>زمان</th><th>اسکیمه</th><th>اسکریپت</th><th>کاربر</th><th>نتیجه</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Rows)
                {
                    <tr>
                        <td>@r.AuditId</td>
                        <td>@r.CreatedAt.ToString("yyyy/MM/dd HH:mm:ss")</td>
                        <td>@r.SchemaName</td>
                        <td>@r.ScriptName</td>
                        <td>@r.UserTokenId</td>
                        <td><span class="h-badge @(r.Outcome == "Success" ? "live" : "danger")">@r.Outcome</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Rows.Count == 0)
    {
        <div class="h-card-pad text-muted">رکوردی یافت نشد.</div>
    }
</div>

@code {
    List<AuditRow> Rows = new();
    string Schema = "";
    string Script = "";
    DateTime From = DateTime.Today.AddDays(-7);
    DateTime To = DateTime.Today;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        try
        {
            Rows = await Request.Request<AuditRow>("AuditSearch", new
            {
                SchemaName = string.IsNullOrWhiteSpace(Schema) ? null : Schema,
                ScriptName = string.IsNullOrWhiteSpace(Script) ? null : Script,
                FromDate = From,
                ToDate = To,
                SkipRows = 0,
                TakeSize = 100
            }) ?? new();
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("حسابرسی", ex.Message); }
    }

    public class AuditRow
    {
        public long AuditId { get; set; }
        public string SchemaName { get; set; } = "";
        public string ScriptName { get; set; } = "";
        public string UserTokenId { get; set; } = "";
        public string RequestId { get; set; } = "";
        public string Outcome { get; set; } = "";
        public DateTime CreatedAt { get; set; }
    }
}
