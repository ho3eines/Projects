@page "/gallery"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>گالری — Hermes</PageTitle>
<h1 class="h-page-title">گالری</h1>
<p class="h-lead mb-4">مدیریت تصاویر گالری وبسایت.</p>

<div class="h-card h-card-pad mb-3">
    <div class="row g-2">
        <div class="col-md-4"><input class="form-control" @bind="NewTitle" placeholder="عنوان" /></div>
        <div class="col-md-4"><input class="form-control" @bind="NewCaption" placeholder="توضیح" /></div>
        <div class="col-md-2"><input class="form-control" type="number" @bind="NewSort" placeholder="ترتیب" /></div>
        <div class="col-md-2">
            <button class="btn btn-hermes w-100" @onclick="AddAsync">افزودن آیتم</button>
        </div>
    </div>
</div>

<div class="row g-3">
    @foreach (var g in Items)
    {
        <div class="col-md-4">
            <div class="h-card h-card-pad">
                <h5 class="mb-1">@g.Title</h5>
                <p class="h-lead mb-1">@g.Caption</p>
                <span class="badge text-bg-secondary">ترتیب @g.SortOrder</span>
                <span class="badge @(g.IsActive ? "text-bg-success" : "text-bg-secondary")">@(g.IsActive ? "فعال" : "غیرفعال")</span>
            </div>
        </div>
    }
</div>

@code {
    List<GalleryItemRow> Items = new();
    string NewTitle = "";
    string NewCaption = "";
    int NewSort = 1;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    async Task ReloadAsync()
        => Items = await Request.Request<GalleryItemRow>("GalleryList", new { SkipRows = 0, TakeSize = 100 }) ?? new();

    async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(NewTitle))
        {
            await Alert.ShowErrorAsync("گالری", "عنوان الزامی است");
            return;
        }
        try
        {
            await Request.Request<object>("GalleryUpsert", new
            {
                GalleryItemId = 0,
                Title = NewTitle,
                ImageUrl = (string?)null,
                Caption = string.IsNullOrWhiteSpace(NewCaption) ? null : NewCaption,
                SortOrder = NewSort,
                IsActive = true,
                CreatedBy = Request.UserToken
            }, isExec: true);
            NewTitle = ""; NewCaption = ""; NewSort = Items.Count + 1;
            await ReloadAsync();
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("گالری", ex.Message); }
    }
}
