@page "/users"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>کاربران — Hermes</PageTitle>

<div class="h-page-header">
    <div>
        <h1 class="h-page-title">کاربران و دسترسی</h1>
        <p class="h-lead">تعریف کاربر در مرکز انجام می‌شود؛ توکن همان کاربر همه پروژه‌ها را باز می‌کند.</p>
    </div>
</div>

<div class="h-card">
    @if (Loading)
    {
        <div class="h-card-pad">
            <div class="placeholder-glow">
                <div class="placeholder col-12" style="height:2.5rem"></div>
                <div class="placeholder col-12 mt-2" style="height:2.5rem"></div>
            </div>
        </div>
    }
    else
    {
        <div class="h-table-wrap">
            <table class="h-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>نام کاربری</th>
                        <th>نام نمایشی</th>
                        <th>نقش</th>
                        <th>وضعیت</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in UsersList)
                    {
                        <tr>
                            <td>@u.UserId</td>
                            <td>@u.Username</td>
                            <td>@u.DisplayName</td>
                            <td>@u.Role</td>
                            <td>
                                <span class="h-badge @(u.IsActive ? "live" : "wait")">
                                    @(u.IsActive ? "فعال" : "غیرفعال")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    List<UserRow> UsersList = new();
    bool Loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            UsersList = await Request.Request<UserRow>("UserList") ?? new();
        }
        catch (Exception ex)
        {
            await Alert.ShowErrorAsync("کاربران", ex.Message);
        }
        finally { Loading = false; }
    }
}
