@page "/login"
@layout EmptyLayout
@inject IRequestService Request
@inject NavigationManager Nav
@inject IClientStorageService Storage
@inject IAlertService Alert

<PageTitle>ورود — Hermes</PageTitle>

<div class="h-login">
    <section class="h-login-art">
        <div>
            <div class="h-brand-mark mb-3">H</div>
            <h2 class="fw-bold">یک ورود، همه پروژه‌ها</h2>
            <p class="mt-3" style="max-width:28rem;color:#94a3b8;line-height:1.9">
                در کلاینت مرکزی وارد شوید. توکن کاربر به حسابداری، انبار و فروشگاه
                از طریق آدرس منتقل می‌شود. هر پروژه با ProjectGuid خودش به webapi وصل است.
            </p>
        </div>
        <div class="d-flex gap-4" style="color:#64748b;font-size:.85rem">
            <div>۱. Handshake پروژه</div>
            <div>۲. لاگین کاربر</div>
            <div>۳. باز کردن ماژول</div>
        </div>
    </section>

    <section class="h-login-panel">
        <div class="h-login-box">
            <p class="text-muted mb-1" style="font-size:.85rem">Hermes ERP</p>
            <h1 class="mb-2">ورود به سیستم</h1>
            <p class="text-muted mb-4" style="font-size:.85rem">تست: <code>admin</code> / <code>admin</code></p>

            <div class="mb-3">
                <label class="form-label" for="user">نام کاربری</label>
                <input id="user" class="form-control form-control-lg" @bind="Username" autocomplete="username" />
            </div>
            <div class="mb-4">
                <label class="form-label" for="pass">رمز عبور</label>
                <input id="pass" type="password" class="form-control form-control-lg" @bind="Password" autocomplete="current-password" />
            </div>
            <button class="btn btn-gold w-100 py-2" disabled="@Busy" @onclick="DoLogin">
                @if (Busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                ورود به مرکز مدیریت
            </button>
        </div>
    </section>
</div>

@code {
    string Username = "admin";
    string Password = "admin";
    bool Busy;

    async Task DoLogin()
    {
        Busy = true;
        try
        {
            var result = await Request.LoginAsync(Username, Password);
            if (result is null) return;
            await Storage.SetLocalAsync("hermes_user_token", result.UserToken);
            await Storage.SetLocalAsync("hermes_user_name", result.DisplayName);
            await Alert.ShowSuccessAsync("خوش آمدید", result.DisplayName);
            Nav.NavigateTo("/");
        }
        finally { Busy = false; }
    }
}
