@page "/login"
@inject IRequestService Request
@inject NavigationManager Nav
@inject IClientStorageService Storage
@inject IAlertService Alert

<PageTitle>ورود</PageTitle>

<div class="container" style="max-width:420px;margin-top:4rem">
    <h2 class="mb-3">ورود به Hermes</h2>
    <p class="text-muted">لاگین کاربر بعد از handshake پروژه</p>

    <div class="mb-3">
        <label class="form-label" for="user">نام کاربری</label>
        <input id="user" class="form-control" @bind="Username" autocomplete="username" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="pass">رمز عبور</label>
        <input id="pass" type="password" class="form-control" @bind="Password" autocomplete="current-password" />
    </div>
    <button class="btn btn-primary w-100" disabled="@Busy" @onclick="DoLogin">
        @if (Busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
        ورود
    </button>
</div>

@code {
    string Username = "admin";
    string Password = "";
    bool Busy;

    async Task DoLogin()
    {
        Busy = true;
        try
        {
            var result = await Request.LoginAsync(Username, Password);
            if (result is null)
                return;
            await Storage.SetLocalAsync("hermes_user_token", result.UserToken);
            await Storage.SetLocalAsync("hermes_user_name", result.DisplayName);
            await Alert.ShowSuccessAsync("خوش آمدید", result.DisplayName);
            Nav.NavigateTo("/");
        }
        finally { Busy = false; }
    }
}
