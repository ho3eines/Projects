@page "/login"
@layout EmptyLayout
@using BlazorDeployService.Services
@inject IRequestService Request
@inject NavigationManager Nav
@inject IClientStorageService Storage
@inject IErrorDisplayService Errors

<PageTitle>ورود — Hermes</PageTitle>

<div class="h-login">
    <!-- حباب‌های متحرک پس‌زمینه (شیشه‌ای) -->
    <div class="h-blob h-blob-1" aria-hidden="true"></div>
    <div class="h-blob h-blob-2" aria-hidden="true"></div>
    <div class="h-blob h-blob-3" aria-hidden="true"></div>

    <div class="h-login-grid">
        <section class="h-login-art">
            <div>
                <div class="h-brand-mark h-brand-mark-lg mb-4">H</div>
                <h2 class="fw-bold text-white">یک ورود، همه پروژه‌ها</h2>
                <p class="mt-3 h-login-art-text">
                    در کلاینت مرکزی وارد شوید. توکن کاربر به حسابداری، انبار و فروشگاه
                    از طریق آدرس منتقل می‌شود. هر پروژه با ProjectGuid خودش به webapi وصل است.
                </p>
            </div>
            <div class="h-login-steps">
                <span class="h-step-pill"><b>۱</b> Handshake پروژه</span>
                <span class="h-step-pill"><b>۲</b> لاگین کاربر</span>
                <span class="h-step-pill"><b>۳</b> باز کردن ماژول</span>
            </div>
        </section>

        <section class="h-login-panel">
            <div class="h-login-box">
                <div class="h-login-mobile-brand">
                    <div class="h-brand-mark mb-2">H</div>
                    <div class="h-login-eyebrow">Hermes ERP</div>
                </div>

                <p class="h-login-eyebrow d-none d-lg-block">Hermes ERP</p>
                <h1 class="mb-2">ورود به سیستم</h1>
                <p class="text-muted mb-4 h-login-hint">تست: <code>admin</code> / <code>admin</code></p>

                @if (!string.IsNullOrEmpty(ErrorText))
                {
                    <div class="h-alert-inline h-alert-inline-error mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span class="h-alert-inline-msg">@ErrorText</span>
                        <button type="button" class="h-alert-close" @onclick="() => ErrorText = null" aria-label="بستن پیام خطا">&times;</button>
                    </div>
                }

                <form @onsubmit="DoLogin" @onsubmit:preventDefault="true" novalidate>
                    <div class="mb-3">
                        <label class="form-label" for="user">نام کاربری</label>
                        <div class="h-input-group">
                            <i class="bi bi-person-fill h-input-icon"></i>
                            <input id="user" class="form-control form-control-lg h-input"
                                   @bind="Username" autocomplete="username" placeholder="نام کاربری" />
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="pass">رمز عبور</label>
                        <div class="h-input-group">
                            <i class="bi bi-shield-lock-fill h-input-icon"></i>
                            <input id="pass" type="@(ShowPass ? "text" : "password")"
                                   class="form-control form-control-lg h-input h-input-pass"
                                   @bind="Password" autocomplete="current-password" placeholder="رمز عبور" />
                            <button type="button" class="h-input-eye" @onclick="() => ShowPass = !ShowPass"
                                    tabindex="-1" aria-label="نمایش/مخفی کردن رمز">
                                <i class="bi @(ShowPass ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </div>
                    </div>

                    <button class="btn btn-gold w-100 h-btn-login" disabled="@Busy" type="submit">
                        @if (Busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <text>در حال ورود…</text>
                        }
                        else
                        {
                            <text>ورود به مرکز مدیریت</text>
                        }
                    </button>
                </form>
            </div>
        </section>
    </div>
</div>

@code {
    string Username = "admin";
    string Password = "admin";
    bool ShowPass;
    bool Busy;
    string? ErrorText;

    async Task DoLogin()
    {
        ErrorText = null;

        if (string.IsNullOrWhiteSpace(Username) || string.IsNullOrWhiteSpace(Password))
        {
            ErrorText = "نام کاربری و رمز عبور را وارد کنید.";
            return;
        }

        Busy = true;
        try
        {
            var result = await Request.LoginAsync(Username, Password);
            if (result is null)
            {
                ErrorText = "پاسخ سرور معتبر نیست — لطفاً دوباره تلاش کنید.";
                await Errors.ShowErrorAsync("پاسخ سرور معتبر نیست — لطفاً دوباره تلاش کنید.", "ورود");
                return;
            }

            await Storage.SetLocalAsync("hermes_user_token", result.UserToken);
            await Storage.SetLocalAsync("hermes_user_name", result.DisplayName);
            await Errors.ShowSuccessAsync($"خوش آمدید {result.DisplayName}", "ورود موفق");
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            // نمایش خطا هم به‌صورت Toast و هم داخل فرم
            await Errors.ShowAsync(ex, "ورود");
            ErrorText = FriendlyError(ex);
        }
        finally
        {
            Busy = false;
        }
    }

    /// <summary>پیام کوتاه و خوانا برای نمایش داخل فرم</summary>
    static string FriendlyError(Exception ex) => ex switch
    {
        RequestServiceException rse => Shorten(rse.Message),
        AuthException ae => Shorten(ae.Message),
        HttpRequestException => "اتصال به سرور برقرار نشد — وضعیت شبکه یا در دسترس بودن سرور را بررسی کنید.",
        OperationCanceledException => "مهلت درخواست تمام شد — لطفاً دوباره تلاش کنید.",
        _ => Shorten(ex.Message)
    };

    static string Shorten(string s)
        => string.IsNullOrEmpty(s) ? "خطای ناشناخته رخ داد." : (s.Length <= 180 ? s : s[..180] + "…");
}
