@page "/"
@inject IRequestService Request

<PageTitle>داشبورد — Hermes</PageTitle>

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h-page-title">پروژه‌های سازمان</h1>
        <p class="h-lead">با یک حساب وارد شوید و هر ماژول را در تب جدا باز کنید. توکن کاربر همراه لینک می‌رود.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="h-card h-stat">
            <div><div class="k">پروژه فعال</div><div class="v">۶</div></div>
            <div class="h-stat-ico">▣</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="h-card h-stat">
            <div><div class="k">پلتفرم مشترک</div><div class="v">۱</div></div>
            <div class="h-stat-ico">◈</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="h-card h-stat">
            <div><div class="k">وضعیت نشست</div><div class="v" style="font-size:1.1rem;padding-top:.35rem">@(LoggedIn ? "وارد شده" : "بدون توکن")</div></div>
            <div class="h-stat-ico">◉</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <article class="h-card h-project">
            <div class="d-flex justify-content-between">
                <div class="h-project-ico">📒</div>
                <span class="h-badge live">فعال</span>
            </div>
            <h4 class="mb-0">حسابداری</h4>
            <p class="h-lead">اسناد، حساب کل/معین، قوانین مالیاتی. Schema: accounting</p>
            <a class="btn btn-hermes mt-auto" href="@Url(HermesApps.Accounting)" target="_blank">ورود به حسابداری</a>
        </article>
    </div>
    <div class="col-md-4">
        <article class="h-card h-project">
            <div class="d-flex justify-content-between">
                <div class="h-project-ico">📦</div>
                <span class="h-badge live">فعال</span>
            </div>
            <h4 class="mb-0">انبار آمل</h4>
            <p class="h-lead">رسید/حواله، کارتکس، انبارگردانی، رزرو موجودی. Schema: inventory</p>
            <a class="btn btn-hermes mt-auto" href="@Url(HermesApps.Inventory)" target="_blank">ورود به انبار</a>
        </article>
    </div>
    <div class="col-md-4">
        <article class="h-card h-project">
            <div class="d-flex justify-content-between">
                <div class="h-project-ico">💰</div>
                <span class="h-badge live">فعال</span>
            </div>
            <h4 class="mb-0">خزانه‌داری</h4>
            <p class="h-lead">دریافت/پرداخت، بانک‌ها و صندوق‌ها، نرخ ارز. Schema: treasury</p>
            <a class="btn btn-hermes mt-auto" href="@Url(HermesApps.Treasury)" target="_blank">ورود به خزانه</a>
        </article>
    </div>
    <div class="col-md-4">
        <article class="h-card h-project">
            <div class="d-flex justify-content-between">
                <div class="h-project-ico">👥</div>
                <span class="h-badge live">فعال</span>
            </div>
            <h4 class="mb-0">حقوق و دستمزد</h4>
            <p class="h-lead">پرسنل، اقلام حقوق، فیش، انتقال به حسابداری و خزانه. Schema: payroll</p>
            <a class="btn btn-hermes mt-auto" href="@Url(HermesApps.Payroll)" target="_blank">ورود به حقوق</a>
        </article>
    </div>
    <div class="col-md-4">
        <article class="h-card h-project">
            <div class="d-flex justify-content-between">
                <div class="h-project-ico">🥇</div>
                <span class="h-badge live">فعال</span>
            </div>
            <h4 class="mb-0">مدیریت طلافروشی</h4>
            <p class="h-lead">فاکتور فروش طلا، اجرت/سود/مالیات، قیمت روز. Schema: goldshop</p>
            <a class="btn btn-hermes mt-auto" href="@Url(HermesApps.GoldShop)" target="_blank">ورود به طلافروشی</a>
        </article>
    </div>
    <div class="col-md-4">
        <article class="h-card h-project">
            <div class="d-flex justify-content-between">
                <div class="h-project-ico">🏪</div>
                <span class="h-badge live">فعال</span>
            </div>
            <h4 class="mb-0">فروشگاه اینترنتی</h4>
            <p class="h-lead">سبد خرید، سفارش → رزرو انبار → فاکتور → نقد. Schema: store</p>
            <a class="btn btn-hermes mt-auto" href="@Url(HermesApps.Store)" target="_blank">ورود به فروشگاه</a>
        </article>
    </div>
</div>

@code {
    bool LoggedIn => !string.IsNullOrEmpty(Request.UserToken);
    string Url(string app) => HermesApps.Open(app, Request.UserToken);
}
