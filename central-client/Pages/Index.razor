@page "/"
@inject IRequestService Request
@inject HttpClient Http
@inject IConfiguration Config
@using System.Net.Http.Json
@using Microsoft.Extensions.Configuration
@using Share

<PageTitle>داشبورد — Hermes</PageTitle>

<div class="h-page-header">
    <div>
        <h1 class="h-page-title">پروژه‌های سازمان</h1>
        <p class="h-lead">با یک حساب وارد شوید و هر ماژول را از لینک همان پروژه باز کنید. توکن کاربر همراه لینک می‌رود.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-4 col-sm-6">
        <div class="h-card h-stat">
            <div><div class="k">پروژه فعال</div><div class="v">@Cards.Count(c => !string.Equals(c.Schema, "central", StringComparison.OrdinalIgnoreCase))</div></div>
            <div class="h-stat-ico">▣</div>
        </div>
    </div>
    <div class="col-lg-4 col-sm-6">
        <div class="h-card h-stat">
            <div><div class="k">پلتفرم مشترک</div><div class="v">۱</div></div>
            <div class="h-stat-ico">◈</div>
        </div>
    </div>
    <div class="col-lg-4 col-sm-12">
        <div class="h-card h-stat">
            <div><div class="k">وضعیت نشست</div><div class="v" style="font-size:1.1rem;padding-top:.35rem">@(LoggedIn ? "وارد شده" : "بدون توکن")</div></div>
            <div class="h-stat-ico">◉</div>
        </div>
    </div>
</div>

<div class="row g-3">
    @foreach (var c in Cards)
    {
        <div class="col-lg-4 col-sm-6">
            <article class="h-card h-project">
                <div class="d-flex justify-content-between">
                    <div class="h-project-ico">@c.Icon</div>
                    <span class="h-badge live">فعال</span>
                </div>
                <h4 class="mb-0">@c.Title</h4>
                <p class="h-lead">@c.Lead</p>
                <div class="h-project-url mb-2">
                    @if (string.IsNullOrWhiteSpace(c.ClientUrl))
                    {
                        <span class="text-muted">آدرس تنظیم نشده</span>
                    }
                    else
                    {
                        <a href="@Url(c.ClientUrl)" target="_blank" rel="noopener">@c.ClientUrl</a>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(c.ClientUrl))
                {
                    <a class="btn btn-hermes mt-auto" href="@Url(c.ClientUrl)" target="_blank" rel="noopener">ورود به @c.Title</a>
                }
                else
                {
                    <span class="btn btn-outline-hermes mt-auto disabled">لینک ندارد</span>
                }
            </article>
        </div>
    }
</div>

@code {
    bool LoggedIn => !string.IsNullOrEmpty(Request.UserToken);
    string Url(string app) => HermesApps.Open(app, Request.UserToken);

    List<ProjectCard> Cards = DefaultCards();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var baseUrl = (Config["Hermes:WebApiUrl"] ?? "https://localhost:65222").TrimEnd('/');
            var dir = await Http.GetFromJsonAsync<List<ProjectDirectoryItem>>($"{baseUrl}/api/projects/directory");
            if (dir is not { Count: > 0 })
                return;

            var bySchema = dir
                .Where(d => !string.IsNullOrWhiteSpace(d.Schema))
                .GroupBy(d => d.Schema, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

            Cards = Cards.Select(c =>
            {
                if (!bySchema.TryGetValue(c.Schema, out var d))
                    return c;
                var url = string.IsNullOrWhiteSpace(d.ClientUrl) ? c.ClientUrl : d.ClientUrl;
                var title = string.IsNullOrWhiteSpace(d.Name) ? c.Title : d.Name;
                var icon = string.IsNullOrWhiteSpace(d.Icon) ? c.Icon : d.Icon!;
                var lead = string.IsNullOrWhiteSpace(d.Description) ? c.Lead : d.Description!;
                return c with { Title = title, Icon = icon, Lead = lead, ClientUrl = url };
            }).ToList();

            foreach (var d in dir.Where(x => x.IsActive
                         && !string.Equals(x.Schema, "central", StringComparison.OrdinalIgnoreCase)))
            {
                if (Cards.Any(c => c.Schema.Equals(d.Schema, StringComparison.OrdinalIgnoreCase)))
                    continue;
                Cards.Add(new ProjectCard(
                    string.IsNullOrWhiteSpace(d.Name) ? d.Schema : d.Name,
                    string.IsNullOrWhiteSpace(d.Icon) ? "▣" : d.Icon!,
                    d.Description ?? $"Schema: {d.Schema}",
                    d.Schema,
                    d.ClientUrl));
            }
        }
        catch
        {
            // API down — keep default localhost URLs
        }
    }

    static List<ProjectCard> DefaultCards() => new()
    {
        new("حسابداری", "📒", "اسناد، حساب کل/معین، قوانین مالیاتی. Schema: accounting", "accounting", HermesApps.Accounting),
        new("انبار آمل", "📦", "رسید/حواله، کارتکس، انبارگردانی، رزرو موجودی. Schema: inventory", "inventory", HermesApps.Inventory),
        new("خزانه‌داری", "💰", "دریافت/پرداخت، بانک‌ها و صندوق‌ها، نرخ ارز. Schema: treasury", "treasury", HermesApps.Treasury),
        new("حقوق و دستمزد", "👥", "پرسنل، اقلام حقوق، فیش، انتقال به حسابداری و خزانه. Schema: payroll", "payroll", HermesApps.Payroll),
        new("مدیریت طلافروشی", "🥇", "فاکتور فروش طلا، اجرت/سود/مالیات، قیمت روز. Schema: goldshop", "goldshop", HermesApps.GoldShop),
        new("فروشگاه اینترنتی", "🏪", "سبد خرید، سفارش → رزرو انبار → فاکتور → نقد. Schema: store", "store", HermesApps.Store),
    };

    sealed record ProjectCard(string Title, string Icon, string Lead, string Schema, string ClientUrl);
}
