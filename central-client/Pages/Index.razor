@page "/"
@inject IRequestService Request

<PageTitle>داشبورد</PageTitle>

<div class="container mt-4">
    <h1>🏢 سیستم مدیریت پروژه‌ها</h1>
    <p class="text-muted">کلاینت مرکزی — وب‌سایت شرکت + مدیریت پروژه‌ها + ویجت‌ها</p>
    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">📁 پروژه‌ها</h5>
                    <p class="card-text">مدیریت همه پروژه‌ها</p>
                    <a class="btn btn-sm btn-outline-primary" href="@AccountingUrl">حسابداری</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">📰 اخبار</h5>
                    <p class="card-text">اخبار شرکت</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">👥 کاربران</h5>
                    <p class="card-text">مدیریت کاربران و دسترسی‌ها</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    string AccountingUrl => string.IsNullOrEmpty(Request.UserToken)
        ? "https://localhost:65218/"
        : "https://localhost:65218/?token=" + Uri.EscapeDataString(Request.UserToken);
}