@page "/blog"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>وبلاگ — Hermes</PageTitle>
<h1 class="h-page-title">وبلاگ</h1>
<p class="h-lead mb-4">مدیریت پست‌های وبلاگ شرکت.</p>

<div class="h-card h-card-pad mb-3">
    <div class="row g-2">
        <div class="col-md-3"><input class="form-control" @bind="NewTitle" placeholder="عنوان پست" /></div>
        <div class="col-md-2"><input class="form-control" @bind="NewSlug" placeholder="slug" /></div>
        <div class="col-md-2"><input class="form-control" @bind="NewAuthor" placeholder="نویسنده" /></div>
        <div class="col-md-3"><input class="form-control" @bind="NewTags" placeholder="برچسب‌ها (با ویرگول)" /></div>
        <div class="col-md-2">
            <button class="btn btn-hermes w-100" @onclick="AddAsync">افزودن پست</button>
        </div>
    </div>
</div>

<div class="h-card">
    <table class="h-table">
        <thead>
            <tr><th>#</th><th>عنوان</th><th>نویسنده</th><th>برچسب‌ها</th><th>تاریخ</th><th>وضعیت</th></tr>
        </thead>
        <tbody>
            @foreach (var b in Posts)
            {
                <tr>
                    <td>@b.PostId</td>
                    <td>@b.Title</td>
                    <td>@b.Author</td>
                    <td>@b.Tags</td>
                    <td>@(b.PublishedAt?.ToString("yyyy/MM/dd") ?? "-")</td>
                    <td>@(b.IsActive ? "فعال" : "غیرفعال")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    List<BlogRow> Posts = new();
    string NewTitle = "";
    string NewSlug = "";
    string NewAuthor = "";
    string NewTags = "";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    async Task ReloadAsync()
        => Posts = await Request.Request<BlogRow>("BlogList", new { SkipRows = 0, TakeSize = 100 }) ?? new();

    async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(NewTitle))
        {
            await Alert.ShowErrorAsync("وبلاگ", "عنوان پست الزامی است");
            return;
        }
        try
        {
            await Request.Request<object>("BlogUpsert", new
            {
                PostId = 0,
                Title = NewTitle,
                Slug = string.IsNullOrWhiteSpace(NewSlug) ? null : NewSlug,
                Body = (string?)null,
                Author = string.IsNullOrWhiteSpace(NewAuthor) ? null : NewAuthor,
                Tags = string.IsNullOrWhiteSpace(NewTags) ? null : NewTags,
                PublishedAt = DateTime.Today,
                IsActive = true,
                CreatedBy = Request.UserToken
            }, isExec: true);
            NewTitle = ""; NewSlug = ""; NewAuthor = ""; NewTags = "";
            await ReloadAsync();
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("وبلاگ", ex.Message); }
    }
}
