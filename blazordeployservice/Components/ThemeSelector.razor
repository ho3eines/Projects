@namespace BlazorDeployService.Components
@using BlazorDeployService.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop

@implements IDisposable
@inject IThemeService ThemeService
@inject IJSRuntime JS

<div class="theme-selector d-flex align-items-center gap-2">
    <!-- دکمه تغییر حالت تاریک/روشن -->
    <button class="btn @GetDarkModeButtonClass() rounded-circle p-2"
            @onclick="ToggleDarkMode"
            title="@(ThemeService.IsDarkMode ? "حالت روشن" : "حالت تاریک")">
        @if (ThemeService.IsDarkMode)
        {
            <i class="bi bi-sun-fill"></i>
        }
        else
        {
            <i class="bi bi-moon-stars-fill"></i>
        }
    </button>

    <!-- انتخاب تم -->
    <div class="dropdown">
        <button class="btn btn-outline-primary dropdown-toggle d-flex align-items-center gap-2"
                type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-palette-fill"></i>
            <span>@ThemeService.GetThemeName(ThemeService.CurrentTheme)</span>
        </button>
        <ul class="dropdown-menu">
            @foreach (var theme in ThemeService.GetAvailableThemes())
            {
                <li>
                    <button class="dropdown-item @(theme == ThemeService.CurrentTheme ? "active" : "")"
                            @onclick="() => ChangeTheme(theme)">
                        <div class="d-flex align-items-center gap-2">
                            <div class="theme-color-indicator" style="background-color: @GetThemeColor(theme)"></div>
                            <span>@ThemeService.GetThemeName(theme)</span>
                            @if (theme == ThemeService.CurrentTheme)
                            {
                                <i class="bi bi-check-lg ms-auto text-primary"></i>
                            }
                        </div>
                    </button>
                </li>
            }
        </ul>
    </div>
</div>

<style>
    .theme-selector {
        font-family: 'Vazir', sans-serif;
    }

    .theme-color-indicator {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 2px solid #fff;
        box-shadow: 0 0 2px rgba(0,0,0,0.3);
    }

    .dropdown-item.active {
        background-color: var(--bs-primary) !important;
        color: white !important;
    }

    .btn-dark-mode {
        transition: all 0.3s ease;
    }

        .btn-dark-mode:hover {
            transform: scale(1.1);
        }
</style>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ThemeService.InitializeAsync();
        ThemeService.OnThemeChanged += OnThemeChanged;
        ThemeService.OnDarkModeChanged += OnDarkModeChanged;
    }

    private string GetDarkModeButtonClass()
    {
        return ThemeService.IsDarkMode ? "btn-warning" : "btn-outline-secondary";
    }

    private string GetThemeColor(string theme)
    {
        return theme switch
        {
            "indigo" => "#3949ab",
            "emerald" => "#2e7d32",
            "blue" => "#1565c0",
            "teal" => "#00796b",
            "rose" => "#e91e63",
            _ => "#3949ab"
        };
    }

    private async Task ToggleDarkMode()
    {
        await ThemeService.ToggleDarkAsync();
    }

    private async Task ChangeTheme(string themeKey)
    {
        await ThemeService.SetThemeAsync(themeKey);
    }

    private void OnThemeChanged(string theme)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnDarkModeChanged(bool isDark)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        ThemeService.OnDarkModeChanged -= OnDarkModeChanged;
    }
}