@using Microsoft.AspNetCore.Components.Web
@typeparam TItem
@typeparam TValue
@implements IAsyncDisposable

<style>
    /* Container for the entire component */
    .searchable-list-wrapper {
        position: relative;
        width: 100%;
    }

    /* The main input field, inheriting Bootstrap's form-control style */
    .search-input {
        /* Inherit all styles from Bootstrap's .form-control */
        /* The glassmorphic styles are layered on top */
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0.2));
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 16px;
        color: #2c3e50;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0px 1px 15px 10px rgba(0, 0, 0, 0.05), inset 1px 1px 15px 15px rgba(255, 255, 255, 0.3);
    }

        /* Style when input is focused */
        .search-input:focus {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.3));
            border-color: transparent;
            outline: none;
            box-shadow: 0px 1px 5px 5px rgb(0 254 8 / 35%), inset 1px 1px 5px 5px rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
            color: #1a1a1a;
        }

    /* The dropdown list container, styled like a Bootstrap dropdown-menu */
    .dropdown-list {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 9999; /* Ensure it's above other content */
        display: flex;
        flex-direction: column;
        padding: 0.5rem 0;
        margin: 0.25rem 0 0;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.25), rgba(255, 255, 255, 0.1));
        backdrop-filter: blur(30px) saturate(180%);
        -webkit-backdrop-filter: blur(30px) saturate(180%);
        background-clip: padding-box;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 16px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(255, 255, 255, 0.05) inset, 0 1px 0 rgba(255, 255, 255, 0.1) inset;
        max-height: 200px;
        overflow-y: visible;
    }

    /* Individual items in dropdown, styled like Bootstrap dropdown-items */
    .dropdown-item {
        display: block;
        width: 100%;
        padding: 0.375rem 1rem;
        clear: both;
        font-weight: 400;
        color: #2c3e50;
        text-align: inherit;
        text-decoration: none;
        white-space: nowrap;
        background-color: transparent;
        border: 0;
        border-radius: 8px;
        margin: 0.1rem 0.5rem;
        transition: all 0.2s ease;
        cursor: pointer;
    }

        /* Hover and highlighted state for dropdown items */
        .dropdown-item:hover, .dropdown-item.highlighted {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.1));
            color: #1a1a1a;
            transform: translateX(-5px);
        }

    /* Style for "No results" message */
    .no-results {
        display: block;
        width: 100%;
        padding: 0.375rem 1rem;
        clear: both;
        font-weight: 400;
        color: #6c757d;
        text-align: center;
        white-space: nowrap;
        background-color: transparent;
        border: 0;
    }

    /* Custom scrollbar for dropdown list */
    .dropdown-list::-webkit-scrollbar {
        width: 8px;
    }

    .dropdown-list::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
    }

    .dropdown-list::-webkit-scrollbar-thumb {
        background: linear-gradient(to bottom, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.1));
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

        .dropdown-list::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(to bottom, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.2));
        }
</style>

<div class="searchable-list-wrapper" @onclick="FocusInput">
    <input type="text"
           class="form-control"
           @bind="displayText"
           @oninput="OnSearchInput"
           @onfocus="OpenDropdown"
           @onblur="OnBlurInput"
           @onkeydown="OnKeyDown"
           @onkeydown:preventDefault="@shouldPreventDefault"
           placeholder="@Placeholder"
           @ref="inputRef" />

    @if (isDropdownOpen)
    {
        <div class="dropdown-list">
            @if (filteredItems.Any())
            {
                @for (int i = 0; i < filteredItems.Count; i++)
                {
                    var item = filteredItems[i];
                    var itemIndex = i;
                    <div class="dropdown-item @(highlightedIndex == itemIndex ? "highlighted" : "")"
                         @onclick:stopPropagation
                         @onclick="@(() => SelectItem(item))"
                         @onmouseenter="@(() => highlightedIndex = itemIndex)">
                        @TextSelector(item)
                    </div>
                }
            }
            else
            {
                <div class="no-results">موردی یافت نشد</div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public List<TItem> Items { get; set; } = new();

    [Parameter]
    public Func<TItem, string> TextSelector { get; set; } = item => item?.ToString() ?? string.Empty;

    [Parameter]
    public Func<TItem, TValue> ValueSelector { get; set; } = null!;

    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    [Parameter]
    public TItem? SelectedItem { get; set; }

    [Parameter]
    public EventCallback<TItem> SelectedItemChanged { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "جستجو...";

    [Parameter]
    public int DebounceMilliseconds { get; set; } = 300;

    private ElementReference inputRef;
    private string searchTerm = string.Empty;
    private string displayText = string.Empty;
    private List<TItem> filteredItems = new();
    private bool isDropdownOpen = false;
    private int highlightedIndex = -1;
    private bool shouldPreventDefault = false;
    private string lastKeyPressed = string.Empty;

    // Timer for debouncing
    private Timer? _debounceTimer;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        UpdateDisplayTextFromSelectedItem();
        FilterItems();
    }

    private void UpdateDisplayTextFromSelectedItem()
    {
        TItem? itemToSync = default;

        if (Value is not null && ValueSelector is not null)
        {
            itemToSync = Items.FirstOrDefault(item => EqualityComparer<TValue>.Default.Equals(ValueSelector(item), Value));
        }
        else if (SelectedItem is not null)
        {
            itemToSync = SelectedItem;
        }

        if (itemToSync is not null)
        {
            displayText = TextSelector(itemToSync);
        }
        else
        {
            displayText = string.Empty;
        }
    }

    private void FilterItems()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredItems = Items.ToList();
        }
        else
        {
            filteredItems = Items.Where(item =>
                TextSelector(item).Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }

        if (isDropdownOpen && filteredItems.Any())
        {
            highlightedIndex = 0;
        }
        else
        {
            highlightedIndex = -1;
        }
    }

    // --- Callback method for the debounce timer ---
    private async void DebounceTimerCallback(object? state)
    {
        await InvokeAsync(() =>
        {
            FilterItems();
            StateHasChanged();
        });
    }

    // --- Debounced search input handler ---
    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;

        // Cancel the previous timer
        _debounceTimer?.Dispose();

        // Start a new timer that will trigger the search after a pause
        _debounceTimer = new Timer(
            callback: DebounceTimerCallback,
            state: null,
            dueTime: TimeSpan.FromMilliseconds(DebounceMilliseconds),
            period: Timeout.InfiniteTimeSpan
        );

        if (!isDropdownOpen)
        {
            OpenDropdown();
        }
    }

    private async Task FocusInput()
    {
        try
        {
            await inputRef.FocusAsync();
            OpenDropdown();
        }
        catch
        {
            // Ignore focus errors
        }
    }

    private void OpenDropdown()
    {
        if (!isDropdownOpen)
        {
            isDropdownOpen = true;
            FilterItems();
            StateHasChanged();
        }
    }

    private async Task OnBlurInput()
    {
        // Wait a bit to allow click on an item to be processed first
        await Task.Delay(200);

        isDropdownOpen = false;
        shouldPreventDefault = false;
        UpdateDisplayTextFromSelectedItem();
        StateHasChanged();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        lastKeyPressed = e.Key;

        if (!isDropdownOpen && (e.Key == "ArrowDown" || e.Key == "ArrowUp" || e.Key == "Enter"))
        {
            shouldPreventDefault = true;
            OpenDropdown();
            return;
        }

        if (!isDropdownOpen)
        {
            shouldPreventDefault = false;
            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
                shouldPreventDefault = true;
                highlightedIndex = (highlightedIndex + 1) % filteredItems.Count;
                break;

            case "ArrowUp":
                shouldPreventDefault = true;
                highlightedIndex = highlightedIndex <= 0 ? filteredItems.Count - 1 : highlightedIndex - 1;
                break;

            case "Enter":
                if (highlightedIndex >= 0 && highlightedIndex < filteredItems.Count)
                {
                    shouldPreventDefault = true;
                    _ = SelectItem(filteredItems[highlightedIndex]);
                }
                else
                {
                    shouldPreventDefault = false;
                }
                break;

            case "Escape":
                shouldPreventDefault = true;
                isDropdownOpen = false;
                UpdateDisplayTextFromSelectedItem();
                break;

            case "Tab":
                shouldPreventDefault = false;
                isDropdownOpen = false;
                UpdateDisplayTextFromSelectedItem();
                break;

            default:
                shouldPreventDefault = false;
                break;
        }
    }

    private async Task SelectItem(TItem item)
    {
        SelectedItem = item;
        displayText = TextSelector(item);
        searchTerm = string.Empty;
        isDropdownOpen = false;
        highlightedIndex = -1;
        shouldPreventDefault = false;

        if (SelectedItemChanged.HasDelegate)
        {
            await SelectedItemChanged.InvokeAsync(SelectedItem);
        }

        if (ValueChanged.HasDelegate && ValueSelector is not null)
        {
            await ValueChanged.InvokeAsync(ValueSelector(item));
        }

        try
        {
            await inputRef.FocusAsync();
        }
        catch
        {
            // Ignore focus errors
        }
    }

    // Dispose of the timer when the component is destroyed
    public async ValueTask DisposeAsync()
    {
        _debounceTimer?.Dispose();
        _debounceTimer = null;
    }
}