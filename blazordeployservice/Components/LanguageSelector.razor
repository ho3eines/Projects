@namespace BlazorDeployService.Components
@using System.Data
@using BlazorDeployService.Services
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web

@inject ILocalizationCacheService _cache
@inject ICultureService _culture

<div class="dropdown">
    <button class="btn btn-outline-primary dropdown-toggle" type="button" id="langMenu"
            data-bs-toggle="dropdown" aria-expanded="false">
        🌐
    </button>

    <ul class="dropdown-menu" aria-labelledby="langMenu">
        @if (languages != null && languages.Count > 0)
        {
            @foreach (var lang in languages)
            {
                <li>
                    <button class="dropdown-item" @onclick="() => ChangeLanguage(lang.Code)">
                        @lang.Flag @lang.Name
                    </button>
                </li>
            }
        }
        else
        {
            <li><button class="dropdown-item" disabled>Loading languages...</button></li>
        }
    </ul>
</div>
