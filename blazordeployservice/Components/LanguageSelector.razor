@code {
    private List<LanguageItem> languages = new();
    private bool _isDark = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadLanguages();
    }

    private async Task ToggleDark()
    {
        _isDark = !_isDark;
        // await ApplyTheme();
        // await SaveThemeToStorage();
        StateHasChanged();
    }

    private async Task LoadLanguages()
    {
        try
        {
            // دریافت DataTable از سرویس
            var dataTable = await _cache.SupportedLanguages();

            if (dataTable != null)
            {
                languages.Clear();

                foreach (DataRow row in dataTable.Rows)
                {
                    languages.Add(new LanguageItem
                    {
                        ID = GetSafeInt(row["ID"]),
                        Code = GetSafeString(row["Code"]),
                        Name = GetSafeString(row["Name"]),
                        Flag = GetSafeString(row["Flag"])
                    });
                }

                Console.WriteLine($"Loaded {languages.Count} languages");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR loading languages: {ex.Message}");
        }
    }

    private string GetSafeString(object value)
    {
        return value == null || value == DBNull.Value ? string.Empty : value.ToString() ?? string.Empty;
    }

    private int GetSafeInt(object value)
    {
        if (value == null || value == DBNull.Value) return 0;
        return int.TryParse(value.ToString(), out int result) ? result : 0;
    }

    private async Task ChangeLanguage(string culture)
    {
        await _culture.SetCulture(culture);
        await _cache.RefreshCache();

        StateHasChanged();
    }

    public class LanguageItem
    {
        public int ID { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Flag { get; set; } = "";
    }
}