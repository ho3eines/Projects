@using System.Globalization
@using Microsoft.AspNetCore.Components.Web

<input type="text"
       class="@CssClass"
       value="@_inputText"
       @oninput="OnInput"
       @onblur="OnBlur"
       placeholder="@Placeholder" />

@code {
    // پارامتر برای مقدار عددی
    [Parameter]
    public decimal Value { get; set; }

    // پارامتر برای رویداد تغییر مقدار
    [Parameter]
    public EventCallback<decimal> ValueChanged { get; set; }

    // پارامتر برای افزودن کلاس‌های CSS دلخواه (form-control کلاس پیش‌فرض بوت‌استرپ است)
    [Parameter]
    public string CssClass { get; set; } = "form-control";

    // پارامتر برای متن راهنما (placeholder)
    [Parameter]
    public string Placeholder { get; set; }

    // فیلد داخلی برای نگهداری متن نمایش داده شده در input
    private string _inputText = "";

    // این متد هر زمان که پارامترها از کامپوننت والد تغییر کنند، فراخوانی می‌شود
    protected override void OnParametersSet()
    {
        // مقدار ورودی را با فرمت‌بندی مناسب (جداساز هزارگان) نمایش می‌دهیم
        _inputText = Value.ToString("N0", CultureInfo.InvariantCulture);
    }

    // این متد در هنگام تایپ کاربر فراخوانی می‌شود
    private async Task OnInput(ChangeEventArgs e)
    {
        // مقدار خام ورودی را می‌گیریم
        var input = e.Value?.ToString() ?? "";

        // مقدار عددی را از ورودی استخراج می‌کنیم
        var newValue = ParseDecimal(input);

        // فقط والد را از مقدار جدید مطلع می‌کنیم، اما متن داخل input را اینجا تغییر نمی‌دهیم
        // تا نشانگر موس (cursor) به انتهای متن نپرد.
        await ValueChanged.InvokeAsync(newValue);
    }

    // این متد زمانی فراخوانی می‌شود که کاربر فوکوس را از input خارج می‌کند
    private async Task OnBlur(FocusEventArgs e)
    {
        // مقدار نهایی را از متن داخل input استخراج می‌کنیم
        var finalValue = ParseDecimal(_inputText);

        // متن داخل input را با فرمت‌بندی نهایی به‌روزرسانی می‌کنیم
        _inputText = finalValue.ToString("N0", CultureInfo.InvariantCulture);

        // والد را از مقدار نهایی مطلع می‌کنیم
        await ValueChanged.InvokeAsync(finalValue);

        // به Blazor اطلاع می‌دهیم که وضعیت UI تغییر کرده است
        StateHasChanged();
    }

    // متد کمکی برای استخراج عدد از رشته ورودی
    private decimal ParseDecimal(string input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return 0;

        // تمام کاراکترهای غیرعددی را حذف می‌کنیم
        var cleaned = new string(input.Where(char.IsDigit).ToArray());

        return decimal.TryParse(cleaned, out var result) ? result : 0;
    }
}