@page "/settings"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>امکانات — حسابداری</PageTitle>

<h1 class="h-page-title">امکانات و جداول پایه</h1>
<p class="h-lead mb-4">حساب کل (قرارداد ChartOfAccount) و قوانین مالیاتی (قرارداد TaxRule).</p>

<div class="h-card h-card-pad mb-3">
    <h5 class="mb-3">حساب‌ها</h5>
    <table class="h-table">
        <thead>
            <tr><th>کد</th><th>عنوان</th><th>نوع</th><th>وضعیت</th></tr>
        </thead>
        <tbody>
            @foreach (var a in Accounts)
            {
                <tr><td>@a.AccountCode</td><td>@a.Title</td><td>@a.AccountType</td><td>@(a.IsActive ? "فعال" : "غیرفعال")</td></tr>
            }
        </tbody>
    </table>
    <div class="row g-2 mt-2">
        <div class="col-md-2"><input class="form-control" @bind="NewAccCode" placeholder="کد" /></div>
        <div class="col-md-4"><input class="form-control" @bind="NewAccTitle" placeholder="عنوان حساب" /></div>
        <div class="col-md-3">
            <select class="form-select" @bind="NewAccType">
                <option value="Asset">Asset</option>
                <option value="Liability">Liability</option>
                <option value="Equity">Equity</option>
                <option value="Income">Income</option>
                <option value="Expense">Expense</option>
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-hermes w-100" @onclick="AddAccountAsync">افزودن حساب</button>
        </div>
    </div>
</div>

<div class="h-card h-card-pad">
    <h5 class="mb-3">قوانین مالیاتی</h5>
    <table class="h-table">
        <thead>
            <tr><th>کد</th><th>عنوان</th><th>دسته</th><th>درصد</th><th>از تاریخ</th><th>وضعیت</th></tr>
        </thead>
        <tbody>
            @foreach (var t in TaxRules)
            {
                <tr>
                    <td>@t.RuleCode</td><td>@t.Title</td><td>@t.Category</td>
                    <td>@t.RatePercent.ToString("N2")</td><td>@t.EffectiveFrom.ToString("yyyy/MM/dd")</td>
                    <td>@(t.IsActive ? "فعال" : "غیرفعال")</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="row g-2 mt-2">
        <div class="col-md-2"><input class="form-control" @bind="NewRuleCode" placeholder="کد قانون" /></div>
        <div class="col-md-3"><input class="form-control" @bind="NewRuleTitle" placeholder="عنوان" /></div>
        <div class="col-md-2">
            <select class="form-select" @bind="NewRuleCategory">
                <option value="Vat">Vat</option>
                <option value="Payroll">Payroll</option>
                <option value="Gold">Gold</option>
                <option value="Commerce">Commerce</option>
            </select>
        </div>
        <div class="col-md-2"><input class="form-control" type="number" step="0.0001" @bind="NewRuleRate" placeholder="درصد" /></div>
        <div class="col-md-3">
            <button class="btn btn-hermes w-100" @onclick="AddRuleAsync">افزودن قانون</button>
        </div>
    </div>
</div>

@code {
    List<ChartOfAccountRow> Accounts = new();
    List<TaxRuleRow> TaxRules = new();
    string NewAccCode = "";
    string NewAccTitle = "";
    string NewAccType = "Asset";
    string NewRuleCode = "";
    string NewRuleTitle = "";
    string NewRuleCategory = "Vat";
    decimal NewRuleRate;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    async Task ReloadAsync()
    {
        Accounts = await Request.Request<ChartOfAccountRow>("ChartOfAccountSearch", new { SearchText = "", SkipRows = 0, TakeSize = 100 }) ?? new();
        TaxRules = await Request.Request<TaxRuleRow>("TaxRuleSearch", new { SearchText = "", SkipRows = 0, TakeSize = 100 }) ?? new();
    }

    async Task AddAccountAsync()
    {
        if (string.IsNullOrWhiteSpace(NewAccCode) || string.IsNullOrWhiteSpace(NewAccTitle))
        {
            await Alert.ShowErrorAsync("امکانات", "کد و عنوان حساب الزامی است");
            return;
        }
        try
        {
            await Request.Request<object>("ChartOfAccountUpsert", new
            {
                AccountId = 0,
                AccountCode = NewAccCode,
                Title = NewAccTitle,
                AccountType = NewAccType,
                ParentAccountId = (int?)null,
                IsActive = true
            }, isExec: true);
            NewAccCode = ""; NewAccTitle = "";
            await ReloadAsync();
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("امکانات", ex.Message); }
    }

    async Task AddRuleAsync()
    {
        if (string.IsNullOrWhiteSpace(NewRuleCode) || string.IsNullOrWhiteSpace(NewRuleTitle))
        {
            await Alert.ShowErrorAsync("امکانات", "کد و عنوان قانون الزامی است");
            return;
        }
        try
        {
            await Request.Request<object>("TaxRuleUpsert", new
            {
                TaxRuleId = 0,
                RuleCode = NewRuleCode,
                Title = NewRuleTitle,
                Category = NewRuleCategory,
                RatePercent = NewRuleRate,
                EffectiveFrom = DateTime.Today,
                IsActive = true
            }, isExec: true);
            NewRuleCode = ""; NewRuleTitle = ""; NewRuleRate = 0;
            await ReloadAsync();
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("امکانات", ex.Message); }
    }
}
