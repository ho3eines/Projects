@page "/entry"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>ورود عملیات — حسابداری</PageTitle>

<h1 class="h-page-title">ثبت سند حسابداری</h1>
<p class="h-lead mb-4">سند روزنامه با ردیف‌های بدهکار / بستانکار (باید متوازن باشد).</p>

<div class="h-card h-card-pad">
    <div class="row g-3">
        <div class="col-md-4 col-sm-6">
            <label class="form-label" for="date">تاریخ سند</label>
            <input id="date" type="date" class="form-control" @bind="DocumentDate" />
        </div>
        <div class="col-md-4 col-sm-6">
            <label class="form-label" for="type">نوع سند</label>
            <select id="type" class="form-select" @bind="DocumentType">
                <option value="Journal">سند روزنامه</option>
                <option value="Receipt">دریافت</option>
                <option value="Payment">پرداخت</option>
                <option value="Purchase">خرید</option>
                <option value="Sale">فروش</option>
            </select>
        </div>
        <div class="col-md-4 col-sm-12">
            <label class="form-label" for="party">طرف حساب</label>
            <input id="party" class="form-control" @bind="CounterPartyName" placeholder="اختیاری" />
        </div>
    </div>

    <h5 class="mt-4 mb-2 h-section-title">ردیف‌های سند</h5>
    <div class="h-table-wrap">
        <table class="h-table">
            <thead>
                <tr><th>حساب</th><th>شرح</th><th>بدهکار</th><th>بستانکار</th><th></th></tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Lines.Count; i++)
                {
                    var idx = i;
                    <tr>
                        <td>
                            <select class="form-select" value="@Lines[i].AccountId"
                                    @onchange="e => OnAccountChange(idx, e)">
                                <option value="0">— انتخاب حساب —</option>
                                @foreach (var a in Accounts)
                                {
                                    <option value="@a.AccountId">@a.AccountCode — @a.Title</option>
                                }
                            </select>
                        </td>
                        <td><input class="form-control" @bind="Lines[i].Description" placeholder="شرح ردیف" /></td>
                        <td><input class="form-control" type="number" step="1000" min="0" @bind="Lines[i].Debit" /></td>
                        <td><input class="form-control" type="number" step="1000" min="0" @bind="Lines[i].Credit" /></td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLine(idx)">حذف</button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="2">جمع</td>
                    <td>@TotalDebit.ToString("N0")</td>
                    <td>@TotalCredit.ToString("N0")</td>
                    <td>@(IsBalanced ? "✔ متوازن" : "✘ نامتوازن")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex gap-2 align-items-center flex-wrap mt-3">
        <button class="btn btn-outline-hermes" @onclick="AddLine">+ ردیف</button>
        <button class="btn btn-hermes" @onclick="SaveAsync" disabled="@Busy">ثبت سند</button>
        @if (Message.Length > 0)
        {
            <div class="alert alert-success mb-0 py-1 px-3">@Message</div>
        }
    </div>
</div>

@code {
    List<ChartOfAccountRow> Accounts = new();
    List<JournalLineRow> Lines = new();
    DateTime DocumentDate = DateTime.Today;
    string DocumentType = "Journal";
    string CounterPartyName = "";
    string Message = "";
    bool Busy;

    decimal TotalDebit => Lines.Sum(l => l.Debit);
    decimal TotalCredit => Lines.Sum(l => l.Credit);
    bool IsBalanced => TotalDebit == TotalCredit && TotalDebit > 0;

    protected override async Task OnInitializedAsync()
    {
        Accounts = await Request.Request<ChartOfAccountRow>("ChartOfAccountSearch",
            new { SearchText = "", SkipRows = 0, TakeSize = 500 }) ?? new();
        AddLine();
    }

    void AddLine() => Lines.Add(new JournalLineRow());

    void RemoveLine(int index)
    {
        if (Lines.Count > 1)
            Lines.RemoveAt(index);
    }

    void OnAccountChange(int index, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            Lines[index].AccountId = id;
            var acc = Accounts.FirstOrDefault(a => a.AccountId == id);
            if (acc is not null)
            {
                Lines[index].AccountCode = acc.AccountCode;
                Lines[index].AccountTitle = acc.Title;
            }
        }
    }

    async Task SaveAsync()
    {
        if (Lines.Any(l => l.AccountId == 0))
        {
            await Alert.ShowErrorAsync("سند", "برای همهٔ ردیف‌ها حساب انتخاب کنید");
            return;
        }
        if (!IsBalanced)
        {
            await Alert.ShowErrorAsync("سند", "بدهی و بستانکاری سند برابر نیست");
            return;
        }
        Busy = true;
        Message = "";
        try
        {
            var linesJson = JsonSerializer.Serialize(Lines.Select(l => new
            {
                l.AccountId,
                l.Description,
                l.Debit,
                l.Credit
            }));
            await Request.Request<object>("DocumentInsert", new
            {
                DocumentDate,
                DocumentType,
                CounterPartyName = string.IsNullOrWhiteSpace(CounterPartyName) ? null : CounterPartyName,
                CreatedBy = Request.UserToken,
                LinesJson = linesJson
            }, isExec: true);
            Message = "سند ثبت شد.";
            Lines = new();
            AddLine();
        }
        catch (Exception ex)
        {
            await Alert.ShowErrorAsync("سند", ex.Message);
        }
        finally { Busy = false; }
    }
}
