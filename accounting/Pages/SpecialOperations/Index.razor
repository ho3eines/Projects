@page "/special"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>عملیات ویژه — حسابداری</PageTitle>

<h1 class="h-page-title">عملیات ویژه</h1>
<p class="h-lead mb-4">بستن دوره: بررسی توازن اسناد و علامت‌گذاری آن‌ها به‌صورت بسته.</p>

<div class="h-card h-card-pad">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label" for="from">از تاریخ</label>
            <input id="from" type="date" class="form-control" @bind="From" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="to">تا تاریخ</label>
            <input id="to" type="date" class="form-control" @bind="To" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-hermes w-100" @onclick="RunAsync" disabled="@Busy">بستن دوره</button>
        </div>
        @if (Message.Length > 0)
        {
            <div class="col-12"><div class="alert alert-success mb-0">@Message</div></div>
        }
        @if (Error.Length > 0)
        {
            <div class="col-12"><div class="alert alert-danger mb-0">@Error</div></div>
        }
    </div>
    <p class="h-lead text-muted mt-3 mb-0">بستن دوره، سندهای پیش‌بستهٔ بازه را «بسته» می‌کند. اگر سند نامتوازنی وجود داشته باشد، عملیات با خطا متوقف می‌شود.</p>
</div>

@code {
    DateTime From = DateTime.Today.AddMonths(-1);
    DateTime To = DateTime.Today;
    string Message = "";
    string Error = "";
    bool Busy;

    async Task RunAsync()
    {
        Busy = true;
        Message = "";
        Error = "";
        try
        {
            await Request.Request<object>("DocumentPeriodClose",
                new { FromDate = From, ToDate = To, CreatedBy = Request.UserToken }, isExec: true);
            Message = "دوره بسته شد؛ سندهای بازه به وضعیت «بسته» منتقل شدند.";
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally { Busy = false; }
    }
}
