<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	  <!-- Only target platforms supported on the current OS -->
	  <TargetFrameworks>net8.0-android</TargetFrameworks>
	  <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net8.0-windows10.0.19041.0</TargetFrameworks>
	  <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net8.0-ios;net8.0-maccatalyst</TargetFrameworks>

    <!-- MAUI framework version — the last .NET 8 servicing release on NuGet.
         MUST be defined here: the PackageReferences below use $(MauiVersion)
         and an empty version fails restore immediately. Keep Controls and
         WebView.Maui on the same version. -->
    <MauiVersion>8.0.100</MauiVersion>

    <OutputType>Exe</OutputType>
    <RootNamespace>Tarazin.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Blazor owns CSS; do not let the MAUI SDK emit default CSS items. -->
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>ترازین</ApplicationTitle>
    <ApplicationId>ir.tarazin.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Packaged (MSIX) Windows app: enables Visual Studio's Publish wizard
         (creates a signed/self-signed MSIX). Decision 2026-08-20 (owner). -->

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Windows release packages should not depend on a separately installed
         Windows App SDK Runtime. Without this, the app may build/deploy cleanly
         but close before managed startup code runs on machines missing that
         runtime.
         RELEASE-ONLY: in Debug the packaged (MSIX) build never generates
         obj\...\MsixContent\AppxManifest.xml on a plain Build, so the
         WindowsAppSDK self-contained targets fail with MSB4018
         (GenerateAppManifestFromAppx → DirectoryNotFoundException). Debug F5
         runs framework-dependent and Visual Studio registers the Windows App
         SDK framework package on the dev machine. -->
    <WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(Configuration)' == 'Release'">true</WindowsAppSDKSelfContained>
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win10-x64;win10-x86;win10-arm64</RuntimeIdentifiers>
    <!-- A packaged (MSIX) Windows app has an app host exe, which cannot be
         ProcessorArchitecture-neutral: WinUI.targets (_GetProjectArchitecture)
         fails with "Packaged .NET applications with an app host exe cannot be
         ProcessorArchitecture neutral. Please specify a RuntimeIdentifier or a
         Platform other than AnyCPU." RuntimeIdentifiers (plural) only feeds
         publish/restore; give the Windows build a concrete DEFAULT RID so a
         plain `dotnet build` / Visual Studio design-time build resolves to a
         real architecture instead of AnyCPU. An explicit
         -p:RuntimeIdentifier=win10-x86|win10-arm64 still overrides this. -->
    <RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifier)' == ''">win10-x64</RuntimeIdentifier>

    <GenerateAppInstallerFile>True</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppInstallerUri>http://app.blazordeploy.ir</AppInstallerUri>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="MudBlazor" Version="9.8.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Direct references: MauiProgram.cs / ApiConnectionSession.cs consume
         Tarazin.Data types (ISqlConnectionProvider) and Tarazin.Share models
         (Tarazin.Models) directly, so the references are explicit instead of
         relying on transitive flow through Tarazin.Ui. -->
    <ProjectReference Include="..\Tarazin.Ui\Tarazin.Ui.csproj" />
    <ProjectReference Include="..\Tarazin.Data\Tarazin.Data.csproj" />
    <ProjectReference Include="..\Tarazin.Share\Tarazin.Share.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#0F766E" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F766E" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="appsettings.json" LogicalName="Tarazin.Maui.appsettings.json" />
  </ItemGroup>
	

</Project>
