@page "/settings"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>امکانات — خزانه‌داری</PageTitle>

<h1 class="h-page-title">امکانات و جداول پایه</h1>
<p class="h-lead mb-4">نرخ ارز (قرارداد مشترک CurrencyRate)، بانک‌ها، حساب‌ها و صندوق‌ها.</p>

<div class="h-card h-card-pad mb-3">
    <h5 class="mb-3">نرخ ارز</h5>
    <table class="h-table">
        <thead>
            <tr><th>کد</th><th>نام</th><th>نرخ به ریال</th><th>تاریخ</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Rates)
            {
                <tr><td>@r.CurrencyCode</td><td>@r.CurrencyName</td><td>@r.RateToIRR.ToString("N0")</td><td>@r.RateDate.ToString("yyyy/MM/dd")</td></tr>
            }
        </tbody>
    </table>
    <div class="row g-2 mt-2">
        <div class="col-md-2"><input class="form-control" @bind="NewCode" placeholder="USD" /></div>
        <div class="col-md-3"><input class="form-control" @bind="NewName" placeholder="نام ارز" /></div>
        <div class="col-md-3"><input class="form-control" type="number" @bind="NewRate" placeholder="نرخ" /></div>
        <div class="col-md-4">
            <button class="btn btn-hermes w-100" @onclick="AddRateAsync">ثبت/به‌روزرسانی نرخ</button>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="h-card h-card-pad">
            <h5 class="mb-3">حساب‌های بانکی</h5>
            <table class="h-table">
                <thead><tr><th>نام</th><th>شماره</th><th>بانک</th><th>موجودی</th></tr></thead>
                <tbody>
                    @foreach (var b in Banks)
                    {
                        <tr><td>@b.AccountName</td><td>@b.AccountNo</td><td>@b.BankName</td><td>@b.Balance.ToString("N0")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-md-6">
        <div class="h-card h-card-pad">
            <h5 class="mb-3">صندوق‌ها</h5>
            <table class="h-table">
                <thead><tr><th>کد</th><th>عنوان</th><th>موجودی</th></tr></thead>
                <tbody>
                    @foreach (var c in Boxes)
                    {
                        <tr><td>@c.CashBoxCode</td><td>@c.Title</td><td>@c.Balance.ToString("N0")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    List<CurrencyRateRow> Rates = new();
    List<BankAccountRow> Banks = new();
    List<CashBoxRow> Boxes = new();
    string NewCode = "";
    string NewName = "";
    decimal NewRate;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    async Task ReloadAsync()
    {
        Rates = await Request.Request<CurrencyRateRow>("CurrencyRateSearch", new { SkipRows = 0, TakeSize = 50 }) ?? new();
        Banks = await Request.Request<BankAccountRow>("BankAccountList", new { }) ?? new();
        Boxes = await Request.Request<CashBoxRow>("CashBoxList", new { }) ?? new();
    }

    async Task AddRateAsync()
    {
        if (string.IsNullOrWhiteSpace(NewCode) || NewRate <= 0)
        {
            await Alert.ShowErrorAsync("امکانات", "کد و نرخ معتبر وارد کنید");
            return;
        }
        try
        {
            await Request.Request<object>("CurrencyRateUpsert", new
            {
                CurrencyCode = NewCode.ToUpperInvariant(),
                CurrencyName = string.IsNullOrWhiteSpace(NewName) ? NewCode.ToUpperInvariant() : NewName,
                RateToIRR = NewRate,
                RateDate = DateTime.Today
            }, isExec: true);
            NewCode = ""; NewName = ""; NewRate = 0;
            await ReloadAsync();
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("امکانات", ex.Message); }
    }
}
