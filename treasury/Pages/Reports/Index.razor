@page "/reports"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>گزارشات — خزانه‌داری</PageTitle>

<h1 class="h-page-title">گزارشات خزانه</h1>
<p class="h-lead mb-4">جریان نقد در بازه.</p>

<div class="h-card h-card-pad mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="from">از تاریخ</label>
            <input id="from" type="date" class="form-control" @bind="From" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="to">تا تاریخ</label>
            <input id="to" type="date" class="form-control" @bind="To" />
        </div>
        <div class="col-md-4">
            <button class="btn btn-hermes w-100" @onclick="LoadAsync">اجرا</button>
        </div>
    </div>
</div>

<div class="h-card">
    <table class="h-table">
        <thead>
            <tr><th>تاریخ</th><th>شماره</th><th>جهت</th><th>مبلغ</th><th>ارز</th><th>حساب</th><th>شرح</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Rows)
            {
                <tr>
                    <td>@r.MovementDate.ToString("yyyy/MM/dd")</td>
                    <td>@r.MovementNumber</td>
                    <td>@(r.Direction == "In" ? "دریافت" : "پرداخت")</td>
                    <td>@r.Amount.ToString("N0")</td>
                    <td>@r.CurrencyCode</td>
                    <td>@r.AccountName</td>
                    <td>@r.Description</td>
                </tr>
            }
        </tbody>
    </table>
    @if (Rows.Count > 0)
    {
        <div class="h-card-pad border-top">
            جمع خالص بازه: <strong>@Rows.Sum(r => r.Direction == "In" ? r.Amount : -r.Amount).ToString("N0")</strong>
        </div>
    }
</div>

@code {
    List<CashFlowRow> Rows = new();
    DateTime From = DateTime.Today.AddMonths(-1);
    DateTime To = DateTime.Today;

    async Task LoadAsync()
    {
        try
        {
            Rows = await Request.Request<CashFlowRow>("CashFlowReport", new { FromDate = From, ToDate = To }) ?? new();
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("گزارش", ex.Message); }
    }
}
