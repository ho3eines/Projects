<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tarazin</RootNamespace>
    <AssemblyName>Tarazin.Shared</AssemblyName>
    <Description>ترازین — مدیریت هوشمند کسب‌وکار (هستهٔ مشترک وب + MAUI)</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI kit — shared by the web host and the MAUI Blazor Hybrid host -->
    <PackageReference Include="MudBlazor" Version="9.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Data access: Dapper over SQL Server (in-process named scripts) -->
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <!--
    Named TSQL scripts: embedded so BOTH hosts (web on disk-free output,
    MAUI packaged app) can load them from the assembly. Files stay in the
    repo as the source of truth and are also available for tooling
    (tools/cross-schema-scan.sh).
  -->
  <ItemGroup>
    <EmbeddedResource Include="Data\Scripts\**\*.sql" />
  </ItemGroup>

</Project>
