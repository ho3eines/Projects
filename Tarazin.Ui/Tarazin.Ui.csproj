<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tarazin</RootNamespace>
    <AssemblyName>Tarazin.Ui</AssemblyName>
    <Description>ترازین — مدیریت هوشمند کسب‌وکار (هستهٔ UI مشترک وب + MAUI)</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI kit — shared by the web host and the MAUI Blazor Hybrid host -->
    <!-- MudBlazor 9.8.0.targets include net8.0 (also net9.0/net10.0) so it stays unchanged. -->
    <PackageReference Include="MudBlazor" Version="9.8.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <!-- صفحهٔ /diag منبع رشتهٔ اتصال را از IConfiguration می‌خواند -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <!-- چاپ و گزارش با Stimulsoft (PRD BI §121) — Viewer بلزور + موتور رندر؛
         این نسخه (2024.3.2) تا net8.0 را پشتیبانی می‌کند (دلیل پایین آوردن
         کل سولوشن روی net8.0). سازگار با هر دو هاست (وب + MAUI WebView).
         لایسنس: docs/BI_MODULE.md -->
	  <PackageReference Include="Stimulsoft.Reports.Blazor" Version="2024.3.2" />
    <!-- PDF سمت سرور (QuestPDF) — جایگزین سبک html2pdf برای MAUI؛ در هاست وب همان‌جا روی سرور اجرا می‌شود. -->
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- فونت Vazirmatn به‌صورت embedded تا در همهٔ پلتفرم‌ها (وب + MAUI اندروید/iOS/ویندوز) در دسترس باشد.
         QuestPDF برخلاف مرورگر به CDN دسترسی ندارد. -->
    <EmbeddedResource Include="wwwroot\fonts\Vazirmatn-Regular.ttf" LogicalName="Tarazin.Ui.fonts.Vazirmatn-Regular.ttf" />
    <EmbeddedResource Include="wwwroot\fonts\Vazirmatn-Bold.ttf" LogicalName="Tarazin.Ui.fonts.Vazirmatn-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts (Share) + data layer (Data) -->
    <ProjectReference Include="..\Tarazin.Share\Tarazin.Share.csproj" />
    <ProjectReference Include="..\Tarazin.Data\Tarazin.Data.csproj" />
  </ItemGroup>
	
	
</Project>
