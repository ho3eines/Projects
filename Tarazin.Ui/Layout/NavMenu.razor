@inject UserSession Session
@inject NavigationManager Nav
@implements IDisposable

<MudNavMenu Class="tz-nav" Bordered="false" Color="Color.Secondary" Dense="false">
    <div class="tz-nav__label">میز کار</div>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">خانه</MudNavLink>
    <MudNavLink Href="/diag" Icon="@Icons.Material.Filled.MonitorHeart">عیب‌یابی اتصال</MudNavLink>
    @if (!Session.IsAuthenticated)
    {
        <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">ورود</MudNavLink>
    }

    <div class="tz-nav__label">ماژول‌ها</div>
    @foreach (var mod in TarazinModules.All)
    {
        @if (Session.CanView(mod.Key))
        {
            <MudNavGroup Title="@mod.Title" Icon="@mod.Icon" Expanded="IsExpanded(mod)"
                         Class="tz-nav__group">
                @foreach (var item in mod.Items)
                {
                    @if (Session.HasPermission(item.Permission))
                    {
                        <MudNavLink Href="@item.Url" Icon="@item.Icon"
                                    Match="@(item.Url == mod.Url ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                            @item.Title
                        </MudNavLink>
                    }
                }
            </MudNavGroup>
        }
    }
</MudNavMenu>

@code {
    [Parameter] public string CurrentPath { get; set; } = "";

    protected override void OnInitialized()
    {
        // بعد از بازیابی نشست (مثلاً رفرش)، CurrentPath تغییر نمی‌کند و Blazor
        // این کامپوننت فرزند را دوباره رندر نمی‌کند؛ برای همین باید خودش به
        // تغییر نشست گوش دهد تا گروه ماژول‌ها نمایش داده شوند.
        Session.Changed += OnSessionChanged;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private bool IsExpanded(TarazinModule mod) =>
        TarazinModules.Match(CurrentPath)?.Key == mod.Key;

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
