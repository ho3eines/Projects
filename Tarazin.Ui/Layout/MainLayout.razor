@inherits LayoutComponentBase
@implements IDisposable
@using Tarazin.Models
@using Tarazin.Services
@using Microsoft.AspNetCore.Components
@inject UserSession Session
@inject UiPreferences Prefs
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject DbService Db
@inject AccountingContextService Context

<MudLayout Class="tz-shell">
    <MudAppBar Elevation="0" Class="tz-appbar" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" aria-label="منو" Class="tz-appbar__menu" />

        <a href="/" class="tz-brand" aria-label="خانه ترازین">
            <img src="_content/Tarazin.Ui/brand/logo.svg" alt="" class="tz-brand__mark" width="36" height="36" />
            <span class="tz-brand__text">
                <strong>ترازین</strong>
                <small>مدیریت هوشمند کسب‌وکار</small>
            </span>
        </a>

        @if (_module is not null)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="tz-appbar__mod"
                     Style="@($"border-color:{_module.Accent};color:{_module.Accent}")">
                @_module.Title
            </MudChip>
        }

        @if (Session.IsAuthenticated && Session.ActiveCompanyId != null && Session.ActiveFiscalYearId != null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Business" Class="ms-2">
                @Session.ActiveCompanyName | @Session.ActiveFiscalYearName
            </MudChip>
            @if (Session.ActiveCompanyId != null)
            {
                <MudSelect T="int" Label="سال مالی" @bind-Value="_selectedFiscalYearId" OnChange="OnFiscalYearChanged">
                    <MudSelectItem Value="0">— همه —</MudSelectItem>
                    @foreach (var y in _years)
                    {
                        <MudSelectItem Value="@y.FiscalYearId">@y.YearName @(y.IsClosed ? "(بسته)" : "")</MudSelectItem>
                    }
                </MudSelect>
            }
        }

        <MudSpacer />

        <MudTooltip Text="@(Prefs.IsDarkMode ? "حالت روشن" : "حالت تیره")">
            <MudIconButton Icon="@(Prefs.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="Prefs.ToggleDarkMode" aria-label="تغییر پوسته" />
        </MudTooltip>

        @if (Session.IsAuthenticated)
        {
            <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Class="tz-user">
                <ActivatorContent>
                    <MudAvatar Size="Size.Small" Color="Color.Secondary" Class="tz-user__av">
                        @Initial
                    </MudAvatar>
                    <span class="tz-user__name">@Session.DisplayName</span>
                    <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" />
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Disabled="true">@Session.RoleTitle</MudMenuItem>
                    @if (Session.HasAny(TarazinPermissions.Users, TarazinPermissions.Roles))
                    {
                        <MudMenuItem Href="/central/users" Icon="@Icons.Material.Filled.ManageAccounts">کاربران</MudMenuItem>
                        <MudMenuItem Href="/central/roles" Icon="@Icons.Material.Filled.AdminPanelSettings">نقش‌ها و دسترسی‌ها</MudMenuItem>
                    }
                    <MudMenuItem Href="/diag" Icon="@Icons.Material.Filled.MonitorHeart">عیب‌یابی اتصال</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">خروج</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Settings" OnClick="NavigateToSettings">تنظیمات</MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                       Href="/login" StartIcon="@Icons.Material.Filled.Login" Class="tz-appbar__login">
                ورود
            </MudButton>
        }
    </MudAppBar>

    <MudDivider />

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Always" Anchor="Anchor.Start" Class="tz-drawer"
               Elevation="0" Breakpoint="Breakpoint.Md">
        <div class="tz-drawer__head">
            <img src="_content/Tarazin.Ui/brand/logo.svg" alt="" width="40" height="40" />
            <div>
                <div class="tz-drawer__title">ترازین</div>
                <div class="tz-drawer__sub">نه ماژول، یک میز کار</div>
            </div>
        </div>
        <NavMenu CurrentPath="@_path" />
    </MudDrawer>

    <MudMainContent Class="tz-main">
        <ModuleSubNav Module="_module" CurrentPath="@_path" />
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="tz-page">
            @if (_denied)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4" Icon="@Icons.Material.Filled.Lock">
                    <MudText Typo="Typo.h6">@_denyMessage</MudText>
                    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               Class="ms-4">بازگشت به خانه</MudButton>
                    @if (!Session.IsAuthenticated)
                    {
                        <MudButton Href="/login" Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                   Class="ms-2">ورود</MudButton>
                    }
                </MudAlert>
            }
            else
            {
                @Body
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@* ───────────────────────────────────────────────────────────
   قفل محیط کاری:
   - اگر هیچ شرکتی در سیستم نیست → فرم ایجاد شرکت (اجباری).
   - اگر شرکت(ها) وجود دارند ولی کاربر محیط فعال ندارد →
     دیالوگ انتخاب شرکت (نه ایجاد).
   - انتخاب/تغییر سال برای جابه‌جایی بین سال‌های موجود از «عملیات ویژه» انجام می‌شود.
   ─────────────────────────────────────────────────────────── *@
@if (Session.IsAuthenticated && (_showCompanyLock || _showCompanySelection))
{
    <div class="tz-context-lock" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0;
           background: rgba(0,0,0,0.8); z-index: 10000; display: flex;
           align-items: center; justify-content: center;">
        @if (_showCompanySelection)
        {
            <MudPaper Elevation="5" Class="pa-6 mx-auto" Style="width: 100%; max-width: 500px; direction: rtl;">
                <div class="text-center mb-4 d-flex flex-column align-center">
                    <img src="_content/Tarazin.Ui/brand/logo.svg" alt="" width="64" height="64" />
                    <MudText Typo="Typo.h5" Class="mt-2 font-weight-bold">انتخاب شرکت مالی</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                        یک شرکت مالی را برای ورود انتخاب کنید. سال مالی به‌صورت خودکار فعال می‌شود.
                    </MudText>
                </div>

                <MudSelect T="int" Label="شرکت مالی" @bind-Value="_selectedCompanyId" Variant="Variant.Outlined"
                           Class="mb-4" Required="true">
                    @foreach (var c in _selectionCompanies)
                    {
                        <MudSelectItem Value="@c.CompanyId">@c.CompanyName</MudSelectItem>
                    }
                </MudSelect>

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                           OnClick="SelectCompanyAsync" Disabled="@(_selectedCompanyId == 0 || _busy)">
                    @if (_busy)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                        <span>در حال ورود...</span>
                    }
                    else
                    {
                        <span>ورود به شرکت انتخه</span>
                    }
                </MudButton>

                <MudDivider Class="my-4" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">یا یک شرکت جدید بسازید:</MudText>
                <MudForm @ref="_companyForm" @bind-IsValid="_companyValid">
                    <MudTextField Label="نام شرکت جدید" @bind-Value="_newCompanyName"
                                  Variant="Variant.Outlined" Class="mb-3" Immediate="true" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true"
                               OnClick="CreateCompanyAsync" Disabled="@(string.IsNullOrWhiteSpace(_newCompanyName) || _busy)">
                        ایجاد شرکت جدید
                    </MudButton>
                </MudForm>
            </MudPaper>
        }
        else
        {
            <MudPaper Elevation="5" Class="pa-6 mx-auto" Style="width: 100%; max-width: 450px; direction: rtl;">
                <div class="text-center mb-4 d-flex flex-column align-center">
                    <img src="_content/Tarazin.Ui/brand/logo.svg" alt="" width="64" height="64" />
                    <MudText Typo="Typo.h5" Class="mt-2 font-weight-bold">ایجاد شرکت مالی</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                        برای شروع باید یک شرکت مالی ایجاد کنید. سال مالی به‌صورت خودکار توسط سیستم ساخته می‌شود.
                    </MudText>
                </div>

                <MudForm @ref="_companyForm" @bind-IsValid="_companyValid">
                    <MudTextField Label="نام شرکت جدید" @bind-Value="_newCompanyName"
                                  Required="true" RequiredError="نام شرکت الزامی است."
                                  Variant="Variant.Outlined" Class="mb-4" Immediate="true" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                               OnClick="CreateCompanyAsync" Disabled="@(!_companyValid || _busy)">
                        @if (_busy)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                            <span>در حال ایجاد...</span>
                        }
                        else
                        {
                            <span>ایجاد شرکت مالی و ورود</span>
                        }
                    </MudButton>
                </MudForm>
            </MudPaper>
        }
    </div>
}
@code {
    private bool _drawerOpen = true;
    private string _path = "";
    private TarazinModule? _module;

    private bool _denied;
    private string _denyMessage = "";

    // Multi-company state
    private bool _loadingContext;
    private bool _showCompanyLock;
    private bool _showCompanySelection;
    private List<CompanyRow> _selectionCompanies = new();
    private int _selectedCompanyId;
    private string _newCompanyName = "";
    private bool _companyValid;
    private MudForm? _companyForm;
    private bool _busy;

    // Fiscal year selector support
    private int _selectedFiscalYearId;

    private string Initial =>
        string.IsNullOrWhiteSpace(Session.DisplayName) ? "ک" : Session.DisplayName[..1];

    private List<FiscalYearRow> _years = new();

    protected override async Task OnInitializedAsync()
    {
        Prefs.Changed += OnPrefsChanged;
        Session.Changed += OnSessionChanged;
        Nav.LocationChanged += OnLocation;
        RefreshPath(Nav.Uri);
        await EnsureContextAsync();
        _selectedFiscalYearId = Session.ActiveFiscalYearId ?? 0;
    }

    private void OnPrefsChanged() => InvokeAsync(StateHasChanged);

    private void OnSessionChanged()
    {
        RefreshPath(Nav.Uri);
        _ = InvokeAsync(async () => {
            await EnsureContextAsync();
            StateHasChanged();
        });
    }

    private void OnLocation(object? sender, LocationChangedEventArgs e)
    {
        RefreshPath(e.Location);
        _ = InvokeAsync(async () => {
            await EnsureContextAsync();
            StateHasChanged();
        });
    }

    private async Task EnsureContextAsync()
    {
        if (!Session.IsAuthenticated || _loadingContext) return;
        _loadingContext = true;
        try
        {
            var state = await Context.ResolveAsync();
            _showCompanyLock = state.RequiresCompany;
            _showCompanySelection = state.RequiresSelection;
            if (state.RequiresSelection)
            {
                _selectionCompanies = state.Companies.ToList();
                if (_selectionCompanies.Count > 0 && _selectedCompanyId == 0)
                    _selectedCompanyId = _selectionCompanies[0].CompanyId;
                _showCompanyLock = false;
            }
            else
            {
                _selectionCompanies.Clear();
                _selectedCompanyId = 0;
            }

            await LoadFiscalYearsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در آماده‌سازی: {ex.Message}", Severity.Error);
            _showCompanyLock = true;
            _showCompanySelection = false;
        }
        finally
        {
            _loadingContext = false;
        }
    }

    private void RefreshPath(string uri)
    {
        _path = Nav.ToBaseRelativePath(uri);
        _module = TarazinModules.Match(_path);

        var required = TarazinModules.RequiredPermissionFor(_path);
        _denied = required is not null && !Session.HasPermission(required);
        _denyMessage = !Session.IsAuthenticated
            ? "برای دسترسی به این بخش ابتدا وارد شوید."
            : "شما دسترسی لازم برای این بخش را ندارید. برای دریافت دسترسی با مدیر سیستم تماس بگیرید.";
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task Logout()
    {
        await Session.SignOutAsync();
        Snackbar.Add("از حساب خود خارج شدید.", Severity.Info);
        Nav.NavigateTo("/", forceLoad: true);
    }

    private async Task NavigateToSettings()
    {
        Nav.NavigateTo("/settings");
    }

    private async Task LoadFiscalYearsAsync()
    {
        if (Session.ActiveCompanyId == null) return;
        try
        {
            _years = (await Context.GetAuthorizedFiscalYearsAsync(Session.ActiveCompanyId.Value)).ToList();
        }
        catch (Exception ex)
        {
            _years = new();
        }
    }

    private async Task OnFiscalYearChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var newYearId)) return;
        if (newYearId == _selectedFiscalYearId) return;

        // Find the selected fiscal year object
        var selectedYear = _years.FirstOrDefault(y => y.FiscalYearId == newYearId);
        if (selectedYear == null) return;

        try
        {
            // Resolve the selected company row using the current company id
            var selectedCompanyRow = _selectionCompanies.FirstOrDefault(c => c.CompanyId == Session.ActiveCompanyId!.Value);
            if (selectedCompanyRow == null) return;
            // Pass the company row and fiscal year row to the service method
            await Context.SetActiveContextAsync(selectedCompanyRow, selectedYear);
            // Update the bound field to reflect the change
            _selectedFiscalYearId = newYearId;
            Snackbar.Add($"سال مالی فعال به «{selectedYear.YearName}» تغییر یافت.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در تغییر سال مالی: {ex.Message}", Severity.Error);
        }
    }

    // --- Added public event handlers ---
    public async Task SelectCompanyAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            // Resolve the company row using the current company id
            var selectedCompanyRow = _selectionCompanies.FirstOrDefault(c => c.CompanyId == _selectedCompanyId);
            if (selectedCompanyRow == null) return;
            // Pass the company id to the service method
            await Context.SelectCompanyAsync(selectedCompanyRow.CompanyId);
            Snackbar.Add("شرکت با موفقیت انتخاب شد.", Severity.Success);
            _showCompanySelection = false;
            _showCompanyLock = false;
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    public async Task CreateCompanyAsync()
    {
        if (_busy) return;
        await (_companyForm?.Validate() ?? Task.CompletedTask);
        if (!_companyValid || string.IsNullOrWhiteSpace(_newCompanyName)) return;

        _busy = true;
        try
        {
            await Context.CreateCompanyAsync(_newCompanyName.Trim());
            Snackbar.Add($"شرکت «{_newCompanyName.Trim()}» با سال مالی جاری ایجاد شد.", Severity.Success);
            _showCompanyLock = false;
            _showCompanySelection = false;
            _newCompanyName = "";
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
    // --- End of added handlers ---

    // Explicit public Dispose to satisfy Roslyn generator
    public void Dispose()
    {
        Prefs.Changed -= OnPrefsChanged;
        Session.Changed -= OnSessionChanged;
        Nav.LocationChanged -= OnLocation;
    }
}