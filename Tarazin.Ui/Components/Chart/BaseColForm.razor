@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudTextField Label="کد (2 رقم)"
                                  @bind-Value="_code"
                                  Required="true"
                                  RequiredError="کد حساب کل الزامی است."
                                  MaxLength="2"
                                  Immediate="true"
                                  OnKeyDown="HandleKeyDown"
                                  Variant="Variant.Outlined"
                                  Counter="2"
                                  HelperText="دقیقاً ۲ رقم — صفرهای ابتدایی حفظ می‌شود" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField Label="عنوان" @bind-Value="_title" MaxLength="200"
                                  Required="true" RequiredError="عنوان الزامی است."
                                  OnKeyDown="HandleKeyDown" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="7">
                    <MudSelect T="int" Label="گروه حساب کل" @bind-Value="_groupId"
                               @bind-Value:after="ApplyGroupDefaultNature"
                               Variant="Variant.Outlined"
                               HelperText="گروه برای طبقه‌بندی و فیلتر حساب‌ها استفاده می‌شود.">
                        <MudSelectItem T="int" Value="0">— بدون گروه —</MudSelectItem>
                        @foreach (var group in _groups)
                        {
                            <MudSelectItem T="int" Value="@group.AccountGroupId">@group.GroupCode | @group.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudSelect T="string" Label="ماهیت حساب" @bind-Value="_accountNature"
                               Required="true" RequiredError="انتخاب ماهیت حساب الزامی است."
                               Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@AccountNatureKind.Debit">بدهکار</MudSelectItem>
                        <MudSelectItem T="string" Value="@AccountNatureKind.Credit">بستانکار</MudSelectItem>
                        <MudSelectItem T="string" Value="@AccountNatureKind.Both">هر دو</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="شرح" @bind-Value="_description"
                                  Lines="2" MaxLength="500" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch T="bool" @bind-Value="_isActive" Color="Color.Success" Label="فعال" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_busy">انصراف</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync" Disabled="_busy">
            @if (_busy) { <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" /> }
            ذخیره
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public int ColId { get; set; }
    [Parameter] public string InitialCode { get; set; } = "";
    [Parameter] public string InitialTitle { get; set; } = "";
    [Parameter] public string InitialDescription { get; set; } = "";
    [Parameter] public int? InitialAccountGroupId { get; set; }
    [Parameter] public string InitialAccountNature { get; set; } = AccountNatureKind.Both;
    [Parameter] public bool InitialIsActive { get; set; } = true;

    private MudForm? _form;
    private bool _isValid;
    private bool _busy;
    private string _code = "";
    private string _title = "";
    private string? _description;
    private int _groupId;
    private string _accountNature = AccountNatureKind.Both;
    private bool _isActive = true;
    private List<AccountGroupRow> _groups = new();

    protected override async Task OnInitializedAsync()
    {
        _code = InitialCode;
        _title = InitialTitle;
        _description = InitialDescription;
        _groupId = InitialAccountGroupId ?? 0;
        _accountNature = string.IsNullOrWhiteSpace(InitialAccountNature) ? AccountNatureKind.Both : InitialAccountNature;
        _isActive = InitialIsActive;

        try
        {
            _groups = (await Db.QueryAsync<AccountGroupRow>("accounting", "AccountGroupList", new
            {
                GroupType = AccountGroupType.Col, CompanyId = Session.ActiveCompanyId,
                IncludeInactive = ColId > 0
            })).ToList();
        }
        catch (Exception ex)
        {
            _groups = new();
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void ApplyGroupDefaultNature()
    {
        if (ColId > 0 || _groupId == 0) return;
        var group = _groups.FirstOrDefault(g => g.AccountGroupId == _groupId);
        if (group is not null) _accountNature = group.DefaultNature;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) _ = SaveAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_busy) return;
        await _form!.Validate();
        if (!_isValid) return;

        var code = (_code ?? "").Trim();
        if (code.Length != 2 || !code.All(char.IsDigit))
        {
            Snackbar.Add("کد حساب کل باید دقیقاً ۲ رقم باشد.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await Db.ExecuteAsync("accounting", "BaseColUpsert", new
            {
                ColId,
                ColCode = code,
                CompanyId = Session.ActiveCompanyId,
                Title = (_title ?? "").Trim(),
                Description = _description?.Trim() ?? "",
                AccountGroupId = _groupId == 0 ? (int?)null : _groupId,
                AccountNature = _accountNature,
                IsActive = _isActive,
                CreatedBy = Session.UserName,
                UpdatedBy = Session.UserName
            });
            Snackbar.Add(ColId == 0 ? "حساب کل ایجاد شد." : "ویرایش با موفقیت انجام شد.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
