@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (Mode != DetilFormMode.Edit)
        {
            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" OverrideStyles="false" Class="mb-3">
                <MudButton OnClick="@(() => SetModeAsync(DetilFormMode.Create))"
                           Variant="@(Mode == DetilFormMode.Create ? Variant.Filled : Variant.Outlined)"
                           StartIcon="@Icons.Material.Filled.FiberNew">ایجاد تفصیلی جدید</MudButton>
                <MudButton OnClick="@(() => SetModeAsync(DetilFormMode.LinkExisting))"
                           Variant="@(Mode == DetilFormMode.LinkExisting ? Variant.Filled : Variant.Outlined)"
                           StartIcon="@Icons.Material.Filled.Link">استفاده از تفصیلی موجود</MudButton>
            </MudButtonGroup>
        }

        @if (Mode == DetilFormMode.LinkExisting)
        {
            <MudText Typo="Typo.subtitle2" Class="mb-2">انتخاب تفصیلی موجود</MudText>
            <MudTextField Value="@_search" ValueChanged="SearchChanged" Placeholder="جستجو با کد، عنوان یا گروه..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" DebounceInterval="300"
                          Variant="Variant.Outlined" Class="mb-2" />
            <MudTable Items="_existing" Dense="true" Hover="true" Striped="true"
                      Breakpoint="Breakpoint.Sm" FixedHeader="true" Height="300px">
                <HeaderContent>
                    <MudTh>کد</MudTh>
                    <MudTh>عنوان</MudTh>
                    <MudTh>گروه</MudTh>
                    <MudTh>ماهیت</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد"><span dir="ltr">@context.DetilCode</span></MudTd>
                    <MudTd DataLabel="عنوان">@context.Title</MudTd>
                    <MudTd DataLabel="گروه">@(context.GroupTitle ?? "—")</MudTd>
                    <MudTd DataLabel="ماهیت">@AccountNatureKind.Title(context.AccountNature)</MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="@(() => LinkAsync(context))" Disabled="_busy">انتخاب</MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Class="pa-3">موردی یافت نشد.</MudText></NoRecordsContent>
            </MudTable>
        }
        else
        {
            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                            @(Mode == DetilFormMode.Create
                                ? "شمارهٔ تفصیلی به‌صورت خودکار و قطعی از بازهٔ گروه انتخاب‌شده تخصیص می‌یابد."
                                : "شمارهٔ تفصیلی در حالت ویرایش تغییر نمی‌کند.")
                        </MudAlert>
                    </MudItem>
                    @if (_groups.Count == 0)
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                هنوز گروه تفصیلی فعالی تعریف نشده است. ابتدا از «مدیریت گروه‌ها» یک گروه با بازهٔ شماره ایجاد کنید.
                            </MudAlert>
                        </MudItem>
                    }
                    <MudItem xs="12" sm="7">
                        <MudSelect T="int" Label="گروه حساب تفصیلی" @bind-Value="_groupId"
                                   @bind-Value:after="OnGroupChangedAsync"
                                   Required="true"
                                   RequiredError="انتخاب گروه تفصیلی الزامی است."
                                   Variant="Variant.Outlined">
                            <MudSelectItem T="int" Value="0">— انتخاب کنید —</MudSelectItem>
                            @foreach (var group in _groups)
                            {
                                <MudSelectItem T="int" Value="@group.AccountGroupId">
                                    @group.GroupCode | @group.Title (@group.FromCode تا @group.ToCode)
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudTextField Label="شماره تفصیلی"
                                      Value="@DisplayedCode"
                                      ReadOnly="true"
                                      Variant="Variant.Outlined"
                                      HelperText="@(Mode == DetilFormMode.Create ? "پیش‌نمایش؛ شماره نهایی هنگام ذخیره قطعی می‌شود" : null)" />
                    </MudItem>
                    @if (Mode == DetilFormMode.Create && _groupId != 0 && _nextCode is not null && !_nextCode.HasCapacity)
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Warning" Dense="true">ظرفیت بازهٔ این گروه تکمیل شده است.</MudAlert>
                        </MudItem>
                    }
                    <MudItem xs="12">
                        <MudTextField Label="عنوان" @bind-Value="_title" Required="true" MaxLength="200"
                                      RequiredError="عنوان الزامی است." OnKeyDown="HandleKeyDown" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudSelect T="string" Label="ماهیت حساب" @bind-Value="_accountNature"
                                   Required="true" RequiredError="انتخاب ماهیت حساب الزامی است."
                                   Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@AccountNatureKind.Debit">بدهکار</MudSelectItem>
                            <MudSelectItem T="string" Value="@AccountNatureKind.Credit">بستانکار</MudSelectItem>
                            <MudSelectItem T="string" Value="@AccountNatureKind.Both">هر دو</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="7">
                        <MudTextField Label="شرح" @bind-Value="_description" Lines="2" MaxLength="500" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudSwitch T="bool" @bind-Value="_isActive" Color="Color.Success" Label="فعال" />
                    </MudItem>
                </MudGrid>
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_busy">انصراف</MudButton>
        @if (Mode != DetilFormMode.LinkExisting)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveAsync" Disabled="@(_busy || (Mode == DetilFormMode.Create && _nextCode is { HasCapacity: false }))">
                @if (_busy) { <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" /> }
                ذخیره
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public DetilFormMode Mode { get; set; } = DetilFormMode.Create;
    [Parameter, EditorRequired] public int MoeinId { get; set; }
    [Parameter] public int? ParentLinkId { get; set; }
    [Parameter] public int DetilId { get; set; }
    [Parameter] public string InitialCode { get; set; } = "";
    [Parameter] public string InitialTitle { get; set; } = "";
    [Parameter] public string? InitialDescription { get; set; }
    [Parameter] public int? InitialAccountGroupId { get; set; }
    [Parameter] public string InitialAccountNature { get; set; } = AccountNatureKind.Both;
    [Parameter] public bool InitialIsActive { get; set; } = true;

    private MudForm? _form;
    private bool _isValid;
    private bool _busy;
    private string _code = "";
    private string _title = "";
    private string? _description;
    private int _groupId;
    private string _accountNature = AccountNatureKind.Both;
    private bool _isActive = true;
    private string _search = "";
    private List<BaseDetilRow> _existing = new();
    private List<AccountGroupRow> _groups = new();
    private DetilNextCodeRow? _nextCode;

    private string DisplayedCode => Mode == DetilFormMode.Create
        ? (_nextCode?.NextCode ?? "—")
        : _code;

    protected override async Task OnInitializedAsync()
    {
        _code = InitialCode;
        _title = InitialTitle;
        _description = InitialDescription;
        _groupId = InitialAccountGroupId ?? 0;
        _accountNature = string.IsNullOrWhiteSpace(InitialAccountNature) ? AccountNatureKind.Both : InitialAccountNature;
        _isActive = InitialIsActive;

        if (Mode == DetilFormMode.LinkExisting)
        {
            await LoadExistingAsync();
            return;
        }

        await LoadGroupsAsync();

        if (Mode == DetilFormMode.Create && _groupId != 0)
            await OnGroupChangedAsync();
    }

    private async Task SetModeAsync(DetilFormMode mode)
    {
        Mode = mode;
        if (mode == DetilFormMode.LinkExisting)
            await LoadExistingAsync();
        else if (_groups.Count == 0)
            await LoadGroupsAsync();
    }

    private async Task LoadGroupsAsync()
    {
        try
        {
            _groups = (await Db.QueryAsync<AccountGroupRow>("accounting", "AccountGroupList", new
            {
                GroupType = AccountGroupType.Detil,
                IncludeInactive = Mode == DetilFormMode.Edit
            })).ToList();
        }
        catch (Exception ex)
        {
            _groups = new();
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OnGroupChangedAsync()
    {
        _nextCode = null;
        if (_groupId == 0) return;

        if (Mode == DetilFormMode.Create)
        {
            var group = _groups.FirstOrDefault(g => g.AccountGroupId == _groupId);
            if (group is not null) _accountNature = group.DefaultNature;

            try
            {
                _nextCode = await Db.QueryFirstOrDefaultAsync<DetilNextCodeRow>(
                    "accounting", "BaseDetilNextCode", new { AccountGroupId = _groupId });
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task LoadExistingAsync()
    {
        try
        {
            _existing = (await Db.QueryAsync<BaseDetilRow>("accounting", "BaseDetilSearch", new
            {
                SearchText = _search,
                Take = 100,
                ExcludeMoeinId = MoeinId,
                ExcludeParentLinkId = ParentLinkId
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SearchChanged(string value)
    {
        _search = value;
        await LoadExistingAsync();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) _ = SaveAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_busy) return;
        await _form!.Validate();
        if (!_isValid) return;

        if (_groupId == 0)
        {
            Snackbar.Add("انتخاب گروه حساب تفصیلی الزامی است.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            if (Mode == DetilFormMode.Create)
            {
                var created = await Db.ExecuteReturningAsync<BaseDetilCreateResult>(
                    "accounting", "BaseDetilCreateAuto", new
                    {
                        MoeinId,
                        ParentLinkId,
                        AccountGroupId = _groupId,
                        AccountNature = _accountNature,
                        Title = (_title ?? "").Trim(),
                        Description = _description?.Trim() ?? "",
                        IsActive = _isActive,
                        CreatedBy = Session.UserName
                    }) ?? throw new InvalidOperationException("نتیجهٔ ایجاد حساب تفصیلی دریافت نشد.");

                Snackbar.Add($"حساب تفصیلی با شمارهٔ {created.DetilCode} ایجاد شد.", Severity.Success);
            }
            else
            {
                await Db.ExecuteAsync("accounting", "BaseDetilUpsert", new
                {
                    DetilId,
                    DetilCode = _code,
                    Title = (_title ?? "").Trim(),
                    Description = _description?.Trim() ?? "",
                    AccountGroupId = _groupId == 0 ? (int?)null : _groupId,
                    AccountNature = _accountNature,
                    IsActive = _isActive,
                    CreatedBy = Session.UserName,
                    UpdatedBy = Session.UserName
                });
                Snackbar.Add("ویرایش حساب تفصیلی انجام شد.", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LinkAsync(BaseDetilRow row)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Db.ExecuteAsync("accounting", "BaseDetilLinkUpsert", new
            {
                LinkId = 0,
                row.DetilId,
                MoeinId,
                ParentLinkId,
                Description = (string?)null,
                IsActive = true,
                CreatedBy = Session.UserName,
                UpdatedBy = Session.UserName
            });
            Snackbar.Add("تفصیلی موجود به مسیر انتخاب‌شده متصل شد.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    public enum DetilFormMode
    {
        Create,
        LinkExisting,
        Edit
    }
}
