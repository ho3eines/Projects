@inject UserSession Session
@implements IDisposable

@if (Module is not null)
{
    <div class="tz-subnav" role="navigation" aria-label="@Module.Title">
        <div class="tz-subnav__brand" style="--tz-accent:@Module.Accent">
            <MudIcon Icon="@Module.Icon" Size="Size.Small" />
            <span>@Module.Title</span>
        </div>
        <div class="tz-subnav__tabs">
            @foreach (var item in Module.Items)
            {
                @if (!item.HideInNav && Session.HasPermission(item.Permission))
                {
                    var active = TarazinModules.IsActive(CurrentPath, item.Url);
                    <a href="@item.Url" class="tz-subnav__tab @(active ? "is-active" : null)">
                        <MudIcon Icon="@item.Icon" Size="Size.Small" />
                        <span>@item.Title</span>
                    </a>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public TarazinModule? Module { get; set; }
    [Parameter] public string CurrentPath { get; set; } = "";

    protected override void OnInitialized()
    {
        // مثل NavMenu: بعد از بازیابی نشست (رفرش) پارامترها ثابت می‌مانند،
        // پس برای نمایش تب‌های زیرمنو باید خودش به تغییر نشست واکنش نشان دهد.
        Session.Changed += OnSessionChanged;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
