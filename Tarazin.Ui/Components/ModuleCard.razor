@namespace Tarazin.Components
@* کارت ماژول — یک <a> واقعی (نه div کلیکی): با کیبورد (Tab/Enter)، کلیک وسط،
   بازکردن در تب جدید و screen reader به‌صورت native کار می‌کند؛ ظاهر با
   کلاس tz-modcard (app.css) در هر دو حالت روشن/تیره و ریسپانسیو یکدست است.
   با (Icon, Title, Lead, Url, Accent) پارامتری شده تا هم از TarazinModule و هم
   از کارت‌های داخلی (مثل مرکز مشترک) قابل‌استفاده باشد. *@

<a href="@Url" class="tz-modcard" style="@CardStyle" aria-label="ورود به ماژول @Title">
    <div class="tz-modcard__icon" aria-hidden="true">
        <MudIcon Icon="@Icon" />
    </div>
    <div class="tz-modcard__body">
        <h3>@Title</h3>
        <p>@Lead</p>
    </div>
    <span class="tz-modcard__go" aria-hidden="true">
        <MudIcon Icon="@Icons.Material.Filled.West" />
    </span>
</a>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Lead { get; set; } = "";
    [Parameter] public string Url { get; set; } = "#";
    [Parameter] public string Accent { get; set; } = TarazinAccents.Ink;

    private string CardStyle => "--tz-accent:" + Accent;
}
