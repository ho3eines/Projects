@inject IJSRuntime JS
@inject PdfReportService Pdf
@inject NavigationManager Nav

@* ═══════════════════════════════════════════════════════════════════════
   دیالوگ عمومی چاپ — موتور چاپ قالب‌محور (TemplatePrintDialog)
   یک قالب (PrintTemplateDef) + داده (PrintDataModel) می‌گیرد و:
     • برگهٔ چاپی HTML خالص RTL را رندر می‌کند (باندها: هدر شرکت، هدر گزارش،
       جدول دیتیل، فوتر گزارش، فوتر صفحه) — خروجی window.print تمیز.
     • PDF با QuestPDF می‌سازد (مسیر سمت سرور، A4/A5 — از تنظیمات قالب).
     • دکمهٔ «ویرایش قالب» به حالت دیزاین (صفحهٔ /central/printing) می‌رود
       تا قالب همین گزارش جداگانه شخصی‌سازی شود.
   مصرف‌کننده فقط باید tpl + data را تزریق کند (تزریق مستقیم داده).
   ═══════════════════════════════════════════════════════════════════════ *@

<MudDialog Class="gp-print-dialog">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Print" />
            <MudText Typo="Typo.h6">چاپ — @DisplayTitle</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@PaperLabel</MudChip>
            @if (_pageCount > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Description">
                    ≈ @(_pageCount == 1 ? "۱ صفحه" : $"{_pageCount} صفحه")
                </MudChip>
            }
        </div>
    </TitleContent>

    <DialogContent>
        <div class="tpl-print-stage">
            <div class="tpl-sheet-shell">
                @((MarkupString)PrintSheetRenderer.BuildHtml(Template, Data))
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        @if (AllowResize)
        {
            <MudSelect T="string" Label="اندازهٔ کاغذ" Value="@_paperSize" ValueChanged="OnSizeChanged"
                       Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                       Style="min-width:130px" Class="mr-1">
                <MudSelectItem Value="@("")">طبق قالب</MudSelectItem>
                <MudSelectItem Value="@("A4")">A4</MudSelectItem>
                <MudSelectItem Value="@("A5")">A5</MudSelectItem>
                <MudSelectItem Value="@("A5L")">A5 افقی</MudSelectItem>
            </MudSelect>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="EditTemplateAsync"
                   StartIcon="@Icons.Material.Filled.Tune">
            ویرایش قالب
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PrintAsync"
                   StartIcon="@Icons.Material.Filled.Print">چاپ</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="Close" StartIcon="@Icons.Material.Filled.Close">بستن</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>قالب چاپ (از دیتابیس یا پیش‌فرض داخلی — توسط صدا زننده بارگذاری می‌شود).</summary>
    [Parameter, EditorRequired] public PrintTemplateDef Template { get; set; } = new();

    /// <summary>دادهٔ چاپ — تزریق مستقیم توسط صدا زننده.</summary>
    [Parameter, EditorRequired] public PrintDataModel Data { get; set; } = new();

    /// <summary>شناسهٔ قالب برای دکمهٔ «ویرایش قالب» (اگر خالی باشد دکمه مخفی می‌شود).</summary>
    [Parameter] public string? TemplateId { get; set; }

    private int _pageCount;
    private bool _countingPages;

    /// <summary>اجازهٔ تغییر اندازهٔ کاغذ هنگام چاپ (پیش‌فرض روشن؛ در صورت لزوم خاموش).</summary>
    [Parameter] public bool AllowResize { get; set; } = true;

    private string _paperSize = "";

    private string DisplayTitle
        => string.IsNullOrWhiteSpace(Data.Title) ? Template.Name : Data.Title;

    /// <summary>
    /// شناسهٔ اندازه برای <see cref="PdfReportService.BuildTemplatePdf"/>.
    /// اگر کاربر دستی اندازه انتخاب نکرده باشد (طبق قالب) null برمی‌گرداند تا موتور
    /// از «اندازه/جهتِ ذخیره‌شدهٔ خود قالب» (PaperSize + Orientation) استفاده کند —
    /// یعنی هر قالب نقطهٔ شروع پیش‌فرض خود را دارد. وقتی کاربر override کند،
    /// همان توکن (A4/A5/A5L) دقیقاً به موتور می‌رود.
    /// </summary>
    private string? ResolvedSizeOverride
        => string.IsNullOrWhiteSpace(_paperSize) ? null : _paperSize;

    /// <summary>برچسب نمایشیِ اندازهٔ فعلی‌ِ چاپ (برای پیش‌نمایش/نام فایل).</summary>
    private string PaperLabel
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_paperSize))
                return _paperSize == "A5L" ? "A5 افقی" : _paperSize;
            return $"{Template.PaperSize}" + (Template.Orientation == PrintOrientation.Landscape ? " افقی" : "");
        }
    }

    private void OnSizeChanged(string? size)
    {
        _paperSize = size ?? "";
        _ = UpdatePageCountAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("tarazinQr.fillAll");
            await UpdatePageCountAsync();
        }
    }

    /// <summary>
    /// چیپ «تعداد صفحه» را از همان بایت‌های BuildTemplatePdf می‌سازد تا کاربر
    /// پیش از چاپ بداند چندصفحه خواهد شد — هم‌دهان با دیالوگ‌های اسناد/فاکتور.
    /// </summary>
    private async Task UpdatePageCountAsync()
    {
        if (_countingPages) return;
        _countingPages = true;
        try
        {
            var count = Pdf.BuildTemplatePdfPageCount(Template, Data, ResolvedSizeOverride);
            if (_pageCount != count)
            {
                _pageCount = count;
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            _countingPages = false;
        }
    }

    /// <summary>
    /// چاپ از همان بایت‌های PDF (QuestPDF) که «دانلود PDF» تولید می‌کند —
    /// ویوئر PDF مرورگر را باز می‌کند تا خروجی چاپ با PDF یکسان باشد.
    /// </summary>
    private async Task PrintAsync()
    {
        var bytes = Pdf.BuildTemplatePdf(Template, Data, ResolvedSizeOverride);
        await JS.InvokeVoidAsync("tarazin.printPdfBytes", Convert.ToBase64String(bytes));
    }

    private void EditTemplateAsync()
    {
        var id = TemplateId ?? Template.Id;
        if (string.IsNullOrWhiteSpace(id)) return;
        MudDialog.Close();
        Nav.NavigateTo($"/central/printing?tpl={Uri.EscapeDataString(id)}");
    }

    private void Close() => MudDialog.Close();
}
