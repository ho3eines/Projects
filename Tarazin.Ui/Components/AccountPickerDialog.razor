@inject DbService Db
@inject ISnackbar Snackbar
@inject UserSession Session
@inject IDialogService DialogService
@inject IJSRuntime JS
@implements IAsyncDisposable
@using Tarazin.Modules.Accounting.Components

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudTextField @ref="_searchRef"
                              Label="جستجو (نام، کد گره، کد حساب)"
                              @bind-Value="_search"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              DebounceInterval="180"
                              OnDebounceIntervalElapsed="OnSearchChanged"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true"
                              OnClearButtonClick="OnSearchCleared"
                              Placeholder="مثلاً: بانک ملی یا 0000123 یا 100010000123" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Label="فیلتر نوع" @bind-Value="_typeFilter" Variant="Variant.Outlined" Dense="true"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.FilterList"
                           OnClose="RefreshAsync"
                           Clearable="true">
                    <MudSelectItem T="string" Value="@((string?)null)">همه</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Col")">فقط حساب کل</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Moein")">فقط معین</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Detil")">فقط تفصیلی</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" Class="d-flex align-center flex-wrap" Style="gap:8px">
                <MudSwitch T="bool" @bind-Value="_showInactive" Color="Color.Default" Label="نمایش غیرفعال‌ها" />
                @if (Options.TransactionalOnly)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.CheckCircle">
                        فقط برگ نهایی تفصیلی قابل انتخاب است
                    </MudChip>
                }
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="2" Class="mt-2">
            <MudItem xs="12" md="7">
                <MudPaper Elevation="0" Outlined="true" Class="tz-pickertree">
                    @if (_loading)
                    {
                        <div class="pa-4 d-flex justify-center">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                        </div>
                    }
                    else if (_flat.Count == 0)
                    {
                        <MudText Color="Color.Secondary" Class="pa-4">موردی یافت نشد.</MudText>
                    }
                    else
                    {
                        <div class="tz-pickertree__scroll" @ref="_scrollRef" tabindex="0" @onkeydown="OnKeyDown">
                            @foreach (var n in _flat)
                            {
                                var isSelected = NodeKey(n) == NodeKey(_selected);
                                var isInvalid = IsInvalidSelection(n);
                                <div class="tz-pickertree__row @(isSelected ? "is-selected" : null) @(isInvalid ? "is-invalid" : null) @(NodeKey(n) == _highlightedNodeKey ? "is-highlighted" : null)"
                                     style="padding-right:@((n.Level - 1) * 24 + 12)px; @(isInvalid ? "opacity:0.6;" : "")"
                                     @onclick="@(() => Select(n))"
                                     @ondblclick="@(() => TryConfirm(n))">
                                    <span class="tz-pickertree__icon">
                                        @if (n.NodeType == "BaseCol")
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" />
                                        }
                                        else if (n.NodeType == "BaseMoein")
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@(n.ChildCount>0 ? Icons.Material.Filled.Folder : Icons.Material.Filled.Article)" Size="Size.Small" Color="@(n.ChildCount>0 ? Color.Warning : Color.Success)" />
                                        }
                                    </span>
                                    @* «کد حساب» (مسیر کامل) شناسهٔ اصلی ردیف است؛
                                       کد کوتاهِ خودِ گره فقط به‌صورت ثانویه نمایش داده می‌شود. *@
                                    <span class="tz-pickertree__code" title="@($"کد حساب: {n.AccountCode} — کد گره: {n.Code}")">@n.AccountCode</span>
                                    <span class="tz-pickertree__title">@n.Title</span>
                                    <span class="tz-pickertree__acc">@n.Code</span>
                                    @if (!n.IsActive)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">غیرفعال</MudChip>
                                    }
                                    @if (n.ChildCount > 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.AccountTree">@n.ChildCount زیرمجموعه</MudChip>
                                    }
                                    else if (n.NodeType == "BaseDetil")
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Check">برگ نهایی</MudChip>
                                    }
                                </div>
                            }
                        </div>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="5">
                <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">اطلاعات حساب انتخاب‌شده</MudText>
                    @if (_selected is null)
                    {
                        <MudText Color="Color.Secondary">برای انتخاب، روی ردیف کلیک کنید یا با کلیدهای ↑/↓ حرکت و Enter تأیید کنید.</MudText>
                    }
                    else
                    {
                        <MudGrid Spacing="1">
                            <MudItem xs="5"><MudText Color="Color.Secondary">عنوان</MudText></MudItem>
                            <MudItem xs="7"><b>@_selected.Title</b></MudItem>
                            <MudItem xs="5"><MudText Color="Color.Secondary">نوع</MudText></MudItem>
                            <MudItem xs="7">@TypeTitle(_selected.NodeType)</MudItem>
                            <MudItem xs="5"><MudText Color="Color.Secondary">کد حساب</MudText></MudItem>
                            <MudItem xs="7" Class="d-flex align-center">
                                <code style="direction:ltr"><b>@_selected.AccountCode</b></code>
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                               OnClick="@(() => Copy("کد حساب", _selected.AccountCode))" />
                            </MudItem>
                            <MudItem xs="5"><MudText Color="Color.Secondary">کد گره</MudText></MudItem>
                            <MudItem xs="7" Class="d-flex align-center">
                                <code style="direction:ltr">@_selected.Code</code>
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                               OnClick="@(() => Copy("کد گره", _selected.Code))" />
                            </MudItem>
                            <MudItem xs="5"><MudText Color="Color.Secondary">مسیر</MudText></MudItem>
                            <MudItem xs="7">
                                <MudBreadcrumbs Items="_breadcrumbs" MaxItems="6" Class="pa-0">
                                    <ItemTemplate Context="b">
                                        <MudText Typo="Typo.caption">@b.Text</MudText>
                                    </ItemTemplate>
                                </MudBreadcrumbs>
                            </MudItem>
                            <MudItem xs="5"><MudText Color="Color.Secondary">فرزندان</MudText></MudItem>
                            <MudItem xs="7">
                                @if (_selected.ChildCount > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">@_selected.ChildCount زیرمجموعه دارد — فقط برگ نهایی قابل انتخاب است</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">سطر آخر (برگ نهایی) — قابل انتخاب</MudChip>
                                }
                            </MudItem>
                            <MudItem xs="5"><MudText Color="Color.Secondary">وضعیت</MudText></MudItem>
                            <MudItem xs="7">
                                <MudChip T="string" Size="Size.Small" Color="@(_selected.IsActive ? Color.Success : Color.Default)">
                                    @(_selected.IsActive ? "فعال" : "غیرفعال")
                                </MudChip>
                            </MudItem>
                        </MudGrid>

                        @if (Options.TransactionalOnly && _selected.NodeType != "BaseDetil")
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3"
                                      Icon="@Icons.Material.Filled.WarningAmber">
                                این حساب قابل انتخاب برای ثبت عملیات نیست. لطفاً یک حساب تفصیلی نهایی (برگ) انتخاب کنید.
                            </MudAlert>
                        }
                        else if (_selected.NodeType == "BaseDetil" && _selected.ChildCount > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3"
                                      Icon="@Icons.Material.Filled.AccountTree">
                                این تفصیلی دارای <b>@_selected.ChildCount زیرمجموعه</b> است و برای ثبت سند قابل انتخاب نیست.
                                فقط سطر آخر (حساب‌های تفصیلی برگ نهایی) قابل انتخاب هستند.
                                می‌توانید زیرمجموعه‌های آن را جستجو کرده و یک مورد نهایی را انتخاب کنید.
                            </MudAlert>
                        }

                        @if (_selected.NodeType == "BaseDetil")
                        {
                            <MudDivider Class="my-3" />
                            <div class="d-flex flex-wrap" style="gap:8px">
                                <MudButton Variant="Variant.Outlined" Color="Color.Info"
                                           StartIcon="@Icons.Material.Filled.ManageSearch"
                                           OnClick="OpenDetailHistoryAsync">
                                    نمایش مرور تفصیلی
                                </MudButton>
                                @if (_selected.ChildCount > 0)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                                               StartIcon="@Icons.Material.Filled.FolderOpen"
                                               OnClick="ShowChildrenAsync">
                                        نمایش زیرمجموعه‌ها
                                    </MudButton>
                                }
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                مرور گردش برای هر تفصیلی (حتی والد) امکان‌پذیر است، اما انتخاب برای ثبت فقط برای برگ نهایی.
                            </MudText>
                        }
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">انصراف (Esc)</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirm" Disabled="!CanConfirm"
                   StartIcon="@Icons.Material.Filled.Check">
            انتخاب (Enter)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public AccountPickerOptions Options { get; set; } = new();

    private MudTextField<string>? _searchRef;
    private ElementReference _scrollRef;
    private string _search = "";
    private string? _typeFilter;
    private bool _showInactive;
    private bool _loading = true;
    private List<ChartTreeNode> _flat = new();
    private ChartTreeNode? _selected;
    private string _highlightedNodeKey = "";
    private List<BreadcrumbItem> _breadcrumbs = new();

    private static string NodeKey(ChartTreeNode? n) => n is null
        ? ""
        : n.NodeType == "BaseDetil"
            ? $"BaseDetil:{n.LinkId ?? n.NodeId}"
            : $"{n.NodeType}:{n.NodeId}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _typeFilter = Options.AllowedType switch
            {
                AccountPickerType.Col => "Col",
                AccountPickerType.Moein => "Moein",
                AccountPickerType.Detil => "Detil",
                _ => null
            };
            _showInactive = Options.ShowInactive;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در مقداردهی اولیه درختواره: {ex.Message}", Severity.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                if (_searchRef is not null)
                    await _searchRef.FocusAsync();
            }
            catch { }
        }
    }

    private async Task OnSearchChanged(string _)
    {
        try { await RefreshAsync(); }
        catch (Exception ex) { Snackbar.Add($"خطا در جستجو: {ex.Message}", Severity.Error); }
    }

    private async Task OnSearchCleared(MouseEventArgs _)
    {
        try
        {
            _search = "";
            await RefreshAsync();
        }
        catch (Exception ex) { Snackbar.Add($"خطا: {ex.Message}", Severity.Error); }
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        try
        {
            try
            {
                _flat = (await Db.QueryAsync<ChartTreeNode>("accounting", "ChartAccountPickerList", new
                {
                    SearchText = _search ?? "",
                    AccountTypeFilter = _typeFilter,
                    AllowTransactionOnly = Options.TransactionalOnly ? 1 : 0,
                    IncludeInactive = _showInactive ? 1 : 0
                })).ToList();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"خطا در بارگذاری درخت حساب‌ها: {ex.Message}", Severity.Error);
                _flat = new();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطای غیرمنتظره در بارگذاری: {ex.Message}", Severity.Error);
            _flat = new();
        }
        finally
        {
            try
            {
                _loading = false;
                if (_flat.Count > 0)
                {
                    // انتخاب اولین برگ نهایی اگر در حالت transactional هستیم
                    ChartTreeNode? firstLeaf = null;
                    if (Options.TransactionalOnly)
                    {
                        firstLeaf = _flat.FirstOrDefault(x => x.NodeType == "BaseDetil" && x.ChildCount == 0);
                    }
                    var toSelect = firstLeaf ?? _flat[0];
                    _highlightedNodeKey = NodeKey(toSelect);
                    _selected = toSelect;
                    await BuildBreadcrumbAsync(_selected);
                }
                else
                {
                    _highlightedNodeKey = "";
                    _selected = null;
                    _breadcrumbs = new();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"خطا در پردازش نتایج: {ex.Message}", Severity.Error);
                _highlightedNodeKey = "";
                _selected = null;
            }
        }
    }

    private void Select(ChartTreeNode n)
    {
        try
        {
            if (n is null) return;
            _selected = n;
            _highlightedNodeKey = NodeKey(n);
            _ = BuildBreadcrumbAsync(n);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در انتخاب: {ex.Message}", Severity.Error);
        }
    }

    private bool IsInvalidSelection(ChartTreeNode n)
    {
        try
        {
            if (n is null) return true;

            // قانون اصلی ثبت سند (TransactionalOnly=true):
            // فقط تفصیلی برگ نهایی (ChildCount==0) قابل انتخاب است.
            // اگر تفصیلی دارای زیرمجموعه (فرزند) باشد → غیرقابل انتخاب، فقط سطر آخر (برگ) قابل انتخاب.
            if (Options.TransactionalOnly)
            {
                if (n.NodeType != "BaseDetil") return true;
                if (n.ChildCount > 0) return true; // دارای زیرمجموعه → غیرقابل انتخاب برای ثبت سند
                return false;
            }

            // در حالت غیر-transactional (مدیریت چارت و ...) محدودیت برگ نهایی اعمال نمی‌شود
            return false;
        }
        catch
        {
            return true;
        }
    }

    private bool CanConfirm
    {
        get
        {
            try { return _selected is not null && !IsInvalidSelection(_selected); }
            catch { return false; }
        }
    }

    private void TryConfirm(ChartTreeNode? n)
    {
        try
        {
            if (n is null) return;
            Select(n);
            if (CanConfirm) Confirm();
            else
            {
                if (n.NodeType == "BaseDetil" && n.ChildCount > 0)
                    Snackbar.Add($"این تفصیلی دارای {n.ChildCount} زیرمجموعه است و قابل انتخاب برای ثبت نیست. فقط برگ نهایی (سطر آخر) را انتخاب کنید.", Severity.Warning);
                else
                    Snackbar.Add("این حساب برای ثبت عملیات قابل انتخاب نیست.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا: {ex.Message}", Severity.Error);
        }
    }

    private void Confirm()
    {
        try
        {
            if (_selected is null) return;
            if (!CanConfirm)
            {
                if (_selected.NodeType == "BaseDetil" && _selected.ChildCount > 0)
                    Snackbar.Add($"این تفصیلی دارای زیرمجموعه است — فقط سطر آخر بدون فرزند قابل انتخاب است.", Severity.Warning);
                return;
            }
            var r = new AccountPickerResult
            {
                Id = _selected.NodeId,
                Code = _selected.Code,
                AccountCode = _selected.AccountCode,
                Title = _selected.Title,
                NodeType = _selected.NodeType,
                DetilEntityId = _selected.DetilEntityId,
                LinkId = _selected.LinkId,
                MoeinId = _selected.MoeinId
            };
            MudDialog.Close(DialogResult.Ok(r));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در تأیید انتخاب: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        try
        {
            if (_flat.Count == 0) return;
            var idx = _flat.FindIndex(x => NodeKey(x) == _highlightedNodeKey);
            if (idx < 0) idx = 0;
            switch (e.Key)
            {
                case "ArrowDown":
                    idx = Math.Min(idx + 1, _flat.Count - 1);
                    _highlightedNodeKey = NodeKey(_flat[idx]);
                    _selected = _flat[idx];
                    await BuildBreadcrumbAsync(_selected);
                    break;
                case "ArrowUp":
                    idx = Math.Max(idx - 1, 0);
                    _highlightedNodeKey = NodeKey(_flat[idx]);
                    _selected = _flat[idx];
                    await BuildBreadcrumbAsync(_selected);
                    break;
                case "ArrowRight":
                case "ArrowLeft":
                    break;
                case "Enter":
                    if (CanConfirm) Confirm();
                    else if (_selected is not null && _selected.ChildCount > 0)
                        await ShowChildrenAsync();
                    break;
                case "Escape":
                    Cancel();
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در پیمایش: {ex.Message}", Severity.Error);
        }
    }

    private async Task BuildBreadcrumbAsync(ChartTreeNode n)
    {
        try
        {
            var rows = (await Db.QueryAsync<ChartBreadcrumbRow>("accounting", "ChartNodeBreadcrumb", new
            {
                NodeId = n.NodeId,
                NodeType = n.NodeType,
                LinkId = n.LinkId
            })).ToList();
            _breadcrumbs = rows
                // در مسیر هم «کد حساب» (مسیر کامل تا آن سطح) نمایش داده می‌شود.
                .Select(r => new BreadcrumbItem($"{r.AccountCode} | {r.Title}", href: null))
                .ToList();
        }
        catch
        {
            _breadcrumbs = new();
        }
    }

    private static string TypeTitle(string t) => t switch
    {
        "BaseCol" => "حساب کل",
        "BaseMoein" => "حساب معین",
        "BaseDetil" => "تفصیلی",
        _ => t
    };

    private async Task Copy(string label, string value)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
            Snackbar.Add($"{label} کپی شد.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add("کپی ناموفق: " + ex.Message, Severity.Warning);
        }
    }

    private async Task OpenDetailHistoryAsync()
    {
        try
        {
            if (_selected is null)
            {
                Snackbar.Add("ابتدا یک حساب انتخاب کنید.", Severity.Warning);
                return;
            }
            if (string.IsNullOrWhiteSpace(_selected.AccountCode))
            {
                Snackbar.Add("کد حساب نامعتبر است.", Severity.Warning);
                return;
            }

            var parameters = new DialogParameters
            {
                ["AccountCode"] = _selected.AccountCode,
                ["AccountTitle"] = _selected.Title
            };
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseButton = true,
                CloseOnEscapeKey = true
            };

            var dialog = await DialogService.ShowAsync<DetailAccountHistoryDialog>("مرور تفصیلی", parameters, options);
            await dialog.Result;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در نمایش مرور تفصیلی: {ex.Message}", Severity.Error);
        }
    }

    private async Task ShowChildrenAsync()
    {
        try
        {
            if (_selected is null) return;
            if (_selected.ChildCount == 0)
            {
                Snackbar.Add("این حساب زیرمجموعه‌ای ندارد — همین سطر آخر قابل انتخاب است.", Severity.Info);
                return;
            }

            // فیلتر جستجو را به AccountCode والد تنظیم می‌کنیم تا فقط فرزندان دیده شوند
            _search = _selected.AccountCode;
            await RefreshAsync();
            Snackbar.Add($"زیرمجموعه‌های {_selected.Title} نمایش داده شد — فقط برگ نهایی بدون فرزند را انتخاب کنید.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در نمایش زیرمجموعه‌ها: {ex.Message}", Severity.Error);
        }
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}
