@* اسکلتون بارگذاری برای ردیف‌های StatCard داشبورد — همان گرید/ستون‌بندی کارت‌های
   واقعی را نشان می‌دهد تا layout هنگام آمدن داده نپرد.
   استفاده:  @if (_loading) { <StatCardSkeleton Count="5" /> } else { <MudGrid>...StatCard ها...</MudGrid> } *@
<MudGrid>
    @for (var i = 0; i < Count; i++)
    {
        <MudItem xs="@Xs" sm="@Sm" md="@Md">
            <MudPaper Elevation="0" Class="tz-stat">
                <div class="tz-stat__icon" aria-hidden="true">
                    <MudSkeleton Width="1.6rem" Height="1.6rem" />
                </div>
                <div class="tz-stat__body">
                    <MudSkeleton Width="45%" Height="0.8rem" Class="mb-1" />
                    <MudSkeleton Width="70%" Height="1.9rem" Class="tz-stat__value" />
                </div>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    /// <summary>تعداد کارت نمونه (معمولاً برابر تعداد StatCard واقعی داشبورد).</summary>
    [Parameter] public int Count { get; set; } = 4;

    /// <summary>ستون‌بندی — پیش‌فرض‌های StatCard: Xs=12, Sm=6, Md=3.</summary>
    [Parameter] public int Md { get; set; } = 3;
    [Parameter] public int Xs { get; set; } = 12;
    [Parameter] public int Sm { get; set; } = 6;
}
