@namespace Tarazin.Components

<MudPaper Class="tz-empty-state pa-6" Elevation="0" Outlined="true">
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1">
        <MudIcon Icon="@Icon" Color="Color.Secondary" Size="Size.Large" />
        <MudText Typo="Typo.subtitle1">@Title</MudText>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Description</MudText>
        }
        @if (ChildContent is not null)
        {
            <MudStack Row="true" Class="mt-2">
                @ChildContent
            </MudStack>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = "داده‌ای برای نمایش وجود ندارد.";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Inbox;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
