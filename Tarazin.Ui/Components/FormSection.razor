@namespace Tarazin.Components

<MudPaper Class="@(string.IsNullOrWhiteSpace(Class) ? "tz-form-section" : $"tz-form-section {Class}")" Elevation="1" Outlined="true">
    @if (!string.IsNullOrWhiteSpace(Title) || ChildHeader is not null)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="tz-form-section__header">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                @if (!string.IsNullOrWhiteSpace(Icon))
                {
                    <MudIcon Icon="@Icon" Color="Color.Primary" />
                }
                <MudText Typo="Typo.h6">@Title</MudText>
            </MudStack>
            @ChildHeader
        </MudStack>
    }
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="tz-form-section__description">@Description</MudText>
    }
    <div class="tz-form-section__content">
        @ChildContent
    </div>
</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? ChildHeader { get; set; }
}
