@page "/goldshop/dashboard"
@inject DbService Db
@inject ISnackbar Snackbar
@inject UserSession Session

<PageTitle>داشبورد — طلافروشی</PageTitle>

<PageHeader Title="نمای کلی طلافروشی" Subtitle="فروش روز و قیمت طلا." Eyebrow="طلافروشی" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <MudGrid>
        <StatCard Label="فروش امروز" Value="@_summary.TodaySales.ToString("N0")"
                  Icon="@Icons.Material.Filled.PointOfSale" Accent="@TarazinAccents.Brass" />
        <StatCard Label="مبلغ امروز" Value="@_summary.TodayAmount.ToString("N0")"
                  Icon="@Icons.Material.Filled.Payments" Accent="@TarazinAccents.Gold" />
        <StatCard Label="قیمت‌های ثبت‌شده" Value="@_summary.PriceCount.ToString("N0")"
                  Icon="@Icons.Material.Filled.ShowChart" Accent="@TarazinAccents.Ink" />
        <StatCard Label="قیمت طلای ۲۴" Value="@_summary.Gold24Price.ToString("N0")"
                  Icon="@Icons.Material.Filled.Diamond" Accent="@TarazinAccents.Wine" />
        <StatCard Label="چک‌های فاکتورها" Value="@_summary.PendingInvoiceCheques.ToString("N0")"
                  Icon="@Icons.Material.Filled.RequestQuote" Accent="@TarazinAccents.Steel"
                  Hint="مدیریت وصول/برگشت" Href="/treasury/cheques" />
    </MudGrid>
}

@code {
    private const string Schema = "goldshop";
    private bool _loading = true;
    private GoldShopDashboardRow _summary = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await Db.QueryFirstOrDefaultAsync<GoldShopDashboardRow>(Schema, "DashboardSummary", new { CompanyId = Session.ActiveCompanyId })
                       ?? new GoldShopDashboardRow();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
