@page "/goldshop/reports"
@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject PdfReportService Pdf
@inject PrintTemplateService Tpl

<PageTitle>گزارشات — طلافروشی</PageTitle>

<PageHeader Title="گزارشات طلافروشی" Subtitle="فروش روز (در بازهٔ تاریخ) و تاریخچهٔ قیمت طلا." Eyebrow="طلافروشی" />
<MudTabs>
    <MudTabPanel Text="فروش روز">
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker Label="از تاریخ" Culture="FaCulture" @bind-Date="_from" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker Label="تا تاریخ" Culture="FaCulture" @bind-Date="_to" />
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="LoadSalesAsync" Disabled="_loadingSales">
                        اجرا
                    </MudButton>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Print" OnClick="PrintSalesAsync"
                               Disabled="_loadingSales || _sales.Count == 0">
                        چاپ / PDF
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
        <MudPaper Elevation="1" Class="pa-4">
            <MudTable Items="_sales" Loading="_loadingSales" Hover="true" Dense="true" Striped="true"
                      Breakpoint="Breakpoint.Sm" RowsPerPage="25">
                <HeaderContent>
                    <MudTh>شماره</MudTh><MudTh>تاریخ</MudTh><MudTh>مشتری</MudTh><MudTh>کالا</MudTh>
                    <MudTh>وزن (گرم)</MudTh><MudTh>اجرت</MudTh><MudTh>سود</MudTh><MudTh>مالیات</MudTh><MudTh>جمع</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="شماره">@context.InvoiceNumber</MudTd>
                    <MudTd DataLabel="تاریخ">@context.InvoiceDate.ToString("yyyy/MM/dd")</MudTd>
                    <MudTd DataLabel="مشتری">@context.CustomerName</MudTd>
                    <MudTd DataLabel="کالا">@context.ItemCode — @context.ItemTitle</MudTd>
                    <MudTd DataLabel="وزن">@context.WeightGram.ToString("N3")</MudTd>
                    <MudTd DataLabel="اجرت">@context.Workmanship.ToString("N0")</MudTd>
                    <MudTd DataLabel="سود">@context.Profit.ToString("N0")</MudTd>
                    <MudTd DataLabel="مالیات">@context.Tax.ToString("N0")</MudTd>
                    <MudTd DataLabel="جمع">@context.TotalAmount.ToString("N0")</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">فاکتوری در این بازه نیست.</MudText></NoRecordsContent>
                <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 25, 50, 100 })" /></PagerContent>
            </MudTable>
            @if (_sales.Count > 0)
            {
                <MudText Typo="Typo.body2" Class="mt-4">
                    جمع فروش: <b>@_sales.Sum(s => s.TotalAmount).ToString("N0")</b>
                </MudText>
            }
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="تاریخچه قیمت طلا">
        <MudPaper Elevation="1" Class="pa-4">
            <PageToolbar Class="mb-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="PrintPricesAsync"
                           Disabled="_loadingPrices || _prices.Count == 0"
                           StartIcon="@Icons.Material.Filled.Print">چاپ / PDF</MudButton>
            </PageToolbar>
            <MudTable Items="_prices" Loading="_loadingPrices" Hover="true" Dense="true" Striped="true"
                      Breakpoint="Breakpoint.Sm" RowsPerPage="25">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>قیمت هر گرم</MudTh><MudTh>به‌روزرسانی</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.ItemCode</MudTd>
                    <MudTd DataLabel="عنوان">@context.Title</MudTd>
                    <MudTd DataLabel="قیمت هر گرم">@context.PricePerGram.ToString("N0")</MudTd>
                    <MudTd DataLabel="به‌روزرسانی">@context.UpdatedAt.ToString("yyyy/MM/dd HH:mm")</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">قیمتی ثبت نشده است.</MudText></NoRecordsContent>
                <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 25, 50, 100 })" /></PagerContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "goldshop";

    private List<DailySaleRow> _sales = new();
    private List<GoldPriceRow> _prices = new();
    private DateTime? _from;
    private DateTime? _to;
    private bool _loadingSales;
    private bool _loadingPrices;

    protected override async Task OnInitializedAsync()
    {
        _from = DateTime.Today.AddMonths(-1);
        _to = DateTime.Today;
        await LoadPricesAsync();
    }

    private async Task LoadSalesAsync()
    {
        _loadingSales = true;
        try
        {
            _sales = (await Db.QueryAsync<DailySaleRow>(Schema, "DailySales", new
            {
                FromDate = _from?.Date ?? DateTime.Today.AddMonths(-1),
                ToDate = _to?.Date ?? DateTime.Today,
                SearchText = "",
                SkipRows = 0,
                TakeSize = 200,
                CompanyId = Session.ActiveCompanyId
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loadingSales = false;
        }
    }

    private async Task LoadPricesAsync()
    {
        _loadingPrices = true;
        try
        {
            _prices = (await Db.QueryAsync<GoldPriceRow>(Schema, "GoldPriceSearch", new
            {
                SkipRows = 0,
                TakeSize = 200,
                CompanyId = Session.ActiveCompanyId
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loadingPrices = false;
        }
    }

    // ── چاپ / PDF (موتور چاپ عمومی — طبق اسکیل tarazin-reporting) ──

    private async Task PrintSalesAsync()
    {
        if (_sales.Count == 0) return;
        var tpl = await Tpl.GetOrCreateDefaultAsync("goldshop.sales");
        var data = new PrintDataModel
        {
            CompanyName = "ترازین — سامانه یکپارچه مدیریت کسب‌وکار",
            Title = "فروش روز طلا",
            Subtitle = "فاکتورهای فروش طلا و جواهرات در بازهٔ تاریخ",
            RangeText = $"از {_from:yyyy/MM/dd} تا {_to:yyyy/MM/dd}",
            QrEnabled = false
        };
        data.MetaFields.Add(new PrintMetaField { Label = "بازه", Value = $"از {_from:yyyy/MM/dd} تا {_to:yyyy/MM/dd}", Bold = true });
        data.MetaFields.Add(new PrintMetaField { Label = "تعداد فاکتور", Value = _sales.Count.ToString("N0"), Bold = true });
        data.MetaFields.Add(new PrintMetaField { Label = "جمع فروش", Value = _sales.Sum(s => s.TotalAmount).ToString("N0"), Bold = true });
        foreach (var r in _sales)
        {
            data.Rows.Add(new PrintRow
            {
                ["InvoiceNumber"] = r.InvoiceNumber,
                ["InvoiceDate"] = r.InvoiceDate.ToString("yyyy/MM/dd"),
                ["CustomerName"] = r.CustomerName,
                ["ItemCode"] = r.ItemCode,
                ["ItemTitle"] = r.ItemTitle,
                ["WeightGram"] = r.WeightGram,
                ["Workmanship"] = r.Workmanship,
                ["Profit"] = r.Profit,
                ["Tax"] = r.Tax,
                ["TotalAmount"] = r.TotalAmount
            });
        }
        await Dialog.ShowAsync<TemplatePrintDialog>("چاپ فروش روز",
            new DialogParameters<TemplatePrintDialog>
            {
                { x => x.Template, tpl }, { x => x.Data, data }, { x => x.TemplateId, "goldshop.sales" }
            },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
    }

    private async Task PrintPricesAsync()
    {
        if (_prices.Count == 0) return;
        var tpl = await Tpl.GetOrCreateDefaultAsync("goldshop.prices");
        var data = new PrintDataModel
        {
            CompanyName = "ترازین — سامانه یکپارچه مدیریت کسب‌وکار",
            Title = "تاریخچه قیمت طلا",
            Subtitle = "قیمت هر گرم اقلام طلا و جواهرات",
            RangeText = $"تهیه‌شده در {DateTime.Now:yyyy/MM/dd HH:mm}",
            QrEnabled = false
        };
        data.MetaFields.Add(new PrintMetaField { Label = "تاریخ تهیه", Value = DateTime.Now.ToString("yyyy/MM/dd HH:mm") });
        data.MetaFields.Add(new PrintMetaField { Label = "تعداد اقلام", Value = _prices.Count.ToString("N0"), Bold = true });
        foreach (var r in _prices)
        {
            data.Rows.Add(new PrintRow
            {
                ["ItemCode"] = r.ItemCode,
                ["Title"] = r.Title,
                ["PricePerGram"] = r.PricePerGram,
                ["UpdatedAt"] = r.UpdatedAt.ToString("yyyy/MM/dd HH:mm")
            });
        }
        await Dialog.ShowAsync<TemplatePrintDialog>("چاپ تاریخچه قیمت طلا",
            new DialogParameters<TemplatePrintDialog>
            {
                { x => x.Template, tpl }, { x => x.Data, data }, { x => x.TemplateId, "goldshop.prices" }
            },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
    }

    private RenderFragment SalesTableBody => @<MudTable Items="_sales" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" Class="gp-lines-table">
        <HeaderContent>
            <MudTh>شماره</MudTh><MudTh>تاریخ</MudTh><MudTh>مشتری</MudTh><MudTh>کالا</MudTh>
            <MudTh>وزن (گرم)</MudTh><MudTh>اجرت</MudTh><MudTh>سود</MudTh><MudTh>مالیات</MudTh><MudTh>جمع</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="شماره">@context.InvoiceNumber</MudTd>
            <MudTd DataLabel="تاریخ">@context.InvoiceDate.ToString("yyyy/MM/dd")</MudTd>
            <MudTd DataLabel="مشتری">@context.CustomerName</MudTd>
            <MudTd DataLabel="کالا">@context.ItemCode — @context.ItemTitle</MudTd>
            <MudTd DataLabel="وزن">@context.WeightGram.ToString("N3")</MudTd>
            <MudTd DataLabel="اجرت">@context.Workmanship.ToString("N0")</MudTd>
            <MudTd DataLabel="سود">@context.Profit.ToString("N0")</MudTd>
            <MudTd DataLabel="مالیات">@context.Tax.ToString("N0")</MudTd>
            <MudTd DataLabel="جمع">@context.TotalAmount.ToString("N0")</MudTd>
        </RowTemplate>
    </MudTable>;

    private RenderFragment PricesTableBody => @<MudTable Items="_prices" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" Class="gp-lines-table">
        <HeaderContent>
            <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>قیمت هر گرم</MudTh><MudTh>به‌روزرسانی</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="کد">@context.ItemCode</MudTd>
            <MudTd DataLabel="عنوان">@context.Title</MudTd>
            <MudTd DataLabel="قیمت هر گرم">@context.PricePerGram.ToString("N0")</MudTd>
            <MudTd DataLabel="به‌روزرسانی">@context.UpdatedAt.ToString("yyyy/MM/dd HH:mm")</MudTd>
        </RowTemplate>
    </MudTable>;

    private byte[] BuildSalesPdf(string paperSize)
    {
        var columns = new List<TableReportColumn>
        {
            new() { Header = "شماره" },
            new() { Header = "تاریخ" },
            new() { Header = "مشتری" },
            new() { Header = "کالا" },
            new() { Header = "وزن (گرم)", AlignRight = true },
            new() { Header = "اجرت", AlignRight = true },
            new() { Header = "سود", AlignRight = true },
            new() { Header = "مالیات", AlignRight = true },
            new() { Header = "جمع", AlignRight = true }
        };
        var rows = _sales.Select(r => (IReadOnlyList<string>)new string[]
        {
            r.InvoiceNumber,
            r.InvoiceDate.ToString("yyyy/MM/dd"),
            r.CustomerName,
            $"{r.ItemCode} — {r.ItemTitle}",
            r.WeightGram.ToString("N3"),
            r.Workmanship.ToString("N0"),
            r.Profit.ToString("N0"),
            r.Tax.ToString("N0"),
            r.TotalAmount.ToString("N0")
        }).ToList();

        return Pdf.BuildTablePdf("فروش روز طلا", "فاکتورهای فروش طلا و جواهرات در بازهٔ تاریخ",
            $"از {_from:yyyy/MM/dd} تا {_to:yyyy/MM/dd}", columns, rows,
            new[] { $"جمع فروش: {_sales.Sum(s => s.TotalAmount):N0} ریال" }, paperSize);
    }

    private byte[] BuildPricesPdf(string paperSize)
    {
        var columns = new List<TableReportColumn>
        {
            new() { Header = "کد" },
            new() { Header = "عنوان" },
            new() { Header = "قیمت هر گرم", AlignRight = true },
            new() { Header = "به‌روزرسانی" }
        };
        var rows = _prices.Select(r => (IReadOnlyList<string>)new string[]
        {
            r.ItemCode,
            r.Title,
            r.PricePerGram.ToString("N0"),
            r.UpdatedAt.ToString("yyyy/MM/dd HH:mm")
        }).ToList();

        return Pdf.BuildTablePdf("تاریخچه قیمت طلا", "قیمت هر گرم اقلام طلا و جواهرات",
            $"تهیه شده در {DateTime.Now:yyyy/MM/dd HH:mm}", columns, rows, null, paperSize);
    }
}
