@page "/goldshop"
@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

<PageTitle>فروش روز — طلافروشی</PageTitle>

<PageHeader Title="فروش روز" Subtitle="فاکتورهای فروش طلا — از تاریخ / تا تاریخ." />

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="از تاریخ" Culture="FaCulture" @bind-Date="_from" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="تا تاریخ" Culture="FaCulture" @bind-Date="_to" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Label="جستجو (شماره فاکتور یا مشتری)" @bind-Value="_search" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync" Disabled="_loading">
                اعمال فیلتر
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="1" Class="pa-4">
    <MudTable Items="_rows" Loading="_loading" Hover="true" Dense="true" Striped="true"
              RowsPerPage="_pageSize" RowsPerPageChanged="v => _pageSize = v"
              CurrentPage="_page" CurrentPageChanged="v => _page = v">
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10,25,50,100}" />
        </PagerContent>
        <HeaderContent>
            <MudTh>شماره</MudTh><MudTh>تاریخ</MudTh><MudTh>مشتری</MudTh><MudTh>کالا</MudTh>
            <MudTh>وزن (گرم)</MudTh><MudTh>اجرت</MudTh><MudTh>سود</MudTh><MudTh>مالیات</MudTh><MudTh>جمع</MudTh><MudTh>وضعیت</MudTh><MudTh>منبع</MudTh><MudTh>عملیات</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="شماره">
                <MudLink Href="#" Style="cursor:pointer" OnClick="() => OpenDetailAsync(context)">@context.InvoiceNumber</MudLink>
            </MudTd>
            <MudTd DataLabel="تاریخ">@context.InvoiceDate.ToString("yyyy/MM/dd")</MudTd>
            <MudTd DataLabel="مشتری">@context.CustomerName</MudTd>
            <MudTd DataLabel="کالا">@context.ItemCode — @context.ItemTitle</MudTd>
            <MudTd DataLabel="وزن">@context.WeightGram.ToString("N3")</MudTd>
            <MudTd DataLabel="اجرت">@TzNumericText.Format(context.Workmanship)</MudTd>
            <MudTd DataLabel="سود">@TzNumericText.Format(context.Profit)</MudTd>
            <MudTd DataLabel="مالیات">@TzNumericText.Format(context.Tax)</MudTd>
            <MudTd DataLabel="جمع">@TzNumericText.Format(context.TotalAmount)</MudTd>
            <MudTd DataLabel="وضعیت">
                @if (context.Status == "Final")
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">نهایی</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">پیش‌نویس</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="منبع">
                <MudButton Variant="Variant.Text" Color="Color.Info" Size="Size.Small"
                           Class="px-1" Style="text-transform:none;white-space:nowrap"
                           OnClick="@(() => ShowSourceAsync(context))"
                           StartIcon="@Icons.Material.Filled.FolderOpen">
                    @SourceReferenceLabel(context)
                </MudButton>
            </MudTd>
            <MudTd DataLabel="عملیات">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary" OnClick="() => OpenDetailAsync(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Secondary" OnClick="() => EditInvoiceAsync(context)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><EmptyState Title="فاکتوری در این بازه ثبت نشده است." /></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "goldshop";

    private List<DailySaleRow> _rows = new();
    private bool _loading = true;
    private string _search = "";
    private DateTime? _from;
    private DateTime? _to;
    private int _page;
    private int _pageSize = 25;

    protected override async Task OnInitializedAsync()
    {
        _from = DateTime.Today.AddDays(-30);
        _to = DateTime.Today;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _rows = (await Db.QueryAsync<DailySaleRow>(Schema, "DailySales", new
            {
                FromDate = _from?.Date ?? DateTime.Today.AddDays(-30),
                ToDate = _to?.Date ?? DateTime.Today,
                SearchText = _search ?? "",
                SkipRows = _page * _pageSize,
                TakeSize = _pageSize,
                CompanyId = Session.ActiveCompanyId
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenDetailAsync(DailySaleRow row)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var parameters = new DialogParameters<GoldInvoiceDetailDialog>
        {
            { x => x.InvoiceId, row.InvoiceId },
            { x => x.InvoiceNumber, row.InvoiceNumber },
            { x => x.InvoiceDate, row.InvoiceDate },
            { x => x.CustomerName, row.CustomerName },
            { x => x.ItemCode, row.ItemCode },
            { x => x.ItemTitle, row.ItemTitle },
            { x => x.WeightGram, row.WeightGram },
            { x => x.Workmanship, row.Workmanship },
            { x => x.Profit, row.Profit },
            { x => x.Tax, row.Tax },
            { x => x.TotalAmount, row.TotalAmount },
            { x => x.Status, row.Status }
        };
        await DialogService.ShowAsync<GoldInvoiceDetailDialog>("جزئیات فاکتور", parameters, options);
    }

    private void EditInvoiceAsync(DailySaleRow row)
        => Nav.NavigateTo($"/goldshop/entry?edit={row.InvoiceId}");

    /// <summary>SourceReference یک فاکتور فروش — برای تعمیم «نمایش منبع قابل‌کلیک» از چک‌های خزانه.</summary>
    private static string SourceReferenceOf(DailySaleRow row)
        => $"GoldInvoice:{row.InvoiceId}";

    private static string SourceReferenceLabel(DailySaleRow row)
        => Tarazin.Models.TreasurySourceLabels.For(SourceReferenceOf(row));

    /// <summary>بازکردن «جزئیات منبع» فاکتور — وضوح سابقهٔ پشتنویس و سند حسابداری لینک‌شده (همان الگوی چک‌های خزانه).</summary>
    private async Task ShowSourceAsync(DailySaleRow row)
    {
        var parameters = new DialogParameters<Tarazin.Modules.Treasury.Components.SourceDetailDialog>
        {
            { x => x.SourceReference, SourceReferenceOf(row) }
        };
        var dlg = await DialogService.ShowAsync<Tarazin.Modules.Treasury.Components.SourceDetailDialog>("جزئیات منبع", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
        await dlg.Result;
    }
}
