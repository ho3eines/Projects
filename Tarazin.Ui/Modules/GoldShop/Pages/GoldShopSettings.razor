@page "/goldshop/settings"
@inject DbService Db
@inject UserSession Session
@inject EntityCrudService EntityCrud
@inject IDialogService Dialog
@inject ISnackbar Snackbar

<PageTitle>امکانات — طلافروشی</PageTitle>

<PageHeader Title="امکانات و اتصال حسابداری" Subtitle="اجناس، قیمت‌ها، انبار طلافروشی و گروه‌های تفصیلی مشتری/تأمین‌کننده.">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => OpenEditorAsync(EntityEditorModel.FromGoldItem()))">
        جنس جدید
    </MudButton>
</PageHeader>

<MudPaper Elevation="1" Class="pa-4">
    <MudTable Items="_items" Hover="true" Dense="true" Striped="true" Loading="_loading">
        <HeaderContent>
            <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>عیار</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="کد">@context.ItemCode</MudTd>
            <MudTd DataLabel="عنوان">@context.Title</MudTd>
            <MudTd DataLabel="عیار">@(context.Purity?.ToString("N2") ?? "—")</MudTd>
            <MudTd DataLabel="وضعیت">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "فعال" : "غیرفعال")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="عملیات">
                <MudTooltip Text="ویرایش جنس">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                   OnClick="@(() => OpenEditorAsync(EntityEditorModel.FromGoldItem(context)))" />
                </MudTooltip>
                <MudTooltip Text="حذف">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => DeleteAsync(EntityEditorModel.FromGoldItem(context)))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Color="Color.Secondary">جنسی تعریف نشده است.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

<MudPaper Class="pa-4 mt-4">
    <MudText Typo="Typo.h6">یکپارچه‌سازی طلافروشی</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">انبار و حساب‌های مشتری/تأمین‌کننده را در تنظیمات شرکت فعال انتخاب کنید.</MudText>
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        برای جلوگیری از ثبت اشتباه، ثبت فاکتور تنها با مشتری معتبر و شرکت فعال انجام می‌شود. موجودی طلا باید از کالاهای ماژول انبار تغذیه شود و ثبت پرداخت از خزانه‌داری انجام می‌گیرد.
    </MudAlert>
    <MudButton Class="mt-3" Variant="Variant.Outlined" Color="Color.Primary" Href="/goldshop/settings/integration" StartIcon="@Icons.Material.Filled.Link">تنظیم اتصال‌ها</MudButton>
</MudPaper>

@code {
    private const string Schema = "goldshop";
    private List<GoldItemRow> _items = new();
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = (await Db.QueryAsync<GoldItemRow>(Schema, "GoldItemList", new { CompanyId = Session.ActiveCompanyId })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenEditorAsync(EntityEditorModel model)
    {
        if (await EntityCrud.ShowEditorAsync(model))
            await LoadAsync();
    }

    private async Task DeleteAsync(EntityEditorModel model)
    {
        if (await EntityCrud.ConfirmDeleteAsync(model))
            await LoadAsync();
    }
}
