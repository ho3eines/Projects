    private async Task SaveAsync()
    {
        if (_busy) return;
        if (_partyId == 0) { Snackbar.Add("طرف حساب را انتخاب کنید.", Severity.Warning); return; }
        if (_lines.Count == 0) { Snackbar.Add("حداقل یک ردیف فاکتور لازم است.", Severity.Warning); return; }
        foreach (var l in _lines)
        {
            if (l.Qty <= 0) { Snackbar.Add("مقدار همهٔ ردیف‌ها باید بیشتر از صفر باشد.", Severity.Warning); return; }
            if (l.RowType == "Gold" && (l.GoldItemId == 0 || l.Price <= 0)) { Snackbar.Add("جنس و قیمت ردیف طلا معتبر نیست.", Severity.Warning); return; }
            if (l.RowType == "Currency" && (string.IsNullOrEmpty(l.CurrencyCode) || l.Rate <= 0)) { Snackbar.Add("ارز و نرخ ردیف ارز معتبر نیست.", Severity.Warning); return; }
        }
        if (Remainder < -0.5m) { Snackbar.Add("مبلغ تسویه (نقدی+بانک+چک+ارز+طلا) از کل فاکتور بیشتر است.", Severity.Error); return; }
        if (_payGoldGram > 0 && GoldPrice <= 0) { Snackbar.Add("تسویه با طلا نیاز به حداقل یک ردیف طلا دارد.", Severity.Warning); return; }
        if (_payCurrencyQty > 0 && (string.IsNullOrEmpty(_payCurrencyCode) || _payCurrencyRate <= 0)) { Snackbar.Add("ارز و نرخ پرداخت معتبر نیست.", Severity.Warning); return; }
        if (_payChequeAmount > 0 && (string.IsNullOrEmpty(_payChequeNumber) || _payChequeBankId <= 0)) { Snackbar.Add("شماره چک و بانک الزامی است.", Severity.Warning); return; }

        _busy = true;
        try
        {
            var linesJson = JsonSerializer.Serialize(_lines.Select(l => new
            {
                RowType = l.RowType,
                ItemCode = l.RowType == "Gold" ? l.ItemCode : (string?)null,
                Title = string.IsNullOrWhiteSpace(l.Title) ? (l.RowType == "Gold" ? l.ItemCode : l.CurrencyCode) : l.Title,
                Qty = l.Qty,
                Price = l.RowType == "Gold" ? l.Price : 0,
                Workmanship = l.Workmanship,
                Profit = l.Profit,
                TaxEnabled = l.TaxEnabled,
                CurrencyCode = l.RowType == "Currency" ? l.CurrencyCode : (string?)null,
                Rate = l.RowType == "Currency" ? l.Rate : 0
            }));
            var script = _mode == "Sale" ? "GoldInvoiceCreate" : "GoldPurchaseCreate";
            var parameters = new
            {
                LinesJson = linesJson,
                PartyId = _partyId,
                InvoiceDate = _date?.Date ?? DateTime.Today,
                CreatedBy = Session.UserName,
                CompanyId = Session.ActiveCompanyId,
                FiscalYearId = Session.ActiveFiscalYearId,
                PayCash = _payCash,
                PayBank = _payBank,
                PayCurrencyCode = string.IsNullOrEmpty(_payCurrencyCode) ? null : _payCurrencyCode,
                PayCurrencyQty = _payCurrencyQty,
                PayCurrencyRate = _payCurrencyRate,
                PayGoldGram = _payGoldGram,
                ChequeNumber = string.IsNullOrEmpty(_payChequeNumber) ? null : _payChequeNumber,
                ChequeBankId = _payChequeBankId > 0 ? _payChequeBankId : (int?)null,
                ChequeAmount = _payChequeAmount,
                ChequeDueDate = _payChequeDueDate?.Date,
                CreditType = _creditType
            };
            InvoiceResultRow? result;
            if (_editId > 0)
            {
                // ویرایش: اول برگرداندن کامل فاکتور قبلی و عوارض آن، بعد ثبت مجدد
                await Db.ExecuteAsync(Schema, "GoldInvoiceReverse", new
                {
                    InvoiceId = _editId,
                    CompanyId = Session.ActiveCompanyId
                });
                result = await Db.ExecuteReturningAsync<InvoiceResultRow>(Schema, script, parameters);
                Snackbar.Add($"فاکتور {result?.InvoiceNumber} ویرایش و ثبت شد. کل: {result?.TotalAmount:N0} — نسیه: {result?.BalanceRial:N0} — سند: {result?.DocumentId}", Severity.Success);
                Nav.NavigateTo("/goldshop");
            }
            else
            {
                result = await Db.ExecuteReturningAsync<InvoiceResultRow>(Schema, script, parameters);
                Snackbar.Add($"{(_mode == "Sale" ? "فاکتور فروش" : "فاکتور خرید")} {result?.InvoiceNumber} ثبت شد. کل: {result?.TotalAmount:N0} — نسیه: {result?.BalanceRial:N0} — سند: {result?.DocumentId}", Severity.Success);
                _lines.Clear();
                AddLine();
                _partyId = 0; _payCash = 0; _payBank = 0; _payCurrencyCode = ""; _payCurrencyQty = 0; _payCurrencyRate = 0; _payGoldGram = 0; _payChequeNumber = ""; _payChequeBankId = 0; _payChequeAmount = 0; _payChequeDueDate = null; _creditType = "Rial";
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

