@page "/accounting"
@inject DbService Db
@inject UserSession Session
@inject AccountingContextService Context
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject PrintTemplateService Tpl

<PageTitle>اسناد — حسابداری</PageTitle>

<PageHeader Title="اسناد" Subtitle="از تاریخ تا تاریخ — پیش‌فرض بازهٔ سال مالی فعال. کلیک روی ردیف، سند را باز می‌کند." Eyebrow="حسابداری">
    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="PrintListAsync" Disabled="_loading || _rows.Count == 0"
               StartIcon="@Icons.Material.Filled.Print">
        چاپ فهرست
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="RenumberAsync" Disabled="_loading"
               StartIcon="@Icons.Material.Filled.Numbers">
        شماره‌گذاری مجدد اسناد
    </MudButton>
</PageHeader>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="از تاریخ" Culture="FaCulture" @bind-Date="_from" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="تا تاریخ" Culture="FaCulture" @bind-Date="_to" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Label="جستجو (شماره یا طرف حساب)" @bind-Value="_search" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync" Disabled="_loading">
                اعمال فیلتر
            </MudButton>
        </MudItem>
        <MudItem xs="12">
            <div class="d-flex align-center flex-wrap gap-2">
                <MudTooltip Text="بازهٔ پیش‌فرض = کل سال مالی فعال">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                             Icon="@Icons.Material.Filled.CalendarMonth" Style="cursor:pointer"
                             OnClick="ResetToActiveFiscalYearAsync" Disabled="_loading">
                        بازهٔ سال مالی
                    </MudChip>
                </MudTooltip>
                @if (_from is not null && _to is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        بازهٔ فعلی: <span class="tz-num">@PersianDate.ToPersian(_from.Value)</span> تا
                        <span class="tz-num">@PersianDate.ToPersian(_to.Value)</span>
                    </MudText>
                }
            </div>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="1" Class="pa-4">
    <MudTable T="DailyDocumentRow" Items="_rows" Loading="_loading" Hover="true" Dense="true" Striped="true"
              RowsPerPage="25" OnRowClick="TableRowClick">
        <HeaderContent>
            <MudTh>شماره</MudTh>
            <MudTh>تاریخ</MudTh>
            <MudTh>نوع</MudTh>
            <MudTh>طرف حساب</MudTh>
            <MudTh>مبلغ</MudTh>
            <MudTh>وضعیت</MudTh>
            <MudTh style="width:110px">عملیات</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="شماره">@context.DocumentNumber</MudTd>
            <MudTd DataLabel="تاریخ">@context.DocumentDate.ToString("yyyy/MM/dd")</MudTd>
            <MudTd DataLabel="نوع">@context.DocumentType</MudTd>
            <MudTd DataLabel="طرف حساب">@context.CounterPartyName</MudTd>
            <MudTd DataLabel="مبلغ">@context.TotalAmount.ToString("N0")</MudTd>
            <MudTd DataLabel="وضعیت">
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">
                    @AccountingDocumentStatus.Title(context.Status)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="عملیات">
                @* دکمه‌ها بر اساس دسترسی کاربر + وضعیت سند فعال/غیرفعال می‌شوند.
                   stopPropagation لازم است: بدون آن کلیک روی «حذف» علاوه بر باز
                   کردن دیالوگ، OnRowClick را هم اجرا و صفحه را عوض می‌کرد. *@
                <span @onclick:stopPropagation="true">
                    <MudTooltip Text="@(CanEdit(context) ? "ویرایش سند" : "نمایش سند (فقط خواندنی)")">
                        <MudIconButton Icon="@(CanEdit(context) ? Icons.Material.Filled.Edit : Icons.Material.Filled.Visibility)"
                                       Color="Color.Info" Size="Size.Small"
                                       OnClick="@(() => OpenDocument(context))" />
                    </MudTooltip>
                    <MudTooltip Text="حذف سند">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                       Disabled="@(!CanDelete(context))"
                                       OnClick="@(() => DeleteAsync(context))" />
                    </MudTooltip>
                </span>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Color="Color.Secondary">سندی در این بازه نیست.</MudText>
        </NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 25, 50, 100 })" /></PagerContent>
    </MudTable>
</MudPaper>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "accounting";

    private List<DailyDocumentRow> _rows = new();

    /// <summary>چاپ فهرست اسناد با موتور چاپ عمومی (قالب accounting.documents).</summary>
    private async Task PrintListAsync()
    {
        if (_rows.Count == 0) return;

        var tpl = await Tpl.GetOrCreateDefaultAsync("accounting.documents");
        var data = new PrintDataModel
        {
            CompanyName = "ترازین — سامانه یکپارچه مدیریت کسب‌وکار",
            Title = "فهرست اسناد حسابداری",
            RangeText = $"از {_from:yyyy/MM/dd} تا {_to:yyyy/MM/dd} — تعداد {_rows.Count:N0} سند",
            QrEnabled = false
        };
        data.MetaFields.Add(new PrintMetaField { Label = "تعداد اسناد", Value = _rows.Count.ToString("N0"), Bold = true });
        data.MetaFields.Add(new PrintMetaField { Label = "جمع کل", Value = _rows.Sum(r => r.TotalAmount).ToString("N0"), Bold = true });
        data.MetaFields.Add(new PrintMetaField { Label = "وضعیت", Value = _search, Bold = false });

        foreach (var r in _rows)
        {
            data.Rows.Add(new PrintRow
            {
                ["DocumentNumber"] = r.DocumentNumber,
                ["DocumentDate"] = r.DocumentDate.ToString("yyyy/MM/dd"),
                ["DocumentType"] = r.DocumentType,
                ["CounterPartyName"] = string.IsNullOrWhiteSpace(r.CounterPartyName) ? "—" : r.CounterPartyName,
                ["StatusTitle"] = AccountingDocumentStatus.Title(r.Status),
                ["TotalAmount"] = r.TotalAmount
            });
        }

        await DialogService.ShowAsync<TemplatePrintDialog>("چاپ فهرست اسناد",
            new DialogParameters<TemplatePrintDialog>
            {
                { x => x.Template, tpl },
                { x => x.Data, data },
                { x => x.TemplateId, "accounting.documents" }
            },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
    }
    private bool _loading = true;
    private string _search = "";
    private DateTime? _from;
    private DateTime? _to;

    protected override async Task OnInitializedAsync()
    {
        // پیش‌فرض بازه = کل بازهٔ سال مالی فعال (نه فقط امروز).
        var fy = await Context.GetActiveFiscalYearAsync();
        _from = fy?.StartDate ?? DateTime.Today;
        _to = fy?.EndDate ?? DateTime.Today;
        await LoadAsync();
    }

    /// <summary>بازگشت بازهٔ تاریخ به پیش‌فرض (کل سال مالی فعال) و بارگذاری مجدد — یک کلیک.</summary>
    private async Task ResetToActiveFiscalYearAsync()
    {
        var fy = await Context.GetActiveFiscalYearAsync();
        _from = fy?.StartDate ?? DateTime.Today;
        _to = fy?.EndDate ?? DateTime.Today;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var from = _from?.Date ?? DateTime.Today;
            var to = _to?.Date ?? DateTime.Today;
            _rows = (await Db.QueryAsync<DailyDocumentRow>(Schema, "DailyDocuments", new
            {
                FromDate = from,
                ToDate = to,
                SearchText = _search ?? "",
                DocumentType = (string?)null,
                SkipRows = 0,
                TakeSize = 100,
                CompanyId = Session.ActiveCompanyId,
                FiscalYearId = Session.ActiveFiscalYearId
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>شماره‌گذاری مجدد قطعی اسناد بر اساس تاریخ (سریال ۸رقمی ترتیبی).</summary>
    private async Task RenumberAsync()
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "شماره‌گذاری مجدد اسناد",
            "همهٔ اسناد این شرکت (سال مالی فعال) به‌ترتیب تاریخ، شمارهٔ قطعی ۸رقمی می‌گیرند. ادامه می‌دهید؟",
            yesText: "شماره‌گذاری مجدد", cancelText: "انصراف");
        if (confirm is not true) return;

        try
        {
            var count = await Db.QueryFirstOrDefaultAsync<int>(Schema, "DocumentRenumber", new
            {
                CompanyId = Session.ActiveCompanyId,
                FiscalYearId = Session.ActiveFiscalYearId,
                CreatedBy = Session.UserName
            });
            Snackbar.Add($"{count} سند شماره‌گذاری مجدد شد.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void TableRowClick(TableRowClickEventArgs<DailyDocumentRow> e)
    {
        if (e.Item is not null)
            OpenDocument(e.Item);
    }

    /// <summary>باز کردن سند — صفحهٔ سند خودش حالت ویرایش/فقط‌خواندنی را تشخیص می‌دهد.</summary>
    private void OpenDocument(DailyDocumentRow row) =>
        Nav.NavigateTo($"/accounting/document/{row.DocumentId}");

    // شرط ویرایش = دسترسی کاربر + وضعیت سند (هر دو لازم‌اند).
    private bool CanEdit(DailyDocumentRow row) =>
        Session.HasPermission(TarazinPermissions.DocumentEdit)
        && AccountingDocumentStatus.IsEditable(row.Status);

    private bool CanDelete(DailyDocumentRow row) =>
        Session.HasPermission(TarazinPermissions.DocumentDelete)
        && AccountingDocumentStatus.IsEditable(row.Status);

    private async Task DeleteAsync(DailyDocumentRow row)
    {
        // بررسی مجدد دسترسی در زمان اجرا — نه فقط با غیرفعال کردن دکمه.
        if (!CanDelete(row))
        {
            Snackbar.Add("امکان حذف این سند وجود ندارد (دسترسی یا وضعیت سند).", Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBoxAsync(
            "تأیید حذف سند",
            $"آیا از حذف سند «{row.DocumentNumber}» مطمئن هستید؟ این عملیات قابل بازگشت نیست.",
            yesText: "حذف سند", cancelText: "انصراف");

        // انصراف = هیچ تغییری در سند ایجاد نمی‌شود.
        if (confirm is not true) return;

        try
        {
            await Db.ExecuteAsync(Schema, "DocumentDelete", new
            {
                DocumentId = row.DocumentId,
                UpdatedBy = Session.UserName,
                CompanyId = Session.ActiveCompanyId,
                FiscalYearId = Session.ActiveFiscalYearId
            });
            Snackbar.Add("سند حذف شد.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static Color StatusColor(string? status) => AccountingDocumentStatus.Normalize(status) switch
    {
        AccountingDocumentStatus.Finalized => Color.Success,
        AccountingDocumentStatus.Confirmed => Color.Info,
        AccountingDocumentStatus.Draft => Color.Warning,
        _ => Color.Default
    };
}
