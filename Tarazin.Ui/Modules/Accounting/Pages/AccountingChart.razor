    private async Task DeleteAsync()
    {
        if (_selected is null) return;
        string label = _selected.NodeType switch
        {
            "BaseCol" => "حساب کل",
            "BaseMoein" => "حساب معین",
            "BaseDetil" => "تفصیلی",
            _ => "حساب"
        };
        var isLastPath = _selected.NodeType == "BaseDetil" && _usagePaths.Count <= 1;
        var question = _selected.NodeType == "BaseDetil"
            ? (isLastPath
                ? $"تفصیلی «{_selected.Title}» فقط در همین مسیر استفاده شده است؛ حذف شود؟"
                : $"تفصیلی «{_selected.Title}» در {_usagePaths.Count} مسیر استفاده شده است. فقط پیوندِ همین مسیر حذف شود؟")
            : $"آیا از حذف {label} «{_selected.Title}» مطمئن هستید؟ اگر دارای فرزند یا گردش باشد، حذف مستقیم ممنوع است.";

        var confirm = await Dialog.ShowMessageBoxAsync(
            "تأیید حذف", question, yesText: "حذف", cancelText: "انصراف");
        if (confirm is not true) return;

        try
        {
            if (_selected.NodeType == "BaseCol")
            {
                await Db.ExecuteAsync(Schema, "BaseColDelete", new { ColId = _selected.NodeId });
            }
            else if (_selected.NodeType == "BaseMoein")
            {
                await Db.ExecuteAsync(Schema, "BaseMoeinDelete", new { MoeinId = _selected.NodeId });
            }
            else if (_selected.NodeType == "BaseDetil" && _selected.DetilEntityId.HasValue)
            {
                await Db.ExecuteAsync(Schema, "BaseDetilLinkDelete", new
                {
                    LinkId = _selected.LinkId ?? 0,
                    DetilId = _selected.DetilEntityId.Value,
                    MoeinId = _selected.MoeinId ?? 0
                });

                if (isLastPath)
                {
                    try
                    {
                        await Db.ExecuteAsync(Schema, "BaseDetilDelete", new { DetilId = _selected.DetilEntityId.Value });
                    }
                    catch { }
                }
            }
            Snackbar.Add($"{label} حذف شد.", Severity.Success);
            _selected = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            if (ex.Message.Contains("گردش"))
            {
                var disable = await Dialog.ShowMessageBoxAsync(
                    "غیرفعال‌سازی",
                    "این حساب به‌دلیل داشتن گردش مالی امکان حذف مستقیم ندارد. آیا مایلید غیرفعال شود؟",
                    yesText: "بله، غیرفعال شود", cancelText: "انصراف");
                if (disable is true) await DeactivateAsync();
            }
        }
    }

    private async Task DeactivateAsync()
    {
        if (_selected is null) return;
        try
        {
            if (_selected.NodeType == "BaseCol")
            {
                await Db.ExecuteAsync(Schema, "BaseColUpsert", new
                {
                    ColId = _selected.NodeId,
                    ColCode = _selected.Code,
                    Title = _selected.Title,
                    Description = (string?)null,
                    AccountGroupId = _selected.AccountGroupId,
                    AccountNature = _selected.AccountNature,
                    IsActive = false,
                    CreatedBy = Session.UserName,
                    UpdatedBy = Session.UserName,
                    CompanyId = Session.ActiveCompanyId
                });
            }
            else if (_selected.NodeType == "BaseMoein")
            {
                int colId = _selected.ParentId ?? 0;
                await Db.ExecuteAsync(Schema, "BaseMoeinUpsert", new
                {
                    MoeinId = _selected.NodeId,
                    ColId = colId,
                    MoeinCode = _selected.Code,
                    Title = _selected.Title,
                    Description = (string?)null,
                    AccountGroupId = _selected.AccountGroupId,
                    AccountNature = _selected.AccountNature,
                    IsActive = false,
                    CreatedBy = Session.UserName,
                    UpdatedBy = Session.UserName,
                    CompanyId = Session.ActiveCompanyId
                });
            }
            else if (_selected.NodeType == "BaseDetil" && _selected.DetilEntityId.HasValue)
            {
                await Db.ExecuteAsync(Schema, "BaseDetilUpsert", new
                {
                    DetilId = _selected.DetilEntityId.Value,
                    DetilCode = _selected.Code,
                    Title = _selected.Title,
                    Description = (string?)null,
                    AccountGroupId = _selected.AccountGroupId,
                    AccountNature = _selected.AccountNature,
                    IsActive = false,
                    CreatedBy = Session.UserName,
                    UpdatedBy = Session.UserName,
                    CompanyId = Session.ActiveCompanyId
                });
            }
            Snackbar.Add("حساب غیرفعال شد.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

