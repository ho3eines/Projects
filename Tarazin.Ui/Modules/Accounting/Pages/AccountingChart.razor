    private void OnFilterChanged() => ApplyFilter();

    private readonly HashSet<(string Type, int Id)> _expanded = new();

    private static (string, int) KeyOf(ChartTreeNode n) =>
        (n.NodeType, n.NodeType == "BaseDetil" ? n.LinkId ?? n.NodeId : n.NodeId);

    private bool IsExpanded(ChartTreeNode n) =>
        _expanded.Contains(KeyOf(n)) || !string.IsNullOrEmpty(_search);

    private void Toggle(ChartTreeNode n)
    {
        var k = KeyOf(n);
        if (!_expanded.Remove(k)) _expanded.Add(k);
    }

    private void ExpandAll()
    {
        foreach (var n in _all) _expanded.Add(KeyOf(n));
    }

    private void CollapseAll() => _expanded.Clear();

    private async Task SelectNode(ChartTreeNode n)
    {
        _selected = n;
        await BuildSelectedBreadcrumbAsync();
        if (n.NodeType == "BaseDetil" && n.DetilEntityId.HasValue)
        {
            try
            {
                _usagePaths = (await Db.QueryAsync<BaseDetilUsagePath>(Schema, "BaseDetilUsagePaths", new
                {
                    DetilId = n.DetilEntityId.Value, CompanyId = Session.ActiveCompanyId
                })).ToList();
            }
            catch
            {
                _usagePaths = new();
            }
        }
        else
        {
            _usagePaths = new();
        }
    }

    private async Task BuildSelectedBreadcrumbAsync()
    {
        if (_selected is null) { _selectedBreadcrumb = new(); return; }
        try
        {
            var rows = (await Db.QueryAsync<ChartBreadcrumbRow>(Schema, "ChartNodeBreadcrumb", new
            {
                NodeId = _selected.NodeId,
                NodeType = _selected.NodeType,
                LinkId = _selected.LinkId, CompanyId = Session.ActiveCompanyId
            })).ToList();
            _selectedBreadcrumb = rows
                .Select(r => new BreadcrumbItem($"{r.AccountCode} | {r.Title}", href: null))
                .ToList();
        }
        catch
        {
            _selectedBreadcrumb = new();
        }
    }

    private List<(string, int)> PathKeys(ChartTreeNode n)
    {
        var keys = new List<(string, int)>();

        if (n.NodeType == "BaseDetil")
        {
            var parentLinkId = n.ParentLinkId;
            var guard = 0;
            while (parentLinkId.HasValue && guard++ < MaxRenderDepth)
            {
                var parent = _all.FirstOrDefault(x => x.NodeType == "BaseDetil" && x.LinkId == parentLinkId.Value);
                if (parent is null) break;
                keys.Add(KeyOf(parent));
                parentLinkId = parent.ParentLinkId;
            }

            if (n.MoeinId.HasValue)
            {
                var moein = _all.FirstOrDefault(x => x.NodeType == "BaseMoein" && x.NodeId == n.MoeinId.Value);
                if (moein is not null)
                {
                    keys.Add(KeyOf(moein));
                    if (moein.ParentId.HasValue) keys.Add(("BaseCol", moein.ParentId.Value));
                }
            }
        }
        else if (n.NodeType == "BaseMoein" && n.ParentId.HasValue)
        {
            keys.Add(("BaseCol", n.ParentId.Value));
        }

        return keys;
    }

    private const int MaxRenderDepth = 100;

    private List<ChartTreeNode> ChildrenOf(ChartTreeNode n)
    {
        return n.NodeType switch
        {
            "BaseCol" => _filtered
                .Where(c => c.NodeType == "BaseMoein" && c.ParentId == n.NodeId)
                .OrderBy(c => c.AccountCode).ToList(),
            "BaseMoein" => _filtered
                .Where(c => c.NodeType == "BaseDetil" && c.MoeinId == n.NodeId && !c.ParentLinkId.HasValue)
                .OrderBy(c => c.AccountCode).ToList(),
            "BaseDetil" when n.LinkId.HasValue => _filtered
                .Where(c => c.NodeType == "BaseDetil" && c.ParentLinkId == n.LinkId.Value)
                .OrderBy(c => c.AccountCode).ToList(),
            _ => new List<ChartTreeNode>()
        };
    }

    private RenderFragment RenderNode(ChartTreeNode n, int indent, int depth = 0) => __builder =>
    {
        var isSelected = _selected is not null && _selected.NodeId == n.NodeId
                         && _selected.NodeType == n.NodeType && _selected.LinkId == n.LinkId;
        var matched = _searchResults.Any(r => r.NodeId == n.NodeId
                                               && r.NodeType == n.NodeType
                                               && (n.NodeType != "BaseDetil" || r.LinkId == n.LinkId));
        var children = ChildrenOf(n);
        var hasChildren = children.Count > 0 && depth < MaxRenderDepth;
        var opened = IsExpanded(n);

        <div class="tz-charttree__node @(isSelected ? "is-selected" : null) @(matched ? "is-matched" : null)"
             style="padding-right:@(indent * 20 + 12)px">
            @if (hasChildren)
            {
                <MudIconButton Icon="@(opened ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronLeft)"
                               Size="Size.Small" OnClick="@(() => Toggle(n))" />
            }
            else
            {
                <span class="tz-charttree__leaf" />
            }
            <span class="tz-charttree__icon">
                @if (n.NodeType == "BaseCol")
                {
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Color="Color.Primary" />
                }
                else if (n.NodeType == "BaseMoein")
                {
                    <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" Color="Color.Secondary" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Small" Color="Color.Tertiary" />
                }
            </span>
            <span class="tz-charttree__row" @onclick="@(() => SelectNode(n))">
                <span class="tz-charttree__code" title="@($"کد حساب: {n.AccountCode} — کد گره: {n.Code}")">@n.AccountCode</span>
                <span class="tz-charttree__own">@n.Code</span>
                <span class="tz-charttree__title">@n.Title</span>
                @if (!string.IsNullOrWhiteSpace(n.GroupTitle))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">@n.GroupTitle</MudChip>
                }
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@AccountNatureKind.Title(n.AccountNature)</MudChip>
                @if (!n.IsActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">غیرفعال</MudChip>
                }
                @if (n.ChildCount > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@n.ChildCount فرزند</MudChip>
                }
            </span>
        </div>

        @if (hasChildren && opened)
        {
            @foreach (var ch in children)
            {
                @RenderNode(ch, indent + 1, depth + 1)
            }
        }
    };

