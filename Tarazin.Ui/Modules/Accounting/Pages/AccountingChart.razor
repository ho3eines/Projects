@page "/accounting/chart"
@using Tarazin.Components.Chart
@using Tarazin.Models
@inject DbService Db
@inject UserSession Session
@inject IDialogService Dialog
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject AccountPickerService Picker
@implements IDisposable

<PageTitle>جداول پایه — حسابداری</PageTitle>

<PageHeader Title="جداول پایه"
            Subtitle="درخت حساب‌های کل، معین و تفصیلی، به همراه مدیریت شرکت‌ها و سال‌های مالی"
            Eyebrow="حسابداری">
</PageHeader>

<MudTabs Elevation="1" Rounded="true" PanelClass="pa-4" Class="mt-3">
    <MudTabPanel Text="درختواره حساب‌ها">
        <div class="d-flex align-center flex-wrap gap-2 mb-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenNewCol" Disabled="@(!CanCreate)">
                حساب کل جدید
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Category"
                       OnClick="OpenGroupManagerAsync" Disabled="@(!CanEdit)" Class="ms-2">
                مدیریت گروه‌ها
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountTree"
                       OnClick="ExpandAll" Class="ms-2">
                باز کردن همه
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.AccountTree"
                       OnClick="CollapseAll" Class="ms-2">
                بستن همه
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="ReloadAsync" Class="ms-2">
                تازه‌سازی درخت
            </MudButton>
        </div>

        <MudPaper Elevation="1" Class="pa-3 mb-3">
            <MudGrid Spacing="2" AlignItems="Center.Center">
                <MudItem xs="12" md="5">
                    <MudTextField @ref="_searchRef"
                                  Label="جستجو (نام، کد گره، کد حساب)"
                                  @bind-Value="_search"
                                  Immediate="true"
                                  DebounceInterval="180"
                                  OnDebounceIntervalElapsed="OnSearchChanged"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Clearable="true" OnClearButtonClick="OnSearchCleared"
                                  Variant="Variant.Outlined"
                                  Placeholder="مثلاً: بانک ملی | 0000123 | 100010000123" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudSelect T="string" Label="فیلتر نوع" @bind-Value="_typeFilter" Variant="Variant.Outlined" Dense="true"
                               OnClose="OnFilterChanged" Clearable="true">
                        <MudSelectItem T="string" Value="@((string?)null)">همه</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Col")">فقط حساب کل</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Moein")">فقط معین</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Detil")">فقط تفصیلی</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudSelect T="string" Label="وضعیت" @bind-Value="_statusFilter" Variant="Variant.Outlined" Dense="true"
                               OnClose="OnFilterChanged" Clearable="true">
                        <MudSelectItem T="string" Value="@((string?)null)">همه</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Active")">فقط فعال</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Inactive")">فقط غیرفعال</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3" Class="d-flex align-center">
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                        تعداد: @_filtered.Count
                    </MudChip>
                    @if (_searchResults.Count > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="ms-2">
                            جستجو: @_searchResults.Count نتیجه
                        </MudChip>
                    }
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudGrid Spacing="2">
            <MudItem xs="12" lg="@(_selected is null ? 12 : 7)">
                <MudPaper Elevation="1" Class="pa-2 tz-charttree">
                    @if (_loading)
                    {
                        <div class="pa-4 d-flex justify-center">
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                        </div>
                    }
                    @if (_searchResults.Count > 0 && !string.IsNullOrEmpty(_search))
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2"
                                  Icon="@Icons.Material.Filled.Search">
                            @_searchResults.Count مسیر منطبق با «@_search» یافت شد. روی هرکدام کلیک کنید تا در درخت باز شود.
                        </MudAlert>
                    }
                    <div class="tz-charttree__scroll" tabindex="0" @onkeydown="OnKeyDown" @ref="_scrollRef">
                        @if (_grouped.Count == 0)
                        {
                            <MudText Color="Color.Secondary" Class="pa-4">
                                @(_loading ? "در حال بارگذاری..." : "هیچ حسابی تعریف نشده است. برای شروع، «حساب کل جدید» را بزنید.")
                            </MudText>
                        }
                        @foreach (var top in _grouped)
                        {
                            @RenderNode(top.TopNode, 0)
                        }
                    </div>
                </MudPaper>
            </MudItem>

            @if (_selected is not null)
            {
                <MudItem xs="12" lg="5">
                    <MudPaper Elevation="1" Class="pa-3">
                        <div class="d-flex align-center mb-2">
                            <MudIcon Icon="@TypeIcon(_selected.NodeType)" Color="@TypeColor(_selected.NodeType)" Class="me-2" />
                            <MudText Typo="Typo.h6">@_selected.Title</MudText>
                            <MudSpacer />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => _selected = null" />
                        </div>

                        <MudBreadcrumbs Items="@_selectedBreadcrumb" Class="mb-3 pa-0">
                            <ItemTemplate Context="bc">
                                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">@bc.Text</MudText>
                            </ItemTemplate>
                        </MudBreadcrumbs>

                        <MudGrid Spacing="1">
                            <MudItem xs="5"><MudText Color="Color.Secondary">نوع</MudText></MudItem>
                            <MudItem xs="7">
                                <MudChip T="string" Size="Size.Small" Color="@TypeColor(_selected.NodeType)">
                                    @TypeTitle(_selected.NodeType)
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="ms-1">
                                    Level @_selected.Level
                                </MudChip>
                            </MudItem>
                            <MudItem xs="5"><MudText Color="Color.Secondary">کد حساب</MudText></MudItem>
                            <MudItem xs="7" Class="d-flex align-center">
                                <code style="direction:ltr"><b>@_selected.AccountCode</b></code>
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                               OnClick="@(() => Copy("کد حساب", _selected.AccountCode))" />
                            </MudItem>
                            <MudItem xs="5"><MudText Color="Color.Secondary">کد گره (@TypeTitle(_selected.NodeType))</MudText></MudItem>
                            <MudItem xs="7" Class="d-flex align-center">
                                <code style="direction:ltr">@_selected.Code</code>
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                               OnClick="@(() => Copy("کد گره", _selected.Code))" />
                            </MudItem>
                            <MudItem xs="5"><MudText Color="Color.Secondary">گروه حساب</MudText></MudItem>
                            <MudItem xs="7">
                                @if (_selected.AccountGroupId.HasValue)
                                {
                                    <span>@_selected.GroupCode | @_selected.GroupTitle</span>
                                }
                                else
                                {
                                    <span>— بدون گروه —</span>
                                }
                            </MudItem>
                            <MudItem xs="5"><MudText Color="Color.Secondary">ماهیت حساب</MudText></MudItem>
                            <MudItem xs="7">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                    @AccountNatureKind.Title(_selected.AccountNature)
                                </MudChip>
                            </MudItem>
                            <MudItem xs="5"><MudText Color="Color.Secondary">تعداد فرزند</MudText></MudItem>
                            <MudItem xs="7">@_selected.ChildCount</MudItem>
                            <MudItem xs="5"><MudText Color="Color.Secondary">وضعیت</MudText></MudItem>
                            <MudItem xs="7">
                                <MudChip T="string" Size="Size.Small" Color="@(_selected.IsActive ? Color.Success : Color.Default)">
                                    @(_selected.IsActive ? "فعال" : "غیرفعال")
                                </MudChip>
                            </MudItem>
                            <MudItem xs="5"><MudText Color="Color.Secondary">والد</MudText></MudItem>
                            <MudItem xs="7">
                                @if (_selected.NodeType == "BaseDetil" && _selected.ParentLinkId.HasValue)
                                {
                                    <span>تفصیلی والد (LinkId=@_selected.ParentLinkId.Value)</span>
                                }
                                else if (_selected.NodeType == "BaseDetil")
                                {
                                    <span>حساب معین (MoeinId=@_selected.MoeinId)</span>
                                }
                                else if (_selected.ParentId.HasValue)
                                {
                                    <span>NodeId=@_selected.ParentId.Value</span>
                                }
                                else
                                {
                                    <span>— ریشه —</span>
                                }
                            </MudItem>
                        </MudGrid>

                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                            @if (_selected.NodeType == "BaseDetil")
                            {
                                <span>
                                    موجودیت در <code>[accounting].[BaseDetil]</code> و جایگاه سطح @_selected.Level
                                    در <code>[accounting].[BaseDetilLink]</code>
                                    (LinkId=@_selected.LinkId، ParentLinkId=@(_selected.ParentLinkId?.ToString() ?? "NULL")) ذخیره شده است.
                                </span>
                            }
                            else
                            {
                                <span>ذخیره در <code>[accounting].[@(_selected.NodeType)]</code>.</span>
                            }
                        </MudAlert>

                        <MudDivider Class="my-3" />

                        <MudText Typo="Typo.subtitle2" Class="mb-2">عملیات سریع</MudText>
                        <div class="d-flex flex-wrap" style="gap:6px">
                            @if (_selected.NodeType == "BaseCol" && CanCreate)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNewMoein">
                                    + معین
                                </MudButton>
                            }
                            @if (CanAddDetilHere)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNewDetil">
                                    @(_selected.NodeType == "BaseDetil" ? "+ زیرسطح تفصیلی" : "+ تفصیلی سطح ۳")
                                </MudButton>
                            }
                            @if (_selected.NodeType == "BaseDetil" && CanCreate)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="OpenUseInNewPath">
                                    استفاده در مسیر جدید
                            </MudButton>
                            }
                            @if (CanEdit)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                                           StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenEdit">
                                    ویرایش
                                </MudButton>
                            }
                            @if (_selected.NodeType == "BaseMoein" && CanMove)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                           StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="OpenMove">
                                    انتقال به کل دیگر
                                </MudButton>
                            }
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => Copy("کد گره", _selected.Code))">
                                کپی کد گره
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => Copy("کد حساب", _selected.AccountCode))">
                                کپی کد حساب
                            </MudButton>
                            @if (CanDelete)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.DeleteOutline" OnClick="DeleteAsync">
                                    حذف
                                </MudButton>
                            }
                        </div>

                        @if (_selected.NodeType == "BaseDetil" && _usagePaths.Count > 0)
                        {
                            <MudDivider Class="my-3" />
                            <MudText Typo="Typo.subtitle2" Class="mb-2">
                                استفاده در @_usagePaths.Count مسیر
                            </MudText>
                            <MudList T="object" Dense="true" DisableGutters="true">
                                @foreach (var p in _usagePaths)
                                {
                                    <MudListItem T="object" Icon="@Icons.Material.Filled.SubdirectoryArrowRight">
                                        <MudText Typo="Typo.body2">
                                            <b>@p.PathTitle</b>
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="direction:ltr">
                                            Level @p.Level / @p.AccountCode
                                        </MudText>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="شرکت‌های مالی">
        <MudTable T="CompanyRow" Items="_companies" Loading="_loadingComp" Hover="true" Dense="true" Striped="true">
            <ToolBarContent>
                <MudText Typo="Typo.h6">شرکت‌های مالی</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNewCompanyAsync" Disabled="@(!Session.IsAdmin)">شرکت جدید</MudButton>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>شناسه</MudTh>
                <MudTh>نام شرکت</MudTh>
                <MudTh>وضعیت</MudTh>
                <MudTh>عملیات</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="شناسه">@context.CompanyId</MudTd>
                <MudTd DataLabel="نام شرکت">@context.CompanyName</MudTd>
                <MudTd DataLabel="وضعیت">
                    <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                        @(context.IsActive ? "فعال" : "غیرفعال")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="عملیات">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenEditCompanyAsync(context))" Disabled="@(!Session.IsAdmin)" />
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteCompanyAsync(context))" Disabled="@(!Session.IsAdmin)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="سال‌های مالی">
        <div class="d-flex align-center gap-4 mb-4">
            <MudSelect T="int" Label="انتخاب شرکت" @bind-Value="_selectedCompId" @bind-Value:after="OnCompChangedForYears" Variant="Variant.Outlined" Style="max-width:300px">
                @foreach (var c in _allCompanies)
                {
                    <MudSelectItem T="int" Value="@c.CompanyId">@c.CompanyName</MudSelectItem>
                }
            </MudSelect>
            <MudSpacer />
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Text">
                سال‌های مالی به‌صورت خودکار توسط سیستم مدیریت می‌شوند و با تغییر شرکت/ورود کاربر ایجاد می‌گردند.
            </MudAlert>
        </div>

        <MudTable T="FiscalYearRow" Items="_years" Loading="_loadingYears" Hover="true" Dense="true" Striped="true">
            <HeaderContent>
                <MudTh>شناسه</MudTh>
                <MudTh>سال مالی</MudTh>
                <MudTh>تاریخ شروع</MudTh>
                <MudTh>تاریخ پایان</MudTh>
                <MudTh>وضعیت</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="شناسه">@context.FiscalYearId</MudTd>
                <MudTd DataLabel="سال مالی">@context.YearName</MudTd>
                <MudTd DataLabel="تاریخ شروع">@context.StartDate.ToString("yyyy/MM/dd")</MudTd>
                <MudTd DataLabel="تاریخ پایان">@context.EndDate.ToString("yyyy/MM/dd")</MudTd>
                <MudTd DataLabel="وضعیت">
                    @if (context.IsClosed)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">بسته</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">باز</MudChip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudTabPanel>
</MudTabs>

@code {
    private const string Schema = "accounting";

    private MudTextField<string>? _searchRef;
    private ElementReference _scrollRef;

    private string _search = "";
    private string? _typeFilter;
    private string? _statusFilter;
    private bool _loading = true;

    private List<ChartTreeNode> _all = new();
    private List<ChartTreeNode> _filtered = new();
    private List<ChartTreeNode> _searchResults = new();
    private List<ChartGroup> _grouped = new();

    private ChartTreeNode? _selected;
    private List<BreadcrumbItem> _selectedBreadcrumb = new();
    private List<BaseDetilUsagePath> _usagePaths = new();

    // Multi-Company & Years variables
    private List<CompanyRow> _companies = new();
    private List<CompanyRow> _allCompanies = new();
    private List<FiscalYearRow> _years = new();
    private bool _loadingComp = true;
    private bool _loadingYears = false;
    private int _selectedCompId;

    private bool CanView => Session.HasPermission(TarazinPermissions.ChartView) || Session.IsAdmin;
    private bool CanCreate => Session.HasPermission(TarazinPermissions.ChartCreate) || Session.IsAdmin;
    private bool CanEdit => Session.HasPermission(TarazinPermissions.ChartEdit) || Session.IsAdmin;
    private bool CanDelete => Session.HasPermission(TarazinPermissions.ChartDelete) || Session.IsAdmin;
    private bool CanMove => Session.HasPermission(TarazinPermissions.ChartMove) || Session.IsAdmin;
    private bool CanManageDetil => Session.HasPermission(TarazinPermissions.ChartManageDetil) || Session.IsAdmin;

    protected override async Task OnInitializedAsync()
    {
        _selectedCompId = Session.ActiveCompanyId ?? 0;
        await ReloadAsync();
        await ReloadCompaniesAsync();
        await ReloadYearsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { if (_searchRef is not null) await _searchRef.FocusAsync(); } catch { }
        }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _all = (await Db.QueryAsync<ChartTreeNode>(Schema, "ChartTreeFull", new
            {
                IncludeInactive = 1, CompanyId = Session.ActiveCompanyId
            })).ToList();

            ApplyFilter();
            if (_selected is not null)
            {
                var match = _all.FirstOrDefault(n => n.NodeId == _selected.NodeId
                                                     && n.NodeType == _selected.NodeType
                                                     && n.LinkId == _selected.LinkId)
                            ?? _all.FirstOrDefault(n => n.NodeId == _selected.NodeId && n.NodeType == _selected.NodeType);
                if (match is not null)
                {
                    _selected = match;
                    await BuildSelectedBreadcrumbAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadCompaniesAsync()
    {
        _loadingComp = true;
        try
        {
            _companies = (await Db.QueryAsync<CompanyRow>("central", "CompanyList", new { })).ToList();
            _allCompanies = _companies.Where(c => c.IsActive).ToList();
            if (_selectedCompId == 0 && _allCompanies.Count > 0)
            {
                _selectedCompId = _allCompanies[0].CompanyId;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loadingComp = false;
        }
    }

    private async Task ReloadYearsAsync()
    {
        if (_selectedCompId == 0) return;
        _loadingYears = true;
        try
        {
            _years = (await Db.QueryAsync<FiscalYearRow>("central", "FiscalYearList", new { CompanyId = _selectedCompId })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loadingYears = false;
        }
    }

    private async Task OnCompChangedForYears()
    {
        await ReloadYearsAsync();
    }

    private void ApplyFilter()
    {
        IEnumerable<ChartTreeNode> q = _all;
        if (!string.IsNullOrWhiteSpace(_statusFilter))
        {
            if (_statusFilter == "Active") q = q.Where(n => n.IsActive);
            else if (_statusFilter == "Inactive") q = q.Where(n => !n.IsActive);
        }

        if (!string.IsNullOrWhiteSpace(_typeFilter))
        {
            var wanted = "Base" + _typeFilter;
            var kept = q.ToList();
            var keep = new HashSet<(string, int)>();

            foreach (var n in kept.Where(n => n.NodeType == wanted))
            {
                keep.Add((n.NodeType, n.NodeId));
                if (n.NodeType == "BaseDetil" && n.MoeinId.HasValue)
                {
                    var mo = kept.FirstOrDefault(x => x.NodeType == "BaseMoein" && x.NodeId == n.MoeinId.Value);
                    if (mo is not null)
                    {
                        keep.Add((mo.NodeType, mo.NodeId));
                        if (mo.ParentId.HasValue)
                            keep.Add(("BaseCol", mo.ParentId.Value));
                    }
                }
                else if (n.NodeType == "BaseMoein" && n.ParentId.HasValue)
                {
                    keep.Add(("BaseCol", n.ParentId.Value));
                }
            }

            q = kept.Where(n => keep.Contains((n.NodeType, n.NodeId)));
        }

        _filtered = q.ToList();
        BuildTree();
    }

    private void BuildTree()
    {
        _grouped = _filtered
            .Where(n => n.NodeType == "BaseCol")
            .OrderBy(n => n.AccountCode)
            .Select(n => new ChartGroup(n, _filtered))
            .ToList();
    }

    private async Task OnSearchChanged(string _)
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            _searchResults = new();
            return;
        }
        try
        {
            _searchResults = (await Db.QueryAsync<ChartTreeNode>(Schema, "ChartTreeSearch", new
            {
                SearchText = _search, CompanyId = Session.ActiveCompanyId
            })).ToList();
            foreach (var r in _searchResults)
            {
                foreach (var key in PathKeys(r))
                    _expanded.Add(key);
            }
        }
        catch (Exception ex)
        {
