    private async Task OpenEdit()
    {
        if (_selected is null) return;
        if (_selected.NodeType == "BaseCol")
        {
            var colRow = (await Db.QueryAsync<BaseColRow>(Schema, "BaseColList", new { CompanyId = Session.ActiveCompanyId }))
                .FirstOrDefault(c => c.ColId == _selected.NodeId);

            var dlg = await Dialog.ShowAsync<BaseColForm>("ویرایش حساب کل", new DialogParameters
            {
                ["ColId"] = _selected.NodeId,
                ["InitialCode"] = _selected.Code,
                ["InitialTitle"] = _selected.Title,
                ["InitialDescription"] = colRow?.Description ?? "",
                ["InitialAccountGroupId"] = _selected.AccountGroupId,
                ["InitialAccountNature"] = _selected.AccountNature,
                ["InitialIsActive"] = _selected.IsActive
            }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
            var r = await dlg.Result;
            if (r is { Canceled: false }) await ReloadAsync();
        }
        else if (_selected.NodeType == "BaseMoein")
        {
            int colId = _selected.ParentId ?? 0;
            var moeinRow = (await Db.QueryAsync<BaseMoeinRow>(Schema, "BaseMoeinListByCol", new { ColId = colId, CompanyId = Session.ActiveCompanyId }))
                .FirstOrDefault(m => m.MoeinId == _selected.NodeId);
            var dlg = await Dialog.ShowAsync<BaseMoeinForm>("ویرایش حساب معین", new DialogParameters
            {
                ["MoeinId"] = _selected.NodeId,
                ["InitialColId"] = colId,
                ["InitialCode"] = _selected.Code,
                ["InitialTitle"] = _selected.Title,
                ["InitialDescription"] = moeinRow?.Description ?? "",
                ["InitialAccountGroupId"] = _selected.AccountGroupId,
                ["InitialAccountNature"] = _selected.AccountNature,
                ["InitialIsActive"] = _selected.IsActive
            }, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
            var r = await dlg.Result;
            if (r is { Canceled: false }) await ReloadAsync();
        }
        else if (_selected.NodeType == "BaseDetil" && _selected.DetilEntityId.HasValue)
        {
            try
            {
                var det = await Db.QueryFirstOrDefaultAsync<BaseDetilRow>(Schema, "BaseDetilByCode", new { DetilCode = _selected.Code, CompanyId = Session.ActiveCompanyId });
                if (det is null) { Snackbar.Add("تفصیلی پیدا نشد.", Severity.Error); return; }

                var dlg = await Dialog.ShowAsync<BaseDetilForm>("ویرایش تفصیلی", new DialogParameters
                {
                    ["Mode"] = BaseDetilForm.DetilFormMode.Edit,
                    ["MoeinId"] = _selected.MoeinId ?? 0,
                    ["DetilId"] = det.DetilId,
                    ["InitialCode"] = det.DetilCode,
                    ["InitialTitle"] = det.Title,
                    ["InitialDescription"] = det.Description ?? "",
                    ["InitialAccountGroupId"] = det.AccountGroupId,
                    ["InitialAccountNature"] = det.AccountNature,
                    ["InitialIsActive"] = det.IsActive
                }, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
                var r = await dlg.Result;
                if (r is { Canceled: false }) await ReloadAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
