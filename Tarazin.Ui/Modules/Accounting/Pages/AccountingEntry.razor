@page "/accounting/entry"
@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<PageTitle>ثبت سند — حسابداری</PageTitle>

<MudText Typo="Typo.h4">ثبت سند حسابداری</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    سند روزنامه با ردیف‌های بدهکار / بستانکار (باید متوازن باشد).
</MudText>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudDatePicker Label="تاریخ سند" Culture="FaCulture" @bind-Date="_documentDate" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="string" Label="نوع سند" @bind-Value="_documentType" Variant="Variant.Outlined">
                <MudSelectItem Value="'Journal'">سند روزنامه</MudSelectItem>
                <MudSelectItem Value="'Receipt'">دریافت</MudSelectItem>
                <MudSelectItem Value="'Payment'">پرداخت</MudSelectItem>
                <MudSelectItem Value="'Purchase'">خرید</MudSelectItem>
                <MudSelectItem Value="'Sale'">فروش</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="12" md="4">
            <MudTextField Label="طرف حساب (اختیاری)" @bind-Value="_counterParty" Variant="Variant.Outlined" />
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudText Typo="Typo.subtitle1" Class="mb-3">ردیف‌های سند</MudText>

    <MudTable Items="_lines" Hover="true" Dense="true" Class="mb-4">
        <HeaderContent>
            <MudTh>حساب</MudTh>
            <MudTh>شرح</MudTh>
            <MudTh>بدهکار</MudTh>
            <MudTh>بستانکار</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="حساب">
                <MudSelect T="int" Value="@context.AccountId"
                           ValueChanged="v => OnAccountChange(_lines.IndexOf(context), v)"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="0">— انتخاب حساب —</MudSelectItem>
                    @foreach (var a in _accounts)
                    {
                        <MudSelectItem Value="a.AccountId">@a.AccountCode — @a.Title</MudSelectItem>
                    }
                </MudSelect>
            </MudTd>
            <MudTd DataLabel="شرح">
                <MudTextField Value="@context.Description"
                              ValueChanged="v => { context.Description = v; }"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudTd>
            <MudTd DataLabel="بدهکار">
                <MudNumericField T="decimal" Value="@context.Debit"
                                 ValueChanged="v => { context.Debit = v; }" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Min="0" />
            </MudTd>
            <MudTd DataLabel="بستانکار">
                <MudNumericField T="decimal" Value="@context.Credit"
                                 ValueChanged="v => { context.Credit = v; }" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Min="0" />
            </MudTd>
            <MudTd DataLabel="">
                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error"
                               Size="Size.Small" OnClick="() => RemoveLine(_lines.IndexOf(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.body2">جمع بدهکار: <b>@TotalDebit.ToString("N0")</b></MudText>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.body2">جمع بستانکار: <b>@TotalCredit.ToString("N0")</b></MudText>
        </MudItem>
        <MudItem xs="12">
            <MudChip T="string" Color="@(IsBalanced ? Color.Success : Color.Error)" Size="Size.Small">
                @(IsBalanced ? "✔ متوازن" : "✘ نامتوازن")
            </MudChip>
        </MudItem>
    </MudGrid>

    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddLine" StartIcon="@Icons.Material.Filled.Add">
        + ردیف
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy"
               StartIcon="@Icons.Material.Filled.Save" Class="ms-2">
        ثبت سند
    </MudButton>
</MudPaper>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "accounting";

    private List<ChartOfAccountRow> _accounts = new();
    private List<JournalLineRow> _lines = new();
    private DateTime? _documentDate = DateTime.Today;
    private string _documentType = "Journal";
    private string _counterParty = "";
    private bool _busy;

    private decimal TotalDebit => _lines.Sum(l => l.Debit);
    private decimal TotalCredit => _lines.Sum(l => l.Credit);
    private bool IsBalanced => TotalDebit == TotalCredit && TotalDebit > 0;

    protected override async Task OnInitializedAsync()
    {
        _accounts = (await Db.QueryAsync<ChartOfAccountRow>(Schema, "ChartOfAccountSearch", new
        {
            SearchText = "",
            SkipRows = 0,
            TakeSize = 500
        })).ToList();
        AddLine();
    }

    private void AddLine() => _lines.Add(new JournalLineRow());

    private void RemoveLine(int index)
    {
        if (_lines.Count > 1)
            _lines.RemoveAt(index);
    }

    private void OnAccountChange(int index, int accountId)
    {
        if (index < 0 || index >= _lines.Count)
            return;

        var line = _lines[index];
        line.AccountId = accountId;
        var account = _accounts.FirstOrDefault(a => a.AccountId == accountId);
        if (account is not null)
        {
            line.AccountCode = account.AccountCode;
            line.AccountTitle = account.Title;
        }
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        if (!IsBalanced)
        {
            Snackbar.Add("بدهی و بستانکاری سند باید برابر باشد.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var linesJson = JsonSerializer.Serialize(_lines.Select(l => new
            {
                l.AccountId,
                l.Description,
                l.Debit,
                l.Credit
            }));

            await Db.ExecuteAsync(Schema, "DocumentInsert", new
            {
                LinesJson = linesJson,
                DocumentDate = _documentDate ?? DateTime.Today,
                DocumentType = _documentType,
                CounterPartyName = _counterParty,
                CreatedBy = Session.UserName
            });

            Snackbar.Add("سند با موفقیت ثبت شد.", Severity.Success);
            _lines.Clear();
            AddLine();
            _counterParty = "";
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
