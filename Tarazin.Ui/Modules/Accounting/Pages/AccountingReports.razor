@page "/accounting/reports"
@inject DbService Db
@inject UserSession Session
@inject AccountPickerService Picker
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>گزارشات — حسابداری</PageTitle>

<PageHeader Title="گزارشات حسابداری"
            Subtitle="دفتر روزنامه، دفتر کل، تراز آزمایشی و مرور مرحله‌ای کل تا سند."
            Eyebrow="حسابداری" />

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string" Label="گزارش" Value="_report" ValueChanged="v => ChangeReportAsync(v)" Variant="Variant.Outlined" Disabled="_loading">
                <MudSelectItem T="string" Value="@("hierarchy")">مرور کل تا سند</MudSelectItem>
                <MudSelectItem T="string" Value="@("detail")">گردش تفصیلی</MudSelectItem>
                <MudSelectItem T="string" Value="@("daily")">دفتر روزنامه</MudSelectItem>
                <MudSelectItem T="string" Value="@("ledger")">دفتر کل</MudSelectItem>
                <MudSelectItem T="string" Value="@("trial")">تراز آزمایشی</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker Label="از تاریخ" Culture="FaCulture" @bind-Date="_from" Disabled="_loading" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker Label="تا تاریخ" Culture="FaCulture" @bind-Date="_to" Disabled="_loading" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="string" Label="وضعیت سند" @bind-Value="_status" Variant="Variant.Outlined" Clearable="true" Disabled="_loading">
                <MudSelectItem T="string" Value="@((string?)null)">همه وضعیت‌ها</MudSelectItem>
                @foreach (var status in AccountingDocumentStatus.Ordered)
                {
                    <MudSelectItem T="string" Value="@status">@AccountingDocumentStatus.Title(status)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudTextField T="string" Label="شماره سند" @bind-Value="_documentNumber" Variant="Variant.Outlined" Clearable="true" Disabled="_loading" />
        </MudItem>
        <MudItem xs="12" md="1" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Search" OnClick="ApplyFiltersAsync" Disabled="_loading">
                اجرا
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (_report == "detail")
    {
        <MudDivider Class="my-3" />
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                @* گردش تفصیلی با «خودِ تفصیلی» شروع می‌شود، نه با انتخاب حساب:
                   ابتدا تفصیلی، سپس کل‌هایی که در آن‌ها گردش دارد، بعد معین، بعد
                   فرزندان تفصیلی تا آخرین برگ و در نهایت سند. *@
                <MudAutocomplete T="BaseDetilRow"
                                 Label="حساب تفصیلی (نام یا کد)"
                                 Value="_detilEntity"
                                 ValueChanged="v => OnDetilEntityChangedAsync(v)"
                                 SearchFunc="SearchDetilAsync"
                                 ToStringFunc="DetilDisplay"
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 Clearable="true"
                                 Disabled="_loading"
                                 Placeholder="مثلاً: بانک ملی یا 0000123"
                                 HelperText="ابتدا تفصیلی را انتخاب کنید؛ سپس حساب‌های کل، معین و زیرمجموعه‌ها تا سند باز می‌شوند." />
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex align-center flex-wrap" Style="gap:8px">
                @if (_detilEntity is not null)
                {
                    <MudChip T="string" Color="Color.Tertiary" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Person">
                        تفصیلی: @_detilEntity.DetilCode — @_detilEntity.Title
                    </MudChip>
                }
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountTree"
                           OnClick="PickDetailAsync" Disabled="_loading">
                    انتخاب از درخت حساب‌ها
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_detilEntity is not null)
        {
            <MudDivider Class="my-3" />
            <div class="d-flex align-center flex-wrap" style="gap:4px">
                <MudButton Variant="@(_detilLevel == 1 && _detailSummary is null ? Variant.Filled : Variant.Text)"
                           Color="Color.Primary" OnClick="ShowDetilColsAsync" Disabled="_loading">
                    حساب‌های کل
                </MudButton>
                @if (_detilCol is not null)
                {
                    <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
                    <MudButton Variant="@(_detilLevel == 2 && _detailSummary is null ? Variant.Filled : Variant.Text)"
                               Color="Color.Primary" OnClick="ShowDetilMoeinsAsync" Disabled="_loading">
                        @_detilCol.AccountCode — @_detilCol.Title
                    </MudButton>
                }
                @if (_detilMoein is not null)
                {
                    <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
                    <MudButton Variant="@(_detilLevel == 3 && _detilPlacements.Count == 0 && _detailSummary is null ? Variant.Filled : Variant.Text)"
                               Color="Color.Primary" OnClick="ShowDetilPlacementsAsync" Disabled="_loading">
                        @_detilMoein.AccountCode — @_detilMoein.Title
                    </MudButton>
                }
                @foreach (var node in _detilPlacements)
                {
                    <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
                    <MudButton Variant="@(IsCurrentPlacement(node) && _detailSummary is null ? Variant.Filled : Variant.Text)"
                               Color="Color.Primary" OnClick="@(() => ShowDetilChildrenAsync(node))" Disabled="_loading">
                        @node.AccountCode — @node.Title
                    </MudButton>
                }
                @if (_detailSummary is not null)
                {
                    <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
                    <MudChip T="string" Variant="Variant.Outlined">گردش و سند</MudChip>
                }
            </div>
        }
    }
</MudPaper>

@if (_report == "hierarchy")
{
    <MudPaper Elevation="1" Class="pa-3 mb-4">
        <div class="d-flex align-center flex-wrap" style="gap:4px">
            <MudButton Variant="@(_hierarchyLevel == 1 && _detailSummary is null ? Variant.Filled : Variant.Text)"
                       Color="Color.Primary" OnClick="ResetHierarchyAsync" Disabled="_loading">
                حساب کل
            </MudButton>
            @if (_selectedCol is not null)
            {
                <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
                <MudButton Variant="@(_hierarchyLevel == 2 && _detailSummary is null ? Variant.Filled : Variant.Text)"
                           Color="Color.Primary" OnClick="ShowSelectedColAsync" Disabled="_loading">
                    @_selectedCol.AccountCode — @_selectedCol.Title
                </MudButton>
            }
            @if (_selectedMoein is not null)
            {
                <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
                <MudButton Variant="@(_hierarchyLevel == 3 && _selectedDetails.Count == 0 && _detailSummary is null ? Variant.Filled : Variant.Text)"
                           Color="Color.Primary" OnClick="ShowSelectedMoeinAsync" Disabled="_loading">
                    @_selectedMoein.AccountCode — @_selectedMoein.Title
                </MudButton>
            }
            @foreach (var detail in _selectedDetails)
            {
                <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
                <MudButton Variant="@(IsCurrentDetailParent(detail) && _detailSummary is null ? Variant.Filled : Variant.Text)"
                           Color="Color.Primary" OnClick="@(() => ShowDetailChildrenAsync(detail))" Disabled="_loading">
                    @detail.AccountCode — @detail.Title
                </MudButton>
            }
            @if (_detailSummary is not null)
            {
                <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
                <MudChip T="string" Color="Color.Tertiary">تفصیلی: @_detailSummary.DetilCode — @_detailSummary.DetilTitle</MudChip>
                <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
                <MudChip T="string" Variant="Variant.Outlined">گردش و سند</MudChip>
            }
        </div>
    </MudPaper>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_report == "hierarchy" && _detailSummary is null)
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-1">@HierarchyTitle</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
            برای رفتن به سطح بعد روی ردیف کلیک کنید؛ سند فقط پس از انتخاب گردش نهایی باز می‌شود.
        </MudText>
        <MudTable T="AccountingHierarchyRow" Items="_hierarchy" Hover="true" Dense="true" Striped="true"
                  OnRowClick="OnHierarchyRowClickAsync">
            <HeaderContent>
                <MudTh>کد حساب</MudTh><MudTh>عنوان حساب</MudTh><MudTh>زیرمجموعه</MudTh><MudTh>ماهیت</MudTh>
                <MudTh>جمع بدهکار</MudTh><MudTh>جمع بستانکار</MudTh><MudTh>مانده</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="کد حساب"><code style="direction:ltr">@context.AccountCode</code></MudTd>
                <MudTd DataLabel="عنوان"><MudText Color="Color.Primary"><b>@context.Title</b></MudText></MudTd>
                <MudTd DataLabel="زیرمجموعه">
                    @if (context.ChildCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@context.ChildCount مورد</MudChip>
                    }
                    else if (context.NodeType == "BaseDetil")
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">گردش</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="ماهیت">@NatureTitle(context.AccountNature)</MudTd>
                <MudTd DataLabel="بدهکار">@Money(context.Debit)</MudTd>
                <MudTd DataLabel="بستانکار">@Money(context.Credit)</MudTd>
                <MudTd DataLabel="مانده">@BalanceText(context.Balance)</MudTd>
                <MudTd><MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Primary" Size="Size.Small" /></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Color="Color.Secondary">در این سطح و بازه، گردش مرتبطی وجود ندارد.</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>
}
else if ((_report is "detail" or "hierarchy") && _detailSummary is not null)
{
    <MudGrid Spacing="2" Class="mb-4">
        <StatCard Label="مانده اول دوره" Value="@BalanceText(_detailSummary.OpeningBalance)" Icon="@Icons.Material.Filled.FirstPage" Accent="#607D8B" />
        <StatCard Label="جمع بدهکار" Value="@Money(_detailSummary.Debit)" Icon="@Icons.Material.Filled.SouthWest" Accent="#1E4B73" />
        <StatCard Label="جمع بستانکار" Value="@Money(_detailSummary.Credit)" Icon="@Icons.Material.Filled.NorthEast" Accent="#C49A3C" />
        <StatCard Label="مانده نهایی" Value="@BalanceText(_detailSummary.FinalBalance)" Icon="@Icons.Material.Filled.Balance" Accent="#0E4D4A" />
    </MudGrid>
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <div class="d-flex align-center justify-space-between flex-wrap" style="gap:8px">
            <div>
                <MudText Typo="Typo.h6">@_detailSummary.DetilCode — @_detailSummary.DetilTitle</MudText>
                <MudText Color="Color.Secondary" Class="mt-1">
                    کل: @_detailSummary.ColCode — @_detailSummary.ColTitle | معین: @_detailSummary.MoeinCode — @_detailSummary.MoeinTitle
                </MudText>
            </div>
            <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick="BackFromDetailAsync" Disabled="_loading">
                بازگشت
            </MudButton>
        </div>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Class="mt-2">AccountCode: @_detailSummary.AccountCode</MudChip>
    </MudPaper>
    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.subtitle1" Class="mb-1">گردش بدهکار و بستانکار تفصیلی</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">برای باز کردن سند روی هر ردیف کلیک کنید.</MudText>
        <MudTable T="DetailAccountTransactionRow" Items="_detailTransactions" Hover="true" Dense="true" Striped="true"
                  OnRowClick="OnDetailTransactionRowClick">
            <HeaderContent>
                <MudTh>تاریخ</MudTh><MudTh>شماره سند</MudTh><MudTh>شرح / طرف حساب سند</MudTh><MudTh>شرح ردیف</MudTh>
                <MudTh>بدهکار</MudTh><MudTh>بستانکار</MudTh><MudTh>مانده</MudTh><MudTh>وضعیت</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@DateText(context.DocumentDate)</MudTd>
                <MudTd><MudText Color="Color.Primary"><b>@DocumentNumber(context.DocumentId, context.DocumentNumber)</b></MudText></MudTd>
                <MudTd>@(context.DocumentDescription ?? "")</MudTd><MudTd>@(context.LineDescription ?? "")</MudTd>
                <MudTd>@Money(context.Debit)</MudTd><MudTd>@Money(context.Credit)</MudTd>
                <MudTd>@BalanceText(context.Balance)</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@AccountingDocumentStatus.Title(context.Status)</MudChip></MudTd>
                <MudTd><MudIcon Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Primary" Size="Size.Small" /></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Color="Color.Secondary">در این بازه گردشی ثبت نشده است.</MudText></NoRecordsContent>
        </MudTable>
        <div class="d-flex align-center justify-end mt-3" style="gap:8px">
            <MudText Typo="Typo.caption">@DetailPageCaption</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="@(_detailPage == 0 || _loading)" OnClick="@(() => ChangeDetailPageAsync(-1))" />
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="@(((_detailPage + 1) * DetailPageSize) >= _detailTotalRows || _loading)" OnClick="@(() => ChangeDetailPageAsync(1))" />
        </div>
    </MudPaper>
}
else if (_report == "detail" && _detilEntity is null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.AccountTree">
        ابتدا یک حساب تفصیلی انتخاب کنید؛ سپس حساب‌های کلی که این تفصیلی در آن‌ها بدهکار/بستانکار شده نمایش داده می‌شود،
        و با کلیک روی هر ردیف، معین و سپس زیرمجموعه‌های تفصیلی تا آخرین سطح و در نهایت سند باز می‌شود.
    </MudAlert>
}
else if (_report == "detail")
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-1">@DetilDrillTitle</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
            برای رفتن به سطح بعد روی ردیف کلیک کنید؛ سند فقط پس از رسیدن به آخرین سطح تفصیلی باز می‌شود.
        </MudText>
        <MudTable T="AccountingHierarchyRow" Items="_detilDrill" Hover="true" Dense="true" Striped="true"
                  OnRowClick="OnDetilDrillRowClickAsync">
            <HeaderContent>
                <MudTh>کد حساب</MudTh><MudTh>عنوان حساب</MudTh><MudTh>زیرمجموعه</MudTh>
                <MudTh>جمع بدهکار</MudTh><MudTh>جمع بستانکار</MudTh><MudTh>مانده</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="کد حساب"><code style="direction:ltr">@context.AccountCode</code></MudTd>
                <MudTd DataLabel="عنوان"><MudText Color="Color.Primary"><b>@context.Title</b></MudText></MudTd>
                <MudTd DataLabel="زیرمجموعه">
                    @if (context.ChildCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@context.ChildCount مورد</MudChip>
                    }
                    else if (context.NodeType == "BaseDetil")
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">گردش</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="بدهکار">@Money(context.Debit)</MudTd>
                <MudTd DataLabel="بستانکار">@Money(context.Credit)</MudTd>
                <MudTd DataLabel="مانده">@BalanceText(context.Balance)</MudTd>
                <MudTd><MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Primary" Size="Size.Small" /></MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Color="Color.Secondary">در این بازه، گردشی برای این تفصیلی در این سطح ثبت نشده است.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}
else if (_report == "daily")
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">برای باز کردن سند روی هر ردیف دفتر روزنامه کلیک کنید.</MudText>
        <MudTable T="DailyBookRow" Items="_dailyBook" Hover="true" Dense="true" Striped="true" RowsPerPage="25"
                  OnRowClick="OnDailyRowClick">
            <HeaderContent>
                <MudTh>تاریخ</MudTh><MudTh>سند</MudTh><MudTh>حساب</MudTh><MudTh>شرح ردیف</MudTh>
                <MudTh>بدهکار</MudTh><MudTh>بستانکار</MudTh><MudTh>مانده</MudTh><MudTh>وضعیت</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@DateText(context.DocumentDate)</MudTd>
                <MudTd><MudText Color="Color.Primary"><b>@DocumentNumber(context.DocumentId, context.DocumentNumber)</b></MudText></MudTd>
                <MudTd>@context.AccountCode — @context.AccountTitle</MudTd>
                <MudTd>@(context.Description ?? "")</MudTd>
                <MudTd>@Money(context.Debit)</MudTd><MudTd>@Money(context.Credit)</MudTd>
                <MudTd>@BalanceText(context.Balance)</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@AccountingDocumentStatus.Title(context.Status)</MudChip></MudTd>
                <MudTd><MudIcon Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Primary" Size="Size.Small" /></MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 25, 50, 100 })" /></PagerContent>
            <NoRecordsContent><MudText Color="Color.Secondary">ردیفی نیست.</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>
}
else if (_report == "ledger")
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">برای مشاهده گردش تفصیلی و سپس سند، روی حساب کلیک کنید.</MudText>
        <MudTable T="GeneralLedgerRow" Items="_ledger" Hover="true" Dense="true" Striped="true" RowsPerPage="25"
                  OnRowClick="OnLedgerRowClickAsync">
            <HeaderContent><MudTh>کد کامل حساب</MudTh><MudTh>حساب</MudTh><MudTh>بدهکار</MudTh><MudTh>بستانکار</MudTh><MudTh>مانده</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                <MudTd><code>@context.AccountCode</code></MudTd><MudTd><MudText Color="Color.Primary"><b>@context.AccountTitle</b></MudText></MudTd>
                <MudTd>@Money(context.Debit)</MudTd><MudTd>@Money(context.Credit)</MudTd><MudTd>@BalanceText(context.Balance)</MudTd>
                <MudTd><MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Primary" Size="Size.Small" /></MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 25, 50, 100 })" /></PagerContent>
            <NoRecordsContent><MudText Color="Color.Secondary">ردیفی نیست.</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>
}
else
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">برای مشاهده گردش تفصیلی و سپس سند، روی حساب کلیک کنید.</MudText>
        <MudTable T="TrialBalanceRow" Items="_trial" Hover="true" Dense="true" Striped="true" RowsPerPage="25"
                  OnRowClick="OnTrialRowClickAsync">
            <HeaderContent><MudTh>کد</MudTh><MudTh>حساب</MudTh><MudTh>ماهیت</MudTh><MudTh>بدهکار</MudTh><MudTh>بستانکار</MudTh><MudTh>مانده</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                <MudTd><code>@context.AccountCode</code></MudTd><MudTd><MudText Color="Color.Primary"><b>@context.AccountTitle</b></MudText></MudTd><MudTd>@NatureTitle(context.AccountType)</MudTd>
                <MudTd>@Money(context.Debit)</MudTd><MudTd>@Money(context.Credit)</MudTd><MudTd>@BalanceText(context.Balance)</MudTd>
                <MudTd><MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Primary" Size="Size.Small" /></MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 25, 50, 100 })" /></PagerContent>
            <NoRecordsContent><MudText Color="Color.Secondary">ردیفی نیست.</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "accounting";
    private const int DetailPageSize = 50;
    private static readonly DateTime AllHistoryFrom = new(1753, 1, 1);

    [Parameter, SupplyParameterFromQuery(Name = "report")] public string? RequestedReport { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "accountCode")] public string? RequestedAccountCode { get; set; }

    private readonly List<DailyBookRow> _dailyBook = new();
    private readonly List<GeneralLedgerRow> _ledger = new();
    private readonly List<TrialBalanceRow> _trial = new();
    private readonly List<AccountingHierarchyRow> _selectedDetails = new();
    // مسیر مرور گزارش «گردش تفصیلی»: تفصیلی → کل → معین → زیرتفصیلی‌ها → سند.
    private readonly List<AccountingHierarchyRow> _detilPlacements = new();
    private List<AccountingHierarchyRow> _detilDrill = new();
    private BaseDetilRow? _detilEntity;
    private AccountingHierarchyRow? _detilCol;
    private AccountingHierarchyRow? _detilMoein;
    private int _detilLevel = 1;
    private List<AccountingHierarchyRow> _hierarchy = new();
    private List<DetailAccountTransactionRow> _detailTransactions = new();
    private AccountingHierarchyRow? _selectedCol;
    private AccountingHierarchyRow? _selectedMoein;
    private DetailAccountSummaryRow? _detailSummary;
    private string _report = "hierarchy";
    private string? _detailReturnReport;
    private string? _detailAccountCode;
    private string? _status;
    private string _documentNumber = "";
    private DateTime? _from;
    private DateTime? _to = DateTime.Today;
    private int _hierarchyLevel = 1;
    private int _detailPage;
    private long _detailTotalRows;
    private bool _loading = true;
    private bool _lastLoadFailed;
    private string _appliedQueryKey = "";

    private string HierarchyTitle => _hierarchyLevel switch
    {
        1 => "حساب‌های کل",
        2 => $"حساب‌های معینِ «{_selectedCol?.Title}»",
        3 => $"تفصیلی‌های «{_selectedMoein?.Title}»",
        _ => $"زیرمجموعه‌های تفصیلی «{_selectedDetails.LastOrDefault()?.Title}»"
    };

    private string DetilDrillTitle => _detilLevel switch
    {
        1 => $"حساب‌های کلِ گردش «{_detilEntity?.Title}»",
        2 => $"حساب‌های معینِ «{_detilCol?.Title}» برای «{_detilEntity?.Title}»",
        3 => $"مسیرهای تفصیلی «{_detilEntity?.Title}» زیر «{_detilMoein?.Title}»",
        _ => $"زیرمجموعه‌های تفصیلی «{_detilPlacements.LastOrDefault()?.Title}»"
    };

    private string DetailPageCaption => $"نمایش {(_detailTotalRows == 0 ? 0 : _detailPage * DetailPageSize + 1)} تا {Math.Min((_detailPage + 1L) * DetailPageSize, _detailTotalRows)} از {_detailTotalRows:N0}";

    protected override async Task OnParametersSetAsync()
    {
        var queryKey = $"{RequestedReport}|{RequestedAccountCode}";
        if (_appliedQueryKey == queryKey && !_loading)
            return;

        _appliedQueryKey = queryKey;
        if (RequestedReport is "hierarchy" or "detail" or "daily" or "ledger" or "trial")
            _report = RequestedReport;
        if ((_report is "daily" or "ledger" or "trial") && _from is null)
            _from = DateTime.Today.AddMonths(-1);

        if (!string.IsNullOrWhiteSpace(RequestedAccountCode))
        {
            _report = "detail";
            _detailAccountCode = RequestedAccountCode.Trim();
            _detailReturnReport = null;
        }

        await LoadAsync();
    }

    private async Task ChangeReportAsync(string value)
    {
        if (string.IsNullOrWhiteSpace(value) || value == _report)
            return;

        _report = value;
        _from = _report is "detail" or "hierarchy" ? null : DateTime.Today.AddMonths(-1);
        _detailReturnReport = null;
        _detilEntity = null;
        ClearDetilDrill();
        ClearDetail();
        ClearHierarchy();
        await LoadAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        _detailPage = 0;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _lastLoadFailed = false;
        if (_from?.Date > _to?.Date)
        {
            _lastLoadFailed = true;
            Snackbar.Add("تاریخ شروع نمی‌تواند بعد از تاریخ پایان باشد.", Severity.Warning);
            return;
        }

        _loading = true;
        try
        {
            var from = _from?.Date ?? AllHistoryFrom;
            var to = _to?.Date ?? DateTime.Today;
            switch (_report)
            {
                case "hierarchy":
                    if (!string.IsNullOrWhiteSpace(_detailAccountCode))
                        await LoadDetailAsync(from, to);
                    else
                        await LoadHierarchyAsync(from, to);
                    break;
                case "detail":
                    // گردش تفصیلی: تا وقتی به برگ نرسیده‌ایم، سطح جاری درخت را نشان می‌دهیم.
                    if (!string.IsNullOrWhiteSpace(_detailAccountCode))
                        await LoadDetailAsync(from, to);
                    else if (_detilEntity is not null)
                        await LoadDetilDrillAsync(from, to);
                    else
                    {
                        _detilDrill = new();
                        ClearDetailRows();
                    }
                    break;
                case "daily":
                    _dailyBook.Clear();
                    _dailyBook.AddRange(await Db.QueryAsync<DailyBookRow>(Schema, "DailyBookReport", ReportParameters(from, to)));
                    break;
                case "ledger":
                    _ledger.Clear();
                    _ledger.AddRange(await Db.QueryAsync<GeneralLedgerRow>(Schema, "GeneralLedgerReport", new
                    {
                        AccountId = (int?)null,
                        FromDate = from,
                        ToDate = to,
                        StatusFilter = _status ?? "",
                        DocumentNumber = _documentNumber ?? "",
                        CompanyId = Session.ActiveCompanyId,
                        FiscalYearId = Session.ActiveFiscalYearId
                    }));
                    break;
                default:
                    _trial.Clear();
                    _trial.AddRange(await Db.QueryAsync<TrialBalanceRow>(Schema, "TrialBalanceReport", ReportParameters(from, to)));
                    break;
            }
        }
        catch (Exception ex)
        {
            _lastLoadFailed = true;
            Snackbar.Add($"خطا در بارگذاری گزارش: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private object ReportParameters(DateTime from, DateTime to) => new
    {
        FromDate = from,
        ToDate = to,
        StatusFilter = _status ?? "",
        DocumentNumber = _documentNumber ?? "",
        CompanyId = Session.ActiveCompanyId,
        FiscalYearId = Session.ActiveFiscalYearId
    };

    private async Task LoadHierarchyAsync(DateTime from, DateTime to)
    {
        var result = await Db.QueryAsync<AccountingHierarchyRow>(Schema, "AccountingHierarchyReport", new
        {
            Level = Math.Min(_hierarchyLevel, 3),
            ColId = _selectedCol?.NodeId,
            MoeinId = _selectedMoein?.NodeId,
            ParentLinkId = _selectedDetails.LastOrDefault()?.LinkId,
            FromDate = from,
            ToDate = to,
            StatusFilter = _status ?? "",
            DocumentNumber = _documentNumber ?? "",
            CompanyId = Session.ActiveCompanyId,
            FiscalYearId = Session.ActiveFiscalYearId
        });
        _hierarchy = result.ToList();
    }

    /// <summary>یک سطح از مرور «گردش تفصیلی» را می‌خواند (کل ← معین ← زیرتفصیلی‌ها).</summary>
    private async Task LoadDetilDrillAsync(DateTime from, DateTime to)
    {
        ClearDetailRows();
        if (_detilEntity is null)
        {
            _detilDrill = new();
            return;
        }

        var rows = await Db.QueryAsync<AccountingHierarchyRow>(Schema, "DetailTurnoverReport", new
        {
            DetilId = _detilEntity.DetilId,
            Level = Math.Min(_detilLevel, 3),
            ColId = _detilCol?.ColId ?? _detilCol?.NodeId,
            MoeinId = _detilMoein?.MoeinId ?? _detilMoein?.NodeId,
            ParentLinkId = _detilPlacements.LastOrDefault()?.LinkId,
            FromDate = from,
            ToDate = to,
            StatusFilter = _status ?? "",
            DocumentNumber = _documentNumber ?? "",
            CompanyId = Session.ActiveCompanyId,
            FiscalYearId = Session.ActiveFiscalYearId
        });
        _detilDrill = rows.ToList();
    }

    private async Task LoadDetailAsync(DateTime from, DateTime to)
    {
        _detailSummary = null;
        ClearDetailRows();
        if (string.IsNullOrWhiteSpace(_detailAccountCode))
            return;

        _detailSummary = await Db.QueryFirstOrDefaultAsync<DetailAccountSummaryRow>(Schema, "DetailAccountSummary", new
        {
            AccountCode = _detailAccountCode,
            FromDate = from,
            ToDate = to,
            StatusFilter = _status ?? "",
            DocumentNumber = _documentNumber ?? "",
            CompanyId = Session.ActiveCompanyId,
            FiscalYearId = Session.ActiveFiscalYearId
        });

        if (_detailSummary is null)
        {
            Snackbar.Add("مسیر تفصیلی انتخاب‌شده در ساختار حساب‌ها پیدا نشد.", Severity.Warning);
            return;
        }

        // ورود مستقیم با ?accountCode= یا از دفتر کل/تراز: تفصیلیِ متناظر را هم
        // می‌شناسیم تا دکمهٔ «بازگشت» به مرور همان تفصیلی برگردد، نه به صفحهٔ خالی.
        if (_report == "detail" && _detilEntity is null && !string.IsNullOrWhiteSpace(_detailSummary.DetilCode))
        {
            try
            {
                _detilEntity = await Db.QueryFirstOrDefaultAsync<BaseDetilRow>(
                    Schema, "BaseDetilByCode", new { DetilCode = _detailSummary.DetilCode, CompanyId = Session.ActiveCompanyId });
            }
            catch
            {
                _detilEntity = null;
            }
        }

        await LoadDetailTransactionsAsync(from, to);
        if (_detailTransactions.Count == 0 && _detailTotalRows > 0 && _detailPage > 0)
        {
            _detailPage = 0;
            await LoadDetailTransactionsAsync(from, to);
        }
    }

    private async Task LoadDetailTransactionsAsync(DateTime from, DateTime to)
    {
        var rows = await Db.QueryAsync<DetailAccountTransactionRow>(Schema, "DetailAccountTransactions", new
        {
            AccountCode = _detailAccountCode,
            FromDate = from,
            ToDate = to,
            StatusFilter = _status ?? "",
            DocumentNumber = _documentNumber ?? "",
            SkipRows = _detailPage * DetailPageSize,
            TakeSize = DetailPageSize,
            CompanyId = Session.ActiveCompanyId,
            FiscalYearId = Session.ActiveFiscalYearId
        });
        _detailTransactions = rows.ToList();
        _detailTotalRows = _detailTransactions.FirstOrDefault()?.TotalRows ?? 0;
    }

    private async Task OnHierarchyRowClickAsync(TableRowClickEventArgs<AccountingHierarchyRow> args)
    {
        if (args.Item is not { } row)
            return;

        _detailPage = 0;

        if (row.NodeType == "BaseCol")
        {
            _selectedCol = row;
            _selectedMoein = null;
            _selectedDetails.Clear();
            _hierarchyLevel = 2;
            await LoadAsync();
            return;
        }

        if (row.NodeType == "BaseMoein")
        {
            _selectedMoein = row;
            _selectedDetails.Clear();
            _hierarchyLevel = 3;
            await LoadAsync();
            return;
        }

        if (row.NodeType != "BaseDetil" || string.IsNullOrWhiteSpace(row.AccountCode))
        {
            Snackbar.Add("مسیر حساب انتخاب‌شده معتبر نیست.", Severity.Warning);
            return;
        }

        if (row.ChildCount > 0)
        {
            _selectedDetails.Add(row);
            _hierarchyLevel = row.Level + 1;
            await LoadAsync();
            if (!_lastLoadFailed && _hierarchy.Count > 0)
                return;

            _selectedDetails.RemoveAt(_selectedDetails.Count - 1);
            _hierarchyLevel = row.Level;
            if (_lastLoadFailed)
                return;
        }

        await OpenAccountDetailAsync(row.AccountCode, "hierarchy");
    }

    private async Task OnDetilDrillRowClickAsync(TableRowClickEventArgs<AccountingHierarchyRow> args)
    {
        if (args.Item is not { } row || _detilEntity is null)
            return;

        _detailPage = 0;

        if (row.NodeType == "BaseCol")
        {
            _detilCol = row;
            _detilMoein = null;
            _detilPlacements.Clear();
            _detilLevel = 2;
            await LoadAsync();
            return;
        }

        if (row.NodeType == "BaseMoein")
        {
            _detilMoein = row;
            _detilPlacements.Clear();
            _detilLevel = 3;
            await LoadAsync();
            return;
        }

        if (row.NodeType != "BaseDetil" || string.IsNullOrWhiteSpace(row.AccountCode))
        {
            Snackbar.Add("مسیر حساب انتخاب‌شده معتبر نیست.", Severity.Warning);
            return;
        }

        // والدِ تفصیلی → یک سطح پایین‌تر؛ برگ نهایی → گردش و سند.
        if (row.ChildCount > 0)
        {
            _detilPlacements.Add(row);
            _detilLevel = row.Level + 1;
            await LoadAsync();
            if (!_lastLoadFailed && _detilDrill.Count > 0)
                return;

            _detilPlacements.RemoveAt(_detilPlacements.Count - 1);
            _detilLevel = row.Level;
            if (_lastLoadFailed)
                return;
        }

        await OpenAccountDetailAsync(row.AccountCode, "detail");
    }

    private async Task OnLedgerRowClickAsync(TableRowClickEventArgs<GeneralLedgerRow> args)
    {
        if (args.Item is { } row)
            await OpenAccountDetailAsync(row.AccountCode, "ledger");
    }

    private async Task OnTrialRowClickAsync(TableRowClickEventArgs<TrialBalanceRow> args)
    {
        if (args.Item is { } row)
            await OpenAccountDetailAsync(row.AccountCode, "trial");
    }

    private async Task OpenAccountDetailAsync(string accountCode, string returnReport)
    {
        if (string.IsNullOrWhiteSpace(accountCode))
        {
            Snackbar.Add("کد حساب انتخاب‌شده معتبر نیست.", Severity.Warning);
            return;
        }

        var originalReport = _report;
        _detailReturnReport = returnReport;
        _detailAccountCode = accountCode.Trim();
        _detailPage = 0;
        _detailSummary = null;
        if (returnReport != "hierarchy")
            _report = "detail";

        await LoadAsync();
        if (_detailSummary is not null)
            return;

        _report = originalReport;
        _detailReturnReport = null;
        _detailAccountCode = null;
    }

    private async Task ResetHierarchyAsync()
    {
        ClearDetail();
        ClearHierarchy();
        await LoadAsync();
    }

    private async Task ShowSelectedColAsync()
    {
        ClearDetail();
        _selectedMoein = null;
        _selectedDetails.Clear();
        _hierarchyLevel = 2;
        await LoadAsync();
    }

    private async Task ShowSelectedMoeinAsync()
    {
        ClearDetail();
        _selectedDetails.Clear();
        _hierarchyLevel = 3;
        await LoadAsync();
    }

    private async Task ShowDetailChildrenAsync(AccountingHierarchyRow detail)
    {
        ClearDetail();
        var index = _selectedDetails.FindIndex(x => x.LinkId == detail.LinkId);
        if (index < 0)
            return;
        if (index + 1 < _selectedDetails.Count)
            _selectedDetails.RemoveRange(index + 1, _selectedDetails.Count - index - 1);
        _hierarchyLevel = detail.Level + 1;
        await LoadAsync();
    }

    private bool IsCurrentDetailParent(AccountingHierarchyRow detail)
        => _selectedDetails.LastOrDefault()?.LinkId == detail.LinkId;

    private async Task BackFromDetailAsync()
    {
        var returnReport = _detailReturnReport;
        ClearDetail();
        _detailReturnReport = null;

        if (returnReport is "ledger" or "trial")
            _report = returnReport;
        else if (returnReport == "hierarchy")
            _report = "hierarchy";

        await LoadAsync();
    }

    private async Task<IEnumerable<BaseDetilRow>> SearchDetilAsync(string value, CancellationToken ct)
    {
        try
        {
            return await Db.QueryAsync<BaseDetilRow>(Schema, "BaseDetilSearch", new { SearchText = value ?? "", CompanyId = Session.ActiveCompanyId });
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در جستجوی تفصیلی: {ex.Message}", Severity.Error);
            return Array.Empty<BaseDetilRow>();
        }
    }

    private static string DetilDisplay(BaseDetilRow? d)
        => d is null ? string.Empty : $"{d.DetilCode} | {d.Title}";

    private async Task OnDetilEntityChangedAsync(BaseDetilRow? value)
    {
        _detilEntity = value;
        ClearDetilDrill();
        ClearDetail();
        _detailReturnReport = null;
        await LoadAsync();
    }

    private async Task ShowDetilColsAsync()
    {
        ClearDetail();
        _detilCol = null;
        _detilMoein = null;
        _detilPlacements.Clear();
        _detilLevel = 1;
        await LoadAsync();
    }

    private async Task ShowDetilMoeinsAsync()
    {
        ClearDetail();
        _detilMoein = null;
        _detilPlacements.Clear();
        _detilLevel = 2;
        await LoadAsync();
    }

    private async Task ShowDetilPlacementsAsync()
    {
        ClearDetail();
        _detilPlacements.Clear();
        _detilLevel = 3;
        await LoadAsync();
    }

    private async Task ShowDetilChildrenAsync(AccountingHierarchyRow node)
    {
        ClearDetail();
        var index = _detilPlacements.FindIndex(x => x.LinkId == node.LinkId);
        if (index < 0)
            return;
        if (index + 1 < _detilPlacements.Count)
            _detilPlacements.RemoveRange(index + 1, _detilPlacements.Count - index - 1);
        _detilLevel = node.Level + 1;
        await LoadAsync();
    }

    private bool IsCurrentPlacement(AccountingHierarchyRow node)
        => _detilPlacements.LastOrDefault()?.LinkId == node.LinkId;

    private void ClearDetilDrill()
    {
        _detilCol = null;
        _detilMoein = null;
        _detilPlacements.Clear();
        _detilLevel = 1;
        _detilDrill = new();
    }

    private async Task PickDetailAsync()
    {
        try
        {
            var picked = await Picker.PickAsync(new AccountPickerOptions
            {
                Title = "انتخاب حساب تفصیلی برای گزارش گردش",
                AllowedType = AccountPickerType.Detil,
                TransactionalOnly = true
            });
            if (picked is null)
                return;
            if (string.IsNullOrWhiteSpace(picked.AccountCode))
            {
                Snackbar.Add("کد حساب انتخاب‌شده نامعتبر است.", Severity.Warning);
                return;
            }

            // انتخاب از درخت = انتخابِ همان موجودیت تفصیلی؛ مرور از سطح «حساب‌های کل»
            // شروع می‌شود تا کاربر ببیند این تفصیلی در کدام کل‌ها گردش دارد.
            _detailReturnReport = null;
            _detailAccountCode = null;
            _detailPage = 0;
            ClearDetail();
            ClearDetilDrill();
            _detilEntity = await FindDetilEntityAsync(picked);
            if (_detilEntity is null)
                Snackbar.Add("موجودیت تفصیلی این مسیر پیدا نشد.", Severity.Warning);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در انتخاب تفصیلی: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>موجودیت تفصیلیِ نتیجهٔ Picker را پیدا می‌کند (کد ۷ رقمی = یکتا در کل سیستم).</summary>
    private async Task<BaseDetilRow?> FindDetilEntityAsync(AccountPickerResult picked)
    {
        var code = string.IsNullOrWhiteSpace(picked.Code) ? null : picked.Code.Trim();
        if (code is null && !string.IsNullOrWhiteSpace(picked.AccountCode) && picked.AccountCode.Length >= 7)
            code = picked.AccountCode[^7..];
        if (string.IsNullOrWhiteSpace(code))
            return null;

        return await Db.QueryFirstOrDefaultAsync<BaseDetilRow>(Schema, "BaseDetilByCode", new { DetilCode = code, CompanyId = Session.ActiveCompanyId });
    }

    private async Task ChangeDetailPageAsync(int delta)
    {
        var next = _detailPage + delta;
        if (next < 0 || (_detailTotalRows > 0 && next * DetailPageSize >= _detailTotalRows))
            return;
        _detailPage = next;
        await LoadAsync();
    }

    private void OnDailyRowClick(TableRowClickEventArgs<DailyBookRow> args)
    {
        if (args.Item is { } row)
            OpenDocument(row.DocumentId);
    }

    private void OnDetailTransactionRowClick(TableRowClickEventArgs<DetailAccountTransactionRow> args)
    {
        if (args.Item is { } row)
            OpenDocument(row.DocumentId);
    }

    private void OpenDocument(int documentId)
    {
        try
        {
            if (documentId <= 0)
            {
                Snackbar.Add("شناسه سند نامعتبر است.", Severity.Warning);
                return;
            }
            if (!CanOpenDocument)
            {
                Snackbar.Add("دسترسی مشاهده سند حسابداری را ندارید.", Severity.Warning);
                return;
            }
            Nav.NavigateTo($"/accounting/document/{documentId}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در باز کردن سند: {ex.Message}", Severity.Error);
        }
    }

    private bool CanOpenDocument
    {
        get
        {
            try { return Session.HasPermission(TarazinPermissions.For("accounting", TarazinActions.View)); }
            catch { return false; }
        }
    }

    private void ClearHierarchy()
    {
        _selectedCol = null;
        _selectedMoein = null;
        _selectedDetails.Clear();
        _hierarchyLevel = 1;
    }

    private void ClearDetail()
    {
        _detailSummary = null;
        _detailAccountCode = null;
        _detailPage = 0;
        ClearDetailRows();
    }

    private void ClearDetailRows()
    {
        _detailTransactions.Clear();
        _detailTotalRows = 0;
    }

    private static string DocumentNumber(int id, string? number)
        => string.IsNullOrWhiteSpace(number) ? id.ToString() : number;

    private static string Money(decimal value) => value == 0 ? "—" : value.ToString("N0");

    private static string BalanceText(decimal value)
        => value == 0 ? "صفر" : $"{Math.Abs(value):N0} {(value > 0 ? "بدهکار" : "بستانکار")}";

    private static string DateText(DateTime value) => value.ToString("yyyy/MM/dd");

    private static string NatureTitle(string? value) => value switch
    {
        AccountNatureKind.Debit => "بدهکار",
        AccountNatureKind.Credit => "بستانکار",
        AccountNatureKind.Both => "هر دو",
        // AccountType قدیمیِ تراز آزمایشی مستقل از ماهیت جداول پایه است.
        "Asset" => "دارایی (بدهکار)",
        "Expense" => "هزینه (بدهکار)",
        "Liability" => "بدهی (بستانکار)",
        "Equity" => "حقوق مالکانه (بستانکار)",
        "Income" => "درآمد (بستانکار)",
        _ => "—"
    };

    private static Color StatusColor(string? status) => AccountingDocumentStatus.Normalize(status) switch
    {
        AccountingDocumentStatus.Finalized => Color.Success,
        AccountingDocumentStatus.Confirmed => Color.Info,
        AccountingDocumentStatus.Draft => Color.Warning,
        _ => Color.Default
    };
}
