@page "/accounting/document/{DocumentId:int}"
@using Tarazin.Modules.Accounting.Components
@inject DbService Db
@inject UserSession Session
@inject IDialogService DialogService
@inject AccountPickerService AccountPicker
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>سند حسابداری — حسابداری</PageTitle>

<PageHeader Title="@($"سند {(_document?.DocumentNumber ?? "")}")"
            Subtitle="نمایش، ویرایش، تغییر وضعیت و حذف سند حسابداری. روی ردیف کلیک کنید تا سبز شود و مرور تفصیلی فعال شود."
            Eyebrow="حسابداری">
    <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowForward"
               Href="/accounting">
        بازگشت به اسناد
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="LoadAsync" Class="ms-2" Disabled="_loading">
        تازه‌سازی
    </MudButton>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_document is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        سند پیدا نشد یا حذف شده است.
    </MudAlert>
}
else
{
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <div class="d-flex align-center flex-wrap mb-3" style="gap:8px">
            <MudChip T="string" Size="Size.Small" Color="@StatusColor(_status)">
                وضعیت: @SafeTitle(_status)
            </MudChip>
            @if (IsReadOnly)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                         Icon="@Icons.Material.Filled.Lock">
                    @ReadOnlyReason
                </MudChip>
            }
        </div>

        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <MudDatePicker Label="تاریخ سند" Culture="FaCulture" @bind-Date="_documentDate"
                               ReadOnly="IsReadOnly" Disabled="IsReadOnly" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="string" Label="نوع سند" @bind-Value="_documentType" Variant="Variant.Outlined"
                           ReadOnly="IsReadOnly" Disabled="IsReadOnly">
                    <MudSelectItem Value="@("Journal")">سند روزنامه</MudSelectItem>
                    <MudSelectItem Value="@("Receipt")">دریافت</MudSelectItem>
                    <MudSelectItem Value="@("Payment")">پرداخت</MudSelectItem>
                    <MudSelectItem Value="@("Purchase")">خرید</MudSelectItem>
                    <MudSelectItem Value="@("Sale")">فروش</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="12" md="4">
                <MudTextField Label="طرف حساب (اختیاری)" @bind-Value="_counterParty" Variant="Variant.Outlined"
                              ReadOnly="IsReadOnly" Disabled="IsReadOnly" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-3">ردیف‌های سند — انتخاب ردیف برای مرور تفصیلی</MudText>

        <MudTable T="JournalLineRow" Items="_lines" Hover="true" Dense="true" Class="mb-4"
                  @bind-SelectedItem="_selectedLine" SelectOnRowClick="true"
                  RowStyleFunc="SelectedRowStyle"
                  OnRowClick="OnRowClick">
            <HeaderContent>
                <MudTh style="width:42%">حساب</MudTh>
                <MudTh>شرح</MudTh>
                <MudTh style="width:130px">بدهکار</MudTh>
                <MudTh style="width:130px">بستانکار</MudTh>
                <MudTh style="width:48px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="حساب">
                    <AccountPickerField Value="@context.PickedAccount"
                                        ValueChanged="(v) => OnAccountPick(_lines.IndexOf(context), v)"
                                        PickerOptions="@(new AccountPickerOptions { TransactionalOnly = true })"
                                        ButtonLabel="انتخاب حساب"
                                        EmptyText="@AccountLabel(context)"
                                        Disabled="IsReadOnly" ReadOnly="IsReadOnly" />
                </MudTd>
                <MudTd DataLabel="شرح">
                    <MudTextField T="string" Value="@context.Description"
                                  ValueChanged="@(v => context.Description = v)"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  ReadOnly="IsReadOnly" Disabled="IsReadOnly" />
                </MudTd>
                <MudTd DataLabel="بدهکار">
                    <MudNumericField T="decimal" Value="@context.Debit"
                                     ValueChanged="v => { context.Debit = v; }" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Min="0" Format="#,##0.##"
                                     ReadOnly="IsReadOnly" Disabled="IsReadOnly" />
                </MudTd>
                <MudTd DataLabel="بستانکار">
                    <MudNumericField T="decimal" Value="@context.Credit"
                                     ValueChanged="v => { context.Credit = v; }" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Min="0" Format="#,##0.##"
                                     ReadOnly="IsReadOnly" Disabled="IsReadOnly" />
                </MudTd>
                <MudTd DataLabel="">
                    <span @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error"
                                       Size="Size.Small" Disabled="@(IsReadOnly || _lines.Count <= 1)"
                                       OnClick="@(() => ConfirmRemoveLineAsync(_lines.IndexOf(context)))" />
                    </span>
                </MudTd>
            </RowTemplate>
        </MudTable>

        @if (_selectedLine is not null)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                ردیف انتخاب شد: <b>@(_selectedLine.AccountCode ?? "—") — @(_selectedLine.AccountTitle ?? "")</b>
            </MudAlert>
        }

        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.body2">جمع بدهکار: <b>@SafeMoney(TotalDebit)</b></MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.body2">جمع بستانکار: <b>@SafeMoney(TotalCredit)</b></MudText>
            </MudItem>
            <MudItem xs="12">
                <MudChip T="string" Color="@(IsBalanced ? Color.Success : Color.Error)" Size="Size.Small">
                    @(IsBalanced ? "✔ متوازن" : "✘ نامتوازن")
                </MudChip>
            </MudItem>
        </MudGrid>

        <div class="d-flex flex-wrap" style="gap:8px">
            @if (CanShowSelectedDetail)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ShowSelectedDetailAsync"
                           StartIcon="@Icons.Material.Filled.ManageSearch">
                    نمایش تفصیلی
                </MudButton>
            }
            else
            {
                <MudTooltip Text="یک ردیف با حساب تفصیلی انتخاب کنید تا مرور گردش نمایش داده شود.">
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Disabled="true" StartIcon="@Icons.Material.Filled.ManageSearch">
                        نمایش تفصیلی
                    </MudButton>
                </MudTooltip>
            }

            @if (!IsReadOnly)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddLine"
                           StartIcon="@Icons.Material.Filled.Add" Class="ms-2">
                    + ردیف
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy"
                           StartIcon="@Icons.Material.Filled.Save" Class="ms-2">
                    ذخیره تغییرات
                </MudButton>
            }
        </div>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.subtitle1" Class="mb-3">عملیات سند</MudText>
        <div class="d-flex flex-wrap" style="gap:8px">
            @if (NextStatus is not null && CanChangeStatusTo(NextStatus))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="_busy"
                           StartIcon="@Icons.Material.Filled.ArrowUpward"
                           OnClick="@(() => ChangeStatusAsync(NextStatus))">
                    @($"تغییر به «{SafeTitle(NextStatus)}»")
                </MudButton>
            }
            @if (PreviousStatus is not null && CanChangeStatusTo(PreviousStatus))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="_busy"
                           StartIcon="@Icons.Material.Filled.ArrowDownward"
                           OnClick="@(() => ChangeStatusAsync(PreviousStatus))">
                    @($"برگشت به «{SafeTitle(PreviousStatus)}»")
                </MudButton>
            }
            @if (CanDeleteDocument)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_busy"
                           StartIcon="@Icons.Material.Filled.DeleteOutline" OnClick="DeleteAsync">
                    حذف سند
                </MudButton>
            }
        </div>
    </MudPaper>
}

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "accounting";

    [Parameter] public int DocumentId { get; set; }

    private DailyDocumentRow? _document;
    private List<JournalLineRow> _lines = new();
    private JournalLineRow? _selectedLine;
    private DateTime? _documentDate = DateTime.Today;
    private string _documentType = "Journal";
    private string _counterParty = "";
    private string _status = AccountingDocumentStatus.Draft;
    private bool _loading = true;
    private bool _busy;

    private decimal TotalDebit
    {
        get { try { return _lines.Sum(l => l.Debit); } catch { return 0; } }
    }
    private decimal TotalCredit
    {
        get { try { return _lines.Sum(l => l.Credit); } catch { return 0; } }
    }
    private bool IsBalanced
    {
        get { try { return TotalDebit == TotalCredit && TotalDebit > 0; } catch { return false; } }
    }

    private bool CanShowSelectedDetail
    {
        get
        {
            try
            {
                return Session.HasPermission(TarazinPermissions.For("accounting", TarazinActions.Reports))
                       && _selectedLine is not null
                       && !string.IsNullOrWhiteSpace(_selectedLine.AccountCode)
                       && _selectedLine.AccountCode.Length >= 12;
            }
            catch { return false; }
        }
    }

    private string SelectedRowStyle(JournalLineRow row, int index)
    {
        try
        {
            if (row is not null && ReferenceEquals(row, _selectedLine))
                return "background-color: #c8e6c9; border-left: 4px solid #2e7d32;";
            return "";
        }
        catch { return ""; }
    }

    private void OnRowClick(TableRowClickEventArgs<JournalLineRow> args)
    {
        try
        {
            if (args?.Item is not null)
                _selectedLine = args.Item;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در انتخاب ردیف: {ex.Message}", Severity.Error);
        }
    }

    private bool HasEditPermission
    {
        get { try { return Session.HasPermission(TarazinPermissions.DocumentEdit); } catch { return false; } }
    }
    private bool IsStatusEditable
    {
        get { try { return AccountingDocumentStatus.IsEditable(_status); } catch { return false; } }
    }
    private bool CanEditDocument => HasEditPermission && IsStatusEditable;
    private bool IsReadOnly => !CanEditDocument;

    private bool CanDeleteDocument
    {
        get
        {
            try { return Session.HasPermission(TarazinPermissions.DocumentDelete) && IsStatusEditable; }
            catch { return false; }
        }
    }

    private string ReadOnlyReason => !HasEditPermission
        ? "فقط خواندنی — دسترسی ویرایش سند حسابداری را ندارید."
        : "فقط خواندنی — سند در وضعیت تأییدشده/تأیید نهایی قابل ویرایش نیست.";

    private string? NextStatus
    {
        get { try { return AccountingDocumentStatus.Next(_status); } catch { return null; } }
    }
    private string? PreviousStatus
    {
        get { try { return AccountingDocumentStatus.Previous(_status); } catch { return null; } }
    }

    private bool CanChangeStatusTo(string? target)
    {
        try
        {
            var permission = AccountingDocumentStatus.PermissionFor(_status, target);
            return permission is not null && Session.HasPermission(permission);
        }
        catch { return false; }
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _document = await Db.QueryFirstOrDefaultAsync<DailyDocumentRow>(Schema, "DocumentById", new { DocumentId, CompanyId = Session.ActiveCompanyId, FiscalYearId = Session.ActiveFiscalYearId });

            if (_document is null)
            {
                _lines = new();
                return;
            }

            _selectedLine = null;
            try { _status = AccountingDocumentStatus.Normalize(_document.Status); } catch { _status = AccountingDocumentStatus.Draft; }
            _documentDate = _document.DocumentDate;
            _documentType = string.IsNullOrWhiteSpace(_document.DocumentType) ? "Journal" : _document.DocumentType!;
            _counterParty = _document.CounterPartyName ?? "";

            var rows = await Db.QueryAsync<DocumentLineRow>(Schema, "DocumentLines", new { DocumentId, CompanyId = Session.ActiveCompanyId, FiscalYearId = Session.ActiveFiscalYearId });
            _lines = (rows ?? Array.Empty<DocumentLineRow>()).Select(r => new JournalLineRow
            {
                AccountId = r.AccountId,
                AccountCode = r.AccountCode,
                AccountTitle = r.Title,
                Description = r.Description ?? "",
                Debit = r.Debit,
                Credit = r.Credit,
                PickedAccount = new AccountPickerResult
                {
                    Id = r.AccountId,
                    Code = r.AccountCode.Length >= 7 ? r.AccountCode[^7..] : r.AccountCode,
                    AccountCode = r.AccountCode,
                    Title = r.Title,
                    NodeType = r.AccountCode.Length >= 12 ? "BaseDetil" : ""
                }
            }).ToList();

            if (_lines.Count == 0)
                AddLine();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در بارگذاری سند: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string AccountLabel(JournalLineRow line)
    {
        try
        {
            return string.IsNullOrWhiteSpace(line.AccountTitle) ? "— انتخاب حساب —" : $"{line.AccountCode} — {line.AccountTitle}";
        }
        catch { return "—"; }
    }

    private void AddLine()
    {
        try
        {
            if (IsReadOnly) return;
            _lines.Add(new JournalLineRow());
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در افزودن ردیف: {ex.Message}", Severity.Error);
        }
    }

    private async Task ConfirmRemoveLineAsync(int index)
    {
        try
        {
            if (IsReadOnly || _lines.Count <= 1 || index < 0 || index >= _lines.Count)
                return;

            var confirmed = await DialogService.ShowMessageBoxAsync(
                "تأیید حذف",
                "آیا این ردیف از سند حذف شود؟",
                yesText: "حذف",
                cancelText: "انصراف");

            if (confirmed is true)
            {
                if (ReferenceEquals(_lines[index], _selectedLine))
                    _selectedLine = null;
                _lines.RemoveAt(index);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در حذف ردیف: {ex.Message}", Severity.Error);
        }
    }

    private void OnAccountPick(int index, AccountPickerResult? picked)
    {
        try
        {
            if (IsReadOnly) return;
            if (index < 0 || index >= _lines.Count) return;
            var line = _lines[index];
            if (picked is null)
            {
                line.PickedAccount = null;
                line.AccountId = 0;
                line.AccountCode = "";
                line.AccountTitle = "";
                return;
            }
            line.PickedAccount = picked;
            line.AccountId = picked.Id;
            line.AccountCode = picked.AccountCode;
            line.AccountTitle = picked.Title;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در انتخاب حساب: {ex.Message}", Severity.Error);
        }
    }

    private async Task ShowSelectedDetailAsync()
    {
        try
        {
            if (!CanShowSelectedDetail || _selectedLine is null)
            {
                Snackbar.Add("برای مرور تفصیلی یک ردیف با حساب تفصیلی معتبر انتخاب کنید.", Severity.Warning);
                return;
            }

            var parameters = new DialogParameters
            {
                ["AccountCode"] = _selectedLine.AccountCode,
                ["AccountTitle"] = _selectedLine.AccountTitle
            };
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseButton = true,
                CloseOnEscapeKey = true
            };

            var dialog = await DialogService.ShowAsync<DetailAccountHistoryDialog>("مرور تفصیلی", parameters, options);
            await dialog.Result;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در نمایش دیالوگ مرور تفصیلی: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveAsync()
    {
        if (_busy) return;

        try
        {
            if (!CanEditDocument)
            {
                Snackbar.Add(ReadOnlyReason, Severity.Warning);
                return;
            }

            if (!IsBalanced)
            {
                Snackbar.Add("بدهی و بستانکاری سند باید برابر باشد.", Severity.Warning);
                return;
            }

            if (_lines.Any(l => (l.Debit <= 0 && l.Credit <= 0) || (l.Debit > 0 && l.Credit > 0)))
            {
                Snackbar.Add("هر ردیف باید فقط یک مبلغ بدهکار یا بستانکار مثبت داشته باشد.", Severity.Warning);
                return;
            }

            if (_lines.Any(l => l.AccountId == 0))
            {
                Snackbar.Add("برای تمام ردیف‌ها باید حساب انتخاب شود.", Severity.Warning);
                return;
            }

            _busy = true;

            var linesJson = System.Text.Json.JsonSerializer.Serialize(_lines.Select(l => new
            {
                l.AccountId,
                l.AccountCode,
                l.Description,
                l.Debit,
                l.Credit
            }));

            await Db.ExecuteAsync(Schema, "DocumentUpdate", new
            {
                DocumentId,
                LinesJson = linesJson,
                DocumentDate = _documentDate ?? DateTime.Today,
                DocumentType = _documentType,
                CounterPartyName = _counterParty,
                UpdatedBy = Session.UserName
            });

            Snackbar.Add("تغییرات سند ذخیره شد.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در ذخیره سند: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChangeStatusAsync(string? target)
    {
        if (_busy || target is null) return;

        try
        {
            if (!CanChangeStatusTo(target))
            {
                Snackbar.Add("دسترسی لازم برای این تغییر وضعیت را ندارید.", Severity.Warning);
                return;
            }

            var confirm = await DialogService.ShowMessageBoxAsync(
                "تأیید تغییر وضعیت",
                $"وضعیت سند از «{SafeTitle(_status)}» به «{SafeTitle(target)}» تغییر کند؟",
                yesText: "تأیید", cancelText: "انصراف");
            if (confirm is not true) return;

            _busy = true;

            await Db.ExecuteAsync(Schema, "DocumentStatusChange", new
            {
                DocumentId,
                NewStatus = target,
                ExpectedStatus = _status,
                UpdatedBy = Session.UserName,
                CompanyId = Session.ActiveCompanyId,
                FiscalYearId = Session.ActiveFiscalYearId
            });
            Snackbar.Add($"وضعیت سند به «{SafeTitle(target)}» تغییر کرد.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در تغییر وضعیت: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_busy) return;

        try
        {
            if (!CanDeleteDocument)
            {
                Snackbar.Add("امکان حذف این سند وجود ندارد (دسترسی یا وضعیت سند).", Severity.Warning);
                return;
            }

            var confirm = await DialogService.ShowMessageBoxAsync(
                "تأیید حذف سند",
                $"آیا از حذف سند «{_document?.DocumentNumber}» مطمئن هستید؟ این عملیات قابل بازگشت نیست.",
                yesText: "حذف سند", cancelText: "انصراف");

            if (confirm is not true) return;

            _busy = true;

            await Db.ExecuteAsync(Schema, "DocumentDelete", new
            {
                DocumentId,
                UpdatedBy = Session.UserName,
                CompanyId = Session.ActiveCompanyId,
                FiscalYearId = Session.ActiveFiscalYearId
            });
            Snackbar.Add("سند حذف شد.", Severity.Success);
            Nav.NavigateTo("/accounting");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در حذف سند: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static Color StatusColor(string? status)
    {
        try
        {
            return AccountingDocumentStatus.Normalize(status) switch
            {
                AccountingDocumentStatus.Finalized => Color.Success,
                AccountingDocumentStatus.Confirmed => Color.Info,
                AccountingDocumentStatus.Draft => Color.Warning,
                _ => Color.Default
            };
        }
        catch { return Color.Default; }
    }

    private static string SafeTitle(string? status)
    {
        try { return AccountingDocumentStatus.Title(status); } catch { return status ?? ""; }
    }

    private static string SafeMoney(decimal v)
    {
        try { return v == 0 ? "—" : v.ToString("N0"); } catch { return "—"; }
    }
}
