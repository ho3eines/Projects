@page "/accounting/special"
@using Tarazin.Models
@inject DbService Db
@inject UserSession Session
@inject AccountingContextService Context
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>عملیات ویژه — حسابداری</PageTitle>

<PageHeader Title="عملیات ویژه" Subtitle="انتخاب محیط کاری (شرکت و سال مالی فعال) و بستن سال مالی" />

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="pa-4 h-100">
            <MudText Typo="Typo.h6" Class="mb-3" Color="Color.Primary">انتخاب شرکت و سال مالی فعال</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                شرکت مالی و سال مالی فعال خود را تغییر دهید. تمام بخش‌های حسابداری، گزارش‌ها و شماره‌گذاری اسناد بلافاصله با محیط فعال جدید هماهنگ می‌شوند.
                <br />
                <b>سال مالی به‌صورت خودکار توسط سیستم مدیریت می‌شود</b> و شما فقط می‌توانید از بین سال‌های موجود انتخاب کنید.
            </MudText>

            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudSelect T="int" Label="شرکت مالی فعال" Value="_selectedCompId" ValueChanged="v => OnCompanyChanged(v)" Required="true" RequiredError="انتخاب شرکت الزامی است." Variant="Variant.Outlined" Class="mb-4">
                    <MudSelectItem T="int" Value="0">— انتخاب کنید —</MudSelectItem>
                    @foreach (var c in _companies)
                    {
                        <MudSelectItem T="int" Value="@c.CompanyId">@c.CompanyName</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="int" Label="سال مالی فعال" Value="_selectedYearId" ValueChanged="OnYearChanged" Required="true" RequiredError="انتخاب سال مالی الزامی است." Variant="Variant.Outlined" Class="mb-5" Disabled="@(_selectedCompId == 0)">
                    <MudSelectItem T="int" Value="0">— انتخاب کنید —</MudSelectItem>
                    @foreach (var y in _years)
                    {
                        <MudSelectItem T="int" Value="@y.FiscalYearId">
                            @y.YearName @(y.IsClosed ? "(بسته)" : "")
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveContextAsync" Disabled="@(!_isValid || _busy)" FullWidth="true">
                    تأیید و ثبت تغییرات محیط فعال
                </MudButton>
            </MudForm>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="pa-4 h-100">
            <MudText Typo="Typo.h6" Class="mb-3" Color="Color.Primary">بستن سال مالی</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                با بستن سال مالی، سیستم به‌صورت خودکار سند اختتامیه را بر اساس مانده واقعی حساب‌های همین شرکت و سال مالی محاسبه و ایجاد (یا به‌روزرسانی) می‌کند و آن را به‌عنوان آخرین سند سال ثبت می‌کند.
                <br />
                پس از بسته‌شدن سال، ثبت سند عادی جدید، ویرایش و حذف اسناد ممنوع است.
            </MudText>

            <div class="d-flex flex-column gap-3">
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                    @if (_activeYear is { IsClosed: true })
                    {
                        <span>سال مالی فعال «@_activeYear.YearName» در حال حاضر <b>بسته</b> است.</span>
                    }
                    else
                    {
                        <span>سال مالی فعال: @Session.ActiveFiscalYearName</span>
                    }
                </MudAlert>

                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Lock"
                           OnClick="CloseFiscalYearAsync"
                           Disabled="@(_busy || _activeYear is null || _activeYear.IsClosed || !CanCloseYear)">
                    بستن سال مالی
                </MudButton>
                @if (!CanCloseYear)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        برای بستن سال مالی به دسترسی «عملیات ویژه» نیاز دارید.
                    </MudText>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    سند اختتامیه سیستم (در صورت وجود) به‌روزرسانی می‌شود؛ سند تکراری ساخته نمی‌شود.
                </MudText>
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3" Color="Color.Primary">بستن دوره (تأیید نهایی اسناد در بازه)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                تمام اسناد تأیید شده (Posted) بازهٔ انتخاب‌شده به وضعیت «تأیید نهایی» (Closed) تغییر خواهند یافت.
            </MudText>
            <MudGrid AlignItems="AlignItems.Center">
                <MudItem xs="12" sm="4">
                    <MudDatePicker Label="از تاریخ" Culture="FaCulture" @bind-Date="_from" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker Label="تا تاریخ" Culture="FaCulture" @bind-Date="_to" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.LockClock" OnClick="ClosePeriodAsync"
                               Disabled="_busy">
                        بستن دوره
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "accounting";

    private MudForm? _form;
    private bool _isValid;
    private bool _busy;

    private List<CompanyRow> _companies = new();
    private List<FiscalYearRow> _years = new();
    private int _selectedCompId;
    private int _selectedYearId;
    private FiscalYearRow? _activeYear;

    private DateTime? _from = DateTime.Today;
    private DateTime? _to = DateTime.Today;

    private bool CanCloseYear =>
        Session.HasPermission(TarazinPermissions.For("accounting", TarazinActions.Special))
        || Session.IsAdmin;

    protected override async Task OnInitializedAsync()
    {
        _selectedCompId = Session.ActiveCompanyId ?? 0;
        _selectedYearId = Session.ActiveFiscalYearId ?? 0;
        await LoadCompaniesAsync();
        await LoadYearsAsync();
        _activeYear = _years.FirstOrDefault(y => y.FiscalYearId == _selectedYearId);
    }

    private async Task LoadCompaniesAsync()
    {
        try
        {
            _companies = (await Context.GetAuthorizedCompaniesAsync()).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در بارگذاری شرکت‌ها: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadYearsAsync()
    {
        if (_selectedCompId == 0)
        {
            _years.Clear();
            return;
        }

        try
        {
            _years = (await Context.GetAuthorizedFiscalYearsAsync(_selectedCompId)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در بارگذاری سال‌های مالی: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnCompanyChanged(int compId)
    {
        _selectedCompId = compId;
        _selectedYearId = 0;
        _years.Clear();

        if (compId == 0) return;

        try
        {
            // با تغییر شرکت، سال جاری به‌صورت سیستمی تضمین می‌شود.
            var currentFy = await Context.EnsureCurrentFiscalYearAsync(compId);
            await LoadYearsAsync();
            if (currentFy != null)
                _selectedYearId = currentFy.FiscalYearId;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در تضمین سال مالی جاری: {ex.Message}", Severity.Error);
        }
    }

    private void OnYearChanged(int yearId)
    {
        _selectedYearId = yearId;
        _activeYear = _years.FirstOrDefault(y => y.FiscalYearId == yearId);
    }

    private async Task SaveContextAsync()
    {
        if (_busy || _selectedCompId == 0 || _selectedYearId == 0) return;

        _busy = true;
        try
        {
            var company = _companies.FirstOrDefault(c => c.CompanyId == _selectedCompId);
            var year = _years.FirstOrDefault(y => y.FiscalYearId == _selectedYearId);

            if (company == null || year == null)
            {
                Snackbar.Add("شرکت یا سال مالی معتبر نیست.", Severity.Warning);
                return;
            }

            await Context.SetActiveContextAsync(company, year);
            _activeYear = year;
            Snackbar.Add($"محیط فعال به «{company.CompanyName} - {year.YearName}» تغییر یافت.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در ذخیره محیط کاری: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CloseFiscalYearAsync()
    {
        if (_busy || _selectedCompId == 0 || _selectedYearId == 0) return;

        var year = _years.FirstOrDefault(y => y.FiscalYearId == _selectedYearId);
        if (year == null) return;
        if (year.IsClosed)
        {
            Snackbar.Add("این سال مالی قبلاً بسته شده است.", Severity.Info);
            return;
        }

        var confirmed = await DialogServiceProvider_Confirm();
        if (!confirmed) return;

        _busy = true;
        try
        {
            await Context.CloseFiscalYearAsync(_selectedCompId, _selectedYearId);
            Snackbar.Add($"سال مالی «{year.YearName}» با موفقیت بسته شد و سند اختتامیه ثبت گردید.", Severity.Success);
            await LoadYearsAsync();
            _activeYear = _years.FirstOrDefault(y => y.FiscalYearId == _selectedYearId);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<bool> DialogServiceProvider_Confirm()
    {
        var result = await Dialogs.ShowMessageBoxAsync(
            "تأیید بستن سال مالی",
            "پس از بستن سال مالی، تمام اسناد آن به وضعیت «تأیید نهایی» می‌روند و امکان ثبت، ویرایش یا حذف سند جدید وجود نخواهد داشت. آیا مطمئن هستید؟",
            yesText: "بستن سال مالی",
            cancelText: "انصراف");
        return result is true;
    }

    private async Task ClosePeriodAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Db.ExecuteAsync(Schema, "DocumentPeriodClose", new
            {
                FromDate = _from?.Date ?? DateTime.Today,
                ToDate = _to?.Date ?? DateTime.Today,
                CreatedBy = Session.UserName,
                CompanyId = Session.ActiveCompanyId,
                FiscalYearId = Session.ActiveFiscalYearId
            });
            Snackbar.Add("دوره با موفقیت بسته شد.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
