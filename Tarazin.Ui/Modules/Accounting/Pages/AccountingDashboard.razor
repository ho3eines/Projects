@page "/accounting/dashboard"
@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<PageTitle>داشبورد — حسابداری</PageTitle>

<PageHeader Title="نمای کلی حسابداری" Subtitle="اسناد و مبالغ امروز." Eyebrow="حسابداری" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <MudGrid>
        <StatCard Label="اسناد امروز" Value="@_todayCount.ToString("N0")"
                  Icon="@Icons.Material.Filled.Description" Accent="#1E4B73" />
        <StatCard Label="جمع مبلغ" Value="@_sum.ToString("N0")"
                  Icon="@Icons.Material.Filled.Payments" Accent="#C49A3C" />
        <StatCard Label="ورود عملیات" Value="ثبت سند"
                  Icon="@Icons.Material.Filled.PostAdd" Accent="#0E4D4A" Hint="از منوی ماژول" />
        <StatCard Label="گزارشات" Value="مرور دفاتر"
                  Icon="@Icons.Material.Filled.Assessment" Accent="#2B6B7A" />
    </MudGrid>
}

@code {
    private const string Schema = "accounting";
    private bool _loading = true;
    private int _todayCount;
    private decimal _sum;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var rows = await Db.QueryAsync<DailyDocumentRow>(Schema, "DailyDocuments", new
            {
                FromDate = DateTime.Today,
                ToDate = DateTime.Today,
                SearchText = "",
                DocumentType = (string?)null,
                CompanyId = Session.ActiveCompanyId,
                FiscalYearId = Session.ActiveFiscalYearId,
                SkipRows = 0,
                TakeSize = 200
            });
            _todayCount = rows.Count;
            _sum = rows.Sum(r => r.TotalAmount);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
