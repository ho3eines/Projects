@page "/accounting/settings"
@inject DbService Db
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>امکانات — حسابداری</PageTitle>

<PageHeader Title="امکانات و جداول پایه" Subtitle="مدیریت حساب‌های کل، معین و تفصیلی.">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => OpenEditorAsync(EntityEditorModel.FromAccount()))">
        حساب جدید
    </MudButton>
</PageHeader>

<MudPaper Elevation="1" Class="pa-4">
    <MudTextField Label="جستجوی حساب" @bind-Value="_search" Variant="Variant.Outlined"
                  Class="mb-4" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                  OnAdornmentClick="@(_ => LoadAsync())" />
    <MudTable Items="_accounts" Hover="true" Dense="true" Striped="true" Loading="_loading">
        <HeaderContent>
            <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>نوع</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="کد">@context.AccountCode</MudTd>
            <MudTd DataLabel="عنوان">@context.Title</MudTd>
            <MudTd DataLabel="نوع">@context.AccountType</MudTd>
            <MudTd DataLabel="وضعیت">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "فعال" : "غیرفعال")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="عملیات">
                <MudTooltip Text="ویرایش حساب">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                   OnClick="@(() => OpenEditorAsync(EntityEditorModel.FromAccount(context)))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Color="Color.Secondary">حسابی نیست.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private const string Schema = "accounting";
    private List<ChartOfAccountRow> _accounts = new();
    private string _search = "";
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _accounts = (await Db.QueryAsync<ChartOfAccountRow>(Schema, "ChartOfAccountSearch", new
            {
                SearchText = _search ?? "",
                SkipRows = 0,
                TakeSize = 500
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenEditorAsync(EntityEditorModel model)
    {
        var parameters = new DialogParameters { [nameof(EntityEditorDialog.Model)] = model };
        var dialog = await DialogService.ShowAsync<EntityEditorDialog>(model.DialogTitle, parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadAsync();
    }
}
