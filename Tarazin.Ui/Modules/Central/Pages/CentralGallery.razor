@page "/central/gallery"
@inject DbService Db
@inject EntityCrudService EntityCrud
@inject ISnackbar Snackbar

<PageTitle>گالری — ترازین</PageTitle>

<PageHeader Title="گالری تصاویر" Subtitle="مدیریت آیتم‌های گالری وبسایت.">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => OpenEditorAsync(EntityEditorModel.FromGallery(nextSortOrder: NextSortOrder)))">
        آیتم جدید
    </MudButton>
</PageHeader>

<MudPaper Elevation="1" Class="pa-4">
    <MudTable Items="_items" Hover="true" Dense="true" Striped="true" Loading="_loading">
        <HeaderContent>
            <MudTh>#</MudTh><MudTh>عنوان</MudTh><MudTh>توضیح</MudTh><MudTh>ترتیب</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="#">@context.GalleryItemId</MudTd>
            <MudTd DataLabel="عنوان">@context.Title</MudTd>
            <MudTd DataLabel="توضیح">@context.Caption</MudTd>
            <MudTd DataLabel="ترتیب">@context.SortOrder</MudTd>
            <MudTd DataLabel="وضعیت">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "فعال" : "غیرفعال")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="عملیات">
                <MudTooltip Text="ویرایش آیتم">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                   OnClick="@(() => OpenEditorAsync(EntityEditorModel.FromGallery(context)))" />
                </MudTooltip>
                <MudTooltip Text="حذف">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => DeleteAsync(EntityEditorModel.FromGallery(context)))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Color="Color.Secondary">آیتمی نیست.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private const string Schema = "central";
    private List<GalleryItemRow> _items = new();
    private bool _loading = true;
    private int NextSortOrder => _items.Count == 0 ? 1 : _items.Max(x => x.SortOrder) + 1;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = (await Db.QueryAsync<GalleryItemRow>(Schema, "GalleryList", new
            {
                SkipRows = 0,
                TakeSize = 200
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenEditorAsync(EntityEditorModel model)
    {
        if (await EntityCrud.ShowEditorAsync(model))
            await LoadAsync();
    }

    private async Task DeleteAsync(EntityEditorModel model)
    {
        if (await EntityCrud.ConfirmDeleteAsync(model))
            await LoadAsync();
    }
}
