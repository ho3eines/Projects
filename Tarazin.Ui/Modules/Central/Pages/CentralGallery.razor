@page "/central/gallery"
@inject DbService Db
@inject EntityCrudService EntityCrud
@inject ISnackbar Snackbar

<PageTitle>گالری — ترازین</PageTitle>

<PageHeader Title="گالری تصاویر" Subtitle="مدیریت آیتم‌های گالری وبسایت.">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="() => OpenEditorAsync(EntityEditorModel.FromGallery(nextSortOrder: NextSortOrder))">
        آیتم جدید
    </MudButton>
</PageHeader>

<TzDataTable T="GalleryItemRow" Items="_items" Loading="_loading" ShowPager="true"
             SkeletonColumns="6" EmptyTitle="آیتمی در گالری ثبت نشده است." EmptyIcon="@Icons.Material.Filled.Collections">
    <HeaderContent>
        <MudTh>#</MudTh><MudTh>عنوان</MudTh><MudTh>توضیح</MudTh><MudTh>ترتیب</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
    </HeaderContent>
    <RowTemplate Context="item">
        <MudTd DataLabel="#">@item.GalleryItemId</MudTd>
        <MudTd DataLabel="عنوان">@item.Title</MudTd>
        <MudTd DataLabel="توضیح">@item.Caption</MudTd>
        <MudTd DataLabel="ترتیب">@item.SortOrder</MudTd>
        <MudTd DataLabel="وضعیت">
            <StatusChip IsActive="item.IsActive" />
        </MudTd>
        <MudTd DataLabel="عملیات">
            <EntityActions EditClicked="() => OpenEditorAsync(EntityEditorModel.FromGallery(item))"
                           DeleteClicked="() => DeleteAsync(EntityEditorModel.FromGallery(item))" />
        </MudTd>
    </RowTemplate>
</TzDataTable>

@code {
    private const string Schema = "central";
    private List<GalleryItemRow> _items = new();
    private bool _loading = true;
    private int NextSortOrder => _items.Count == 0 ? 1 : _items.Max(x => x.SortOrder) + 1;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = (await Db.QueryAsync<GalleryItemRow>(Schema, "GalleryList", new
            {
                SkipRows = 0,
                TakeSize = 200
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenEditorAsync(EntityEditorModel model)
    {
        if (await EntityCrud.ShowEditorAsync(model))
            await LoadAsync();
    }

    private async Task DeleteAsync(EntityEditorModel model)
    {
        if (await EntityCrud.ConfirmDeleteAsync(model))
            await LoadAsync();
    }
}