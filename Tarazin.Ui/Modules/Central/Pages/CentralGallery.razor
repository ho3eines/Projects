@page "/central/gallery"
@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<PageTitle>گالری — ترازین</PageTitle>

<MudText Typo="Typo.h4">گالری تصاویر</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    مدیریت آیتم‌های گالری وبسایت.
</MudText>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Label="عنوان" @bind-Value="_title" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Label="توضیح" @bind-Value="_caption" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Label="آدرس تصویر" @bind-Value="_imageUrl" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddAsync" Disabled="_busy">
                افزودن آیتم
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="1" Class="pa-4">
    <MudTable Items="_items" Hover="true" Dense="true" Striped="true" Loading="_loading">
        <HeaderContent>
            <MudTh>#</MudTh><MudTh>عنوان</MudTh><MudTh>توضیح</MudTh><MudTh>ترتیب</MudTh><MudTh>وضعیت</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="#">@context.GalleryItemId</MudTd>
            <MudTd DataLabel="عنوان">@context.Title</MudTd>
            <MudTd DataLabel="توضیح">@context.Caption</MudTd>
            <MudTd DataLabel="ترتیب">@context.SortOrder</MudTd>
            <MudTd DataLabel="وضعیت">
                <MudChip Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "فعال" : "غیرفعال")
                </MudChip>
            </MudTd>
        </RowTemplate>
        <EmptyContent><MudText Color="Color.Secondary">آیتمی نیست.</MudText></EmptyContent>
    </MudTable>
</MudPaper>

@code {
    private const string Schema = "central";

    private List<GalleryItemRow> _items = new();
    private bool _loading = true;
    private bool _busy;
    private string _title = "";
    private string _caption = "";
    private string _imageUrl = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = (await Db.QueryAsync<GalleryItemRow>(Schema, "GalleryList", new
            {
                SkipRows = 0,
                TakeSize = 200
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddAsync()
    {
        if (_busy) return;
        if (string.IsNullOrWhiteSpace(_title))
        {
            Snackbar.Add("عنوان آیتم الزامی است.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await Db.ExecuteAsync(Schema, "GalleryUpsert", new
            {
                GalleryItemId = 0,
                Title = _title.Trim(),
                Caption = _caption,
                ImageUrl = _imageUrl,
                SortOrder = (_items.Count + 1),
                IsActive = true,
                CreatedBy = Session.UserName
            });
            Snackbar.Add("آیتم گالری افزوده شد.", Severity.Success);
            _title = "";
            _caption = "";
            _imageUrl = "";
            _items = (await Db.QueryAsync<GalleryItemRow>(Schema, "GalleryList", new
            {
                SkipRows = 0,
                TakeSize = 200
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
