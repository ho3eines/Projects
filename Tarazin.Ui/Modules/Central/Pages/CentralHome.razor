@page "/central"
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>پلتفرم مشترک — ترازین</PageTitle>

<PageHeader Title="پلتفرم مشترک" Subtitle="وبسایت شرکت، کاربران و ممیزی." Eyebrow="مرکز" />

<div class="tz-modgrid">
    @foreach (var card in Cards)
    {
        <button type="button" class="tz-modcard" style="--tz-accent:@card.Accent"
                @onclick="() => Nav.NavigateTo(card.Url)">
            <div class="tz-modcard__icon">
                <MudIcon Icon="@card.Icon" />
            </div>
            <div class="tz-modcard__body">
                <h3>@card.Title</h3>
                <p>@card.Lead</p>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.West" Class="tz-modcard__go" />
        </button>
    }
</div>

<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-6">
    وضعیت نشست: @(Session.IsAuthenticated ? $"وارد شده — {Session.DisplayName} ({Session.Role})" : "خارج شده")
</MudText>

@code {
    record CardInfo(string Icon, string Title, string Lead, string Url, string Accent);

    static readonly List<CardInfo> Cards =
    [
        new(Icons.Material.Filled.Newspaper, "اخبار", "مدیریت اخبار شرکت", "/central/news", "#1E4B73"),
        new(Icons.Material.Filled.EditNote, "وبلاگ", "پست‌های وبلاگ", "/central/blog", "#0E4D4A"),
        new(Icons.Material.Filled.PhotoLibrary, "گالری", "گالری تصاویر", "/central/gallery", "#2B6B7A"),
        new(Icons.Material.Filled.Group, "کاربران", "مدیریت کاربران و نقش‌ها", "/central/users", "#9C3B2E"),
        new(Icons.Material.Filled.Policy, "ممیزی", "ممیزی رویدادهای سیستم", "/central/audit", "#C49A3C"),
    ];
}
