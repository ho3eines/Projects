@page "/central"
@inject UserSession Session

<PageTitle>پلتفرم مشترک — ترازین</PageTitle>

<MudText Typo="Typo.h4">پلتفرم مشترک</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    وبسایت شرکت (اخبار، بلاگ، گالری)، مدیریت کاربران و ممیزی.
</MudText>

<MudGrid>
    @foreach (var card in Cards)
    {
        <MudItem xs="12" sm="6" md="3">
            <div class="h-module-card" @onclick="() => Nav.NavigateTo(card.Url)" role="link" tabindex="0">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudText Typo="Typo.h5">@card.Icon</MudText>
                        <MudText Typo="Typo.h6" Class="mt-2">@card.Title</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@card.Lead</MudText>
                    </MudCardContent>
                </MudCard>
            </div>
        </MudItem>
    }
</MudGrid>

<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-6">
    وضعیت نشست: @(Session.IsAuthenticated ? $"وارد شده — {Session.DisplayName} ({Session.Role})" : "خارج شده")
</MudText>

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;

    record CardInfo(string Icon, string Title, string Lead, string Url);

    static readonly List<CardInfo> Cards =
    [
        new("📰", "اخبار", "مدیریت اخبار شرکت", "/central/news"),
        new("✍️", "وبلاگ", "پست‌های وبلاگ", "/central/blog"),
        new("🖼️", "گالری", "گالری تصاویر", "/central/gallery"),
        new("👥", "کاربران", "مدیریت کاربران و نقش‌ها", "/central/users"),
        new("🕵️", "ممیزی", "ممیزی رویدادهای سیستم", "/central/audit"),
    ];
}
