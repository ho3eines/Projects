@page "/central/blog"
@inject DbService Db
@inject EntityCrudService EntityCrud
@inject ISnackbar Snackbar

<PageTitle>وبلاگ — ترازین</PageTitle>

<PageHeader Title="پست‌های وبلاگ" Subtitle="مدیریت پست‌های وبلاگ شرکت.">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="() => OpenEditorAsync(EntityEditorModel.FromBlog())">
        پست جدید
    </MudButton>
</PageHeader>

<TzDataTable T="BlogRow" Items="_items" Loading="_loading" ShowPager="true"
             SkeletonColumns="7" EmptyTitle="پستی ثبت نشده است." EmptyIcon="@Icons.Material.Filled.Article">
    <HeaderContent>
        <MudTh>#</MudTh><MudTh>عنوان</MudTh><MudTh>نویسنده</MudTh><MudTh>برچسب‌ها</MudTh><MudTh>تاریخ انتشار</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
    </HeaderContent>
    <RowTemplate Context="item">
        <MudTd DataLabel="#">@item.PostId</MudTd>
        <MudTd DataLabel="عنوان">@item.Title</MudTd>
        <MudTd DataLabel="نویسنده">@item.Author</MudTd>
        <MudTd DataLabel="برچسب‌ها">@item.Tags</MudTd>
        <MudTd DataLabel="تاریخ انتشار">@(item.PublishedAt?.ToString("yyyy/MM/dd") ?? "—")</MudTd>
        <MudTd DataLabel="وضعیت">
            <StatusChip IsActive="item.IsActive" />
        </MudTd>
        <MudTd DataLabel="عملیات">
            <EntityActions EditClicked="() => OpenEditorAsync(EntityEditorModel.FromBlog(item))"
                           DeleteClicked="() => DeleteAsync(EntityEditorModel.FromBlog(item))" />
        </MudTd>
    </RowTemplate>
</TzDataTable>

@code {
    private const string Schema = "central";
    private List<BlogRow> _items = new();
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = (await Db.QueryAsync<BlogRow>(Schema, "BlogList", new
            {
                SkipRows = 0,
                TakeSize = 200
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenEditorAsync(EntityEditorModel model)
    {
        if (await EntityCrud.ShowEditorAsync(model))
            await LoadAsync();
    }

    private async Task DeleteAsync(EntityEditorModel model)
    {
        if (await EntityCrud.ConfirmDeleteAsync(model))
            await LoadAsync();
    }
}