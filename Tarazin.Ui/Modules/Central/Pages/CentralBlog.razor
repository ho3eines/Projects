@page "/central/blog"
@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<PageTitle>وبلاگ — ترازین</PageTitle>

<MudText Typo="Typo.h4">پست‌های وبلاگ</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    مدیریت پست‌های وبلاگ شرکت.
</MudText>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Label="عنوان" @bind-Value="_title" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Label="نویسنده" @bind-Value="_author" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Label="برچسب‌ها" @bind-Value="_tags" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddAsync" Disabled="_busy">
                افزودن پست
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="1" Class="pa-4">
    <MudTable Items="_items" Hover="true" Dense="true" Striped="true" Loading="_loading">
        <HeaderContent>
            <MudTh>#</MudTh><MudTh>عنوان</MudTh><MudTh>نویسنده</MudTh><MudTh>برچسب‌ها</MudTh><MudTh>تاریخ انتشار</MudTh><MudTh>وضعیت</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="#">@context.PostId</MudTd>
            <MudTd DataLabel="عنوان">@context.Title</MudTd>
            <MudTd DataLabel="نویسنده">@context.Author</MudTd>
            <MudTd DataLabel="برچسب‌ها">@context.Tags</MudTd>
            <MudTd DataLabel="تاریخ انتشار">@(context.PublishedAt?.ToString("yyyy/MM/dd") ?? "—")</MudTd>
            <MudTd DataLabel="وضعیت">
                <MudChip Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "فعال" : "غیرفعال")
                </MudChip>
            </MudTd>
        </RowTemplate>
        <EmptyContent><MudText Color="Color.Secondary">پستی نیست.</MudText></EmptyContent>
    </MudTable>
</MudPaper>

@code {
    private const string Schema = "central";

    private List<BlogRow> _items = new();
    private bool _loading = true;
    private bool _busy;
    private string _title = "";
    private string _author = "";
    private string _tags = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = (await Db.QueryAsync<BlogRow>(Schema, "BlogList", new
            {
                SkipRows = 0,
                TakeSize = 200
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddAsync()
    {
        if (_busy) return;
        if (string.IsNullOrWhiteSpace(_title))
        {
            Snackbar.Add("عنوان پست الزامی است.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await Db.ExecuteAsync(Schema, "BlogUpsert", new
            {
                PostId = 0,
                Title = _title.Trim(),
                Slug = (string?)null,
                Author = _author,
                Tags = _tags,
                Body = (string?)null,
                PublishedAt = DateTime.Today,
                IsActive = true,
                CreatedBy = Session.UserName
            });
            Snackbar.Add("پست افزوده شد.", Severity.Success);
            _title = "";
            _author = "";
            _tags = "";
            _items = (await Db.QueryAsync<BlogRow>(Schema, "BlogList", new
            {
                SkipRows = 0,
                TakeSize = 200
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
