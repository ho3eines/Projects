@page "/central/news"
@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<PageTitle>اخبار — ترازین</PageTitle>

<PageHeader Title="اخبار شرکت" Subtitle="مدیریت اخبار نمایش‌داده‌شده در وبسایت مرکزی." />
<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Label="عنوان خبر" @bind-Value="_title" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Label="خلاصه" @bind-Value="_summary" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudDatePicker Label="تاریخ انتشار" Culture="FaCulture" @bind-Date="_publishedAt" />
        </MudItem>
        <MudItem xs="12">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddAsync" Disabled="_busy">
                افزودن خبر
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="1" Class="pa-4">
    <MudTable Items="_items" Hover="true" Dense="true" Striped="true" Loading="_loading">
        <HeaderContent>
            <MudTh>#</MudTh><MudTh>عنوان</MudTh><MudTh>خلاصه</MudTh><MudTh>تاریخ انتشار</MudTh><MudTh>وضعیت</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="#">@context.NewsId</MudTd>
            <MudTd DataLabel="عنوان">@context.Title</MudTd>
            <MudTd DataLabel="خلاصه">@context.Summary</MudTd>
            <MudTd DataLabel="تاریخ انتشار">@(context.PublishedAt?.ToString("yyyy/MM/dd") ?? "—")</MudTd>
            <MudTd DataLabel="وضعیت">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "فعال" : "غیرفعال")
                </MudChip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Color="Color.Secondary">خبری نیست.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "central";

    private List<NewsRow> _items = new();
    private bool _loading = true;
    private bool _busy;
    private string _title = "";
    private string _summary = "";
    private DateTime? _publishedAt = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = (await Db.QueryAsync<NewsRow>(Schema, "NewsList", new
            {
                SkipRows = 0,
                TakeSize = 200
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddAsync()
    {
        if (_busy) return;
        if (string.IsNullOrWhiteSpace(_title))
        {
            Snackbar.Add("عنوان خبر الزامی است.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await Db.ExecuteAsync(Schema, "NewsUpsert", new
            {
                NewsId = 0,
                Title = _title.Trim(),
                Summary = _summary,
                Body = (string?)null,
                ImageUrl = (string?)null,
                PublishedAt = _publishedAt,
                IsActive = true,
                CreatedBy = Session.UserName
            });
            Snackbar.Add("خبر افزوده شد.", Severity.Success);
            _title = "";
            _summary = "";
            _items = (await Db.QueryAsync<NewsRow>(Schema, "NewsList", new
            {
                SkipRows = 0,
                TakeSize = 200
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
