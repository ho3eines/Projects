@page "/central/news"
@inject DbService Db
@inject EntityCrudService EntityCrud
@inject ISnackbar Snackbar

<PageTitle>اخبار — ترازین</PageTitle>

<PageHeader Title="اخبار شرکت" Subtitle="مدیریت اخبار نمایش‌داده‌شده در وبسایت مرکزی.">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="() => OpenEditorAsync(EntityEditorModel.FromNews())">
        خبر جدید
    </MudButton>
</PageHeader>

<TzDataTable T="NewsRow" Items="_items" Loading="_loading" ShowPager="true"
             SkeletonColumns="6" EmptyTitle="خبری ثبت نشده است." EmptyIcon="@Icons.Material.Filled.Campaign">
    <HeaderContent>
        <MudTh>#</MudTh><MudTh>عنوان</MudTh><MudTh>خلاصه</MudTh><MudTh>تاریخ انتشار</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
    </HeaderContent>
    <RowTemplate Context="item">
        <MudTd DataLabel="#">@item.NewsId</MudTd>
        <MudTd DataLabel="عنوان">@item.Title</MudTd>
        <MudTd DataLabel="خلاصه">@item.Summary</MudTd>
        <MudTd DataLabel="تاریخ انتشار">@(item.PublishedAt?.ToString("yyyy/MM/dd") ?? "—")</MudTd>
        <MudTd DataLabel="وضعیت">
            <StatusChip IsActive="item.IsActive" />
        </MudTd>
        <MudTd DataLabel="عملیات">
            <EntityActions EditClicked="() => OpenEditorAsync(EntityEditorModel.FromNews(item))"
                           DeleteClicked="() => DeleteAsync(EntityEditorModel.FromNews(item))" />
        </MudTd>
    </RowTemplate>
</TzDataTable>

@code {
    private const string Schema = "central";
    private List<NewsRow> _items = new();
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = (await Db.QueryAsync<NewsRow>(Schema, "NewsList", new
            {
                SkipRows = 0,
                TakeSize = 200
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenEditorAsync(EntityEditorModel model)
    {
        if (await EntityCrud.ShowEditorAsync(model))
            await LoadAsync();
    }

    private async Task DeleteAsync(EntityEditorModel model)
    {
        if (await EntityCrud.ConfirmDeleteAsync(model))
            await LoadAsync();
    }
}