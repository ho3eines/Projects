    /// <summary>کلیدهای دادهٔ شناخته‌شده در پروژه (از مصرف‌کننده‌های موتور چاپ و مدل‌ها).</summary>
    private static readonly string[] KnownKeys =
    {
        "AccountCode", "AccountTitle", "Title", "Description", "Debit", "Credit", "TotalAmount", "Amount",
        "Quantity", "UnitPrice", "WeightGram", "DocumentNumber", "DocumentDate", "DocumentType",
        "CounterPartyName", "StatusTitle", "ChequeNumber", "BankName", "Direction", "DueDate", "AlertTitle",
        "SourceReference", "InvoiceNumber", "InvoiceDate", "CustomerName", "ItemTitle", "CurrencyCode",
        "CurrencyName", "SystemRate", "RialValue", "EmployeeName", "EmployeeCode", "OrderNumber", "ItemName"
    };

    private IEnumerable<string> FilterKeys(string? search)
    {
        var list = KnownKeys.Concat(_tpl?.Columns.Select(c => c.Key) ?? Enumerable.Empty<string>());
        if (string.IsNullOrWhiteSpace(search))
            return list.Distinct().OrderBy(k => k);
        return list.Where(k => k.Contains(search, StringComparison.OrdinalIgnoreCase))
            .Distinct().OrderBy(k => k);
    }



    // ── پیش‌نمایش ──

    private PrintDataModel BuildPreviewData()
    {
        var data = new PrintDataModel
        {
            CompanyName = _company?.CompanyName ?? "ترازین — سامانه یکپارچه مدیریت کسب‌وکار",
            CompanyAddress = _company?.Address,
            LogoPath = _company?.LogoPath,
            Title = _tpl!.ReportTitle ?? _tpl.Name,
            Subtitle = _tpl.ReportSubtitle,
            RangeText = _showSample ? "بازه: 1405/06/01 تا 1405/06/31" : null,
            QrPayload = _showSample ? $"tarazin:tpl:{_tpl.Id}" : null,
            QrEnabled = _tpl.QrEnabled
        };

        for (var i = 0; i < _tpl.MetaFields.Count; i++)
        {
            var f = _tpl.MetaFields[i];
            var value = _showSample switch
            {
                _ when i == 0 && string.IsNullOrWhiteSpace(f.Label) is false && f.Label.Contains("شماره") => "00000018",
                _ when i == 1 && string.IsNullOrWhiteSpace(f.Label) is false && f.Label.Contains("تاریخ") => "1405/06/06",
                _ when i == 2 && string.IsNullOrWhiteSpace(f.Label) is false && f.Label.Contains("وضعیت") => "یادداشت",
                _ when i == 3 && string.IsNullOrWhiteSpace(f.Label) is false && f.Label.Contains("نوع") => "فروش",
                _ when i == 4 && string.IsNullOrWhiteSpace(f.Label) is false && f.Label.Contains("طرف") => "سارا رضایی",
                _ => _showSample ? "نمونه" : null
            };
            data.MetaFields.Add(new PrintMetaField { Label = f.Label, Value = _showSample ? value : null, Bold = f.Bold });
        }

        if (_showSample)
        {
            data.Rows.Add(new PrintRow
            {
                ["AccountCode"] = "2000", ["Title"] = "صندوق — دریافت نقدی", ["Debit"] = 20000000m, ["Credit"] = 0m
            });
            data.Rows.Add(new PrintRow
            {
                ["AccountCode"] = "1020", ["Title"] = "بانک — دریافت چک", ["Debit"] = 8000000m, ["Credit"] = 0m
            });
            data.Rows.Add(new PrintRow
            {
                ["AccountCode"] = "1010", ["Title"] = "فروش — فروش فروشگاه", ["Debit"] = 0m, ["Credit"] = 28000000m
            });
            data.FooterFields.Add(new PrintMetaField { Label = "تعداد ردیف", Value = data.Rows.Count.ToString(), Bold = true });
        }
        else
        {
            data.Rows.Add(new PrintRow { ["Title"] = "داده‌ای انتخاب نشده — برای پیش‌نمایش واقعی «نمونه داده» را روشن کنید." });
        }
        return data;
    }

