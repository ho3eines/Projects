                        <MudSelectItem Value="@("Sales")">فروش</MudSelectItem>
                        <MudSelectItem Value="@("Profit")">سود</MudSelectItem>
                        <MudSelectItem Value="@("Expense")">هزینه</MudSelectItem>
                        <MudSelectItem Value="@("Collection")">وصول</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <TzNumericField T="decimal" Label="مبلغ هدف (ریال)" @bind-Value="_targetAmount" Variant="Variant.Outlined" Min="0" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudDatePicker Label="ماه هدف" Culture="FaCulture" @bind-Date="_targetMonth" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveTargetAsync" Disabled="_loading"
                               StartIcon="@Icons.Material.Filled.Save">ثبت هدف</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.subtitle1" Class="mb-3">هدف در برابر عملکرد واقعی — ماه جاری</MudText>
            <MudTable Items="_targetVsActual" Hover="true" Dense="true" Striped="true">
                <HeaderContent>
                    <MudTh>عنوان</MudTh><MudTh>هدف</MudTh><MudTh>عملکرد واقعی</MudTh><MudTh>اختلاف</MudTh>
                    <MudTh>درصد تحقق</MudTh><MudTh>وضعیت</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="عنوان">@context.Title</MudTd>
                    <MudTd DataLabel="هدف">@context.TargetAmount.ToString("N0")</MudTd>
                    <MudTd DataLabel="واقعی">@context.ActualAmount.ToString("N0")</MudTd>
                    <MudTd DataLabel="اختلاف">
                        <MudText Typo="Typo.body2" Color="@VarianceColor(context)">
                            @context.Variance.ToString("N0")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="درصد تحقق">
                        <MudProgressLinear Value="@((double)context.ProgressPercent)" Color="@ProgressColor(context)" Rounded="true" />
                        <MudText Typo="Typo.caption">@context.ProgressPercent.ToString("0.0")٪</MudText>
                    </MudTd>
                    <MudTd DataLabel="وضعیت">
                        <MudChip T="string" Size="Size.Small" Color="@TargetStatusColor(context)" Variant="Variant.Outlined">
                            @TargetStatusText(context)
                        </MudChip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><EmptyState Title="هدف‌ای برای ماه جاری تعریف نشده است." /></NoRecordsContent>
            </MudTable>
        </MudPaper>;
    };

    private RenderFragment RenderAlerts() => __builder =>
    {
        <MudPaper Elevation="1" Class="pa-4">
            @if (_alerts.Count == 0)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">هشدار فعالی وجود ندارد.</MudAlert>
            }
            @foreach (var alert in _alerts)
            {
                <MudAlert Severity="@AlertSeverity(alert)" Variant="Variant.Outlined" Class="mb-2">
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <b>@alert.Title</b> — @alert.Detail
                            @if (alert.Amount.HasValue)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" Class="ms-2">
                                    @alert.Amount.Value.ToString("N0") ریال
                                </MudChip>
                            }
                            @if (alert.OccurredAt.HasValue)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@alert.OccurredAt.Value.ToString("yyyy/MM/dd")</MudText>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(alert.Link))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" OnClick="@(() => Navigate(alert.Link!))" />
                        }
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">اقدام پیشنهادی: @alert.Action</MudText>
                </MudAlert>
            }
        </MudPaper>;
    };

    private RenderFragment RenderInsights() => __builder =>
    {
        <MudPaper Elevation="1" Class="pa-4">
            @if (_insights.Count == 0)
            {
                <MudText Color="Color.Secondary">تحلیلی برای نمایش نیست.</MudText>
            }
            @foreach (var insight in _insights)
            {
                <MudAlert Severity="@InsightSeverity(insight.Kind)" Variant="Variant.Outlined" Class="mb-2">
                    <div class="d-flex justify-space-between align-center">
                        <div><b>@insight.Title:</b> @insight.Detail</div>
                        @if (!string.IsNullOrWhiteSpace(insight.Link))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" OnClick="@(() => Navigate(insight.Link!))" />
                        }
                    </div>
                </MudAlert>
            }
        </MudPaper>;
    };

