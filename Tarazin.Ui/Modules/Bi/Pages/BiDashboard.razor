    private static Color VarianceColor(BiTargetVsActualRow row) => row.Variance >= 0 ? Color.Success : Color.Error;
    private static Color ProgressColor(BiTargetVsActualRow row) => row.Status == "Good" ? Color.Success : Color.Error;
    private static Color TargetStatusColor(BiTargetVsActualRow row) => row.Status == "Good" ? Color.Success : Color.Warning;
    private static string TargetStatusText(BiTargetVsActualRow row) => row.Status == "Good" ? "رسیده به هدف" : "کمتر از هدف";

    // ── فرم هدف ─────────────────────────────────────────────────────────
    private string _targetKey = "Sales";
    private decimal _targetAmount;
    private DateTime? _targetMonth = DateTime.Today;

    private async Task SaveTargetAsync()
    {
        if (_targetAmount <= 0)
        {
            Snackbar.Add("مبلغ هدف معتبر وارد کنید.", Severity.Warning);
            return;
        }
        try
        {
            var month = _targetMonth?.Date ?? DateTime.Today;
            await Db.ExecuteAsync(Schema, "BiTargetUpsert", new
            {
                TargetKey = _targetKey,
                Title = _targetKey switch
                {
                    "Sales" => "هدف فروش",
                    "Profit" => "هدف سود",
                    "Expense" => "سقف هزینه",
                    _ => "هدف وصول"
                },
                Period = "Month",
                PeriodYear = month.Year,
                PeriodMonth = month.Month,
                TargetAmount = _targetAmount,
                CreatedBy = "admin"
            });
            Snackbar.Add("هدف ثبت شد.", Severity.Success);
            await LoadTargetsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
