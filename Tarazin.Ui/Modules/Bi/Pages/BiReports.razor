@page "/bi/reports"
@inject DbService Db
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject PrintTemplateService Tpl

<PageTitle>گزارش‌ها — داشبورد و BI</PageTitle>

<PageHeader Title="گزارش‌های سیستم" Subtitle="هر گزارش از دادهٔ واقعی نرم‌افزار (اسکریپت‌های نامدار) ساخته می‌شود و با موتور چاپ عمومی (قالب قابل‌طراحی) چاپ/PDF می‌شود."
            Eyebrow="داشبورد و BI" />

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="string" Label="گزارش" @bind-Value="_selectedKey" Variant="Variant.Outlined">
                @foreach (var r in Reports)
                {
                    <MudSelectItem Value="r.Key">@r.Title</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="از تاریخ" Culture="FaCulture" @bind-Date="_from" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="تا تاریخ" Culture="FaCulture" @bind-Date="_to" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="PrintGenericAsync" Disabled="_busy"
                       StartIcon="@Icons.Material.Filled.Print">
                چاپ / PDF
            </MudButton>
        </MudItem>
    </MudGrid>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
        چاپ با <b>موتور چاپ عمومی</b> انجام می‌شود — قالب هر گزارش در «مدیریت چاپ» قابل طراحی است
        (اندازه/جهت کاغذ، ستون‌ها، هدر شرکت، QR و…). خروجی چاپ و PDF از همان قالب یکسان ساخته می‌شوند.
    </MudAlert>
</MudPaper>

@if (_busy)
{
    <MudPaper Elevation="1" Class="pa-8 text-center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.body2" Class="mt-3">در حال ساخت گزارش از دادهٔ واقعی…</MudText>
    </MudPaper>
}

@if (!_busy && _error is not null)
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            ساخت گزارش ناموفق بود: @_error
        </MudAlert>
    </MudPaper>
}

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");

    private string _selectedKey = "wallet";
    private DateTime? _from = DateTime.Today.AddMonths(-1);
    private DateTime? _to = DateTime.Today;
    private bool _busy;
    private string? _error;

    private static IReadOnlyList<BiReportDefinition> Reports => BiReportCatalog.Reports;
    /// <summary>
    /// چاپ گزارش انتخاب‌شده با موتور چاپ عمومی (قالب پویا از تعریف گزارش + همان دادهٔ اسکریپت).
    /// ستون‌ها از ColumnTitles گزارش ساخته می‌شوند؛ مقدارها از خروجی اسکریپت نامدار می‌آیند.
    /// </summary>
    private async Task PrintGenericAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            var def = Reports.First(r => r.Key == _selectedKey);

            var parameters = new Dictionary<string, object?>(def.Params);
            foreach (var key in new[] { "FromDate", "ToDate" })
            {
                if (parameters.ContainsKey(key))
                    parameters[key] = key == "FromDate" ? _from : _to;
            }

            var rows = await Db.QueryAsync<dynamic>(def.Schema, def.Script, parameters);

            var tpl = BiPrintFactory.BuildTemplate(def, rows.Count);
            var data = BiPrintFactory.BuildData(def, rows, _from, _to);

            await Dialog.ShowAsync<TemplatePrintDialog>($"چاپ — {def.Title}",
                new DialogParameters<TemplatePrintDialog>
                {
                    { x => x.Template, tpl }, { x => x.Data, data }, { x => x.TemplateId, "bi." + def.Key }
                },
                new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

}
