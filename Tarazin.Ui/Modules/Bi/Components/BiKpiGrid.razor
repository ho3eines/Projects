@inject NavigationManager Nav

@* کارت‌های KPI مشترک BI — با مقایسهٔ دوره قبل، جهت تغییر، وضعیت و Drill-down (§4/§105/§106) *@
<MudGrid>
    @foreach (var kpi in Rows)
    {
        <MudItem xs="12" sm="6" md="@Md">
            <MudPaper Elevation="1" Class="@KpiClass(kpi)"
                      Style="@($"border-top:3px solid {KpiColor(kpi)}")">
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@kpi.Title</MudText>
                    @if (!string.IsNullOrWhiteSpace(kpi.Link))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Color="Color.Default"
                                       OnClick="@(() => Nav.NavigateTo(kpi.Link!))" aria-label="مشاهده جزئیات" />
                    }
                </div>
                <MudText Typo="Typo.h6" Class="tz-num mt-1">
                    @FormatAmount(kpi.Amount) @(kpi.Unit ?? "")
                </MudText>
                <div class="d-flex align-center mt-1">
                    @if (kpi.ChangePercent.HasValue)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                 Color="@(kpi.Direction == "Down" ? Color.Error : Color.Success)">
                            @(kpi.Direction == "Up" ? "▲" : kpi.Direction == "Down" ? "▼" : "—")
                            @Math.Abs(kpi.ChangePercent.Value).ToString("0.0")٪
                        </MudChip>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ms-2">
                            @(kpi.PrevAmount.HasValue ? "قبلی: " + kpi.PrevAmount.Value.ToString("N0") : "")
                        </MudText>
                    }
                    else if (kpi.PrevAmount.HasValue)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">قبلی: @kpi.PrevAmount.Value.ToString("N0")</MudText>
                    }
                </div>
                @if (ShowDefinition)
                {
                    <MudTooltip Text="@($"فرمول: {kpi.Formula ?? "—"} | منبع: {kpi.Source ?? "—"}")">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1" Style="cursor:help">
                            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" /> تعریف KPI
                        </MudText>
                    </MudTooltip>
                }
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter] public IReadOnlyList<BiKpiRow> Rows { get; set; } = Array.Empty<BiKpiRow>();
    [Parameter] public int Md { get; set; } = 3;
    [Parameter] public bool ShowDefinition { get; set; } = true;

    private static string KpiClass(BiKpiRow kpi) =>
        $"tz-bi-kpi {(kpi.Status == "Bad" ? "tz-bi-kpi--bad" : kpi.Status == "Good" ? "tz-bi-kpi--good" : "")}";

    private static string KpiColor(BiKpiRow kpi) => kpi.Status switch
    {
        "Bad" => TarazinAccents.Crimson,
        "Good" => TarazinAccents.Emerald,
        _ => TarazinAccents.Steel
    };

    private static string FormatAmount(decimal value) =>
        Math.Abs(value) >= 1_000_000_000m ? (value / 1_000_000_000m).ToString("0.00") + " میلیارد"
        : Math.Abs(value) >= 1_000_000m ? (value / 1_000_000m).ToString("0.0") + " میلیون"
        : value.ToString("N0");
}
