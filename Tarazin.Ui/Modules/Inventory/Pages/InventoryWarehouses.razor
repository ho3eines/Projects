@page "/inventory/warehouses"
@inject DbService Db
@inject UserSession Session
@inject EntityCrudService Crud
@inject ISnackbar Snackbar

<PageHeader Eyebrow="انبار" Title="انبارها" Subtitle="فهرست انبارهای شرکت فعال" />

<PageToolbar AddText="انبار جدید" AddIcon="@Icons.Material.Filled.Add" OnAddClick="CreateAsync"
             AddDisabled="@(!Session.HasPermission(InventoryEditKey))">
    <MudTextField @bind-Value="_search" Placeholder="جستجو در کد/عنوان/موقعیت..." Immediate="true"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-0" />
</PageToolbar>

<TzDataTable T="WarehouseRow" Items="_filtered" Loading="_loading" ShowPager="true"
             SkeletonColumns="4" EmptyTitle="انباری ثبت نشده است."
             EmptyDescription="با دکمهٔ «انبار جدید» اولین انبار را بسازید.">
    <HeaderContent>
        <MudTh>کد</MudTh>
        <MudTh>عنوان</MudTh>
        <MudTh>موقعیت</MudTh>
        <MudTh>وضعیت</MudTh>
        <MudTh Style="text-align:center">عملیات</MudTh>
    </HeaderContent>
    <RowTemplate Context="item">
        <MudTd DataLabel="کد" Class="tz-num">@item.WarehouseCode</MudTd>
        <MudTd DataLabel="عنوان">@item.Title</MudTd>
        <MudTd DataLabel="موقعیت">@(item.Location ?? "—")</MudTd>
        <MudTd DataLabel="وضعیت"><StatusChip IsActive="item.IsActive" /></MudTd>
        <MudTd DataLabel="عملیات">
            <EntityActions EditClicked="() => EditAsync(item)"
                           DeleteClicked="() => DeleteAsync(item)"
                           EditDisabled="!Session.HasPermission(InventoryEditKey)"
                           DeleteDisabled="!Session.HasPermission(InventoryEditKey)" />
        </MudTd>
    </RowTemplate>
</TzDataTable>

@code {
    private const string InventoryEditKey = "inventory.admin";
    private const string Schema = "inventory";

    private IReadOnlyList<WarehouseRow> _rows = Array.Empty<WarehouseRow>();
    private string _search = "";
    private bool _loading = true;

    private IReadOnlyList<WarehouseRow> _filtered =>
        string.IsNullOrWhiteSpace(_search)
            ? _rows
            : _rows.Where(r => (r.Title ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
                            || (r.WarehouseCode ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
                            || (r.Location ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try { _rows = await Db.QueryAsync<WarehouseRow>(Schema, "WarehouseList", new { CompanyId = Db.CurrentCompanyId }); }
        finally { _loading = false; }
    }

    private async Task CreateAsync()
    {
        var model = EntityEditorModel.FromWarehouse();
        if (await Crud.ShowEditorAsync(model)) await ReloadAsync();
    }

    private async Task EditAsync(WarehouseRow row)
    {
        var model = EntityEditorModel.FromWarehouse(row);
        if (await Crud.ShowEditorAsync(model)) await ReloadAsync();
    }

    private async Task DeleteAsync(WarehouseRow row)
    {
        var model = EntityEditorModel.FromWarehouse(row);
        if (await Crud.ConfirmDeleteAsync(model)) await ReloadAsync();
    }
}