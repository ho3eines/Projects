@page "/inventory/settings"
@inject DbService Db
@inject UserSession Session
@inject IDialogService Dialog
@inject ISnackbar Snackbar

<PageTitle>امکانات — انبار</PageTitle>

<PageHeader Title="امکانات و جداول پایه" Subtitle="گروه کالا، واحد کالا، کالاها، انبارها و انبارک‌ها + اتصال به حساب انبار." />
<MudTabs>
    <MudTabPanel Text="گروه کالا">
        <MudPaper Elevation="1" Class="pa-4">
            <PageToolbar AddText="گروه جدید" AddIcon="@Icons.Material.Filled.Add"
                         OnAddClick="OpenGroupNewAsync" />
            <MudTable Items="_groups" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>ترتیب</MudTh><MudTh>تعداد کالا</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.GroupCode</MudTd>
                    <MudTd DataLabel="عنوان">@context.Title</MudTd>
                    <MudTd DataLabel="ترتیب">@context.SortOrder</MudTd>
                    <MudTd DataLabel="تعداد کالا">@context.ItemCount</MudTd>
                    <MudTd DataLabel="وضعیت"><StatusChip IsActive="@context.IsActive" /></MudTd>
                    <MudTd DataLabel="عملیات">
                        <EntityActions EditClicked="@(() => OpenGroupEditAsync(context))"
                                       DeleteClicked="@(() => DeleteGroupAsync(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">گروهی نیست.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="واحد کالا">
        <MudPaper Elevation="1" Class="pa-4">
            <PageToolbar AddText="واحد جدید" AddIcon="@Icons.Material.Filled.Add"
                         OnAddClick="OpenUnitNewAsync" />
            <MudTable Items="_units" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.UnitCode</MudTd>
                    <MudTd DataLabel="عنوان">@context.Title</MudTd>
                    <MudTd DataLabel="وضعیت"><StatusChip IsActive="@context.IsActive" /></MudTd>
                    <MudTd DataLabel="عملیات">
                        <EntityActions EditClicked="@(() => OpenUnitEditAsync(context))"
                                       DeleteClicked="@(() => DeleteUnitAsync(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">واحدی نیست.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="کالاها">
        <MudPaper Elevation="1" Class="pa-4">
            <PageToolbar AddText="کالای جدید" AddIcon="@Icons.Material.Filled.Add"
                         OnAddClick="OpenItemNewAsync" />
            <MudTable Items="_items" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>گروه</MudTh><MudTh>واحد</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.ItemCode</MudTd>
                    <MudTd DataLabel="عنوان">@context.ItemTitle</MudTd>
                    <MudTd DataLabel="گروه">@(context.GroupTitle ?? context.Category)</MudTd>
                    <MudTd DataLabel="واحد">@(context.UnitTitle ?? context.Unit)</MudTd>
                    <MudTd DataLabel="وضعیت"><StatusChip IsActive="@context.IsActive" /></MudTd>
                    <MudTd DataLabel="عملیات">
                        <EntityActions EditClicked="@(() => OpenItemEditAsync(context))"
                                       DeleteClicked="@(() => DeleteItemAsync(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">کالایی نیست.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="انبارها">
        <MudPaper Elevation="1" Class="pa-4">
            <PageToolbar AddText="انبار جدید" AddIcon="@Icons.Material.Filled.Add"
                         OnAddClick="OpenWarehouseNewAsync" />
            <MudTable Items="_warehouses" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>موقعیت</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.WarehouseCode</MudTd>
                    <MudTd DataLabel="عنوان">@context.Title</MudTd>
                    <MudTd DataLabel="موقعیت">@context.Location</MudTd>
                    <MudTd DataLabel="وضعیت"><StatusChip IsActive="@context.IsActive" /></MudTd>
                    <MudTd DataLabel="عملیات">
                        <EntityActions EditClicked="@(() => OpenWarehouseEditAsync(context))"
                                       DeleteClicked="@(() => DeleteWarehouseAsync(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">انباری نیست.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="انبارک‌ها">
        <MudPaper Elevation="1" Class="pa-4">
            <PageToolbar AddText="انبارک جدید" AddIcon="@Icons.Material.Filled.Add"
                         OnAddClick="OpenSubWarehouseNewAsync" />
            <MudTable Items="_subWarehouses" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>انبار اصلی</MudTh><MudTh>موقعیت</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.SubWarehouseCode</MudTd>
                    <MudTd DataLabel="عنوان">@context.Title</MudTd>
                    <MudTd DataLabel="انبار اصلی">@context.WarehouseTitle</MudTd>
                    <MudTd DataLabel="موقعیت">@context.Location</MudTd>
                    <MudTd DataLabel="وضعیت"><StatusChip IsActive="@context.IsActive" /></MudTd>
                    <MudTd DataLabel="عملیات">
                        <EntityActions EditClicked="@(() => OpenSubWarehouseEditAsync(context))"
                                       DeleteClicked="@(() => DeleteSubWarehouseAsync(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">انبارکی نیست.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="اتصال به حساب انبار">
        <MudPaper Elevation="1" Class="pa-4">
            <MudForm @ref="_settingsForm" @bind-IsValid="_settingsValid">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6" md="4">
                        <MudSelect T="string" Label="روش قیمت‌گذاری" @bind-Value="_settings.CostingMethod"
                                   Variant="Variant.Outlined" Required="true" RequiredError="روش قیمت‌گذاری الزامی است.">
                            <MudSelectItem Value="@((string)"WeightedAverage")">میانگین موزون</MudSelectItem>
                            <MudSelectItem Value="@((string)"FIFO")">اولین خرید، اولین مصرف (FIFO)</MudSelectItem>
                            <MudSelectItem Value="@((string)"LIFO")">آخرین خرید، اولین مصرف (LIFO)</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudSelect T="int" Label="انبار پیش‌فرض" @bind-Value="_defaultWarehouseId"
                                   Variant="Variant.Outlined" Clearable="true">
                            <MudSelectItem Value="0">— بدون انبار پیش‌فرض —</MudSelectItem>
                            @foreach (var w in _warehouses)
                            {
                                <MudSelectItem Value="w.WarehouseId">@w.Title</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudSelect T="int" Label="انبارک پیش‌فرض" @bind-Value="_defaultSubWarehouseId"
                                   Variant="Variant.Outlined" Clearable="true">
                            <MudSelectItem Value="0">— بدون انبارک پیش‌فرض —</MudSelectItem>
                            @foreach (var s in _subWarehouses)
                            {
                                <MudSelectItem Value="s.SubWarehouseId">@s.Title (@s.WarehouseTitle)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12"><MudDivider /></MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">حساب انبار (کالا)</MudText>
                        <AccountPickerField Value="_inventoryAccount" ValueChanged="OnInventoryAccountAsync"
                                            ButtonLabel="انتخاب حساب انبار" EmptyText="حساب انبار انتخاب نشده است."
                                            PickerOptions="@_moeinOptions" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">حساب مقابل رسید (خرید)</MudText>
                        <AccountPickerField Value="_receiptContraAccount" ValueChanged="OnReceiptContraAccountAsync"
                                            ButtonLabel="انتخاب حساب مقابل رسید" EmptyText="حساب مقابل رسید انتخاب نشده است."
                                            PickerOptions="@_moeinOptions" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">حساب مقابل حواله (بهای تمام‌شده)</MudText>
                        <AccountPickerField Value="_issueContraAccount" ValueChanged="OnIssueContraAccountAsync"
                                            ButtonLabel="انتخاب حساب مقابل حواله" EmptyText="حساب مقابل حواله انتخاب نشده است."
                                            PickerOptions="@_moeinOptions" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudSwitch T="bool" @bind-Value="_settings.IsEnabled" Color="Color.Success">
                            ثبت خودکار سند حسابداری هنگام رسید/حواله
                        </MudSwitch>
                    </MudItem>
                    <MudItem xs="12">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSettingsAsync" Disabled="_busy">
                            ذخیره تنظیمات
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private const string Schema = "inventory";
    private List<ItemRow> _items = new();
    private List<WarehouseRow> _warehouses = new();
    private List<SubWarehouseRow> _subWarehouses = new();
    private List<ItemGroupRow> _groups = new();
    private List<UnitRow> _units = new();
    private InventorySettingsRow _settings = new();
    private int _defaultWarehouseId;
    private int _defaultSubWarehouseId;
    private AccountPickerResult? _inventoryAccount, _receiptContraAccount, _issueContraAccount;
    private static readonly AccountPickerOptions _moeinOptions = new()
    {
        Title = "انتخاب حساب (کل/معین/تفصیلی)",
        AllowedType = AccountPickerType.Moein,
        TransactionalOnly = true
    };
    private MudForm? _settingsForm;
    private bool _settingsValid;
    private bool _loading = true;
    private bool _busy;

    private Task OnInventoryAccountAsync(AccountPickerResult? v) { _inventoryAccount = v; return Task.CompletedTask; }
    private Task OnReceiptContraAccountAsync(AccountPickerResult? v) { _receiptContraAccount = v; return Task.CompletedTask; }
    private Task OnIssueContraAccountAsync(AccountPickerResult? v) { _issueContraAccount = v; return Task.CompletedTask; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = (await Db.QueryAsync<ItemRow>(Schema, "ItemList", new { CompanyId = Session.ActiveCompanyId })).ToList();
            _warehouses = (await Db.QueryAsync<WarehouseRow>(Schema, "WarehouseList", new { CompanyId = Session.ActiveCompanyId })).ToList();
            _subWarehouses = (await Db.QueryAsync<SubWarehouseRow>(Schema, "SubWarehouseList", new { CompanyId = Session.ActiveCompanyId, WarehouseId = (int?)null })).ToList();
            _groups = (await Db.QueryAsync<ItemGroupRow>(Schema, "ItemGroupList", new { CompanyId = Session.ActiveCompanyId })).ToList();
            _units = (await Db.QueryAsync<UnitRow>(Schema, "UnitList", new { CompanyId = Session.ActiveCompanyId })).ToList();
            _settings = await Db.QueryFirstOrDefaultAsync<InventorySettingsRow>(Schema, "InventorySettingsGet",
                new { CompanyId = Session.ActiveCompanyId }) ?? new InventorySettingsRow { CostingMethod = "WeightedAverage", IsEnabled = true };
            _defaultWarehouseId = _settings.DefaultWarehouseId ?? 0;
            _defaultSubWarehouseId = _settings.DefaultSubWarehouseId ?? 0;
            if (_settings.InventoryAccountId is int iid && iid > 0)
                _inventoryAccount = new AccountPickerResult { Id = iid, AccountCode = _settings.InventoryAccountCode ?? "", Title = _settings.InventoryAccountTitle ?? "", NodeType = "BaseMoein" };
            if (_settings.ReceiptContraAccountId is int rid && rid > 0)
                _receiptContraAccount = new AccountPickerResult { Id = rid, AccountCode = _settings.ReceiptContraAccountCode ?? "", Title = _settings.ReceiptContraAccountTitle ?? "", NodeType = "BaseMoein" };
            if (_settings.IssueContraAccountId is int xid && xid > 0)
                _issueContraAccount = new AccountPickerResult { Id = xid, AccountCode = _settings.IssueContraAccountCode ?? "", Title = _settings.IssueContraAccountTitle ?? "", NodeType = "BaseMoein" };
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ─── گروه کالا ───
    private Task OpenGroupNewAsync() => OpenGroupEditorAsync(new ItemGroupRow());
    private Task OpenGroupEditAsync(ItemGroupRow row) => OpenGroupEditorAsync(row);
    private async Task OpenGroupEditorAsync(ItemGroupRow row)
    {
        var dlg = await Dialog.ShowAsync<ItemGroupDialog>("گروه کالا", new DialogParameters
        {
            ["Model"] = row
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
        if ((await dlg.Result) is { Canceled: false })
            await LoadAsync();
    }

    private async Task DeleteGroupAsync(ItemGroupRow row)
    {
        var confirmed = await Dialog.ShowMessageBoxAsync("تأیید حذف",
            $"آیا از حذف گروه «{row.Title}» مطمئن هستید؟", yesText: "حذف", cancelText: "انصراف");
        if (confirmed is not true) return;
        try
        {
            await Db.ExecuteAsync(Schema, "ItemGroupDelete", new { GroupId = row.GroupId, CompanyId = Session.ActiveCompanyId });
            Snackbar.Add("حذف شد.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    // ─── واحد کالا ───
    private Task OpenUnitNewAsync() => OpenUnitEditorAsync(new UnitRow());
    private Task OpenUnitEditAsync(UnitRow row) => OpenUnitEditorAsync(row);
    private async Task OpenUnitEditorAsync(UnitRow row)
    {
        var dlg = await Dialog.ShowAsync<UnitDialog>("واحد کالا", new DialogParameters
        {
            ["Model"] = row
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
        if ((await dlg.Result) is { Canceled: false })
            await LoadAsync();
    }

    private async Task DeleteUnitAsync(UnitRow row)
    {
        var confirmed = await Dialog.ShowMessageBoxAsync("تأیید حذف",
            $"آیا از حذف واحد «{row.Title}» مطمئن هستید؟", yesText: "حذف", cancelText: "انصراف");
        if (confirmed is not true) return;
        try
        {
            await Db.ExecuteAsync(Schema, "UnitDelete", new { UnitId = row.UnitId, CompanyId = Session.ActiveCompanyId });
            Snackbar.Add("حذف شد.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    // ─── کالا ───
    private Task OpenItemNewAsync() => OpenItemEditorAsync(new ItemRow());
    private Task OpenItemEditAsync(ItemRow row) => OpenItemEditorAsync(row);
    private async Task OpenItemEditorAsync(ItemRow row)
    {
        var dlg = await Dialog.ShowAsync<ItemDialog>("کالا", new DialogParameters
        {
            ["Model"] = row,
            ["Groups"] = _groups,
            ["Units"] = _units
        }, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
        if ((await dlg.Result) is { Canceled: false })
            await LoadAsync();
    }

    private async Task DeleteItemAsync(ItemRow row)
    {
        var confirmed = await Dialog.ShowMessageBoxAsync("تأیید حذف",
            $"آیا از حذف کالای «{row.ItemTitle}» مطمئن هستید؟", yesText: "حذف", cancelText: "انصراف");
        if (confirmed is not true) return;
        try
        {
            await Db.ExecuteAsync(Schema, "ItemDelete", new { ItemId = row.ItemId, CompanyId = Session.ActiveCompanyId });
            Snackbar.Add("حذف شد.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    // ─── انبار ───
    private Task OpenWarehouseNewAsync() => OpenWarehouseEditorAsync(new WarehouseRow());
    private Task OpenWarehouseEditAsync(WarehouseRow row) => OpenWarehouseEditorAsync(row);
    private async Task OpenWarehouseEditorAsync(WarehouseRow row)
    {
        var dlg = await Dialog.ShowAsync<WarehouseDialog>("انبار", new DialogParameters
        {
            ["Model"] = row
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
        if ((await dlg.Result) is { Canceled: false })
            await LoadAsync();
    }

    private async Task DeleteWarehouseAsync(WarehouseRow row)
    {
        var confirmed = await Dialog.ShowMessageBoxAsync("تأیید حذف",
            $"آیا از حذف انبار «{row.Title}» مطمئن هستید؟", yesText: "حذف", cancelText: "انصراف");
        if (confirmed is not true) return;
        try
        {
            await Db.ExecuteAsync(Schema, "WarehouseDelete", new { WarehouseId = row.WarehouseId, CompanyId = Session.ActiveCompanyId });
            Snackbar.Add("حذف شد.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    // ─── انبارک ───
    private Task OpenSubWarehouseNewAsync() => OpenSubWarehouseEditorAsync(new SubWarehouseRow());
    private Task OpenSubWarehouseEditAsync(SubWarehouseRow row) => OpenSubWarehouseEditorAsync(row);
    private async Task OpenSubWarehouseEditorAsync(SubWarehouseRow row)
    {
        var dlg = await Dialog.ShowAsync<SubWarehouseDialog>("انبارک", new DialogParameters
        {
            ["Model"] = row,
            ["Warehouses"] = _warehouses
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
        if ((await dlg.Result) is { Canceled: false })
            await LoadAsync();
    }

    private async Task DeleteSubWarehouseAsync(SubWarehouseRow row)
    {
        var confirmed = await Dialog.ShowMessageBoxAsync("تأیید حذف",
            $"آیا از حذف انبارک «{row.Title}» مطمئن هستید؟", yesText: "حذف", cancelText: "انصراف");
        if (confirmed is not true) return;
        try
        {
            await Db.ExecuteAsync(Schema, "SubWarehouseDelete", new { SubWarehouseId = row.SubWarehouseId, CompanyId = Session.ActiveCompanyId });
            Snackbar.Add("حذف شد.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    // ─── تنظیمات ───
    private async Task SaveSettingsAsync()
    {
        if (_busy || _settingsForm is null) return;
        await _settingsForm.ValidateAsync();
        if (!_settingsValid) return;
        _busy = true;
        try
        {
            await Db.ExecuteAsync(Schema, "InventorySettingsUpsert", new
            {
                CompanyId = Session.ActiveCompanyId,
                CostingMethod = _settings.CostingMethod,
                InventoryAccountId = _inventoryAccount?.Id,
                InventoryAccountCode = _inventoryAccount?.AccountCode,
                InventoryAccountTitle = _inventoryAccount?.Title,
                ReceiptContraAccountId = _receiptContraAccount?.Id,
                ReceiptContraAccountCode = _receiptContraAccount?.AccountCode,
                ReceiptContraAccountTitle = _receiptContraAccount?.Title,
                IssueContraAccountId = _issueContraAccount?.Id,
                IssueContraAccountCode = _issueContraAccount?.AccountCode,
                IssueContraAccountTitle = _issueContraAccount?.Title,
                DefaultWarehouseId = _defaultWarehouseId == 0 ? (int?)null : _defaultWarehouseId,
                DefaultSubWarehouseId = _defaultSubWarehouseId == 0 ? (int?)null : _defaultSubWarehouseId,
                IsEnabled = _settings.IsEnabled,
                UpdatedBy = Session.UserName
            });
            Snackbar.Add("تنظیمات انبار ذخیره شد.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
