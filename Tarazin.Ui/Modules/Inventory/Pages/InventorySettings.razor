@page "/inventory/settings"
@inject DbService Db
@inject EntityCrudService EntityCrud
@inject ISnackbar Snackbar

<PageTitle>امکانات — انبار آمل</PageTitle>

<PageHeader Title="امکانات و جداول پایه" Subtitle="مدیریت کالاها و انبارها." />
<MudTabs>
    <MudTabPanel Text="کالاها">
        <MudPaper Elevation="1" Class="pa-4">
            <div class="d-flex justify-end mb-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => OpenItemEditorAsync(EntityEditorModel.FromInventoryItem()))">
                    کالای جدید
                </MudButton>
            </div>
            <MudTable Items="_items" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>دسته</MudTh><MudTh>واحد</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.ItemCode</MudTd>
                    <MudTd DataLabel="عنوان">@context.ItemTitle</MudTd>
                    <MudTd DataLabel="دسته">@context.Category</MudTd>
                    <MudTd DataLabel="واحد">@context.Unit</MudTd>
                    <MudTd DataLabel="وضعیت">
                        <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                            @(context.IsActive ? "فعال" : "غیرفعال")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="عملیات">
                        <MudTooltip Text="ویرایش کالا">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => OpenItemEditorAsync(EntityEditorModel.FromInventoryItem(context)))" />
                        </MudTooltip>
                        <MudTooltip Text="حذف">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => DeleteAsync(EntityEditorModel.FromInventoryItem(context)))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">کالایی نیست.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="انبارها">
        <MudPaper Elevation="1" Class="pa-4">
            <div class="d-flex justify-end mb-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => OpenWarehouseEditorAsync(EntityEditorModel.FromWarehouse()))">
                    انبار جدید
                </MudButton>
            </div>
            <MudTable Items="_warehouses" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>موقعیت</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.WarehouseCode</MudTd>
                    <MudTd DataLabel="عنوان">@context.Title</MudTd>
                    <MudTd DataLabel="موقعیت">@context.Location</MudTd>
                    <MudTd DataLabel="وضعیت">
                        <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                            @(context.IsActive ? "فعال" : "غیرفعال")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="عملیات">
                        <MudTooltip Text="ویرایش انبار">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => OpenWarehouseEditorAsync(EntityEditorModel.FromWarehouse(context)))" />
                        </MudTooltip>
                        <MudTooltip Text="حذف">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => DeleteAsync(EntityEditorModel.FromWarehouse(context)))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">انباری نیست.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private const string Schema = "inventory";
    private List<ItemRow> _items = new();
    private List<WarehouseRow> _warehouses = new();
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = (await Db.QueryAsync<ItemRow>(Schema, "ItemList")).ToList();
            _warehouses = (await Db.QueryAsync<WarehouseRow>(Schema, "WarehouseList")).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OpenItemEditorAsync(EntityEditorModel model) => OpenEditorAsync(model);
    private Task OpenWarehouseEditorAsync(EntityEditorModel model) => OpenEditorAsync(model);

    private async Task OpenEditorAsync(EntityEditorModel model)
    {
        if (await EntityCrud.ShowEditorAsync(model))
            await LoadAsync();
    }

    private async Task DeleteAsync(EntityEditorModel model)
    {
        if (await EntityCrud.ConfirmDeleteAsync(model))
            await LoadAsync();
    }
}
