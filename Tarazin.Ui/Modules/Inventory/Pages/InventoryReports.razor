@page "/inventory/reports"
@inject DbService Db
@inject UserSession Session
@inject AccountingContextService Context
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject PdfReportService Pdf
@inject PrintTemplateService Tpl

<PageTitle>گزارشات — انبار</PageTitle>

<PageHeader Title="گزارشات انبار" Subtitle="موجودی کالا (به تفکیک انبار/انبارک) و کارتکس کالا با ماندهٔ جاری." Eyebrow="انبار" />
<MudTabs>
    <MudTabPanel Text="موجودی کالا">
        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int" Label="انبار" @bind-Value="_whFilter" Variant="Variant.Outlined"
                               @bind-Value:after="OnFilterWarehouseChanged" Clearable="true">
                        <MudSelectItem Value="0">همهٔ انبارها</MudSelectItem>
                        @foreach (var w in _warehouses)
                        {
                            <MudSelectItem Value="w.WarehouseId">@w.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int" Label="انبارک" @bind-Value="_subFilter" Variant="Variant.Outlined"
                               Disabled="_whFilter == 0" Clearable="true">
                        <MudSelectItem Value="0">همهٔ انبارک‌ها</MudSelectItem>
                        @foreach (var s in _subFilters)
                        {
                            <MudSelectItem Value="s.SubWarehouseId">@s.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSwitch T="bool" @bind-Value="_onlyNonZero" Color="Color.Success">فقط کالاهای دارای موجودی</MudSwitch>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               OnClick="LoadBalancesAsync" Disabled="_loadingBalances">
                        بارگذاری موجودی
                    </MudButton>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Print" OnClick="PrintBalancesAsync"
                               Disabled="_loadingBalances || _balances.Count == 0">
                        چاپ
                    </MudButton>
                </MudItem>
            </MudGrid>
            <MudTable Items="_balances" Loading="_loadingBalances" Hover="true" Dense="true" Striped="true"
                      Breakpoint="Breakpoint.Sm" RowsPerPage="25">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>کالا</MudTh><MudTh>واحد</MudTh>
                    <MudTh>انبار</MudTh><MudTh>انبارک</MudTh>
                    <MudTh>موجودی</MudTh><MudTh>قیمت</MudTh><MudTh>ارزش</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.ItemCode</MudTd>
                    <MudTd DataLabel="کالا">@context.ItemTitle</MudTd>
                    <MudTd DataLabel="واحد">@context.Unit</MudTd>
                    <MudTd DataLabel="انبار">@(context.WarehouseName ?? "—")</MudTd>
                    <MudTd DataLabel="انبارک">@(context.SubWarehouseName ?? "—")</MudTd>
                    <MudTd DataLabel="موجودی">@context.StockQty.ToString("N0")</MudTd>
                    <MudTd DataLabel="قیمت">@context.UnitPrice.ToString("N0")</MudTd>
                    <MudTd DataLabel="ارزش">@context.StockValue.ToString("N0")</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Title="موجودی‌ای برای نمایش وجود ندارد." Description="فیلتر انبار یا گزینهٔ نمایش موجودی را تغییر دهید." Icon="@Icons.Material.Filled.Inventory2" />
                </NoRecordsContent>
                <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 25, 50, 100 })" /></PagerContent>
            </MudTable>
            @if (_balances.Count > 0)
            {
                <MudText Typo="Typo.body2" Class="mt-4">
                    جمع ارزش موجودی: <b>@_balances.Sum(b => b.StockValue).ToString("N0")</b>
                </MudText>
            }
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="کاردکس کالا">
        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int" Label="کالا" @bind-Value="_cardItemId" Variant="Variant.Outlined">
                        <MudSelectItem Value="0">— انتخاب کالا —</MudSelectItem>
                        @foreach (var it in _items)
                        {
                            <MudSelectItem Value="it.ItemId">@it.ItemCode — @it.ItemTitle</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int" Label="انبار" @bind-Value="_cardWarehouseId" Variant="Variant.Outlined"
                               @bind-Value:after="OnCardWarehouseChanged" Clearable="true">
                        <MudSelectItem Value="0">همهٔ انبارها</MudSelectItem>
                        @foreach (var w in _warehouses)
                        {
                            <MudSelectItem Value="w.WarehouseId">@w.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int" Label="انبارک" @bind-Value="_cardSubWarehouseId" Variant="Variant.Outlined"
                               Disabled="_cardWarehouseId == 0" Clearable="true">
                        <MudSelectItem Value="0">همهٔ انبارک‌ها</MudSelectItem>
                        @foreach (var s in _cardSubFilters)
                        {
                            <MudSelectItem Value="s.SubWarehouseId">@s.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="string" Label="مبدأ حرکت" @bind-Value="_cardSourceType" Variant="Variant.Outlined" Clearable="true">
                        <MudSelectItem Value="@("")">همهٔ مبدأها</MudSelectItem>
                        @foreach (var s in InventorySourceLabels.Options)
                        {
                            <MudSelectItem Value="s.Key">@s.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker Label="از تاریخ" Culture="FaCulture" @bind-Date="_from" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker Label="تا تاریخ" Culture="FaCulture" @bind-Date="_to" />
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               OnClick="LoadCardAsync" Disabled="_loadingCard">اجرا</MudButton>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Print" OnClick="PrintCardAsync"
                               Disabled="_loadingCard || _card.Count == 0">
                        چاپ
                    </MudButton>
                </MudItem>
                <MudItem xs="12">
                    <div class="d-flex align-center flex-wrap gap-2">
                        <MudTooltip Text="بازهٔ پیش‌فرض = کل سال مالی فعال">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                     Icon="@Icons.Material.Filled.CalendarMonth" Style="cursor:pointer"
                                     OnClick="ResetCardToFiscalYearAsync" Disabled="_loadingCard">
                                بازهٔ سال مالی
                            </MudChip>
                        </MudTooltip>
                        @if (_from is not null && _to is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                بازهٔ فعلی: <span class="tz-num">@PersianDate.ToPersian(_from.Value)</span> تا
                                <span class="tz-num">@PersianDate.ToPersian(_to.Value)</span>
                            </MudText>
                        }
                    </div>
                </MudItem>
            </MudGrid>
            @if (_card.Count > 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    ماندهٔ ابتدای دوره: @_card[0].OpeningQty.ToString("N0") واحد — ارزش @_card[0].OpeningValue.ToString("N0")
                </MudText>
            }
            <MudTable Items="_card" Loading="_loadingCard" Hover="true" Dense="true" Striped="true"
                      Breakpoint="Breakpoint.Sm" RowsPerPage="25">
                <HeaderContent>
                    <MudTh>تاریخ</MudTh><MudTh>شماره</MudTh><MudTh>نوع</MudTh>
                    <MudTh>مبدأ</MudTh><MudTh>دریافت</MudTh><MudTh>صدور</MudTh><MudTh>قیمت</MudTh>
                    <MudTh>مانده تعداد</MudTh><MudTh>مانده ارزش</MudTh><MudTh>شرح</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="تاریخ">@context.MovementDate.ToString("yyyy/MM/dd")</MudTd>
                    <MudTd DataLabel="شماره">@context.MovementNumber</MudTd>
                    <MudTd DataLabel="نوع">@context.MovementType</MudTd>
                    <MudTd DataLabel="مبدأ">
                        <MudChip T="string" Size="Size.Small" Color="@CardSourceColor(context.SourceType)" Variant="Variant.Outlined">
                            @InventorySourceLabels.For(context.SourceType)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="دریافت">@(context.InQty > 0 ? context.InQty.ToString("N0") : "—")</MudTd>
                    <MudTd DataLabel="صدور">@(context.OutQty > 0 ? context.OutQty.ToString("N0") : "—")</MudTd>
                    <MudTd DataLabel="قیمت">@context.CostPrice.ToString("N0")</MudTd>
                    <MudTd DataLabel="مانده تعداد">@context.BalanceQty.ToString("N0")</MudTd>
                    <MudTd DataLabel="مانده ارزش">@context.BalanceValue.ToString("N0")</MudTd>
                    <MudTd DataLabel="شرح">@context.Description</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Title="کارتکسی برای نمایش وجود ندارد." Description="کالا و بازهٔ تاریخ را انتخاب کنید." Icon="@Icons.Material.Filled.ListAlt" />
                </NoRecordsContent>
                <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 25, 50, 100 })" /></PagerContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "inventory";

    private List<StockBalanceRow> _balances = new();
    private List<StockCardRow> _card = new();
    private List<ItemRow> _items = new();
    private List<WarehouseRow> _warehouses = new();
    private List<SubWarehouseRow> _subFilters = new();
    private List<SubWarehouseRow> _cardSubFilters = new();
    private int _cardItemId;
    private int _whFilter;
    private int _subFilter;
    private int _cardWarehouseId;
    private int _cardSubWarehouseId;
    private string _cardSourceType = "";
    private bool _onlyNonZero = true;
    private DateTime? _from = DateTime.Today.AddMonths(-1);
    private DateTime? _to = DateTime.Today;
    private bool _loadingBalances;
    private bool _loadingCard;

    protected override async Task OnInitializedAsync()
    {
        _items = (await Db.QueryAsync<ItemRow>(Schema, "ItemList", new { CompanyId = Session.ActiveCompanyId, Search = "" })).ToList();
        _warehouses = (await Db.QueryAsync<WarehouseRow>(Schema, "WarehouseList", new { CompanyId = Session.ActiveCompanyId })).ToList();

        // پیش‌فرض فیلترها: انبار فعال نشست (مثل سال مالی) به‌جای «همهٔ انبارها».
        if (Session.ActiveWarehouseId is int aw && _warehouses.Any(w => w.WarehouseId == aw))
        {
            _whFilter = aw;
            _cardWarehouseId = aw;
            await OnFilterWarehouseChanged();
            await OnCardWarehouseChanged();
        }
    }

    private async Task OnFilterWarehouseChanged()
    {
        _subFilter = 0;
        _subFilters = _whFilter == 0 ? new() : (await Db.QueryAsync<SubWarehouseRow>(Schema, "SubWarehouseList", new
        {
            CompanyId = Session.ActiveCompanyId,
            WarehouseId = _whFilter
        })).ToList();
    }

    private async Task OnCardWarehouseChanged()
    {
        _cardSubWarehouseId = 0;
        _cardSubFilters = _cardWarehouseId == 0 ? new() : (await Db.QueryAsync<SubWarehouseRow>(Schema, "SubWarehouseList", new
        {
            CompanyId = Session.ActiveCompanyId,
            WarehouseId = _cardWarehouseId
        })).ToList();
    }

    private async Task LoadBalancesAsync()
    {
        _loadingBalances = true;
        try
        {
            _balances = (await Db.QueryAsync<StockBalanceRow>(Schema, "StockBalanceReport", new
            {
                CompanyId = Session.ActiveCompanyId,
                WarehouseId = _whFilter == 0 ? (int?)null : _whFilter,
                SubWarehouseId = _subFilter == 0 ? (int?)null : _subFilter,
                OnlyNonZero = _onlyNonZero ? 1 : 0
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loadingBalances = false;
        }
    }

    /// <summary>بازگشت بازهٔ کارتکس به کل سال مالی فعال و اجرای مجدد — یک کلیک.</summary>
    private async Task ResetCardToFiscalYearAsync()
    {
        var fy = await Context.GetActiveFiscalYearAsync();
        _from = fy?.StartDate ?? DateTime.Today.AddMonths(-1);
        _to = fy?.EndDate ?? DateTime.Today;
        await LoadCardAsync();
    }

    private async Task LoadCardAsync()
    {
        if (_cardItemId == 0)
        {
            Snackbar.Add("کالا را انتخاب کنید.", Severity.Warning);
            return;
        }

        _loadingCard = true;
        try
        {
            _card = (await Db.QueryAsync<StockCardRow>(Schema, "StockCardReport", new
            {
                CompanyId = Session.ActiveCompanyId,
                ItemId = _cardItemId,
                FromDate = _from?.Date ?? DateTime.Today.AddMonths(-1),
                ToDate = _to?.Date ?? DateTime.Today,
                WarehouseId = _cardWarehouseId == 0 ? (int?)null : _cardWarehouseId,
                SubWarehouseId = _cardSubWarehouseId == 0 ? (int?)null : _cardSubWarehouseId,
                SourceType = string.IsNullOrWhiteSpace(_cardSourceType) ? (string?)null : _cardSourceType
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loadingCard = false;
        }
    }

    // ── چاپ (موتور چاپ عمومی — طبق اسکیل tarazin-reporting) ──

    private static Color CardSourceColor(string? type)
    {
        try
        {
            return type?.ToUpperInvariant() switch
            {
                "STOREORDER" => Color.Secondary,
                "PINV" => Color.Info,
                "SINV" => Color.Primary,
                "RET" => Color.Warning,
                "STOCKTAKE" => Color.Error,
                _ => Color.Default
            };
        }
        catch { return Color.Default; }
    }

    private async Task PrintBalancesAsync()
    {
        if (_balances.Count == 0) return;
        var tpl = await Tpl.GetOrCreateDefaultAsync("inventory.balances");
        var data = new PrintDataModel
        {
            CompanyName = "ترازین — سامانه یکپارچه مدیریت کسب‌وکار",
            Title = "موجودی کالا",
            Subtitle = "موجودی به تفکیک انبار/انبارک",
            RangeText = $"تهیه‌شده در {DateTime.Now:yyyy/MM/dd HH:mm}",
            QrEnabled = false
        };
        data.MetaFields.Add(new PrintMetaField { Label = "انبار", Value = _whFilter == 0 ? "همه" : (_warehouses.FirstOrDefault(w => w.WarehouseId == _whFilter)?.Title ?? "—"), Bold = true });
        data.MetaFields.Add(new PrintMetaField { Label = "تاریخ تهیه", Value = DateTime.Now.ToString("yyyy/MM/dd HH:mm") });
        data.MetaFields.Add(new PrintMetaField { Label = "تعداد اقلام", Value = _balances.Count.ToString("N0"), Bold = true });
        foreach (var r in _balances)
        {
            data.Rows.Add(new PrintRow
            {
                ["ItemCode"] = r.ItemCode,
                ["ItemTitle"] = r.ItemTitle,
                ["Unit"] = r.Unit,
                ["WarehouseName"] = r.WarehouseName ?? "—",
                ["SubWarehouseName"] = r.SubWarehouseName ?? "—",
                ["StockQty"] = r.StockQty,
                ["UnitPrice"] = r.UnitPrice,
                ["StockValue"] = r.StockValue
            });
        }
        data.FooterFields.Add(new PrintMetaField { Label = "جمع ارزش", Value = _balances.Sum(b => b.StockValue).ToString("N0") + " ریال", Bold = true });
        await Dialog.ShowAsync<TemplatePrintDialog>("چاپ موجودی کالا",
            new DialogParameters<TemplatePrintDialog>
            {
                { x => x.Template, tpl }, { x => x.Data, data }, { x => x.TemplateId, "inventory.balances" }
            },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
    }

    private async Task PrintCardAsync()
    {
        if (_card.Count == 0) return;
        var item = _items.FirstOrDefault(i => i.ItemId == _cardItemId);
        var title = item is null ? "کاردکس کالا" : $"کاردکس {item.ItemCode} — {item.ItemTitle}";
        var tpl = await Tpl.GetOrCreateDefaultAsync("inventory.card");
        var data = new PrintDataModel
        {
            CompanyName = "ترازین — سامانه یکپارچه مدیریت کسب‌وکار",
            Title = title,
            Subtitle = "گردش دریافت/صدور و ماندهٔ جاری",
            RangeText = $"از {_from:yyyy/MM/dd} تا {_to:yyyy/MM/dd}",
            QrEnabled = false
        };
        data.MetaFields.Add(new PrintMetaField { Label = "کالا", Value = title, Bold = true });
        data.MetaFields.Add(new PrintMetaField { Label = "بازه", Value = $"از {_from:yyyy/MM/dd} تا {_to:yyyy/MM/dd}" });
        if (_card.Count > 0)
            data.MetaFields.Add(new PrintMetaField { Label = "ماندهٔ ابتدا", Value = $"{_card[0].OpeningQty:N0} واحد — ارزش {_card[0].OpeningValue:N0}", Bold = true });
        foreach (var r in _card)
        {
            data.Rows.Add(new PrintRow
            {
                ["MovementDate"] = r.MovementDate.ToString("yyyy/MM/dd"),
                ["MovementNumber"] = r.MovementNumber,
                ["MovementType"] = r.MovementType,
                ["InQty"] = r.InQty > 0 ? r.InQty : (object)0,
                ["OutQty"] = r.OutQty > 0 ? r.OutQty : (object)0,
                ["CostPrice"] = r.CostPrice,
                ["BalanceQty"] = r.BalanceQty,
                ["BalanceValue"] = r.BalanceValue,
                ["Description"] = r.Description ?? ""
            });
        }
        await Dialog.ShowAsync<TemplatePrintDialog>("چاپ کاردکس کالا",
            new DialogParameters<TemplatePrintDialog>
            {
                { x => x.Template, tpl }, { x => x.Data, data }, { x => x.TemplateId, "inventory.card" }
            },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
    }

    private RenderFragment BalancesTableBody => @<MudTable Items="_balances" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" Class="gp-lines-table">
        <HeaderContent>
            <MudTh>کد</MudTh><MudTh>کالا</MudTh><MudTh>واحد</MudTh>
            <MudTh>انبار</MudTh><MudTh>انبارک</MudTh>
            <MudTh>موجودی</MudTh><MudTh>قیمت</MudTh><MudTh>ارزش</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="کد">@context.ItemCode</MudTd>
            <MudTd DataLabel="کالا">@context.ItemTitle</MudTd>
            <MudTd DataLabel="واحد">@context.Unit</MudTd>
            <MudTd DataLabel="انبار">@(context.WarehouseName ?? "—")</MudTd>
            <MudTd DataLabel="انبارک">@(context.SubWarehouseName ?? "—")</MudTd>
            <MudTd DataLabel="موجودی">@context.StockQty.ToString("N0")</MudTd>
            <MudTd DataLabel="قیمت">@context.UnitPrice.ToString("N0")</MudTd>
            <MudTd DataLabel="ارزش">@context.StockValue.ToString("N0")</MudTd>
        </RowTemplate>
    </MudTable>;

    private RenderFragment CardTableBody => @<MudTable Items="_card" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" Class="gp-lines-table">
        <HeaderContent>
            <MudTh>تاریخ</MudTh><MudTh>شماره</MudTh><MudTh>نوع</MudTh>
            <MudTh>دریافت</MudTh><MudTh>صدور</MudTh><MudTh>قیمت</MudTh>
            <MudTh>Lot</MudTh><MudTh>Serial</MudTh><MudTh>انقضا</MudTh>
            <MudTh>مانده تعداد</MudTh><MudTh>مانده ارزش</MudTh><MudTh>شرح</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="تاریخ">@context.MovementDate.ToString("yyyy/MM/dd")</MudTd>
            <MudTd DataLabel="شماره">@context.MovementNumber</MudTd>
            <MudTd DataLabel="نوع">@context.MovementType</MudTd>
            <MudTd DataLabel="دریافت">@(context.InQty > 0 ? context.InQty.ToString("N0") : "—")</MudTd>
            <MudTd DataLabel="صدور">@(context.OutQty > 0 ? context.OutQty.ToString("N0") : "—")</MudTd>
            <MudTd DataLabel="قیمت">@context.CostPrice.ToString("N0")</MudTd>
            <MudTd DataLabel="Lot">@(string.IsNullOrWhiteSpace(context.LotNo) ? "—" : context.LotNo)</MudTd>
            <MudTd DataLabel="Serial">@(string.IsNullOrWhiteSpace(context.SerialNo) ? "—" : context.SerialNo)</MudTd>
            <MudTd DataLabel="انقضا">@(string.IsNullOrWhiteSpace(context.ExpiryDate) ? "—" : context.ExpiryDate)</MudTd>
            <MudTd DataLabel="مانده تعداد">@context.BalanceQty.ToString("N0")</MudTd>
            <MudTd DataLabel="مانده ارزش">@context.BalanceValue.ToString("N0")</MudTd>
            <MudTd DataLabel="شرح">@context.Description</MudTd>
        </RowTemplate>
    </MudTable>;

    private byte[] BuildBalancesPdf(string paperSize)
    {
        var columns = new List<TableReportColumn>
        {
            new() { Header = "کد" },
            new() { Header = "کالا" },
            new() { Header = "واحد" },
            new() { Header = "انبار" },
            new() { Header = "انبارک" },
            new() { Header = "موجودی", AlignRight = true },
            new() { Header = "قیمت", AlignRight = true },
            new() { Header = "ارزش", AlignRight = true }
        };
        var rows = _balances.Select(r => (IReadOnlyList<string>)new string[]
        {
            r.ItemCode, r.ItemTitle, r.Unit, r.WarehouseName ?? "—", r.SubWarehouseName ?? "—",
            r.StockQty.ToString("N0"), r.UnitPrice.ToString("N0"), r.StockValue.ToString("N0")
        }).ToList();

        return Pdf.BuildTablePdf("موجودی کالا", "موجودی به تفکیک انبار/انبارک",
            $"تهیه شده در {DateTime.Now:yyyy/MM/dd HH:mm}", columns, rows,
            new[] { $"جمع ارزش: {_balances.Sum(b => b.StockValue):N0} ریال" }, paperSize);
    }

    private byte[] BuildCardPdf(string paperSize)
    {
        var columns = new List<TableReportColumn>
        {
            new() { Header = "تاریخ" },
            new() { Header = "شماره" },
            new() { Header = "نوع" },
            new() { Header = "دریافت", AlignRight = true },
            new() { Header = "صدور", AlignRight = true },
            new() { Header = "قیمت", AlignRight = true },
            new() { Header = "Lot" },
            new() { Header = "Serial" },
            new() { Header = "انقضا" },
            new() { Header = "مانده تعداد", AlignRight = true },
            new() { Header = "مانده ارزش", AlignRight = true },
            new() { Header = "شرح" }
        };
        var rows = _card.Select(r => (IReadOnlyList<string>)new string[]
        {
            r.MovementDate.ToString("yyyy/MM/dd"), r.MovementNumber, r.MovementType,
            r.InQty > 0 ? r.InQty.ToString("N0") : "—", r.OutQty > 0 ? r.OutQty.ToString("N0") : "—",
            r.CostPrice.ToString("N0"),
            string.IsNullOrWhiteSpace(r.LotNo) ? "—" : r.LotNo,
            string.IsNullOrWhiteSpace(r.SerialNo) ? "—" : r.SerialNo,
            string.IsNullOrWhiteSpace(r.ExpiryDate) ? "—" : r.ExpiryDate,
            r.BalanceQty.ToString("N0"), r.BalanceValue.ToString("N0"), r.Description
        }).ToList();

        var summary = new List<string>();
        if (_card.Count > 0)
            summary.Add($"ماندهٔ ابتدای دوره: {_card[0].OpeningQty:N0} واحد — ارزش {_card[0].OpeningValue:N0}");

        return Pdf.BuildTablePdf("کاردکس کالا", "گردش دریافت/صدور و ماندهٔ جاری",
            $"از {_from:yyyy/MM/dd} تا {_to:yyyy/MM/dd}", columns, rows, summary, paperSize);
    }
}
