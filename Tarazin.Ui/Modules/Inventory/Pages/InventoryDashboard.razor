@page "/inventory/dashboard"
@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<PageTitle>داشبورد — انبار</PageTitle>

<PageHeader Title="نمای کلی انبار" Subtitle="حرکت‌ها، موجودی و رزرو." Eyebrow="انبار" />

@if (_loading)
{
    <StatCardSkeleton Count="4" />
}
else
{
    <MudGrid>
        <StatCard Label="حرکات امروز" Value="@_summary.TodayMovements.ToString("N0")"
                  Icon="@Icons.Material.Filled.SwapHoriz" Accent="@TarazinAccents.Moss" />
        <StatCard Label="کل کالاها" Value="@_summary.TotalItems.ToString("N0")"
                  Icon="@Icons.Material.Filled.Inventory2" Accent="@TarazinAccents.Ink" />
        <StatCard Label="ارزش موجودی" Value="@_summary.StockValue.ToString("N0")"
                  Icon="@Icons.Material.Filled.Savings" Accent="@TarazinAccents.Gold" />
        <StatCard Label="رزرو فعال" Value="@_summary.ActiveReservations.ToString("N0")"
                  Icon="@Icons.Material.Filled.Bookmark" Accent="@TarazinAccents.Wine" />
    </MudGrid>
}

@code {
    private const string Schema = "inventory";
    private bool _loading = true;
    private InventoryDashboardRow _summary = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await Db.QueryFirstOrDefaultAsync<InventoryDashboardRow>(Schema, "DashboardSummary",
                       new { CompanyId = Session.ActiveCompanyId })
                       ?? new InventoryDashboardRow();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
