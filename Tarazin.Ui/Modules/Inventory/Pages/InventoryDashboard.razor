@page "/inventory/dashboard"
@inject DbService Db
@inject ISnackbar Snackbar

<PageTitle>داشبورد — انبار آمل</PageTitle>

<PageHeader Title="نمای کلی انبار" Subtitle="حرکت‌ها، موجودی و رزرو." Eyebrow="انبار آمل" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <MudGrid>
        <StatCard Label="حرکات امروز" Value="@_summary.TodayMovements.ToString("N0")"
                  Icon="@Icons.Material.Filled.SwapHoriz" Accent="#4A6B3A" />
        <StatCard Label="کل کالاها" Value="@_summary.TotalItems.ToString("N0")"
                  Icon="@Icons.Material.Filled.Inventory2" Accent="#0E4D4A" />
        <StatCard Label="ارزش موجودی" Value="@_summary.StockValue.ToString("N0")"
                  Icon="@Icons.Material.Filled.Savings" Accent="#C49A3C" />
        <StatCard Label="رزرو فعال" Value="@_summary.ActiveReservations.ToString("N0")"
                  Icon="@Icons.Material.Filled.Bookmark" Accent="#9C3B2E" />
    </MudGrid>
}

@code {
    private const string Schema = "inventory";
    private bool _loading = true;
    private InventoryDashboardRow _summary = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await Db.QueryFirstOrDefaultAsync<InventoryDashboardRow>(Schema, "DashboardSummary")
                       ?? new InventoryDashboardRow();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
