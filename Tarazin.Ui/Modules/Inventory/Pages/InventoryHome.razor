@page "/inventory"
@inject DbService Db
@inject ISnackbar Snackbar

<PageTitle>اسناد روز انبار — انبار آمل</PageTitle>

<MudText Typo="Typo.h4">اسناد روز انبار</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    رسید و حواله — از تاریخ / تا تاریخ (پیش‌فرض امروز).
</MudText>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="از تاریخ" Culture="FaCulture" @bind-Date="_from" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="تا تاریخ" Culture="FaCulture" @bind-Date="_to" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Label="جستجو (شماره حرکت یا کالا)" @bind-Value="_search" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync" Disabled="_loading">
                اعمال فیلتر
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="1" Class="pa-4">
    <MudTable Items="_rows" Loading="_loading" Hover="true" Dense="true" Striped="true">
        <HeaderContent>
            <MudTh>شماره</MudTh><MudTh>تاریخ</MudTh><MudTh>نوع</MudTh><MudTh>کالا</MudTh>
            <MudTh>انبار</MudTh><MudTh>تعداد</MudTh><MudTh>ارزش</MudTh><MudTh>وضعیت</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="شماره">@context.MovementNumber</MudTd>
            <MudTd DataLabel="تاریخ">@context.MovementDate.ToString("yyyy/MM/dd")</MudTd>
            <MudTd DataLabel="نوع">@context.MovementType</MudTd>
            <MudTd DataLabel="کالا">@context.ItemCode — @context.ItemTitle</MudTd>
            <MudTd DataLabel="انبار">@context.WarehouseName</MudTd>
            <MudTd DataLabel="تعداد">@context.Qty.ToString("N0")</MudTd>
            <MudTd DataLabel="ارزش">@context.TotalValue.ToString("N0")</MudTd>
            <MudTd DataLabel="وضعیت">
                <MudChip Size="Size.Small" Color="@(context.Status == "Posted" ? Color.Success : Color.Default)">@context.Status</MudChip>
            </MudTd>
        </RowTemplate>
        <EmptyContent><MudText Color="Color.Secondary">حرکتی در این بازه نیست.</MudText></EmptyContent>
    </MudTable>
</MudPaper>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "inventory";

    private List<DailyMovementRow> _rows = new();
    private bool _loading = true;
    private string _search = "";
    private DateTime? _from;
    private DateTime? _to;

    protected override async Task OnInitializedAsync()
    {
        _from = DateTime.Today;
        _to = DateTime.Today;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _rows = (await Db.QueryAsync<DailyMovementRow>(Schema, "DailyMovements", new
            {
                FromDate = _from?.Date ?? DateTime.Today,
                ToDate = _to?.Date ?? DateTime.Today,
                SearchText = _search ?? "",
                MovementType = (string?)null,
                SkipRows = 0,
                TakeSize = 100
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
