@page "/inventory/special"
@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<PageTitle>عملیات ویژه — انبار آمل</PageTitle>

<MudText Typo="Typo.h4">عملیات ویژه</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    شمارش موجودی (انبارگردانی) — تعدیل بر اساس تعداد شمرده‌شده.
</MudText>

<MudPaper Elevation="1" Class="pa-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="int" Label="کالا" @bind-Value="_itemId" Variant="Variant.Outlined">
                <MudSelectItem Value="0">— انتخاب کالا —</MudSelectItem>
                @foreach (var it in _items)
                {
                    <MudSelectItem Value="it.ItemId">@it.ItemCode — @it.ItemTitle</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudNumericField T="decimal" Label="تعداد شمرده‌شده" @bind-Value="_counted" Variant="Variant.Outlined" Min="0" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Rule" OnClick="RunAsync" Disabled="_busy">
                اجرای انبارگردانی
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    private const string Schema = "inventory";

    private List<ItemRow> _items = new();
    private int _itemId;
    private decimal _counted;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _items = (await Db.QueryAsync<ItemRow>(Schema, "ItemList")).ToList();
    }

    private async Task RunAsync()
    {
        if (_busy) return;
        if (_itemId == 0)
        {
            Snackbar.Add("کالا را انتخاب کنید.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await Db.ExecuteAsync(Schema, "StocktakeRun", new
            {
                ItemId = _itemId,
                CountedQty = _counted,
                CreatedBy = Session.UserName
            });
            Snackbar.Add("انبارگردانی ثبت شد.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
