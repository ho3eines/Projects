@page "/inventory/special"
@using Tarazin.Modules.Accounting.Pages
@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>عملیات ویژه — انبار</PageTitle>

<PageHeader Title="عملیات ویژه" Subtitle="شمارش موجودی (انبارگردانی) — تعدیل بر اساس تعداد شمرده‌شده در انبار/انبارک مشخص." />
<MudPaper Elevation="1" Class="pa-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="int" Label="کالا" @bind-Value="_itemId" Variant="Variant.Outlined">
                <MudSelectItem Value="0">— انتخاب کالا —</MudSelectItem>
                @foreach (var it in _items)
                {
                    <MudSelectItem Value="it.ItemId">@it.ItemCode — @it.ItemTitle</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="int" Label="انبار" @bind-Value="_warehouseId" Variant="Variant.Outlined"
                       @bind-Value:after="OnWarehouseChanged">
                <MudSelectItem Value="0">— انتخاب انبار —</MudSelectItem>
                @foreach (var w in _warehouses)
                {
                    <MudSelectItem Value="w.WarehouseId">@w.Title</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="int" Label="انبارک (اختیاری)" @bind-Value="_subWarehouseId" Variant="Variant.Outlined"
                       Disabled="_warehouseId == 0" Clearable="true">
                <MudSelectItem Value="0">— بدون انبارک —</MudSelectItem>
                @foreach (var s in _subWarehouses)
                {
                    <MudSelectItem Value="s.SubWarehouseId">@s.Title</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <TzNumericField T="decimal" Label="تعداد شمرده‌شده" @bind-Value="_counted" Variant="Variant.Outlined" Min="0" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Rule" OnClick="RunAsync" Disabled="_busy">
                اجرای انبارگردانی
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_lastDocument is not null)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-4">
        <div class="d-flex align-center flex-wrap" style="gap:8px">
            <MudText>
                سند حسابداری مغایرت ایجاد شد:
                <b>@_lastDocument.DocumentNumber</b> — مبلغ @_lastDocument.TotalAmount.ToString("N0")
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ReceiptLong"
                       OnClick="ShowAdjustmentDocumentAsync">
                مشاهدهٔ سند انبارگردانی
            </MudButton>
        </div>
    </MudAlert>
}

@code {
    private const string Schema = "inventory";

    private List<ItemRow> _items = new();
    private List<WarehouseRow> _warehouses = new();
    private List<SubWarehouseRow> _subWarehouses = new();
    private int _itemId;
    private int _warehouseId;
    private int _subWarehouseId;
    private decimal _counted;
    private bool _busy;
    private DailyDocumentRow? _lastDocument;

    protected override async Task OnInitializedAsync()
    {
        _items = (await Db.QueryAsync<ItemRow>(Schema, "ItemList", new { CompanyId = Session.ActiveCompanyId, Search = "" })).ToList();
        _warehouses = (await Db.QueryAsync<WarehouseRow>(Schema, "WarehouseList", new { CompanyId = Session.ActiveCompanyId })).ToList();
        // انبار فعال نشست (انتخاب‌شده از نوار بالا مثل سال مالی).
        if (Session.ActiveWarehouseId is int aw && _warehouses.Any(w => w.WarehouseId == aw))
        {
            _warehouseId = aw;
            await OnWarehouseChanged();
        }
        else if (_warehouses.Count > 0)
        {
            _warehouseId = _warehouses[0].WarehouseId;
            await OnWarehouseChanged();
        }
    }

    private async Task OnWarehouseChanged()
    {
        _subWarehouseId = 0;
        _subWarehouses = (await Db.QueryAsync<SubWarehouseRow>(Schema, "SubWarehouseList", new
        {
            CompanyId = Session.ActiveCompanyId,
            WarehouseId = _warehouseId == 0 ? (int?)null : _warehouseId
        })).ToList();
    }

    private async Task RunAsync()
    {
        if (_busy) return;
        if (_itemId == 0 || _warehouseId == 0)
        {
            Snackbar.Add("کالا و انبار را انتخاب کنید.", Severity.Warning);
            return;
        }

        _busy = true;
        _lastDocument = null;
        try
        {
            var result = await Db.QueryFirstOrDefaultAsync<StocktakeResultRow>(Schema, "StocktakeRun", new
            {
                ItemId = _itemId,
                WarehouseId = _warehouseId,
                SubWarehouseId = _subWarehouseId == 0 ? (int?)null : _subWarehouseId,
                CountedQty = _counted,
                FiscalYearId = Session.ActiveFiscalYearId,
                CreatedBy = Session.UserName,
                CompanyId = Session.ActiveCompanyId
            });

            if (result?.DocumentId is int documentId && documentId > 0)
            {
                _lastDocument = await Db.QueryFirstOrDefaultAsync<DailyDocumentRow>(
                    "accounting", "DocumentById",
                    new
                    {
                        DocumentId = documentId,
                        CompanyId = Session.ActiveCompanyId,
                        FiscalYearId = Session.ActiveFiscalYearId
                    });
            }

            Snackbar.Add("انبارگردانی ثبت شد.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ShowAdjustmentDocumentAsync()
    {
        if (_lastDocument is null) return;
        try
        {
            var parameters = new DialogParameters
            {
                ["DocumentId"] = _lastDocument.DocumentId,
                ["IsModal"] = 1
            };
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseButton = true,
                CloseOnEscapeKey = true
            };
            await DialogService.ShowAsync<AccountingDocument>(
                $"سند انبارگردانی {_lastDocument.DocumentNumber}", parameters, options);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در نمایش سند: {ex.Message}", Severity.Error);
        }
    }
}
