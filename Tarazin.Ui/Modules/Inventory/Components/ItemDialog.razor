@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField Label="کد کالا" @bind-Value="_model.ItemCode" Variant="Variant.Outlined"
                                  HelperText="خالی = خودکار" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="عنوان" @bind-Value="_model.ItemTitle" Required="true"
                                  RequiredError="عنوان کالا الزامی است." Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" Label="گروه کالا" @bind-Value="_groupId" Variant="Variant.Outlined" Clearable="true">
                        <MudSelectItem Value="0">— بدون گروه —</MudSelectItem>
                        @foreach (var g in Groups)
                        {
                            <MudSelectItem Value="g.GroupId">@g.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" Label="واحد کالا" @bind-Value="_unitId" Variant="Variant.Outlined" Clearable="true">
                        <MudSelectItem Value="0">— بدون واحد —</MudSelectItem>
                        @foreach (var u in Units)
                        {
                            <MudSelectItem Value="u.UnitId">@u.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="دسته‌بندی (متن آزاد)" @bind-Value="_model.Category" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="واحد (متن آزاد)" @bind-Value="_model.Unit" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudNumericField T="decimal" Label="قیمت واحد (پایه)" @bind-Value="_model.UnitPrice"
                                     Min="0" Format="#,##0.##" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Success">فعال</MudSwitch>
                </MudItem>

                <MudItem xs="12" Class="mt-2">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">واحدهای چندگانهٔ کالا (اختیاری)</MudText>
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                        @foreach (var iu in _itemUnits.Select((u, i) => new { u, i }))
                        {
                            <MudGrid Spacing="2" Class="py-1">
                                <MudItem xs="6" sm="4">
                                    <MudSelect T="int" Label="واحد" @bind-Value="iu.u.UnitId" Variant="Variant.Outlined" Margin="Margin.Dense">
                                        <MudSelectItem Value="0">— واحد —</MudSelectItem>
                                        @foreach (var u in Units)
                                        {
                                            <MudSelectItem Value="u.UnitId">@u.Title</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="3" sm="3">
                                    <MudNumericField T="decimal" Label="ضریب" @bind-Value="iu.u.Factor"
                                                     Min="0.0001m" Format="#,##0.####" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="2" sm="3">
                                    <MudSwitch T="bool" @bind-Value="iu.u.IsDefault" Color="Color.Success" Label="پیش‌فرض" />
                                </MudItem>
                                <MudItem xs="1" sm="2" Class="d-flex align-center">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => _itemUnits.RemoveAt(iu.i))" />
                                </MudItem>
                            </MudGrid>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _itemUnits.Add(new ItemUnitRow()))">
                            افزودن واحد
                        </MudButton>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            ضریب، تبدیل به واحد پایه است (پیش‌فرض = ۱). مثال: «کیلوگرم» ضریب ۱۰۰۰ نسبت به «گرم».
                        </MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel" Disabled="_busy">انصراف</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync" Disabled="_busy">ذخیره</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public ItemRow Model { get; set; } = default!;
    [Parameter] public List<ItemGroupRow> Groups { get; set; } = new();
    [Parameter] public List<UnitRow> Units { get; set; } = new();

    private ItemRow _model = new();
    private int _groupId;
    private int _unitId;
    private List<ItemUnitRow> _itemUnits = new();
    private MudForm? _form;
    private bool _isValid;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        if (Model is not null)
        {
            _model = new ItemRow
            {
                ItemId = Model.ItemId,
                ItemCode = Model.ItemCode,
                ItemTitle = Model.ItemTitle,
                Category = Model.Category,
                Unit = Model.Unit,
                UnitPrice = Model.UnitPrice,
                IsActive = Model.IsActive
            };
            _groupId = Model.GroupId ?? 0;
            _unitId = Model.UnitId ?? 0;
        }
        // واحدهای چندگانهٔ کالا (برای کالای جدید خالی می‌ماند)
        if (_model.ItemId > 0)
        {
            try
            {
                _itemUnits = (await Db.QueryAsync<ItemUnitRow>("inventory", "ItemUnitsList",
                    new { ItemId = _model.ItemId })).ToList();
            }
            catch
            {
                // جدول/اسکریپت‌ها تازه اضافه شده‌اند — بدون واحد چندگانه ادامه بده
                _itemUnits = new();
            }
        }
    }

    private async Task SaveItemUnitsAsync(int itemId, List<ItemUnitRow> units)
    {
        var unitsJson = JsonSerializer.Serialize(units.Select(u => new
        {
            UnitId = u.UnitId,
            Factor = u.Factor,
            IsDefault = u.IsDefault
        }));
        await Db.ExecuteAsync("inventory", "ItemUnitsUpsert", new
        {
            ItemId = itemId,
            Json = unitsJson,
            CreatedBy = Session.UserName
        });
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_busy || _form is null) return;
        await _form.ValidateAsync();
        if (!_isValid) return;
        _busy = true;
        try
        {
            await Db.ExecuteAsync("inventory", "ItemUpsert", new
            {
                ItemId = _model.ItemId,
                ItemCode = _model.ItemCode.Trim(),
                ItemTitle = _model.ItemTitle.Trim(),
                Category = string.IsNullOrWhiteSpace(_model.Category) ? null : _model.Category.Trim(),
                Unit = string.IsNullOrWhiteSpace(_model.Unit) ? "عدد" : _model.Unit.Trim(),
                GroupId = _groupId == 0 ? (int?)null : _groupId,
                UnitId = _unitId == 0 ? (int?)null : _unitId,
                UnitPrice = _model.UnitPrice,
                IsActive = _model.IsActive,
                CreatedBy = Session.UserName,
                CompanyId = Session.ActiveCompanyId
            });

            // واحدهای چندگانه: برای کالای تازه‌ساخته، شناسه را با ItemList جستجو می‌کنیم
            var validUnits = _itemUnits.Where(u => u.UnitId > 0).Select(u => new ItemUnitRow
            {
                UnitId = u.UnitId,
                Factor = u.IsDefault ? 1m : (u.Factor <= 0 ? 1m : u.Factor),
                IsDefault = u.IsDefault
            }).ToList();
            if (validUnits.Count > 0 && _model.ItemId > 0)
            {
                await SaveItemUnitsAsync(_model.ItemId, validUnits);
            }
            else if (validUnits.Count > 0)
            {
                // کالای جدید — شناسهٔ تازه را از طریق ItemList پیدا کن
                var fresh = (await Db.QueryAsync<ItemRow>("inventory", "ItemList", new
                {
                    CompanyId = Session.ActiveCompanyId,
                    Search = _model.ItemTitle.Trim()
                })).FirstOrDefault(x => x.ItemTitle == _model.ItemTitle.Trim());
                if (fresh is not null)
                    await SaveItemUnitsAsync(fresh.ItemId, validUnits);
            }

            Snackbar.Add("ذخیره شد.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }
}
