@page "/login"
@layout AuthLayout
@inject AuthService Auth
@inject UserSession Session
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>ورود — ترازین</PageTitle>

<div class="tz-login">
    <aside class="tz-login__brand">
        <img src="_content/Tarazin.Ui/brand/logo.svg" alt="" width="72" height="72" />
        <h1>ترازین</h1>
        <p class="tz-login__tag">مدیریت هوشمند کسب‌وکار</p>
        <ul class="tz-login__points">
            <li>یک حساب برای هر هفت ماژول</li>
            <li>راست‌چین، فونت فارسی، تاریخ شمسی</li>
            <li>حسابداری، خزانه، انبار، حقوق، طلا، فروشگاه</li>
        </ul>
    </aside>

    <main class="tz-login__panel">
        <MudText Typo="Typo.h4" Class="mb-1">ورود به سامانه</MudText>
        <MudText Typo="Typo.body2" Class="tz-login__lead">
            نام کاربری و رمز خود را وارد کنید.
        </MudText>

        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudTextField @bind-Value="_username" Label="نام کاربری" Variant="Variant.Outlined"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"
                          Immediate="true" Class="mb-4" Required="true" RequiredError="نام کاربری لازم است." />
            <MudTextField @bind-Value="_password" Label="رمز عبور" Variant="Variant.Outlined"
                          InputType="@_pwdType" Adornment="Adornment.End"
                          AdornmentIcon="@_pwdIcon" OnAdornmentClick="TogglePwd"
                          Immediate="true" Class="mb-5" Required="true" RequiredError="رمز عبور لازم است." />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                       Disabled="_busy" OnClick="LoginAsync" StartIcon="@Icons.Material.Filled.Login">
                @(_busy ? "در حال ورود..." : "ورود")
            </MudButton>
        </MudForm>

        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mt-6 tz-login__hint"
                  Icon="@Icons.Material.Filled.Info">
            اولین اجرا: کاربر <b>admin</b> با رمز <b>admin</b>
        </MudAlert>
    </main>
</div>

@code {
    private MudForm? _form;
    private bool _valid;
    private bool _busy;
    private bool _showPwd;
    private string _username = "";
    private string _password = "";

    private InputType _pwdType => _showPwd ? InputType.Text : InputType.Password;
    private string _pwdIcon => _showPwd ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;

    private void TogglePwd() => _showPwd = !_showPwd;

    private async Task LoginAsync()
    {
        if (_busy) return;
        await (_form?.Validate() ?? Task.CompletedTask);
        if (!_valid) return;

        _busy = true;
        try
        {
            var user = await Auth.AuthenticateAsync(_username, _password);
            if (user is null)
            {
                Snackbar.Add("نام کاربری یا رمز عبور صحیح نیست.", Severity.Error);
                return;
            }

            Session.SignIn(user.UserId, user.Username, user.DisplayName, user.Role);
            Snackbar.Add($"خوش آمدید، {user.DisplayName}", Severity.Success);
            Nav.NavigateTo("/", forceLoad: true);
        }
        finally
        {
            _busy = false;
        }
    }
}
