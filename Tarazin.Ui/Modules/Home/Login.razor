@page "/login"
@layout AuthLayout
@inject AuthService Auth
@inject UserService Users
@inject UserSession Session
@inject AccountingContextService Context
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>ورود — ترازین</PageTitle>

<div class="tz-login">
    <aside class="tz-login__brand">
        <img src="_content/Tarazin.Ui/brand/logo.svg" alt="" width="72" height="72" />
        <h1>ترازین</h1>
        <p class="tz-login__tag">مدیریت هوشمند کسب‌وکار</p>
        <ul class="tz-login__points">
            <li>یک حساب برای هر هفت ماژول</li>
            <li>راست‌چین، فونت فارسی، تاریخ شمسی</li>
            <li>حسابداری، خزانه، انبار، حقوق، طلا، فروشگاه</li>
        </ul>
    </aside>

    <main class="tz-login__panel">
        <MudText Typo="Typo.h4" Class="mb-1">ورود به سامانه</MudText>
        <MudText Typo="Typo.body2" Class="tz-login__lead">
            نام کاربری و رمز خود را وارد کنید.
        </MudText>

        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudTextField @bind-Value="_username" Label="نام کاربری" Variant="Variant.Outlined"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"
                          Immediate="true" Class="mb-4" Required="true" RequiredError="نام کاربری لازم است." />
            <MudTextField @bind-Value="_password" Label="رمز عبور" Variant="Variant.Outlined"
                          InputType="@_pwdType" Adornment="Adornment.End"
                          AdornmentIcon="@_pwdIcon" OnAdornmentClick="TogglePwd"
                          Immediate="true" Class="mb-4" Required="true" RequiredError="رمز عبور لازم است." />
            @if (Auth.RequiresCustomerGuid)
            {
                <MudTextField @bind-Value="_customerGuid" Label="شناسه مشتری" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Business"
                              Immediate="true" Class="mb-5" Required="true" RequiredError="شناسه مشتری لازم است." />
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                       Disabled="_busy" OnClick="LoginAsync" StartIcon="@Icons.Material.Filled.Login">
                @(_busy ? "در حال ورود..." : "ورود")
            </MudButton>
        </MudForm>

        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mt-6 tz-login__hint"
                  Icon="@Icons.Material.Filled.Security">
            اطلاعات ورود را فقط از مدیر سامانه دریافت کنید.
        </MudAlert>
    </main>
</div>

@code {
    private MudForm? _form;
    private bool _valid;
    private bool _busy;
    private bool _showPwd;
    private string _username = "";
    private string _password = "";
    private string _customerGuid = "";

    private InputType _pwdType => _showPwd ? InputType.Text : InputType.Password;
    private string _pwdIcon => _showPwd ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;

    private void TogglePwd() => _showPwd = !_showPwd;

    private async Task LoginAsync()
    {
        if (_busy) return;
        await (_form?.Validate() ?? Task.CompletedTask);
        if (!_valid) return;

        _busy = true;
        try
        {
            Guid? customerGuid = null;
            if (Auth.RequiresCustomerGuid)
            {
                if (!Guid.TryParse(_customerGuid, out var parsedGuid) || parsedGuid == Guid.Empty)
                {
                    Snackbar.Add("شناسه مشتری معتبر نیست.", Severity.Error);
                    return;
                }
                customerGuid = parsedGuid;
            }

            var user = await Auth.AuthenticateAsync(_username, _password, customerGuid);
            if (user is null)
            {
                Snackbar.Add("نام کاربری یا رمز عبور صحیح نیست.", Severity.Error);
                return;
            }

            // بارگذاری دسترسی‌های مؤثر کاربر از نقشش (RBAC).
            var permissions = await Users.GetUserPermissionKeysAsync(user.UserId);

            await Session.SignInAsync(user.UserId, user.Username, user.DisplayName,
                user.Role, user.RoleTitle, user.RoleId, permissions);
            Snackbar.Add($"خوش آمدید، {user.DisplayName}", Severity.Success);

            // نشست هم در circuit و هم در مرورگر ذخیره می‌شود؛ مسیریابی داخلی
            // همان نشست را نگه می‌دارد و رفرش هم با بازیابی از مرورگر حفظ می‌شود.
            //
            // پس از ورود، محیط کاری (شرکت + سال مالی) به‌صورت خودکار تضمین
            // می‌شود. اگر کاربر شرکت نداشته باشد، MainLayout یک Modal اجباری
            // نمایش می‌دهد؛ در غیر این صورت سال جاری به‌صورت سیستمی ایجاد
            // و فعال می‌شود.
            try
            {
                await Context.ResolveAsync();
            }
            catch
            {
                Snackbar.Add("آماده‌سازی محیط کاری کامل نشد. دوباره تلاش کنید.", Severity.Warning);
            }

            Nav.NavigateTo("/");
        }
        catch (SafeAuthenticationException ex)
        {
            // Authentication may already have prepared a short-lived SQL
            // principal before a later login step failed. Always revoke/erase
            // it rather than leaving an unauthenticated credential session.
            await Session.SignOutAsync();
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch
        {
            await Session.SignOutAsync();
            Snackbar.Add("سرویس ورود یا پایگاه داده در دسترس نیست. دوباره تلاش کنید.", Severity.Error);
        }
        finally
        {
            _password = "";
            _busy = false;
        }
    }
}
