@page "/"
@inject UserSession Session
@inject ScriptCatalog Catalog
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>خانه — ترازین</PageTitle>

<section class="tz-hero">
    <div class="tz-hero__copy">
        <div class="tz-kicker">ترازین</div>
        <h1>میز کار یکپارچهٔ کسب‌وکار</h1>
        <p>
            حسابداری، خزانه، انبار، حقوق، طلا، فروشگاه، معاملات ارز و داشبورد هوش تجاری —
            همه در یک پوستهٔ راست‌چین، با یک حساب و یک دیتابیس.
        </p>
        <div class="tz-hero__cta">
            @if (Session.IsAuthenticated)
            {
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Person">
                    @Greeting، @Session.DisplayName
                </MudChip>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login"
                           StartIcon="@Icons.Material.Filled.Login" Size="Size.Large">
                    ورود به سامانه
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/diag"
                       StartIcon="@Icons.Material.Filled.MonitorHeart">
                وضعیت اتصال
            </MudButton>
        </div>
    </div>
    <div class="tz-hero__aside" aria-hidden="true">
        <div class="tz-hero__orb"></div>
        <img src="_content/Tarazin.Ui/brand/logo.svg" alt="" width="120" height="120" />
    </div>
</section>

<MudText Typo="Typo.subtitle2" Class="tz-section-label">ماژول‌ها</MudText>

<div class="tz-modgrid">
    @foreach (var m in TarazinModules.All)
    {
        @if (!Session.IsAuthenticated || Session.CanView(m.Key))
        {
        <button type="button" class="tz-modcard" style="--tz-accent:@m.Accent"
                @onclick="() => Nav.NavigateTo(m.Url)">
            <div class="tz-modcard__icon">
                <MudIcon Icon="@m.Icon" />
            </div>
            <div class="tz-modcard__body">
                <h3>@m.Title</h3>
                <p>@m.Lead</p>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.West" Class="tz-modcard__go" />
        </button>
        }
    }
</div>

<footer class="tz-home-meta">
    @Catalog.Count اسکریپت نامدار در @Catalog.Schemas.Count اسکیمه بارگذاری شده است.
</footer>

@code {
    protected override void OnInitialized()
    {
        // صفحهٔ خانه هیچ دسترسی اجباری ندارد و هنگام رفرش با نشست خالی رندر می‌شود؛
        // پس برای به‌روز شدن سلام/کارت ماژول‌ها بعد از بازیابی نشست، گوش می‌دهیم.
        Session.Changed += OnSessionChanged;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;

    private static string Greeting
    {
        get
        {
            var h = DateTime.Now.Hour;
            return h switch
            {
                _ when h < 12 => "صبح بخیر",
                _ when h < 17 => "ظهر بخیر",
                _ when h < 20 => "عصر بخیر",
                _ => "شب بخیر"
            };
        }
    }
}
