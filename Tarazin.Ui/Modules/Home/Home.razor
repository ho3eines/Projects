@page "/"
@inject UserSession Session
@inject ScriptCatalog Catalog
@inject DbService Db
@implements IDisposable

<PageTitle>خانه — ترازین</PageTitle>

<section class="tz-hero">
    <div class="tz-hero__copy">
        <div class="tz-kicker">ترازین</div>
        <MudText Typo="Typo.h2" Class="tz-hero__title" Style="color:#f7f1e3">میز کار یکپارچهٔ کسب‌وکار</MudText>
        <MudText Typo="Typo.body1" Class="tz-hero__desc">
            حسابداری، خزانه، انبار، حقوق، طلا، فروشگاه، معاملات ارز و داشبورد هوش تجاری —
            همه در یک پوستهٔ راست‌چین، با یک حساب و یک دیتابیس.
        </MudText>
        <div class="tz-hero__cta">
            @if (Session.IsAuthenticated)
            {
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Person">
                    @Greeting، @Session.DisplayName
                </MudChip>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login"
                           StartIcon="@Icons.Material.Filled.Login" Size="Size.Large">
                    ورود به سامانه
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="/diag"
                       StartIcon="@Icons.Material.Filled.MonitorHeart" Style="color:#f7f1e3;border-color:rgba(247,241,227,0.6)">
                وضعیت اتصال
            </MudButton>
        </div>
    </div>
    <div class="tz-hero__aside" aria-hidden="true">
        <div class="tz-hero__orb"></div>
        <img src="_content/Tarazin.Ui/brand/logo.svg" alt="" width="120" height="120" />
    </div>
</section>

@if (Session.IsAuthenticated && _chequeAlert is not null)
{
    @if (_chequeAlert.OverdueCount > 0)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4"
                  Icon="@Icons.Material.Filled.NotificationImportant">
            <b>@_chequeAlert.OverdueCount چک سررسیدشده</b> در انتظار پیگیری است.
            <MudLink Href="/treasury/cheque-report" Underline="Underline.Always" Class="ms-2" Style="color:inherit">
                مشاهده گزارش سررسید
            </MudLink>
        </MudAlert>
    }
    else if (_chequeAlert.DueSoonCount > 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4"
                  Icon="@Icons.Material.Filled.Schedule">
            <b>@_chequeAlert.DueSoonCount چک</b> تا ۷ روز آینده سررسید می‌شود.
            <MudLink Href="/treasury/cheque-report" Underline="Underline.Always" Class="ms-2" Style="color:inherit">
                مشاهده گزارش سررسید
            </MudLink>
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4" Dense="true"
                  Icon="@Icons.Material.Filled.DoneAll">
            هیچ چکی سررسید نشده است.
        </MudAlert>
    }
}

<MudText Typo="Typo.subtitle2" Class="tz-section-label">ماژول‌ها</MudText>

<div class="tz-modgrid">
    @foreach (var m in TarazinModules.All)
    {
        @if (!Session.IsAuthenticated || Session.CanView(m.Key))
        {
            var card = ModuleCardSpec.FromModule(m);
            <ModuleCard Icon="@card.Icon" Title="@card.Title" Lead="@card.Lead"
                        Url="@card.Url" Accent="@card.Accent" />
        }
    }
</div>

<footer class="tz-home-meta">
    @Catalog.Count اسکریپت نامدار در @Catalog.Schemas.Count اسکیمه بارگذاری شده است.
</footer>

@code {
    private ChequeAlertSummaryRow? _chequeAlert;

    protected override void OnInitialized()
    {
        // صفحهٔ خانه هیچ دسترسی اجباری ندارد و هنگام رفرش با نشست خالی رندر می‌شود؛
        // پس برای به‌روز شدن سلام/کارت ماژول‌ها بعد از بازیابی نشست، گوش می‌دهیم.
        Session.Changed += OnSessionChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAlertAsync();
    }

    private async Task LoadAlertAsync()
    {
        if (!Session.IsAuthenticated)
            return;

        try
        {
            _chequeAlert = await Db.QueryFirstOrDefaultAsync<ChequeAlertSummaryRow>("treasury", "ChequeAlertSummary",
                               new { CompanyId = Session.ActiveCompanyId })
                           ?? new ChequeAlertSummaryRow();
        }
        catch
        {
            // هشدار داشبورد اختیاری است؛ خطای آن نباید صفحهٔ خانه را خراب کند.
            _chequeAlert = new ChequeAlertSummaryRow();
        }

        await InvokeAsync(StateHasChanged);
    }

    private void OnSessionChanged()
    {
        if (Session.IsAuthenticated && _chequeAlert is null)
            _ = LoadAlertAsync();
        else
            InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;

    private static string Greeting
    {
        get
        {
            var h = DateTime.Now.Hour;
            return h switch
            {
                _ when h < 12 => "صبح بخیر",
                _ when h < 17 => "ظهر بخیر",
                _ when h < 20 => "عصر بخیر",
                _ => "شب بخیر"
            };
        }
    }
}
