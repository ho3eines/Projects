@page "/diag"
@using Tarazin.Data
@inject DbService Db

<PageTitle>عیب‌یابی اتصال</PageTitle>

<MudStack Spacing="3" Class="pa-4" Style="max-width:900px;margin:auto">
    <MudText Typo="Typo.h4">عیب‌یابی اتصال داده</MudText>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        این صفحه فقط وضعیت غیرمحرمانهٔ ارائه‌دهنده و نتیجهٔ آزمون اتصال را نمایش می‌دهد.
        رشتهٔ اتصال، رمز، توکن، منبع پیکربندی و مسیر فایل‌های پایگاه داده هرگز نمایش داده نمی‌شوند.
    </MudAlert>

    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6" GutterBottom="true">وضعیت ارائه‌دهنده</MudText>
        <MudSimpleTable Dense="true" Hover="true">
            <tbody>
                <tr>
                    <td>نوع اتصال</td>
                    <td>@(Db.UsesTemporaryCredential ? "اعتبار موقت دریافت‌شده از سرویس امن" : "اتصال مدیریت‌شدهٔ سمت سرور")</td>
                </tr>
                <tr>
                    <td>آماده برای استفاده</td>
                    <td>@(Db.IsConnectionAvailable ? "بله" : "خیر")</td>
                </tr>
                <tr>
                    <td>شرح ایمن</td>
                    <td>@Db.ConnectionDescription</td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@_testing"
                       OnClick="TestAsync"
                       StartIcon="@Icons.Material.Filled.WifiTethering">
                @(_testing ? "در حال آزمون…" : "آزمون اتصال")
            </MudButton>
            @if (_testing)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
        </MudStack>

        @if (_result is not null)
        {
            <MudAlert Class="mt-3"
                      Severity="@(_result.Ok ? Severity.Success : Severity.Error)"
                      Variant="Variant.Outlined">
                <MudText Typo="Typo.subtitle1"><b>@_result.Message</b></MudText>
                <MudText Typo="Typo.body2">زمان آزمون: @(_result.Elapsed.TotalMilliseconds.ToString("N0")) میلی‌ثانیه</MudText>
            </MudAlert>
        }
        else if (!string.IsNullOrWhiteSpace(_safeFailure))
        {
            <MudAlert Class="mt-3" Severity="Severity.Error" Variant="Variant.Outlined">
                @_safeFailure
            </MudAlert>
        }
    </MudPaper>

    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        در MAUI ابتدا از صفحهٔ ورود، شناسهٔ مشتری و اطلاعات ورود را برای سرویس HTTPS ارسال کنید تا
        اعتبار کوتاه‌عمر فقط در حافظه آماده شود. در هاست وب، تنظیم اتصال باید از secret store یا
        متغیر محیطیِ زمان استقرار تأمین شود. در محیط تولید، HTTPS، رمزنگاری SQL و اعتبارسنجی عادی
        گواهی الزامی است و نباید غیرفعال شود.
    </MudAlert>
</MudStack>

@code {
    private bool _testing;
    private ConnectionCheckResult? _result;
    private string? _safeFailure;

    private async Task TestAsync()
    {
        _testing = true;
        _result = null;
        _safeFailure = null;
        try
        {
            _result = await Db.TestConnectionAsync();
        }
        catch (OperationCanceledException)
        {
            _safeFailure = "آزمون اتصال لغو شد.";
        }
        catch
        {
            _safeFailure = "آزمون اتصال در حال حاضر قابل انجام نیست.";
        }
        finally
        {
            _testing = false;
        }
    }
}
