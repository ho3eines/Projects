@page "/currency/reports"
@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject PdfReportService Pdf

<PageTitle>گزارشات — ارز و معاملات ارزی</PageTitle>

<PageHeader Title="گزارشات ارز" Subtitle="معاملات ارز، گردش ارز، سود و زیان، تاریخچهٔ نرخ‌ها و نمودار تغییرات (§49/§52)."
            Eyebrow="ارز و معاملات ارزی" />

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="از تاریخ" Culture="FaCulture" @bind-Date="_from" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="تا تاریخ" Culture="FaCulture" @bind-Date="_to" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="LoadAsync" Disabled="_loading">
                اجرا
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTabs>
    <MudTabPanel Text="معاملات ارز">
        <MudPaper Elevation="1" Class="pa-4">
            <PageToolbar Class="mb-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="PrintTransactionsAsync"
                           Disabled="_loading || _transactions.Count == 0" StartIcon="@Icons.Material.Filled.Print">چاپ / PDF</MudButton>
            </PageToolbar>
            <MudTable Items="_transactions" Hover="true" Dense="true" Striped="true" Loading="_loading"
                      Breakpoint="Breakpoint.Sm" RowsPerPage="25">
                <HeaderContent>
                    <MudTh>تاریخ</MudTh><MudTh>شماره</MudTh><MudTh>نوع</MudTh><MudTh>طرف حساب</MudTh>
                    <MudTh>مبلغ ریالی</MudTh><MudTh>سند حسابداری</MudTh><MudTh>پاها</MudTh><MudTh>وضعیت</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="تاریخ">@context.TransactionDate.ToString("yyyy/MM/dd") @context.TransactionTime</MudTd>
                    <MudTd DataLabel="شماره">@context.TransactionNumber</MudTd>
                    <MudTd DataLabel="نوع">@TransactionTypeText(context.TransactionType)</MudTd>
                    <MudTd DataLabel="طرف">@context.PartyName</MudTd>
                    <MudTd DataLabel="مبلغ"><b>@context.TotalRial.ToString("N0")</b></MudTd>
                    <MudTd DataLabel="سند">@context.DocumentNumber</MudTd>
                    <MudTd DataLabel="پاها">@context.LegCount</MudTd>
                    <MudTd DataLabel="وضعیت">@context.Status</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">معامله‌ای نیست.</MudText></NoRecordsContent>
                <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 25, 50, 100 })" /></PagerContent>
            </MudTable>
            @if (_transactions.Count > 0)
            {
                <MudText Typo="Typo.body2" Class="mt-4">جمع مبلغ ریالی: <b>@_transactions.Sum(t => t.TotalRial).ToString("N0")</b></MudText>
            }
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="گردش ارز">
        <MudPaper Elevation="1" Class="pa-4">
            <PageToolbar Class="mb-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="PrintMovementsAsync"
                           Disabled="_loading || _movements.Count == 0" StartIcon="@Icons.Material.Filled.Print">چاپ / PDF</MudButton>
            </PageToolbar>
            <MudTable Items="_movements" Hover="true" Dense="true" Striped="true" Loading="_loading"
                      Breakpoint="Breakpoint.Sm" RowsPerPage="25">
                <HeaderContent>
                    <MudTh>تاریخ</MudTh><MudTh>نوع</MudTh><MudTh>جهت</MudTh><MudTh>ارز</MudTh><MudTh>مقدار</MudTh>
                    <MudTh>نرخ</MudTh><MudTh>معادل ریالی</MudTh><MudTh>طرف حساب</MudTh><MudTh>شرح</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="تاریخ">@context.MovementDate.ToString("yyyy/MM/dd") @context.MovementTime</MudTd>
                    <MudTd DataLabel="نوع">@MovementTypeText(context.MovementType)</MudTd>
                    <MudTd DataLabel="جهت">@(context.Direction == "In" ? "ورود" : "خروج")</MudTd>
                    <MudTd DataLabel="ارز">@context.CurrencyCode</MudTd>
                    <MudTd DataLabel="مقدار">@context.Quantity.ToString("N2")</MudTd>
                    <MudTd DataLabel="نرخ">@context.Rate.ToString("N0")</MudTd>
                    <MudTd DataLabel="معادل">@context.AmountRial.ToString("N0")</MudTd>
                    <MudTd DataLabel="طرف">@context.CounterPartyName</MudTd>
                    <MudTd DataLabel="شرح">@context.Description</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">گردشی نیست.</MudText></NoRecordsContent>
                <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 25, 50, 100 })" /></PagerContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="سود و زیان (§52/§53)">
        <MudPaper Elevation="1" Class="pa-4">
            <MudTable Items="_pnl" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>عنوان</MudTh><MudTh>مبلغ (ریال)</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="عنوان">
                        @if (context.PnlKey == "net")
                        {
                            <b>@context.Title</b>
                        }
                        else
                        {
                            @context.Title
                        }
                    </MudTd>
                    <MudTd DataLabel="مبلغ">
                        <MudText Typo="@(context.PnlKey == "net" ? Typo.subtitle1 : Typo.body2)"
                                 Color="@(context.Amount >= 0 ? Color.Success : Color.Error)">
                            @context.Amount.ToString("N0")
                        </MudText>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">داده‌ای نیست.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="تاریخچهٔ نرخ (§49)">
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="string" Label="آیتم (نمودار و تاریخچه)" @bind-Value="_historyItemKey" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("USD")">دلار آمریکا</MudSelectItem>
                        <MudSelectItem Value="@("EUR")">یورو</MudSelectItem>
                        <MudSelectItem Value="@("AED")">درهم</MudSelectItem>
                        <MudSelectItem Value="@("XAU-18")">طلای ۱۸ عیار</MudSelectItem>
                        <MudSelectItem Value="@("XAU-24")">طلای ۲۴ عیار</MudSelectItem>
                        <MudSelectItem Value="@("SIKKEH-EMAMI")">سکه امامی</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="string" Label="نوع نرخ" @bind-Value="_historyKind" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("")">همه</MudSelectItem>
                        <MudSelectItem Value="@("Online")">آنلاین</MudSelectItem>
                        <MudSelectItem Value="@("System")">سیستم</MudSelectItem>
                        <MudSelectItem Value="@("Manual")">دستی</MudSelectItem>
                        <MudSelectItem Value="@("Buy")">خرید</MudSelectItem>
                        <MudSelectItem Value="@("Sell")">فروش</MudSelectItem>
                        <MudSelectItem Value="@("Transaction")">معامله</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4" Class="d-flex align-center">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadHistoryAsync" Disabled="_loading"
                               StartIcon="@Icons.Material.Filled.PlayArrow">
                        نمایش
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (_chartPoints.Count > 1)
        {
            <MudPaper Elevation="1" Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" Class="mb-3">نمودار تغییرات نرخ — @_historyItemKey</MudText>
                <MudChart T="double" ChartType="ChartType.Line" ChartSeries="@(_chartData.AsChartDataSet())" ChartLabels="@_chartLabels"
                          Width="100%" Height="320px" />
            </MudPaper>
        }

        <MudPaper Elevation="1" Class="pa-4">
            <div class="d-flex justify-end mb-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="PrintHistoryAsync"
                           Disabled="_loading || _history.Count == 0" StartIcon="@Icons.Material.Filled.Print">چاپ / PDF</MudButton>
            </div>
            <MudTable Items="_history" Hover="true" Dense="true" Striped="true" Loading="_loading"
                      Breakpoint="Breakpoint.Sm" RowsPerPage="25">
                <HeaderContent>
                    <MudTh>تاریخ و ساعت</MudTh><MudTh>آیتم</MudTh><MudTh>نوع نرخ</MudTh><MudTh>نرخ قبلی</MudTh>
                    <MudTh>نرخ جدید</MudTh><MudTh>نوع تغییر</MudTh><MudTh>منبع</MudTh><MudTh>کاربر</MudTh><MudTh>دلیل</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="زمان">@context.ChangedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</MudTd>
                    <MudTd DataLabel="آیتم">@context.ItemKey</MudTd>
                    <MudTd DataLabel="نوع">@RateKindText(context.RateKind)</MudTd>
                    <MudTd DataLabel="قبلی">@(context.PrevValue?.ToString("N0") ?? "—")</MudTd>
                    <MudTd DataLabel="جدید"><b>@context.NewValue.ToString("N0")</b></MudTd>
                    <MudTd DataLabel="تغییر">@ChangeTypeText(context.ChangeType)</MudTd>
                    <MudTd DataLabel="منبع">@context.SourceKey</MudTd>
                    <MudTd DataLabel="کاربر">@context.ChangedBy</MudTd>
                    <MudTd DataLabel="دلیل">@context.Reason</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">تاریخچه‌ای نیست.</MudText></NoRecordsContent>
                <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 25, 50, 100 })" /></PagerContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "currency";

    private List<FxTransactionRow> _transactions = new();
    private List<CurrencyMovementRow> _movements = new();
    private List<PnlBreakdownRow> _pnl = new();
    private List<RateHistoryRow> _history = new();
    private List<RateChartRow> _chartPoints = new();

    private DateTime? _from;
    private DateTime? _to;
    private string _historyItemKey = "USD";
    private string _historyKind = "";
    private bool _loading;

    private double[] _chartData = Array.Empty<double>();
    private string[] _chartLabels = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await LoadHistoryAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _transactions = (await Db.QueryAsync<FxTransactionRow>(Schema, "FxTransactionList", new
            {
                FromDate = _from,
                ToDate = _to,
                TransactionType = (string?)null,
                SearchText = "",
                SkipRows = 0,
                TakeSize = 300
            })).ToList();

            _movements = (await Db.QueryAsync<CurrencyMovementRow>(Schema, "WalletMovements", new
            {
                CurrencyCode = (string?)null,
                Direction = (string?)null,
                FromDate = _from,
                ToDate = _to,
                SkipRows = 0,
                TakeSize = 300
            })).ToList();

            _pnl = (await Db.QueryAsync<PnlBreakdownRow>(Schema, "PnlSummary", new
            {
                FromDate = _from,
                ToDate = _to
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadHistoryAsync()
    {
        _loading = true;
        try
        {
            _history = (await Db.QueryAsync<RateHistoryRow>(Schema, "RateHistory", new
            {
                ItemType = (string?)null,
                ItemKey = _historyItemKey,
                RateKind = string.IsNullOrEmpty(_historyKind) ? (string?)null : _historyKind,
                FromDate = _from,
                ToDate = _to,
                SkipRows = 0,
                TakeSize = 200
            })).ToList();

            var points = (await Db.QueryAsync<RateChartRow>(Schema, "RateHistoryChart", new
            {
                ItemKey = _historyItemKey,
                RateKind = string.IsNullOrEmpty(_historyKind) ? (string?)null : _historyKind,
                Limit = 120
            })).ToList();

            // مرتب‌سازی صعودی برای نمودار
            points.Reverse();
            _chartPoints = points;
            _chartData = points.Select(p => (double)p.NewValue).ToArray();
            _chartLabels = points.Select(p => p.ChangedAt.ToLocalTime().ToString("MM/dd HH:mm")).ToArray();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string TransactionTypeText(string type) => type switch
    {
        "Buy" => "خرید",
        "Sell" => "فروش",
        "Conversion" => "تبدیل",
        "Combined" => "ترکیبی",
        "Transfer" => "انتقال",
        _ => type
    };

    private static string MovementTypeText(string type) => type switch
    {
        "Buy" => "خرید",
        "Sell" => "فروش",
        "In" => "ورود",
        "Out" => "خروج",
        "Transfer" => "انتقال",
        "Conversion" => "تبدیل",
        "Combined" => "ترکیبی",
        _ => type
    };

    private static string RateKindText(string kind) => kind switch
    {
        "Online" => "آنلاین",
        "System" => "سیستم",
        "Manual" => "دستی",
        "Buy" => "خرید",
        "Sell" => "فروش",
        "Accounting" => "حسابداری",
        "Transaction" => "معامله",
        _ => kind
    };

    private static string ChangeTypeText(string type) => type switch
    {
        "AutoFetch" => "دریافت خودکار",
        "Manual" => "دستی",
        "Override" => "Override",
        "Transaction" => "معامله",
        _ => type
    };

    // ── چاپ / PDF (طبق اسکیل tarazin-reporting) ──

    private async Task PrintTransactionsAsync()
    {
        if (_transactions.Count == 0) return;
        await Dialog.ShowAsync<ReportPrintDialog>("چاپ معاملات ارز", new DialogParameters<ReportPrintDialog>
        {
            { x => x.Title, "گزارش معاملات ارز" },
            { x => x.Subtitle, "خرید/فروش/تبدیل/ترکیبی" },
            { x => x.RangeText, $"از {_from:yyyy/MM/dd} تا {_to:yyyy/MM/dd}" },
            { x => x.Body, TransactionsTableBody },
            { x => x.BuildPdf, BuildTransactionsPdf },
            { x => x.Wide, true }
        }, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
    }

    private async Task PrintMovementsAsync()
    {
        if (_movements.Count == 0) return;
        await Dialog.ShowAsync<ReportPrintDialog>("چاپ گردش ارز", new DialogParameters<ReportPrintDialog>
        {
            { x => x.Title, "گردش ارز" },
            { x => x.Subtitle, "حرکت‌های کیف پول ارز" },
            { x => x.RangeText, $"از {_from:yyyy/MM/dd} تا {_to:yyyy/MM/dd}" },
            { x => x.Body, MovementsTableBody },
            { x => x.BuildPdf, BuildMovementsPdf },
            { x => x.Wide, true }
        }, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
    }

    private async Task PrintHistoryAsync()
    {
        if (_history.Count == 0) return;
        await Dialog.ShowAsync<ReportPrintDialog>("چاپ تاریخچهٔ نرخ", new DialogParameters<ReportPrintDialog>
        {
            { x => x.Title, $"تاریخچهٔ نرخ — {_historyItemKey}" },
            { x => x.Subtitle, "تغییرات نرخ‌ها با جزئیات" },
            { x => x.RangeText, $"از {_from:yyyy/MM/dd} تا {_to:yyyy/MM/dd}" },
            { x => x.Body, HistoryTableBody },
            { x => x.BuildPdf, BuildHistoryPdf },
            { x => x.Wide, true }
        }, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
    }

    private RenderFragment TransactionsTableBody => @<MudTable Items="_transactions" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" Class="gp-lines-table">
        <HeaderContent>
            <MudTh>تاریخ</MudTh><MudTh>شماره</MudTh><MudTh>نوع</MudTh><MudTh>طرف حساب</MudTh>
            <MudTh>مبلغ ریالی</MudTh><MudTh>سند حسابداری</MudTh><MudTh>پاها</MudTh><MudTh>وضعیت</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="تاریخ">@context.TransactionDate.ToString("yyyy/MM/dd") @context.TransactionTime</MudTd>
            <MudTd DataLabel="شماره">@context.TransactionNumber</MudTd>
            <MudTd DataLabel="نوع">@TransactionTypeText(context.TransactionType)</MudTd>
            <MudTd DataLabel="طرف">@context.PartyName</MudTd>
            <MudTd DataLabel="مبلغ"><b>@context.TotalRial.ToString("N0")</b></MudTd>
            <MudTd DataLabel="سند">@context.DocumentNumber</MudTd>
            <MudTd DataLabel="پاها">@context.LegCount</MudTd>
            <MudTd DataLabel="وضعیت">@context.Status</MudTd>
        </RowTemplate>
    </MudTable>;

    private RenderFragment MovementsTableBody => @<MudTable Items="_movements" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" Class="gp-lines-table">
        <HeaderContent>
            <MudTh>تاریخ</MudTh><MudTh>نوع</MudTh><MudTh>جهت</MudTh><MudTh>ارز</MudTh><MudTh>مقدار</MudTh>
            <MudTh>نرخ</MudTh><MudTh>معادل ریالی</MudTh><MudTh>طرف حساب</MudTh><MudTh>شرح</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="تاریخ">@context.MovementDate.ToString("yyyy/MM/dd") @context.MovementTime</MudTd>
            <MudTd DataLabel="نوع">@MovementTypeText(context.MovementType)</MudTd>
            <MudTd DataLabel="جهت">@(context.Direction == "In" ? "ورود" : "خروج")</MudTd>
            <MudTd DataLabel="ارز">@context.CurrencyCode</MudTd>
            <MudTd DataLabel="مقدار">@context.Quantity.ToString("N2")</MudTd>
            <MudTd DataLabel="نرخ">@context.Rate.ToString("N0")</MudTd>
            <MudTd DataLabel="معادل">@context.AmountRial.ToString("N0")</MudTd>
            <MudTd DataLabel="طرف">@context.CounterPartyName</MudTd>
            <MudTd DataLabel="شرح">@context.Description</MudTd>
        </RowTemplate>
    </MudTable>;

    private RenderFragment HistoryTableBody => @<MudTable Items="_history" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" Class="gp-lines-table">
        <HeaderContent>
            <MudTh>تاریخ و ساعت</MudTh><MudTh>آیتم</MudTh><MudTh>نوع نرخ</MudTh><MudTh>نرخ قبلی</MudTh>
            <MudTh>نرخ جدید</MudTh><MudTh>نوع تغییر</MudTh><MudTh>منبع</MudTh><MudTh>کاربر</MudTh><MudTh>دلیل</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="زمان">@context.ChangedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</MudTd>
            <MudTd DataLabel="آیتم">@context.ItemKey</MudTd>
            <MudTd DataLabel="نوع">@RateKindText(context.RateKind)</MudTd>
            <MudTd DataLabel="قبلی">@(context.PrevValue?.ToString("N0") ?? "—")</MudTd>
            <MudTd DataLabel="جدید"><b>@context.NewValue.ToString("N0")</b></MudTd>
            <MudTd DataLabel="تغییر">@ChangeTypeText(context.ChangeType)</MudTd>
            <MudTd DataLabel="منبع">@context.SourceKey</MudTd>
            <MudTd DataLabel="کاربر">@context.ChangedBy</MudTd>
            <MudTd DataLabel="دلیل">@context.Reason</MudTd>
        </RowTemplate>
    </MudTable>;

    private byte[] BuildTransactionsPdf(string paperSize)
    {
        var columns = new List<TableReportColumn>
        {
            new() { Header = "تاریخ" }, new() { Header = "شماره" }, new() { Header = "نوع" },
            new() { Header = "طرف حساب" }, new() { Header = "مبلغ ریالی", AlignRight = true },
            new() { Header = "سند حسابداری" }, new() { Header = "پاها", AlignRight = true }, new() { Header = "وضعیت" }
        };
        var rows = _transactions.Select(r => (IReadOnlyList<string>)new string[]
        {
            r.TransactionDate.ToString("yyyy/MM/dd"), r.TransactionNumber, TransactionTypeText(r.TransactionType),
            r.PartyName, r.TotalRial.ToString("N0"), r.DocumentNumber, r.LegCount.ToString(), r.Status
        }).ToList();

        return Pdf.BuildTablePdf("گزارش معاملات ارز", "خرید/فروش/تبدیل/ترکیبی",
            $"از {_from:yyyy/MM/dd} تا {_to:yyyy/MM/dd}", columns, rows,
            new[] { $"جمع مبلغ ریالی: {_transactions.Sum(t => t.TotalRial):N0}" }, paperSize);
    }

    private byte[] BuildMovementsPdf(string paperSize)
    {
        var columns = new List<TableReportColumn>
        {
            new() { Header = "تاریخ" }, new() { Header = "نوع" }, new() { Header = "جهت" },
            new() { Header = "ارز" }, new() { Header = "مقدار", AlignRight = true }, new() { Header = "نرخ", AlignRight = true },
            new() { Header = "معادل ریالی", AlignRight = true }, new() { Header = "طرف حساب" }, new() { Header = "شرح" }
        };
        var rows = _movements.Select(r => (IReadOnlyList<string>)new string[]
        {
            r.MovementDate.ToString("yyyy/MM/dd"), MovementTypeText(r.MovementType), r.Direction == "In" ? "ورود" : "خروج",
            r.CurrencyCode, r.Quantity.ToString("N2"), r.Rate.ToString("N0"), r.AmountRial.ToString("N0"),
            r.CounterPartyName, r.Description
        }).ToList();

        return Pdf.BuildTablePdf("گردش ارز", "حرکت‌های کیف پول ارز",
            $"از {_from:yyyy/MM/dd} تا {_to:yyyy/MM/dd}", columns, rows, null, paperSize);
    }

    private byte[] BuildHistoryPdf(string paperSize)
    {
        var columns = new List<TableReportColumn>
        {
            new() { Header = "تاریخ و ساعت" }, new() { Header = "آیتم" }, new() { Header = "نوع نرخ" },
            new() { Header = "نرخ قبلی", AlignRight = true }, new() { Header = "نرخ جدید", AlignRight = true },
            new() { Header = "نوع تغییر" }, new() { Header = "منبع" }, new() { Header = "کاربر" }, new() { Header = "دلیل" }
        };
        var rows = _history.Select(r => (IReadOnlyList<string>)new string[]
        {
            r.ChangedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss"), r.ItemKey, RateKindText(r.RateKind),
            r.PrevValue?.ToString("N0") ?? "—", r.NewValue.ToString("N0"), ChangeTypeText(r.ChangeType),
            r.SourceKey, r.ChangedBy, r.Reason
        }).ToList();

        return Pdf.BuildTablePdf($"تاریخچهٔ نرخ — {_historyItemKey}", "تغییرات نرخ‌ها با جزئیات",
            $"از {_from:yyyy/MM/dd} تا {_to:yyyy/MM/dd}", columns, rows, null, paperSize);
    }
}
