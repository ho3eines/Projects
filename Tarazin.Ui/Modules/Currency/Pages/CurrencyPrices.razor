@page "/currency/prices"
@inject DbService Db
@inject UserSession Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>مرکز نرخ‌ها و قیمت‌ها — ارز و معاملات ارزی</PageTitle>

<PageHeader Title="مرکز نرخ‌ها و قیمت‌ها" Subtitle="مرکز کنترل تمام قیمت‌های سیستم — طلا، سکه، ارز و فلزات؛ همهٔ معاملات از همین مرکز تغذیه می‌شوند (§43/§60)."
            Eyebrow="ارز و معاملات ارزی">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync" Disabled="_loading"
               StartIcon="@Icons.Material.Filled.Refresh">
        بروزرسانی
    </MudButton>
</PageHeader>

<MudTabs>
    <MudTabPanel Text="ارز">
        @RenderBoard("Currency")
    </MudTabPanel>
    <MudTabPanel Text="طلا">
        @RenderBoard("Gold")
    </MudTabPanel>
    <MudTabPanel Text="سکه">
        @RenderBoard("Coin")
    </MudTabPanel>
    <MudTabPanel Text="فلزات">
        @RenderBoard("Metal")
    </MudTabPanel>
    <MudTabPanel Text="برابری ارزها با دلار">
        @RenderBoard("FxParity")
    </MudTabPanel>
    <MudTabPanel Text="بازار جهانی">
        @RenderBoard("Global")
    </MudTabPanel>
    <MudTabPanel Text="مقایسهٔ منابع (§59)">
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                داده‌های API رسمی کنار هم — بازار ایران (IR) | بازار جهانی (FR) | نرخ سیستم.
            </MudText>
            <MudTable Items="_comparison" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>عنوان</MudTh><MudTh>TabloTala IR</MudTh><MudTh>TabloTala FR</MudTh><MudTh>سایر</MudTh><MudTh>نرخ سیستم</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="عنوان">@context.ItemKey — @context.Title</MudTd>
                    <MudTd DataLabel="بازار ایران">
                        @FormatNullableRate(context.TabloIranRate)
                        @if (context.TabloIranAt.HasValue)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.TabloIranAt.Value.ToLocalTime().ToString("HH:mm")</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="بازار جهانی">
                        @FormatNullableRate(context.TabloGlobalRate)
                        @if (context.TabloGlobalAt.HasValue)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.TabloGlobalAt.Value.ToLocalTime().ToString("HH:mm")</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="سایر">@FormatNullableRate(context.OtherRate)</MudTd>
                    <MudTd DataLabel="سیستم"><b>@FormatRate(context.SystemRate)</b></MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">داده‌ای نیست.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private const string Schema = "currency";

    private List<PriceRateRow> _rows = new();
    private List<RateComparisonRow> _comparison = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _rows = (await Db.QueryAsync<PriceRateRow>(Schema, "RateBoard", new
            {
                ItemType = (string?)null,
                ItemKey = (string?)null
            })).ToList();

            _comparison = (await Db.QueryAsync<RateComparisonRow>(Schema, "RateComparison", new
            {
                ItemType = (string?)null
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private RenderFragment RenderBoard(string itemType) => __builder =>
    {
        var rows = _rows.Where(r => r.ItemType == itemType).ToList();
        <MudPaper Elevation="1" Class="pa-4">
            <MudTable Items="rows" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>عنوان</MudTh>
                    <MudTh>آنلاین</MudTh>
                    <MudTh>دستی</MudTh>
                    <MudTh>سیستم</MudTh>
                    <MudTh>خرید</MudTh>
                    <MudTh>فروش</MudTh>
                    <MudTh>میانی</MudTh>
                    <MudTh>حسابداری</MudTh>
                    <MudTh>اسپرد</MudTh>
                    <MudTh>منبع</MudTh>
                    <MudTh>وضعیت</MudTh>
                    <MudTh>آخرین تغییر</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="عنوان"><b>@context.Title</b></MudTd>
                    <MudTd DataLabel="آنلاین">@FormatNullableRate(context.OnlineRate)</MudTd>
                    <MudTd DataLabel="دستی">@FormatNullableRate(context.ManualRate)</MudTd>
                    <MudTd DataLabel="سیستم"><b>@FormatRate(context.SystemRate)</b></MudTd>
                    <MudTd DataLabel="خرید">@FormatNullableRate(context.BuyRate)</MudTd>
                    <MudTd DataLabel="فروش">@FormatNullableRate(context.SellRate)</MudTd>
                    <MudTd DataLabel="میانی">@FormatNullableRate(context.MidRate)</MudTd>
                    <MudTd DataLabel="حسابداری">@FormatNullableRate(context.AccountingRate)</MudTd>
                    <MudTd DataLabel="اسپرد">@FormatNullableRate(context.Spread)</MudTd>
                    <MudTd DataLabel="منبع">@(context.SourceTitle ?? context.SourceKey ?? "دستی")</MudTd>
                    <MudTd DataLabel="وضعیت">
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(context)" Variant="Variant.Outlined">
                            @StatusText(context)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="آخرین تغییر">
                        @(context.LastChangeAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "—")
                    </MudTd>
                    <MudTd DataLabel="">
                        @if (context.ItemType is not ("FxParity" or "Global")
                            && Session.HasAny(TarazinPermissions.RateChange, TarazinPermissions.RateChangeBuy, TarazinPermissions.RateChangeSell))
                        {
                            <MudTooltip Text="ویرایش نرخ">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                               OnClick="@(() => OpenRateEditorAsync(context))" />
                            </MudTooltip>
                        }
                        @if (context.ItemType is not ("FxParity" or "Global")
                            && context.OnlineRate.HasValue
                            && Session.HasPermission(TarazinPermissions.RateOverride))
                        {
                            <MudTooltip Text="Override (نرخ آنلاین ← نرخ سیستم)">
                                <MudIconButton Icon="@Icons.Material.Filled.Download" Color="Color.Secondary" Size="Size.Small"
                                               OnClick="@(() => OverrideAsync(context))" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">آیتمی نیست.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>;
    };

    private async Task OpenRateEditorAsync(PriceRateRow rate)
    {
        var parameters = new DialogParameters<RateEditDialog>
        {
            { x => x.Rate, rate }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<RateEditDialog>($"اصلاح نرخ — {rate.Title}", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task OverrideAsync(PriceRateRow rate)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "تأیید Override نرخ",
            $"نرخ سیستم «{rate.Title}» به نرخ آنلاین {FormatNullableRate(rate.OnlineRate)} تغییر کند؟ (§46)",
            yesText: "تأیید و اعمال", cancelText: "انصراف");

        if (confirmed is not true) return;

        try
        {
            await Db.ExecuteAsync(Schema, "RateOverride", new
            {
                ItemKey = rate.ItemKey,
                SourceKey = rate.SourceKey,
                Reason = "تأیید مدیر در مرکز نرخ‌ها",
                ChangedBy = Session.UserName
            });
            Snackbar.Add($"نرخ سیستم {rate.Title} بروزرسانی شد.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static string FormatNullableRate(decimal? value) =>
        value.HasValue ? FormatRate(value.Value) : "—";

    private static string FormatRate(decimal value)
    {
        var absolute = Math.Abs(value);
        return absolute < 10m ? value.ToString("N4")
            : absolute < 10_000m ? value.ToString("N2")
            : value.ToString("N0");
    }

    private static Color StatusColor(PriceRateRow r) => r.Status switch
    {
        "Active" => Color.Success,
        "Stale" => Color.Warning,
        "Offline" => Color.Error,
        _ => Color.Default
    };

    private static string StatusText(PriceRateRow r) => r.Status switch
    {
        "Active" => "فعال",
        "Stale" => "قدیمی",
        "Offline" => "قطع",
        _ => r.Status
    };
}
