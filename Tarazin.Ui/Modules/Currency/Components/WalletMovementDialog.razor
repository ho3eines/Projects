@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-3">ثبت گردش دستی کیف پول (§36)</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            ورود / خروج / انتقال / تعدیل موجودی یک ارز — نرخ با واحد مشخص ثبت می‌شود.
        </MudText>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Label="ارز" @bind-Value="_currencyCode" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("")">— انتخاب ارز —</MudSelectItem>
                    @foreach (var c in _currencies.Where(c => c.CurrencyCode != "IRR" && c.CurrencyCode != "TOMAN"))
                    {
                        <MudSelectItem Value="c.CurrencyCode">@c.CurrencyCode — @c.CurrencyName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Label="نوع حرکت" @bind-Value="_movementKey" Variant="Variant.Outlined">
                    @foreach (var m in MovementOptions)
                    {
                        <MudSelectItem Value="m.Key">@m.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" Label="مقدار" @bind-Value="_quantity" Variant="Variant.Outlined" Min="0" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" Label="نرخ (به ریال)" @bind-Value="_rate" Format="#,##0.##" Variant="Variant.Outlined" Min="0" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker Label="تاریخ" Culture="FaCulture" @bind-Date="_date" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTimePicker Label="ساعت" @bind-Time="_time" Culture="FaCulture" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Label="توضیحات" @bind-Value="_description" Variant="Variant.Outlined" MaxLength="300" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">انصراف</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy"
                   StartIcon="@Icons.Material.Filled.Save">ثبت گردش</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "currency";

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string DefaultCurrencyCode { get; set; } = "";

    private List<CurrencyDefRow> _currencies = new();
    private string _currencyCode = "";
    private string _movementKey = "In";
    private decimal _quantity;
    private decimal _rate;
    private DateTime? _date = DateTime.Today;
    private TimeSpan? _time = DateTime.Now.TimeOfDay;
    private string _description = "";
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _currencyCode = DefaultCurrencyCode;
        _currencies = (await Db.QueryAsync<CurrencyDefRow>(Schema, "CurrencyList", new { OnlyActive = 1 })).ToList();
    }

    private static readonly IReadOnlyList<MovementOption> MovementOptions = new List<MovementOption>
    {
        new("In", "ورود", "In", "In"),
        new("Out", "خروج", "Out", "Out"),
        new("TransferIn", "انتقال (ورودی)", "Transfer", "In"),
        new("TransferOut", "انتقال (خروجی)", "Transfer", "Out"),
        new("AdjustIn", "تعدیل (افزایشی)", "Adjustment", "In"),
        new("AdjustOut", "تعدیل (کاهشی)", "Adjustment", "Out"),
    };

    private sealed record MovementOption(string Key, string Label, string Type, string Direction);

    private void Cancel() => MudDialog.Close(DialogResult.Cancel());

    private async Task SaveAsync()
    {
        if (_busy) return;
        if (string.IsNullOrEmpty(_currencyCode))
        {
            Snackbar.Add("ارز را انتخاب کنید.", Severity.Warning);
            return;
        }
        if (_quantity <= 0 || _rate <= 0)
        {
            Snackbar.Add("مقدار و نرخ معتبر الزامی است.", Severity.Warning);
            return;
        }

        var selected = MovementOptions.First(m => m.Key == _movementKey);

        _busy = true;
        try
        {
            await Db.ExecuteAsync(Schema, "WalletMovementManual", new
            {
                CurrencyCode = _currencyCode,
                MovementType = selected.Type,
                Direction = selected.Direction,
                Quantity = _quantity,
                Rate = _rate,
                MovementDate = _date?.Date ?? DateTime.Today,
                MovementTime = _time ?? DateTime.Now.TimeOfDay,
                Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                // این سه پارامتر در اسکریپت استفاده می‌شوند و اگر ارسال نشوند
                // SQL با «Must declare the scalar variable @PartyName» شکست
                // می‌خورد (ثبت گردش دستی کیف پول اصلاً کار نمی‌کرد).
                PartyName = (string?)null,
                FundType = (string?)null,
                FundId = (int?)null,
                CreatedBy = Session.UserName
            });

            Snackbar.Add($"گردش «{selected.Label}» برای {_currencyCode} ثبت شد.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
