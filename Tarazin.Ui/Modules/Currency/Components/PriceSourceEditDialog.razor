@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-3">@(Source.SourceId == 0 ? "ایجاد منبع قیمت" : $"ویرایش منبع — {Source.Title}")</MudText>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField Label="کلید منبع (SourceKey)" @bind-Value="_sourceKey" Variant="Variant.Outlined"
                              Disabled="@(Source.SourceId != 0)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Label="عنوان" @bind-Value="_title" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Label="آدرس پایه (BaseUrl)" @bind-Value="_baseUrl" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Label="Endpoint (API/Feed رسمی)" @bind-Value="_endpoint" Variant="Variant.Outlined"
                              HelperText="آدرس رسمی و پایدار منبع — بدون وابستگی به HTML (§61)" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="int" Label="اولویت (§58)" @bind-Value="_priority" Variant="Variant.Outlined" Min="1" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="int" Label="فاصلهٔ بروزرسانی (ثانیه)" @bind-Value="_interval" Variant="Variant.Outlined" Min="10" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSwitch T="bool" Label="فعال" @bind-Value="_isActive" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Label="نگاشت آیتم‌ها (MappingsJson)" @bind-Value="_mappings" Variant="Variant.Outlined"
                              Rows="4" Lines="4"
                              HelperText="مثال: [{'ItemKey':'XAU-18','Path':'data[type=IRG18].price','Factor':10}]" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">انصراف</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy"
                   StartIcon="@Icons.Material.Filled.Save">ذخیره</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string Schema = "currency";

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public PriceSourceRow Source { get; set; } = new();

    private string _sourceKey = "";
    private string _title = "";
    private string _baseUrl = "";
    private string _endpoint = "";
    private string _mappings = "";
    private int _priority = 100;
    private int _interval = 300;
    private bool _isActive = true;
    private bool _busy;

    protected override void OnInitialized()
    {
        _sourceKey = Source.SourceKey;
        _title = Source.Title;
        _baseUrl = Source.BaseUrl ?? "";
        _endpoint = Source.Endpoint ?? "";
        _mappings = Source.MappingsJson ?? "";
        _priority = Source.Priority > 0 ? Source.Priority : 100;
        _interval = Source.FetchIntervalSeconds > 0 ? Source.FetchIntervalSeconds : 300;
        _isActive = Source.IsActive;
    }

    private void Cancel() => MudDialog.Close(DialogResult.Cancel());

    private async Task SaveAsync()
    {
        if (_busy) return;
        if (string.IsNullOrWhiteSpace(_sourceKey) || string.IsNullOrWhiteSpace(_title))
        {
            Snackbar.Add("کلید و عنوان منبع الزامی است.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await Db.ExecuteAsync(Schema, "PriceSourceUpsert", new
            {
                SourceId = Source.SourceId,
                SourceKey = _sourceKey.Trim(),
                Title = _title.Trim(),
                BaseUrl = string.IsNullOrWhiteSpace(_baseUrl) ? null : _baseUrl.Trim(),
                Endpoint = string.IsNullOrWhiteSpace(_endpoint) ? null : _endpoint.Trim(),
                MappingsJson = string.IsNullOrWhiteSpace(_mappings) ? null : _mappings.Trim(),
                Priority = _priority,
                FetchIntervalSeconds = _interval,
                IsActive = _isActive,
                CreatedBy = Session.UserName
            });

            Snackbar.Add("منبع قیمت ذخیره شد.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
