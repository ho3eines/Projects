@using System.Globalization
@inject DbService Db
@inject ISnackbar Snackbar
@inject UserSession Session

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudSelect T="int" Label="کارمند" @bind-Value="_employeeId" Variant="Variant.Outlined" Required="true">
                    <MudSelectItem Value="0">— انتخاب کارمند —</MudSelectItem>
                    @foreach (var e in Employees)
                    {
                        <MudSelectItem Value="e.EmployeeId">@e.FullName (‎@e.EmployeeCode)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6">
                <MudDatePicker Label="از تاریخ" Culture="FaCulture" @bind-Date="_startDate" />
            </MudItem>
            <MudItem xs="6">
                <MudDatePicker Label="تا تاریخ" Culture="FaCulture" @bind-Date="_endDate" />
            </MudItem>
            <MudItem xs="6">
                <MudSelect T="string" Label="نوع مرخصی" @bind-Value="_leaveType" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Annual")">استحقاقی سالانه</MudSelectItem>
                    <MudSelectItem Value="@("Sick")">استعلاجی</MudSelectItem>
                    <MudSelectItem Value="@("Unpaid")">بدون حقوق</MudSelectItem>
                    <MudSelectItem Value="@("Hourly")">ساعتی</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="decimal" Label="تعداد روز" @bind-Value="_days" Min="0.5m" Max="365m" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudSwitch T="bool" @bind-Value="_isPaid" Color="Color.Success" Label="با حقوق (استحقاقی)" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Label="شرح" @bind-Value="_description" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
            مرخصی «بدون حقوق» هنگام باز کردن دورهٔ حقوق به‌صورت خودکار (روز × پایه/۳۰) کسر می‌شود.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">انصراف</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">ذخیره</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "payroll";

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<EmployeeRow> Employees { get; set; } = new();

    private int _employeeId;
    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate = DateTime.Today;
    private string _leaveType = "Annual";
    private decimal _days = 1;
    private bool _isPaid = true;
    private string _description = "";
    private bool _busy;

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_employeeId <= 0)
        {
            Snackbar.Add("کارمند را انتخاب کنید.", Severity.Warning);
            return;
        }
        if (_startDate is null || _endDate is null || _endDate < _startDate)
        {
            Snackbar.Add("بازهٔ مرخصی نامعتبر است.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await Db.ExecuteAsync(Schema, "LeaveUpsert", new
            {
                LeaveId = 0,
                EmployeeId = _employeeId,
                CompanyId = Session.ActiveCompanyId,
                StartDate = _startDate,
                EndDate = _endDate,
                Days = _days,
                LeaveType = _leaveType,
                IsPaid = _isPaid,
                Description = string.IsNullOrWhiteSpace(_description) ? null : _description,
                ApprovedBy = Session.UserName,
                CreatedBy = Session.UserName
            });
            Snackbar.Add("مرخصی ثبت شد.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در ثبت: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
