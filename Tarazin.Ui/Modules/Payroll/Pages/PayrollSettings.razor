@page "/payroll/settings"
@inject DbService Db
@inject EntityCrudService EntityCrud
@inject ISnackbar Snackbar

<PageTitle>امکانات — حقوق و دستمزد</PageTitle>

<PageHeader Title="امکانات و جداول پایه" Subtitle="مدیریت کارمندان.">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="@(() => OpenEditorAsync(EntityEditorModel.FromEmployee()))">
        کارمند جدید
    </MudButton>
</PageHeader>

<MudPaper Elevation="1" Class="pa-4">
    <MudTable Items="_employees" Hover="true" Dense="true" Striped="true" Loading="_loading">
        <HeaderContent>
            <MudTh>کد</MudTh><MudTh>نام</MudTh><MudTh>دپارتمان</MudTh><MudTh>حقوق پایه</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="کد">@context.EmployeeCode</MudTd>
            <MudTd DataLabel="نام">@context.FullName</MudTd>
            <MudTd DataLabel="دپارتمان">@context.Department</MudTd>
            <MudTd DataLabel="حقوق پایه">@context.BaseSalary.ToString("N0")</MudTd>
            <MudTd DataLabel="وضعیت">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "فعال" : "غیرفعال")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="عملیات">
                <MudTooltip Text="ویرایش کارمند">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                   OnClick="@(() => OpenEditorAsync(EntityEditorModel.FromEmployee(context)))" />
                </MudTooltip>
                <MudTooltip Text="حذف">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => DeleteAsync(EntityEditorModel.FromEmployee(context)))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Color="Color.Secondary">کارمندی ثبت نشده است.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private const string Schema = "payroll";
    private List<EmployeeRow> _employees = new();
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _employees = (await Db.QueryAsync<EmployeeRow>(Schema, "EmployeeList")).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenEditorAsync(EntityEditorModel model)
    {
        if (await EntityCrud.ShowEditorAsync(model))
            await LoadAsync();
    }

    private async Task DeleteAsync(EntityEditorModel model)
    {
        if (await EntityCrud.ConfirmDeleteAsync(model))
            await LoadAsync();
    }
}
