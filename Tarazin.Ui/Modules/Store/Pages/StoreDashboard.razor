@page "/store/dashboard"
@inject DbService Db
@inject ISnackbar Snackbar

<PageTitle>داشبورد — فروشگاه اینترنتی</PageTitle>

<PageHeader Title="نمای کلی فروشگاه" Subtitle="سفارش‌ها و مشتریان." Eyebrow="فروشگاه" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <MudGrid>
        <StatCard Label="سفارش‌های امروز" Value="@_summary.TodayOrders.ToString("N0")"
                  Icon="@Icons.Material.Filled.ShoppingBag" Accent="#2B6B7A" />
        <StatCard Label="مبلغ امروز" Value="@_summary.TodayAmount.ToString("N0")"
                  Icon="@Icons.Material.Filled.Payments" Accent="#C49A3C" />
        <StatCard Label="سفارش‌های در انتظار" Value="@_summary.PendingOrders.ToString("N0")"
                  Icon="@Icons.Material.Filled.HourglassTop" Accent="#9C3B2E" />
        <StatCard Label="کل مشتریان" Value="@_summary.TotalCustomers.ToString("N0")"
                  Icon="@Icons.Material.Filled.Groups" Accent="#0E4D4A" />
    </MudGrid>
}

@code {
    private const string Schema = "store";
    private bool _loading = true;
    private StoreDashboardRow _summary = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await Db.QueryFirstOrDefaultAsync<StoreDashboardRow>(Schema, "DashboardSummary")
                       ?? new StoreDashboardRow();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
