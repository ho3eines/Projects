@page "/store/dashboard"
@inject DbService Db
@inject ISnackbar Snackbar

<PageTitle>داشبورد — فروشگاه اینترنتی</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">نمای کلی فروشگاه</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4 h-stat">
                <MudText Typo="Typo.caption" Color="Color.Secondary">سفارش‌های امروز</MudText>
                <MudText Typo="Typo.h4">@_summary.TodayOrders</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4 h-stat">
                <MudText Typo="Typo.caption" Color="Color.Secondary">مبلغ امروز</MudText>
                <MudText Typo="Typo.h5">@_summary.TodayAmount.ToString("N0")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4 h-stat">
                <MudText Typo="Typo.caption" Color="Color.Secondary">سفارش‌های در انتظار</MudText>
                <MudText Typo="Typo.h4">@_summary.PendingOrders</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4 h-stat">
                <MudText Typo="Typo.caption" Color="Color.Secondary">کل مشتریان</MudText>
                <MudText Typo="Typo.h4">@_summary.TotalCustomers</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private const string Schema = "store";
    private bool _loading = true;
    private StoreDashboardRow _summary = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await Db.QueryFirstOrDefaultAsync<StoreDashboardRow>(Schema, "DashboardSummary")
                       ?? new StoreDashboardRow();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
