@page "/store/settings"
@inject DbService Db
@inject EntityCrudService EntityCrud
@inject IDialogService Dialog
@inject UserSession Session
@inject ISnackbar Snackbar

<PageTitle>امکانات — فروشگاه اینترنتی</PageTitle>

<PageHeader Title="امکانات و جداول پایه" Subtitle="مدیریت فروشگاه‌ها، محصولات، مشتریان و کاتالوگ." />
<MudTabs>
    <MudTabPanel Text="فروشگاه‌ها">
        <MudPaper Elevation="1" Class="pa-4">
            <PageToolbar AddText="فروشگاه جدید" AddIcon="@Icons.Material.Filled.AddBusiness"
                         OnAddClick="OpenNewStoreAsync" />
            <MudTable Items="_stores" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>نام</MudTh><MudTh>نوع</MudTh><MudTh>انبار متصل</MudTh>
                    <MudTh>مدیر</MudTh><MudTh>تلفن</MudTh><MudTh>آنلاین</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.StoreCode</MudTd>
                    <MudTd DataLabel="نام">@context.Title</MudTd>
                    <MudTd DataLabel="نوع">@StoreTypeText(context.StoreType)</MudTd>
                    <MudTd DataLabel="انبار متصل">@(context.WarehouseTitle ?? "—")</MudTd>
                    <MudTd DataLabel="مدیر">@(context.ManagerName ?? "—")</MudTd>
                    <MudTd DataLabel="تلفن">@(context.Phone ?? "—")</MudTd>
                    <MudTd DataLabel="آنلاین">@if (context.OnlineEnabled){<MudChip T="string" Size="Size.Small" Color="Color.Success">فعال</MudChip>} else {<MudText Typo="Typo.body2">—</MudText>}</MudTd>
                    <MudTd DataLabel="وضعیت"><StatusChip IsActive="@context.IsActive" /></MudTd>
                    <MudTd DataLabel="عملیات">
                        <MudTooltip Text="ویرایش فروشگاه">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => OpenEditStoreAsync(context))" />
                        </MudTooltip>
                        <MudTooltip Text="حذف">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => DeleteStoreAsync(context))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Icon="@Icons.Material.Filled.Storefront" Title="فروشگاهی تعریف نشده است." />
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="برندها">
        <MudPaper Elevation="1" Class="pa-4">
            <PageToolbar AddText="برند جدید" AddIcon="@Icons.Material.Filled.Add"
                         OnAddClick="@(() => OpenBrandEditorAsync(null))" />
            <MudTable Items="_brands" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>نام برند</MudTh><MudTh>تعداد محصول</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.BrandCode</MudTd>
                    <MudTd DataLabel="نام برند">@context.Title</MudTd>
                    <MudTd DataLabel="تعداد محصول">@context.ProductCount</MudTd>
                    <MudTd DataLabel="وضعیت"><StatusChip IsActive="@context.IsActive" /></MudTd>
                    <MudTd DataLabel="عملیات">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                       OnClick="@(() => OpenBrandEditorAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => DeleteBrandAsync(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Icon="@Icons.Material.Filled.BrandingWatermark" Title="برندی تعریف نشده است." />
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="مشخصات داینامیک">
        <MudPaper Elevation="1" Class="pa-4">
            <PageToolbar AddText="ویژگی جدید" AddIcon="@Icons.Material.Filled.Add"
                         OnAddClick="@(() => OpenAttrEditorAsync(null))" />
            <MudTable Items="_attributes" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>عنوان</MudTh><MudTh>نوع داده</MudTh><MudTh>واحد</MudTh><MudTh>facet تنوع</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="عنوان">@context.Title</MudTd>
                    <MudTd DataLabel="نوع داده">@context.DataType</MudTd>
                    <MudTd DataLabel="واحد">@(context.Unit ?? "—")</MudTd>
                    <MudTd DataLabel="facet تنوع">@if (context.IsVariantFacet){<MudChip T="string" Size="Size.Small" Color="Color.Info">رنگ/سایز</MudChip>} else {<MudText Typo="Typo.body2">—</MudText>}</MudTd>
                    <MudTd DataLabel="وضعیت"><StatusChip IsActive="@context.IsActive" /></MudTd>
                    <MudTd DataLabel="عملیات">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                       OnClick="@(() => OpenAttrEditorAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => DeleteAttrAsync(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Icon="@Icons.Material.Filled.Tune" Title="ویژگی‌ای تعریف نشده است." />
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="قیمت‌گذاری">
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <PageToolbar AddText="لیست قیمت جدید" AddIcon="@Icons.Material.Filled.Add"
                         OnAddClick="@(() => OpenPriceListEditorAsync(null))" />
            <MudTable Items="_priceLists" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>فروشگاه</MudTh><MudTh>تعداد قیمت</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.Code</MudTd>
                    <MudTd DataLabel="عنوان">@context.Title</MudTd>
                    <MudTd DataLabel="فروشگاه">@(context.StoreTitle ?? "همهٔ فروشگاه‌ها")</MudTd>
                    <MudTd DataLabel="تعداد قیمت">@context.PriceCount</MudTd>
                    <MudTd DataLabel="وضعیت"><StatusChip IsActive="@context.IsActive" /></MudTd>
                    <MudTd DataLabel="عملیات">
                        <MudTooltip Text="ویرایش لیست">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => OpenPriceListEditorAsync(context))" />
                        </MudTooltip>
                        <MudTooltip Text="حذف لیست">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => DeletePriceListAsync(context))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Icon="@Icons.Material.Filled.PriceCheck" Title="لیست قیمتی تعریف نشده است." />
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <PageToolbar AddText="قیمت جدید" AddIcon="@Icons.Material.Filled.AttachMoney"
                         OnAddClick="@(() => OpenPriceEditorAsync(null))" />
            <MudTable Items="_productPrices" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>لیست</MudTh><MudTh>محصول</MudTh><MudTh>فروشگاه</MudTh><MudTh>قیمت</MudTh><MudTh>پایه</MudTh><MudTh>بازه</MudTh><MudTh>حداقل تعداد</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="لیست">@context.PriceListTitle</MudTd>
                    <MudTd DataLabel="محصول">@context.ProductTitle</MudTd>
                    <MudTd DataLabel="فروشگاه">@(context.StoreTitle ?? "همه")</MudTd>
                    <MudTd DataLabel="قیمت">@context.Price.ToString("N0")</MudTd>
                    <MudTd DataLabel="پایه">@context.BasePrice.ToString("N0")</MudTd>
                    <MudTd DataLabel="بازه">@(context.FromDate is null && context.ToDate is null ? "همیشه" : $"{context.FromDate:yyyy/MM/dd} — {context.ToDate:yyyy/MM/dd}")</MudTd>
                    <MudTd DataLabel="حداقل تعداد">@context.MinQty</MudTd>
                    <MudTd DataLabel="عملیات">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                       OnClick="@(() => OpenPriceEditorAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => DeletePriceAsync(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Icon="@Icons.Material.Filled.Sell" Title="قیمتی ثبت نشده — قیمت پایهٔ محصول استفاده می‌شود." />
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <PageToolbar AddText="کمپین جدید" AddIcon="@Icons.Material.Filled.Campaign"
                         OnAddClick="@(() => OpenPromoEditorAsync(null))" />
            <MudTable Items="_promotions" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>دامنه</MudTh><MudTh>تخفیف</MudTh><MudTh>بازهٔ زمانی</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.Code</MudTd>
                    <MudTd DataLabel="عنوان">@context.Title</MudTd>
                    <MudTd DataLabel="دامنه">@(context.ProductTitle ?? context.CategoryTitle ?? "همهٔ محصولات")</MudTd>
                    <MudTd DataLabel="تخفیف">@(context.DiscountType == "Percent" ? $"{context.DiscountValue:N0}٪" : $"{context.DiscountValue:N0} ریال")</MudTd>
                    <MudTd DataLabel="بازهٔ زمانی">@context.FromDate.ToString("yyyy/MM/dd") — @context.ToDate.ToString("yyyy/MM/dd")</MudTd>
                    <MudTd DataLabel="وضعیت">
                        @if (context.IsRunning){<MudChip T="string" Size="Size.Small" Color="Color.Success">در جریان</MudChip>}
                        else {<MudChip T="string" Size="Size.Small" Color="Color.Default">غیرفعال</MudChip>}
                    </MudTd>
                    <MudTd DataLabel="عملیات">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                       OnClick="@(() => OpenPromoEditorAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => DeletePromoAsync(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Icon="@Icons.Material.Filled.Campaign" Title="کمپینی تعریف نشده است." />
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <PageToolbar AddText="کد تخفیف جدید" AddIcon="@Icons.Material.Filled.LocalOffer"
                         OnAddClick="@(() => OpenCouponEditorAsync(null))" />
            <MudTable Items="_coupons" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>تخفیف</MudTh><MudTh>سقف</MudTh><MudTh>مصرف</MudTh><MudTh>بازهٔ زمانی</MudTh><MudTh>اعتبار</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.Code</MudTd>
                    <MudTd DataLabel="عنوان">@context.Title</MudTd>
                    <MudTd DataLabel="تخفیف">@(context.DiscountType == "Percent" ? $"{context.DiscountValue:N0}٪" : $"{context.DiscountValue:N0} ریال")</MudTd>
                    <MudTd DataLabel="سقف">@(context.MaxDiscount?.ToString("N0") ?? "—")</MudTd>
                    <MudTd DataLabel="مصرف">@(context.UsageLimit is null ? $"{context.UsedCount}" : $"{context.UsedCount}/{context.UsageLimit}")</MudTd>
                    <MudTd DataLabel="بازهٔ زمانی">@context.FromDate.ToString("yyyy/MM/dd") — @context.ToDate.ToString("yyyy/MM/dd")</MudTd>
                    <MudTd DataLabel="اعتبار">
                        @if (context.IsValidNow){<MudChip T="string" Size="Size.Small" Color="Color.Success">معتبر</MudChip>}
                        else {<MudChip T="string" Size="Size.Small" Color="Color.Warning">نامعتبر</MudChip>}
                    </MudTd>
                    <MudTd DataLabel="عملیات">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                       OnClick="@(() => OpenCouponEditorAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => DeleteCouponAsync(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Icon="@Icons.Material.Filled.LocalOffer" Title="کد تخفیفی تعریف نشده است." />
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="محصولات">
        <MudPaper Elevation="1" Class="pa-4">
            <PageToolbar AddText="محصول جدید" AddIcon="@Icons.Material.Filled.Add"
                         OnAddClick="@(() => OpenEditorAsync(EntityEditorModel.FromProduct()))" />
            <MudTable Items="_products" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>قیمت</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.ProductCode</MudTd>
                    <MudTd DataLabel="عنوان">@context.Title</MudTd>
                    <MudTd DataLabel="قیمت">@context.Price.ToString("N0")</MudTd>
                    <MudTd DataLabel="وضعیت"><StatusChip IsActive="@context.IsActive" /></MudTd>
                    <MudTd DataLabel="عملیات">
                        <EntityActions EditClicked="@(() => OpenEditorAsync(EntityEditorModel.FromProduct(context)))"
                                       DeleteClicked="@(() => DeleteAsync(EntityEditorModel.FromProduct(context)))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Icon="@Icons.Material.Filled.Inventory2" Title="محصولی ثبت نشده است." />
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="دسته‌های کالا">
        @if (Session.HasPermission(TarazinPermissions.StoreCategories))
        {
            <MudPaper Elevation="1" Class="pa-4">
                <PageToolbar AddText="دستهٔ جدید" AddIcon="@Icons.Material.Filled.Add"
                             OnAddClick="OpenNewCategoryAsync" />
                <MudTable Items="_categories" Hover="true" Dense="true" Striped="true" Loading="_loading">
                    <HeaderContent>
                        <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>ترتیب</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="کد">@context.CategoryCode</MudTd>
                        <MudTd DataLabel="عنوان">@context.Title</MudTd>
                        <MudTd DataLabel="ترتیب">@context.SortOrder</MudTd>                            <MudTd DataLabel="وضعیت"><StatusChip IsActive="@context.IsActive" /></MudTd>
                        <MudTd DataLabel="عملیات">
                            <MudTooltip Text="ویرایش دسته">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                               OnClick="@(() => OpenEditCategoryAsync(context))" />
                            </MudTooltip>
                            <MudTooltip Text="حذف">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => DeleteCategoryAsync(context))" />
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <EmptyState Icon="@Icons.Material.Filled.Category" Title="دسته‌ای تعریف نشده است." />
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
                شما دسترسی لازم برای مدیریت دسته‌های کالا را ندارید (دسترسی «فروشگاه — مدیریت دسته‌بندی کالا»).
                برای دریافت دسترسی با مدیر سیستم تماس بگیرید.
            </MudAlert>
        }
    </MudTabPanel>

    <MudTabPanel Text="اتصال حسابداری">
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
            انبار، حساب‌های حسابداری و تسویهٔ خزانه برای شرکت فعال. گروه تفصیلی مشتری در
            <MudLink Href="/accounting/settings" Typo="Typo.body2">تنظیمات شرکت مالی</MudLink>
            تعریف می‌شود و هنگام ساخت مشتری به‌صورت خودکار لینک می‌شود.
        </MudAlert>
        <MudPaper Elevation="1" Class="pa-4">
            <MudForm @ref="_settingsForm" @bind-IsValid="_settingsValid">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6"><MudSelect T="int?" Label="انبار فروشگاه" @bind-Value="_warehouse" Required="true" Variant="Variant.Outlined"><MudSelectItem Value="@((int?)null)">انتخاب کنید</MudSelectItem>@foreach(var w in _warehouses){<MudSelectItem Value="@((int?)w.WarehouseId)">@w.Title</MudSelectItem>}</MudSelect></MudItem>
                    <MudItem xs="12" sm="6"><MudSelect T="int?" Label="صندوق پیش‌فرض خزانه" @bind-Value="_cashBox" Variant="Variant.Outlined"><MudSelectItem Value="@((int?)null)">— بدون صندوق —</MudSelectItem>@foreach(var c in _cashBoxes){<MudSelectItem Value="@((int?)c.CashBoxId)">@c.Title</MudSelectItem>}</MudSelect></MudItem>
                    <MudItem xs="12" sm="6"><MudSelect T="int?" Label="حساب بانکی پیش‌فرض خزانه" @bind-Value="_bankAccount" Variant="Variant.Outlined"><MudSelectItem Value="@((int?)null)">— بدون بانک —</MudSelectItem>@foreach(var b in _banks){<MudSelectItem Value="@((int?)b.AccountId)">@b.AccountName — @b.AccountNo</MudSelectItem>}</MudSelect></MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">حساب فروش</MudText>
                        <AccountPickerField Value="_salesAccount" ValueChanged="OnSalesAccountAsync" ButtonLabel="انتخاب حساب فروش" EmptyText="حساب فروش انتخاب نشده است." PickerOptions="@_moeinOptions" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">حساب صندوق (سند حسابداری)</MudText>
                        <AccountPickerField Value="_cashAccount" ValueChanged="OnCashAccountAsync" ButtonLabel="انتخاب حساب صندوق" EmptyText="حساب صندوق انتخاب نشده است." PickerOptions="@_moeinOptions" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">حساب بانکی سند حسابداری</MudText>
                        <AccountPickerField Value="_bankChartAccount" ValueChanged="OnBankChartAccountAsync" ButtonLabel="انتخاب حساب بانک" EmptyText="حساب بانک انتخاب نشده است." PickerOptions="@_moeinOptions" />
                    </MudItem>
                    <MudItem xs="12"><MudSwitch T="bool" @bind-Value="_settingsEnabled" Color="Color.Success">فعال‌سازی یکپارچه‌سازی فروشگاه (سند خودکار سفارش)</MudSwitch></MudItem>
                </MudGrid>
            </MudForm>
            <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettingsAsync" Disabled="_busy">ذخیره تنظیمات اتصال</MudButton>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="مشتریان">
        <MudPaper Elevation="1" Class="pa-4">
            <PageToolbar AddText="مشتری جدید" AddIcon="@Icons.Material.Filled.PersonAdd"
                         OnAddClick="@(() => OpenEditorAsync(EntityEditorModel.FromCustomer()))" />
            <MudTable Items="_customers" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>نام</MudTh><MudTh>تلفن</MudTh><MudTh>ماندهٔ دفتر</MudTh><MudTh>وضعیت</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.CustomerCode</MudTd>
                    <MudTd DataLabel="نام">@context.FullName</MudTd>
                    <MudTd DataLabel="تلفن">@context.Phone</MudTd>
                    <MudTd DataLabel="ماندهٔ دفتر">
                        <MudChip T="string" Size="Size.Small" Color="@(context.Balance > 0 ? Color.Error : context.Balance < 0 ? Color.Success : Color.Default)">
                            @(context.Balance == 0 ? "تسویه" : $"{(context.Balance > 0 ? "بدهکار" : "بستانکار")} {Math.Abs(context.Balance):N0}")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="وضعیت"><StatusChip IsActive="@context.IsActive" /></MudTd>
                    <MudTd DataLabel="عملیات">
