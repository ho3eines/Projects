@page "/store/reports"
@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject PdfReportService Pdf

<PageTitle>گزارشات — فروشگاه اینترنتی</PageTitle>

<PageHeader Title="گزارش سفارش‌ها" Subtitle="سفارش‌ها بر اساس وضعیت در بازهٔ تاریخ." Eyebrow="فروشگاه اینترنتی">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync" Disabled="_loading"
               StartIcon="@Icons.Material.Filled.Refresh">بروزرسانی</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="PrintAsync" Disabled="_loading || _rows.Count == 0"
               StartIcon="@Icons.Material.Filled.Print">چاپ / PDF</MudButton>
</PageHeader>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="از تاریخ" Culture="FaCulture" @bind-Date="_from" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="تا تاریخ" Culture="FaCulture" @bind-Date="_to" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string?" Label="وضعیت" @bind-Value="_status" Variant="Variant.Outlined">
                <MudSelectItem Value="@((string?)null)">همه</MudSelectItem>
                <MudSelectItem Value="@("Placed")">ثبت‌شده</MudSelectItem>
                <MudSelectItem Value="@("Reserved")">رزروشده</MudSelectItem>
                <MudSelectItem Value="@("Invoiced")">فاکتورشده</MudSelectItem>
                <MudSelectItem Value="@("Rejected")">ردشده</MudSelectItem>
                <MudSelectItem Value="@("Cancelled")">لغوشده</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="LoadAsync" Disabled="_loading">
                اجرا
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="1" Class="pa-4">
    <MudTable Items="_rows" Loading="_loading" Hover="true" Dense="true" Striped="true"
              Breakpoint="Breakpoint.Sm" RowsPerPage="25">
        <HeaderContent>
            <MudTh>شماره</MudTh><MudTh>تاریخ</MudTh><MudTh>مشتری</MudTh>
            <MudTh>تعداد اقلام</MudTh><MudTh>مبلغ</MudTh><MudTh>وضعیت</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="شماره">@context.OrderNumber</MudTd>
            <MudTd DataLabel="تاریخ">@context.OrderDate.ToString("yyyy/MM/dd")</MudTd>
            <MudTd DataLabel="مشتری">@context.CustomerName</MudTd>
            <MudTd DataLabel="تعداد اقلام">@context.ItemCount</MudTd>
            <MudTd DataLabel="مبلغ">@context.TotalAmount.ToString("N0")</MudTd>
            <MudTd DataLabel="وضعیت">@StatusText(context.Status)</MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Color="Color.Secondary">داده‌ای نیست.</MudText></NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 25, 50, 100 })" /></PagerContent>
    </MudTable>

    @if (_rows.Count > 0)
    {
        <MudText Typo="Typo.body2" Class="mt-4">
            جمع مبلغ سفارش‌های نمایش‌داده‌شده: <b>@_rows.Sum(r => r.TotalAmount).ToString("N0")</b>
        </MudText>
    }
</MudPaper>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "store";

    private List<OrderRow> _rows = new();
    private DateTime? _from;
    private DateTime? _to;
    private string? _status;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        _from = DateTime.Today.AddMonths(-1);
        _to = DateTime.Today;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _rows = (await Db.QueryAsync<OrderRow>(Schema, "OrderListReport", new
            {
                FromDate = _from?.Date ?? DateTime.Today.AddMonths(-1),
                ToDate = _to?.Date ?? DateTime.Today,
                Status = string.IsNullOrWhiteSpace(_status) ? null : _status,
                CompanyId = Session.ActiveCompanyId
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ── چاپ / PDF (طبق اسکیل tarazin-reporting) ──

    private async Task PrintAsync()
    {
        if (_rows.Count == 0) return;
        await Dialog.ShowAsync<ReportPrintDialog>("چاپ گزارش سفارش‌ها", new DialogParameters<ReportPrintDialog>
        {
            { x => x.Title, "گزارش سفارش‌ها" },
            { x => x.Subtitle, "سفارش‌ها بر اساس وضعیت در بازهٔ تاریخ" },
            { x => x.RangeText, $"از {_from:yyyy/MM/dd} تا {_to:yyyy/MM/dd}" },
            { x => x.Body, TableBody },
            { x => x.BuildPdf, BuildPdf }
        }, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
    }

    private RenderFragment TableBody => @<MudTable Items="_rows" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" Class="gp-lines-table">
        <HeaderContent>
            <MudTh>شماره</MudTh><MudTh>تاریخ</MudTh><MudTh>مشتری</MudTh>
            <MudTh>تعداد اقلام</MudTh><MudTh>مبلغ</MudTh><MudTh>وضعیت</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="شماره">@context.OrderNumber</MudTd>
            <MudTd DataLabel="تاریخ">@context.OrderDate.ToString("yyyy/MM/dd")</MudTd>
            <MudTd DataLabel="مشتری">@context.CustomerName</MudTd>
            <MudTd DataLabel="تعداد اقلام">@context.ItemCount</MudTd>
            <MudTd DataLabel="مبلغ">@context.TotalAmount.ToString("N0")</MudTd>
            <MudTd DataLabel="وضعیت">@StatusText(context.Status)</MudTd>
        </RowTemplate>
    </MudTable>;

    private byte[] BuildPdf(string paperSize)
    {
        var columns = new List<TableReportColumn>
        {
            new() { Header = "شماره" },
            new() { Header = "تاریخ" },
            new() { Header = "مشتری" },
            new() { Header = "تعداد اقلام", AlignRight = true },
            new() { Header = "مبلغ", AlignRight = true },
            new() { Header = "وضعیت" }
        };
        var rows = _rows.Select(r => (IReadOnlyList<string>)new string[]
        {
            r.OrderNumber,
            r.OrderDate.ToString("yyyy/MM/dd"),
            r.CustomerName,
            r.ItemCount.ToString("N0"),
            r.TotalAmount.ToString("N0"),
            StatusText(r.Status)
        }).ToList();

        return Pdf.BuildTablePdf("گزارش سفارش‌ها", "سفارش‌ها بر اساس وضعیت در بازهٔ تاریخ",
            $"از {_from:yyyy/MM/dd} تا {_to:yyyy/MM/dd}", columns, rows,
            new[] { $"جمع مبلغ: {_rows.Sum(r => r.TotalAmount):N0} ریال" }, paperSize);
    }

    private static string StatusText(string status) => status switch
    {
        "Placed" => "ثبت‌شده",
        "Reserved" => "رزروشده",
        "Invoiced" => "فاکتورشده",
        "Rejected" => "ردشده",
        "Cancelled" => "لغوشده",
        _ => status
    };
}
