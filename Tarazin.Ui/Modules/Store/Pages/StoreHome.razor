@page "/store"
@inject DbService Db
@inject UserSession Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>سفارش‌های روز — فروشگاه اینترنتی</PageTitle>

<PageHeader Title="سفارش‌های روز" Subtitle="وضعیت سفارش‌ها — از تاریخ / تا تاریخ." />
<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="از تاریخ" Culture="FaCulture" @bind-Date="_from" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="تا تاریخ" Culture="FaCulture" @bind-Date="_to" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Label="جستجو (شماره سفارش یا مشتری)" @bind-Value="_search" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync" Disabled="_loading">
                اعمال فیلتر
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="1" Class="pa-4">
    <MudTable Items="_rows" Loading="_loading" Hover="true" Dense="true" Striped="true">
        <HeaderContent>
            <MudTh>شماره</MudTh><MudTh>تاریخ</MudTh><MudTh>مشتری</MudTh>
            <MudTh>تعداد اقلام</MudTh><MudTh>مبلغ</MudTh><MudTh>نسیه</MudTh><MudTh>وضعیت</MudTh><MudTh>تسویه</MudTh><MudTh>سند</MudTh><MudTh>عملیات</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="شماره">@context.OrderNumber</MudTd>
            <MudTd DataLabel="تاریخ">@context.OrderDate.ToString("yyyy/MM/dd")</MudTd>
            <MudTd DataLabel="مشتری">@context.CustomerName</MudTd>
            <MudTd DataLabel="تعداد اقلام">@context.ItemCount</MudTd>
            <MudTd DataLabel="مبلغ">@context.TotalAmount.ToString("N0")</MudTd>
            <MudTd DataLabel="نسیه">@context.BalanceRial.ToString("N0")</MudTd>
            <MudTd DataLabel="وضعیت">
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@context.Status</MudChip>
            </MudTd>
            <MudTd DataLabel="تسویه">
                <MudChip T="string" Size="Size.Small" Color="@PaymentStatusColor(context.PaymentStatus)">@PaymentStatusText(context.PaymentStatus)</MudChip>
            </MudTd>
            <MudTd DataLabel="سند">
                @if (context.DocumentId is int did && did > 0)
                {
                    <MudLink Href="/accounting" Typo="Typo.body2">@did</MudLink>
                }
                else { <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText> }
            </MudTd>
            <MudTd DataLabel="عملیات">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary" OnClick="() => OpenDetailAsync(context)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Color="Color.Secondary">سفارشی در این بازه نیست.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "store";

    private List<OrderRow> _rows = new();
    private bool _loading = true;
    private string _search = "";
    private DateTime? _from;
    private DateTime? _to;

    protected override async Task OnInitializedAsync()
    {
        _from = DateTime.Today;
        _to = DateTime.Today;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _rows = (await Db.QueryAsync<OrderRow>(Schema, "DailyOrders", new
            {
                CompanyId = Session.ActiveCompanyId,
                FromDate = _from?.Date ?? DateTime.Today,
                ToDate = _to?.Date ?? DateTime.Today,
                SearchText = _search ?? "",
                Status = (string?)null,
                SkipRows = 0,
                TakeSize = 100
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenDetailAsync(OrderRow row)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true };
        var parameters = new DialogParameters<OrderDetailDialog>
        {
            { x => x.OrderId, row.OrderId },
            { x => x.CustomerId, row.CustomerId },
            { x => x.OrderNumber, row.OrderNumber },
            { x => x.CustomerName, row.CustomerName },
            { x => x.OrderDate, row.OrderDate },
            { x => x.TotalAmount, row.TotalAmount },
            { x => x.BalanceRial, row.BalanceRial },
            { x => x.DocumentId, row.DocumentId }
        };
        await DialogService.ShowAsync<OrderDetailDialog>("جزئیات سفارش", parameters, options);
    }

    private static string PaymentStatusText(string? s) => s switch
    {
        "Paid" => "تسویه شده",
        "Partial" => "تسویه جزئی",
        _ => "نسیه"
    };

    private static Color PaymentStatusColor(string? s) => s switch
    {
        "Paid" => Color.Success,
        "Partial" => Color.Warning,
        _ => Color.Error
    };

    private static Color StatusColor(string? status) => status switch
    {
        "Placed" => Color.Info,
        "Reserved" => Color.Warning,
        "Invoiced" => Color.Success,
        "Rejected" or "Cancelled" => Color.Error,
        _ => Color.Default
    };
}
