@using Tarazin.Models
@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

@* دیالوگ کد تخفیف — با سقف مبلغ و سقف مصرف *@
<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="کد تخفیف" @bind-Value="_code" Required="true"
                                  RequiredError="کد تخفیف الزامی است" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="عنوان" @bind-Value="_title" Required="true"
                                  RequiredError="عنوان الزامی است" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" Label="فروشگاه (اختیاری)" @bind-Value="_storeId" Variant="Variant.Outlined">
                        <MudSelectItem Value="@((int?)null)">همهٔ فروشگاه‌ها</MudSelectItem>
                        @foreach (var s in _stores)
                        {
                            <MudSelectItem Value="@((int?)s.StoreId)">@s.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="string" Label="نوع تخفیف" @bind-Value="_discountType" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Percent")">درصدی</MudSelectItem>
                        <MudSelectItem Value="@("Amount")">مبلغی (ریال)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <TzNumericField T="decimal" Label="@(_discountType == "Percent" ? "درصد تخفیف" : "مبلغ تخفیف")"
                                     @bind-Value="_discountValue" Required="true"
                                     RequiredError="مقدار تخفیف الزامی است" Variant="Variant.Outlined" Min="0" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <TzNumericField T="decimal" Label="سقف تخفیف (ریال — اختیاری)" @bind-Value="_maxDiscount"
                                     Variant="Variant.Outlined" Min="0" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <TzNumericField T="decimal" Label="حداقل مبلغ سفارش" @bind-Value="_minOrderTotal" Variant="Variant.Outlined" Min="0" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <TzNumericField T="int?" Label="سقف کل مصرف" @bind-Value="_usageLimit" Variant="Variant.Outlined" Min="1" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <TzNumericField T="int?" Label="سقف هر مشتری" @bind-Value="_perCustomerLimit" Variant="Variant.Outlined" Min="1" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Class="mt-4">
                        مصرف فعلی: @_usedCount
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="از تاریخ" @bind-Date="_fromDate" Required="true" RequiredError="تاریخ شروع الزامی است" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="تا تاریخ" @bind-Date="_toDate" Required="true" RequiredError="تاریخ پایان الزامی است" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch T="bool" @bind-Value="_isActive" Color="Color.Primary">فعال</MudSwitch>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Cancel())">انصراف</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">ذخیره</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public CouponRow? Model { get; set; }

    private MudForm? _form;
    private bool _valid;
    private bool _busy;

    private string _code = "", _title = "", _discountType = "Percent";
    private int? _storeId;
    private decimal _discountValue, _maxDiscount, _minOrderTotal;
    private int? _usageLimit, _perCustomerLimit;
    private int _usedCount;
    private DateTime? _fromDate = DateTime.Today, _toDate = DateTime.Today.AddDays(30);
    private bool _isActive = true;

    private List<StoreRow> _stores = new();

    protected override async Task OnInitializedAsync()
    {
        _stores = (await Db.QueryAsync<StoreRow>("store", "StoreList",
            new { CompanyId = Session.ActiveCompanyId, StoreId = (int?)null, IsActive = (bool?)null })).ToList();

        if (Model is not null)
        {
            _code = Model.Code; _title = Model.Title; _storeId = Model.StoreId;
            _discountType = Model.DiscountType; _discountValue = Model.DiscountValue;
            _maxDiscount = Model.MaxDiscount ?? 0;
            _minOrderTotal = Model.MinOrderTotal;
            _usageLimit = Model.UsageLimit; _perCustomerLimit = Model.PerCustomerLimit;
            _usedCount = Model.UsedCount;
            _fromDate = Model.FromDate; _toDate = Model.ToDate; _isActive = Model.IsActive;
        }
    }

    private async Task SaveAsync()
    {
        if (_busy || _form is null) return;
        await _form.ValidateAsync();
        if (!_valid) return;
        if (_fromDate is null || _toDate is null) return;

        _busy = true;
        try
        {
            await Db.ExecuteAsync("store", "CouponUpsert", new
            {
                CouponId = Model?.CouponId ?? 0,
                CompanyId = Session.ActiveCompanyId,
                Code = _code.Trim(), Title = _title.Trim(), StoreId = _storeId,
                DiscountType = _discountType, DiscountValue = _discountValue,
                MaxDiscount = _maxDiscount > 0 ? _maxDiscount : (decimal?)null,
                MinOrderTotal = _minOrderTotal,
                UsageLimit = _usageLimit, PerCustomerLimit = _perCustomerLimit,
                FromDate = _fromDate.Value.Date, ToDate = _toDate.Value.Date,
                IsActive = _isActive,
                CreatedBy = Session.UserName, UpdatedBy = Session.UserName
            });
            Snackbar.Add(Model is null ? "کد تخفیف ایجاد شد." : "کد تخفیف ویرایش شد.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
