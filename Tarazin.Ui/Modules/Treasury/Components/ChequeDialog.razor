@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField Label="شماره چک" @bind-Value="_number" Required="true"
                                  RequiredError="شماره چک الزامی است." Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <EntityPickerField T="BankRow"
                                   @bind-Value="_selectedBank"
                                   Options="_bankOptions"
                                   ButtonLabel="انتخاب بانک"
                                   ButtonIcon="@Icons.Material.Filled.AccountBalance"
                                   Display="@(b => b.Title)"
                                   EmptyText="بانک انتخاب نشده است." />
                @if (_selectedBank is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">بانک الزامی است.</MudText>
                }
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="جهت" @bind-Value="_direction" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("In")">دریافتی</MudSelectItem>
                        <MudSelectItem Value="@("Out")">پرداختی</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <TzNumericField T="decimal" Label="مبلغ" @bind-Value="_amount" Variant="Variant.Outlined" Min="0" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="سررسید" Culture="FaCulture" @bind-Date="_dueDate" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel" Disabled="_busy">انصراف</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync" Disabled="_busy">ذخیره</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    private List<BankRow> _banks = new();
    private BankRow? _selectedBank;
    private EntityPickerOptions<BankRow> _bankOptions = new()
    {
        Title = "انتخاب بانک",
        SearchPlaceholder = "جستجوی نام بانک...",
        Columns = new()
        {
            new("کد", b => b.BankCode),
            new("عنوان", b => b.Title),
        },
        DisplayText = b => b.Title,
        RowsPerPage = 10,
    };
    private string _number = "";
    private string _direction = "In";
    private decimal _amount;
    private DateTime? _dueDate = DateTime.Today;
    private MudForm? _form;
    private bool _valid;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _banks = (await Db.QueryAsync<BankRow>("treasury", "BankList",
                new { CompanyId = Session.ActiveCompanyId })).ToList();
        }
        catch { _banks = new List<BankRow>(); }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_busy || _form is null) return;
        await _form.ValidateAsync();
        if (!_valid) return;
        _busy = true;
        try
        {
            await Db.ExecuteAsync("treasury", "ChequeInsert", new
            {
                ChequeNumber = _number.Trim(),
                BankId = _selectedBank?.BankId,
                Amount = _amount,
                DueDate = _dueDate?.Date,
                Direction = _direction,
                CompanyId = Session.ActiveCompanyId,
                CreatedBy = Session.UserName
            });
            Snackbar.Add("چک ثبت شد.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }
}
