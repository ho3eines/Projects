@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.DoneAll" Class="mr-2" Color="Color.Success" />
            وصول چک @Cheque.ChequeNumber
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            مبلغ <b>@Cheque.Amount.ToString("N0")</b> ریال — حساب بانکی مقصد وصول را انتخاب کنید.
            پس از تأیید، حرکت خزانه (دریافت) و سند حسابداری یاداشت ساخته می‌شود.
        </MudText>
        <MudSelect T="int" Label="حساب بانکی مقصد" @bind-Value="_accountId" Variant="Variant.Outlined">
            <MudSelectItem Value="0">— انتخاب حساب —</MudSelectItem>
            @foreach (var a in BankAccounts.Where(a => a.IsActive))
            {
                <MudSelectItem Value="a.AccountId">@a.AccountName — @a.BankName (موجودی: @a.Balance.ToString("N0"))</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel" Disabled="_busy">انصراف</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.DoneAll"
                   OnClick="SaveAsync" Disabled="_busy">تأیید وصول</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ChequeRow Cheque { get; set; } = default!;
    [Parameter] public List<BankAccountRow> BankAccounts { get; set; } = new();

    private int _accountId;
    private bool _busy;

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_busy) return;
        if (_accountId <= 0)
        {
            Snackbar.Add("حساب بانکی مقصد را انتخاب کنید.", Severity.Warning);
            return;
        }
        _busy = true;
        try
        {
            await Db.ExecuteAsync("treasury", "ChequeStatusChange", new
            {
                ChequeId = Cheque.ChequeId,
                Status = "Passed",
                CompanyId = Session.ActiveCompanyId,
                UpdatedBy = Session.UserName,
                Reason = (string?)null,
                CollectAccountId = _accountId,
                FiscalYearId = Session.ActiveFiscalYearId
            });
            Snackbar.Add($"چک «{Cheque.ChequeNumber}» وصول شد — حرکت خزانه و سند حسابداری ساخته شد.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }
}
