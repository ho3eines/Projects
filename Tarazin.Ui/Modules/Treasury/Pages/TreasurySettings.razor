@page "/treasury/settings"
@inject DbService Db
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>امکانات — خزانه‌داری</PageTitle>

<PageHeader Title="امکانات و جداول پایه" Subtitle="نرخ ارز، بانک‌ها و صندوق‌ها." />
<MudTabs>
    <MudTabPanel Text="نرخ ارز">
        <MudPaper Elevation="1" Class="pa-4">
            <div class="d-flex justify-end mb-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => OpenRateEditorAsync(EntityEditorModel.FromCurrencyRate()))">
                    نرخ جدید
                </MudButton>
            </div>
            <MudTable Items="_rates" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>نام</MudTh><MudTh>نرخ به ریال</MudTh><MudTh>تاریخ</MudTh><MudTh>عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.CurrencyCode</MudTd>
                    <MudTd DataLabel="نام">@context.CurrencyName</MudTd>
                    <MudTd DataLabel="نرخ">@context.RateToIRR.ToString("N0")</MudTd>
                    <MudTd DataLabel="تاریخ">@context.RateDate.ToString("yyyy/MM/dd")</MudTd>
                    <MudTd DataLabel="عملیات">
                        <MudTooltip Text="ویرایش نرخ">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => OpenRateEditorAsync(EntityEditorModel.FromCurrencyRate(context)))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">نرخی ثبت نشده است.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="بانک‌ها">
        <MudPaper Elevation="1" Class="pa-4">
            <MudTable Items="_banks" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>عنوان</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.BankCode</MudTd>
                    <MudTd DataLabel="عنوان">@context.Title</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">بانکی نیست.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="صندوق‌ها">
        <MudPaper Elevation="1" Class="pa-4">
            <MudTable Items="_cashBoxes" Hover="true" Dense="true" Striped="true" Loading="_loading">
                <HeaderContent>
                    <MudTh>کد</MudTh><MudTh>عنوان</MudTh><MudTh>مانده</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="کد">@context.CashBoxCode</MudTd>
                    <MudTd DataLabel="عنوان">@context.Title</MudTd>
                    <MudTd DataLabel="مانده">@context.Balance.ToString("N0")</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Color="Color.Secondary">صندوقی نیست.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private const string Schema = "treasury";
    private List<CurrencyRateRow> _rates = new();
    private List<BankRow> _banks = new();
    private List<CashBoxRow> _cashBoxes = new();
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _rates = (await Db.QueryAsync<CurrencyRateRow>(Schema, "CurrencyRateSearch", new
            {
                SkipRows = 0,
                TakeSize = 200
            })).ToList();
            _banks = (await Db.QueryAsync<BankRow>(Schema, "BankList")).ToList();
            _cashBoxes = (await Db.QueryAsync<CashBoxRow>(Schema, "CashBoxList")).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenRateEditorAsync(EntityEditorModel model)
    {
        var parameters = new DialogParameters { [nameof(EntityEditorDialog.Model)] = model };
        var dialog = await DialogService.ShowAsync<EntityEditorDialog>(model.DialogTitle, parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadAsync();
    }
}
