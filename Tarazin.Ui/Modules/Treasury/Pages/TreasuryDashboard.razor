@page "/treasury/dashboard"
@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<PageTitle>داشبورد — خزانه‌داری</PageTitle>

<PageHeader Title="نمای کلی خزانه" Subtitle="مانده‌ها و گردش امروز." Eyebrow="خزانه‌داری" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <MudGrid>
        <StatCard Label="خالص امروز" Value="@_summary.TodayNet.ToString("N0")"
                  Icon="@Icons.Material.Filled.SwapVert" Accent="@TarazinAccents.Gold" />
        <StatCard Label="مانده بانک" Value="@_summary.BankBalance.ToString("N0")"
                  Icon="@Icons.Material.Filled.AccountBalance" Accent="@TarazinAccents.Steel" />
        <StatCard Label="مانده صندوق" Value="@_summary.CashBalance.ToString("N0")"
                  Icon="@Icons.Material.Filled.PointOfSale" Accent="@TarazinAccents.Ink" />
        <StatCard Label="چک‌های در انتظار" Value="@_summary.PendingCheques.ToString("N0")"
                  Icon="@Icons.Material.Filled.ReceiptLong" Accent="@TarazinAccents.Wine"
                  Hint="مدیریت وصول/برگشت" Href="/treasury/cheques" />
        <StatCard Label="چک‌های سررسیدشده" Value="@_summary.OverdueCheques.ToString("N0")"
                  Icon="@Icons.Material.Filled.NotificationImportant" Accent="@TarazinAccents.Crimson"
                  Hint="مشاهده گزارش سررسید" Href="/treasury/cheque-report" />
    </MudGrid>
}

@code {
    private const string Schema = "treasury";
    private bool _loading = true;
    private TreasuryDashboardRow _summary = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await Db.QueryFirstOrDefaultAsync<TreasuryDashboardRow>(Schema, "DashboardSummary",
                           new { CompanyId = Session.ActiveCompanyId })
                       ?? new TreasuryDashboardRow();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
