@page "/treasury/entry"
@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<PageTitle>دریافت / پرداخت — خزانه‌داری</PageTitle>

<PageHeader Title="ثبت دریافت / پرداخت" Subtitle="حرکت نقدی صندوق یا بانک؛ در صورت فعال‌بودن اتصال حسابداری، سند حسابداری هم ساخته می‌شود." Eyebrow="خزانه‌داری" />

<MudPaper Elevation="1" Class="pa-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="string" Label="جهت" @bind-Value="_direction" Variant="Variant.Outlined">
                <MudSelectItem Value="@("In")">دریافت</MudSelectItem>
                <MudSelectItem Value="@("Out")">پرداخت</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudDatePicker Label="تاریخ" Culture="FaCulture" @bind-Date="_date" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <TzNumericField T="decimal" Label="مبلغ" @bind-Value="_amount" Variant="Variant.Outlined" Min="0" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <EntityPickerField T="TreasuryAccountOption"
                               @bind-Value="_account"
                               Options="_accountOptions"
                               ButtonLabel="صندوق / حساب بانکی"
                               ButtonIcon="@Icons.Material.Filled.AccountBalanceWallet"
                               Display="@(a => a.Label)"
                               EmptyText="صندوق یا حساب بانکی انتخاب نشده است." />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <EntityPickerField T="TreasuryPartyRow"
                               @bind-Value="_party"
                               Options="_partyOptions"
                               ButtonLabel="طرف حساب (اختیاری)"
                               ButtonIcon="@Icons.Material.Filled.PeopleAlt"
                               Display="@(p => (p.PartyType == "Vendor" ? "تأمین‌کننده" : "مشتری") + ": " + p.FullName)"
                               EmptyText="بدون طرف حساب — برای انتخاب کلیک کنید." />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Label="شرح" @bind-Value="_description" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Label="ارجاع (اختیاری)" @bind-Value="_reference" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveAsync" Disabled="_busy">
                ثبت حرکت
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "treasury";

    /// <summary>گزینهٔ مشترک صندوق/حساب بانکی برای EntityPickerField.</summary>
    private sealed record TreasuryAccountOption(int Id, string Label, bool IsCashBox);

    private List<CashBoxRow> _cashBoxes = new();
    private List<BankAccountRow> _bankAccounts = new();
    private List<TreasuryPartyRow> _parties = new();
    private TreasuryAccountOption? _account;
    private TreasuryPartyRow? _party;
    private string _direction = "In";
    private DateTime? _date = DateTime.Today;
    private decimal _amount;
    private string _description = "";
    private string _reference = "";
    private bool _busy;

    private EntityPickerOptions<TreasuryAccountOption> _accountOptions = new()
    {
        Title = "انتخاب صندوق / حساب بانکی",
        SearchPlaceholder = "جستجوی صندوق یا بانک...",
        Columns = new()
        {
            new("نوع", a => a.IsCashBox ? "صندوق" : "بانک"),
            new("عنوان", a => a.Label),
        },
        DisplayText = a => a.Label,
        RowsPerPage = 10,
    };

    private EntityPickerOptions<TreasuryPartyRow> _partyOptions = new()
    {
        Title = "انتخاب طرف حساب",
        SearchPlaceholder = "جستجوی نام یا کد طرف حساب...",
        Columns = new()
        {
            new("کد", p => p.PartyCode),
            new("نوع", p => p.PartyType == "Vendor" ? "تأمین‌کننده" : "مشتری"),
            new("نام", p => p.FullName),
            new("تلفن", p => p.Phone ?? ""),
        },
        DisplayText = p => p.FullName,
        RowsPerPage = 10,
    };

    protected override async Task OnInitializedAsync()
    {
        _cashBoxes = (await Db.QueryAsync<CashBoxRow>(Schema, "CashBoxList", new { CompanyId = Session.ActiveCompanyId })).ToList();
        _bankAccounts = (await Db.QueryAsync<BankAccountRow>(Schema, "BankAccountList", new { CompanyId = Session.ActiveCompanyId })).ToList();
        _parties = (await Db.QueryAsync<TreasuryPartyRow>(Schema, "PartyList", new
        {
            CompanyId = Session.ActiveCompanyId,
            PartyType = (string?)null,
            SearchText = "",
            SkipRows = 0,
            TakeSize = 200
        })).ToList();

        _accountOptions.Items = _cashBoxes.Select(c => new TreasuryAccountOption(c.CashBoxId, "صندوق: " + c.Title, true))
                .Concat(_bankAccounts.Select(b => new TreasuryAccountOption(b.AccountId, "بانک: " + b.AccountName, false)))
                .ToList();
        _partyOptions.Items = _parties;
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        if (_account is null || _amount <= 0)
        {
            Snackbar.Add("صندوق/بانک و مبلغ معتبر الزامی است.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var cash = _cashBoxes.FirstOrDefault(c => c.CashBoxId == _account!.Id);
            await Db.ExecuteAsync(Schema, "CashMovementInsert", new
            {
                Direction = _direction,
                Amount = _amount,
                CurrencyCode = "IRR",
                CashBoxId = cash?.CashBoxId,
                AccountId = cash is null ? _account!.Id : (int?)null,
                MovementDate = _date?.Date ?? DateTime.Today,
                Description = _description,
                SourceReference = _reference,
                CreatedBy = Session.UserName,
                CompanyId = Session.ActiveCompanyId,
                FiscalYearId = Session.ActiveFiscalYearId,
                PartyId = _party?.PartyId
            });
            Snackbar.Add("حرکت نقدی ثبت شد.", Severity.Success);
            _amount = 0;
            _description = "";
            _reference = "";
            _party = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
