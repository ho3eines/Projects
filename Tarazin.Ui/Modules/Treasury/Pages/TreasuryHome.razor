@page "/treasury"
@inject DbService Db
@inject UserSession Session
@inject AccountingContextService Context
@inject IDialogService Dialog
@inject ISnackbar Snackbar

<PageTitle>گردش روز — خزانه‌داری</PageTitle>

<PageHeader Title="گردش روز صندوق و بانک" Subtitle="دریافت‌ها و پرداخت‌ها — از تاریخ تا تاریخ." Eyebrow="خزانه‌داری" />

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="از تاریخ" Culture="FaCulture" @bind-Date="_from" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="تا تاریخ" Culture="FaCulture" @bind-Date="_to" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Label="جستجو (شماره یا شرح)" @bind-Value="_search" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync" Disabled="_loading">
                اعمال فیلتر
            </MudButton>
        </MudItem>
        <MudItem xs="12">
            <div class="d-flex align-center flex-wrap gap-2">
                <MudTooltip Text="بازهٔ پیش‌فرض = کل سال مالی فعال">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                             Icon="@Icons.Material.Filled.CalendarMonth" Style="cursor:pointer"
                             OnClick="ResetToActiveFiscalYearAsync" Disabled="_loading">
                        بازهٔ سال مالی
                    </MudChip>
                </MudTooltip>
                @if (_from is not null && _to is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        بازهٔ فعلی: <span class="tz-num">@PersianDate.ToPersian(_from.Value)</span> تا
                        <span class="tz-num">@PersianDate.ToPersian(_to.Value)</span>
                    </MudText>
                }
            </div>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="1" Class="pa-4">
    <MudTable Items="_rows" Loading="_loading" Hover="true" Dense="true" Striped="true" RowsPerPage="25">
        <HeaderContent>
            <MudTh>شماره</MudTh><MudTh>تاریخ</MudTh><MudTh>جهت</MudTh><MudTh>مبلغ</MudTh>
            <MudTh>ارز</MudTh><MudTh>حساب</MudTh><MudTh>شرح</MudTh><MudTh>وضعیت</MudTh><MudTh>ردیابی</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="شماره">@context.MovementNumber</MudTd>
            <MudTd DataLabel="تاریخ">@context.MovementDate.ToString("yyyy/MM/dd")</MudTd>
            <MudTd DataLabel="جهت">
                <MudChip T="string" Size="Size.Small" Color="@(context.Direction == "In" ? Color.Success : Color.Error)">
                    @(context.Direction == "In" ? "دریافت" : "پرداخت")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="مبلغ">@TzNumericText.Format(context.Amount)</MudTd>
            <MudTd DataLabel="ارز">@context.CurrencyCode</MudTd>
            <MudTd DataLabel="حساب">@context.AccountName</MudTd>
            <MudTd DataLabel="شرح">@context.Description</MudTd>
            <MudTd DataLabel="وضعیت">@context.Status</MudTd>
            <MudTd DataLabel="ردیابی">
                @if (!string.IsNullOrWhiteSpace(context.SourceReference))
                {
                    <MudTooltip Text="ردیابی زنجیره (سند/فروشگاه/انبار)">
                        <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Color="Color.Info" Size="Size.Small"
                                       OnClick="@(() => ShowTraceAsync(context))" />
                    </MudTooltip>
                }
                else
                {
                    <span class="tz-muted">—</span>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><EmptyState Title="حرکتی در این بازه ثبت نشده است." /></NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 25, 50, 100 })" /></PagerContent>
    </MudTable>
</MudPaper>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "treasury";

    private List<DailyCashMovementRow> _rows = new();
    private bool _loading = true;
    private string _search = "";
    private DateTime? _from;
    private DateTime? _to;

    protected override async Task OnInitializedAsync()
    {
        _from = DateTime.Today.AddDays(-30);
        _to = DateTime.Today;
        await LoadAsync();
    }

    /// <summary>بازگشت بازهٔ تاریخ به کل سال مالی فعال و بارگذاری مجدد — یک کلیک.</summary>
    private async Task ResetToActiveFiscalYearAsync()
    {
        var fy = await Context.GetActiveFiscalYearAsync();
        _from = fy?.StartDate ?? DateTime.Today.AddDays(-30);
        _to = fy?.EndDate ?? DateTime.Today;
        await LoadAsync();
    }

    /// <summary>بازکردن دیالوگ ردیابی زنجیره برای یک حرکت نقدی — ورودی کلید مشترک SourceReference.</summary>
    private async Task ShowTraceAsync(DailyCashMovementRow row)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(row.SourceReference))
            {
                Snackbar.Add("این حرکت منبعی برای ردیابی ندارد.", Severity.Warning);
                return;
            }
            var parameters = new DialogParameters<Tarazin.Modules.Accounting.Components.DocumentTraceDialog>
            {
                { x => x.SourceReference, row.SourceReference }
            };
            await Dialog.ShowAsync<Tarazin.Modules.Accounting.Components.DocumentTraceDialog>("ردیابی زنجیره", parameters,
                new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در ردیابی زنجیره: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _rows = (await Db.QueryAsync<DailyCashMovementRow>(Schema, "DailyCashMovements", new
            {
                FromDate = _from?.Date ?? DateTime.Today.AddDays(-30),
                ToDate = _to?.Date ?? DateTime.Today,
                SearchText = _search ?? "",
                Direction = (string?)null,
                SkipRows = 0,
                TakeSize = 100,
                CompanyId = Session.ActiveCompanyId
            })).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
