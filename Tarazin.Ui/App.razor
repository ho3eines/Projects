@using System.Globalization
@implements IDisposable
@inject UiPreferences Prefs
@inject UserSession Session

@* Shared App shell — hosted by BOTH the web host (Tarazin.Web/_Host.cshtml)
   and the MAUI Blazor Hybrid host (Tarazin.Maui/MainPage.xaml root component). *@

<MudRTLProvider RightToLeft="true">
    <MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDark" />
    <MudPopoverProvider />
    <MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseButton="true" />
    <MudSnackbarProvider />

    <Router AppAssembly="typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-6" Icon="@Icons.Material.Filled.SearchOff">
                    صفحه‌ای که دنبالش بودید پیدا نشد.
                </MudAlert>
            </LayoutView>
        </NotFound>
    </Router>
</MudRTLProvider>

@code {
    private readonly MudTheme _theme = TarazinTheme.Create();
    private bool _isDark;

    protected override void OnInitialized()
    {
        ApplyPersianCulture();
        Prefs.Changed += OnPrefsChanged;
        _isDark = Prefs.IsDarkMode;
    }

    // بازیابی نشست بعد از رفرش: ProtectedSessionStorage (و هر استور مرورگری)
    // فقط بعد از اتصال circuit در دسترس است؛ OnAfterRenderAsync دقیقاً همان
    // نقطهٔ امن است (در حین prerender صدا زده نمی‌شود).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // شکست در بازیابی نشست نباید کل برنامه را از کار بیندازد؛
            // بدترین حالت این است که کاربر دوباره وارد شود.
            try
            {
                await Session.RestoreAsync();
            }
            catch
            {
                // ignored — treated as "not signed in"
            }
        }
    }

    private void OnPrefsChanged()
    {
        _isDark = Prefs.IsDarkMode;
        _ = InvokeAsync(StateHasChanged);
    }

    private static void ApplyPersianCulture()
    {
        var fa = CultureInfo.GetCultureInfo("fa-IR");
        CultureInfo.DefaultThreadCurrentCulture = fa;
        CultureInfo.DefaultThreadCurrentUICulture = fa;
    }

    public void Dispose() => Prefs.Changed -= OnPrefsChanged;
}
