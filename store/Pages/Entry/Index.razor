@page "/entry"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>ثبت سفارش — فروشگاه اینترنتی</PageTitle>

<h1 class="h-page-title">ثبت سفارش</h1>
<p class="h-lead mb-4">انتخاب مشتری ← افزودن به سبد ← ثبت سفارش (رویداد OrderPlaced).</p>

<div class="row g-3">
    <div class="col-lg-7 col-12">
        <div class="h-card h-card-pad">
            <h5 class="h-section-title">سبد خرید — @(CustomerId == 0 ? "مشتری را انتخاب کنید" : CustomerName)</h5>
            <div class="row g-2 mb-3">
                <div class="col-md-5 col-sm-6">
                    <select class="form-select" value="@CustomerId" @onchange="OnCustomerChanged">
                        <option value="0">— مشتری —</option>
                        @foreach (var c in Customers) { <option value="@c.CustomerId">@c.FullName</option> }
                    </select>
                </div>
                <div class="col-md-5 col-sm-6">
                    <select class="form-select" @bind="ProductId">
                        <option value="0">— محصول —</option>
                        @foreach (var p in Products) { <option value="@p.ProductId">@p.Title — @p.Price.ToString("N0")</option> }
                    </select>
                </div>
                <div class="col-md-2 col-sm-12">
                    <button class="btn btn-outline-primary w-100" @onclick="AddToCartAsync">افزودن</button>
                </div>
            </div>
            <div class="h-table-wrap">
                <table class="h-table">
                    <thead>
                        <tr><th>محصول</th><th>تعداد</th><th>فی</th><th>جمع</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Cart)
                        {
                            <tr>
                                <td>@l.ProductTitle</td>
                                <td>@l.Qty.ToString("N0")</td>
                                <td>@l.Price.ToString("N0")</td>
                                <td>@l.LineTotal.ToString("N0")</td>
                                <td><button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveFromCartAsync(l)">حذف</button></td>
                            </tr>
                        }
                    </tbody>
                    @if (Cart.Count > 0)
                    {
                        <tfoot>
                            <tr><th colspan="3">جمع سبد</th><th colspan="2">@Cart.Sum(l => l.LineTotal).ToString("N0")</th></tr>
                        </tfoot>
                    }
                </table>
            </div>
            <div class="d-flex gap-2 mt-3 flex-wrap">
                <button class="btn btn-hermes" @onclick="PlaceOrderAsync" disabled="@(CustomerId == 0 || Cart.Count == 0 || Busy)">ثبت سفارش</button>
                @if (Message.Length > 0) { <div class="alert @(Error ? "alert-danger" : "alert-success") mb-0 py-1 px-3">@Message</div> }
            </div>
        </div>
    </div>
    <div class="col-lg-5 col-12">
        <div class="h-card h-card-pad">
            <h5 class="h-section-title">مسیر رویداد (ساگا)</h5>
            <ol class="mb-0" style="line-height:2">
                <li>OrderPlaced → رزرو انبار (ReserveStockForOrder)</li>
                <li>StockReserved → فاکتور حسابداری (SalesInvoiceFromOrder)</li>
                <li>InvoiceCreated → دریافت نقد خزانه (CashEntryFromInvoice)</li>
                <li>تسعیر قیمت طلا → به‌روزرسانی GoldPriceSnapshot ها</li>
            </ol>
        </div>
    </div>
</div>

@code {
    List<CustomerRow> Customers = new();
    List<ProductRow> Products = new();
    List<CartItemRow> Cart = new();
    int CustomerId;
    int ProductId;
    string Message = "";
    bool Error;
    bool Busy;

    string CustomerName => Customers.FirstOrDefault(c => c.CustomerId == CustomerId)?.FullName ?? "";

    protected override async Task OnInitializedAsync()
    {
        Customers = await Request.Request<CustomerRow>("CustomerList", new { }) ?? new();
        Products = await Request.Request<ProductRow>("ProductList", new { }) ?? new();
        if (Customers.Count > 0) { CustomerId = Customers[0].CustomerId; await LoadCartAsync(); }
    }

    async Task LoadCartAsync()
        => Cart = CustomerId == 0 ? new() : (await Request.Request<CartItemRow>("CartView", new { CustomerId }) ?? new());

    async Task OnCustomerChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
            CustomerId = id;
        Message = "";
        await LoadCartAsync();
    }

    async Task AddToCartAsync()
    {
        if (CustomerId == 0 || ProductId == 0) { await Alert.ShowErrorAsync("فروشگاه", "مشتری و محصول را انتخاب کنید"); return; }
        try
        {
            await Request.Request<object>("CartUpsert", new { CustomerId, ProductId, Qty = 1m }, isExec: true);
            await LoadCartAsync();
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("فروشگاه", ex.Message); }
    }

    async Task RemoveFromCartAsync(CartItemRow line)
    {
        try
        {
            await Request.Request<object>("CartUpsert", new { CustomerId, ProductId = line.ProductId, Qty = 0m }, isExec: true);
            await LoadCartAsync();
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("فروشگاه", ex.Message); }
    }

    async Task PlaceOrderAsync()
    {
        Busy = true;
        Message = "";
        Error = false;
        try
        {
            await Request.Request<object>("OrderPlace", new { CustomerId }, isExec: true);
            Message = "سفارش ثبت شد؛ زنجیره رزرو → فاکتور → نقد به‌صورت خودکار در حال اجراست.";
            await LoadCartAsync();
        }
        catch (Exception ex) { Error = true; Message = ex.Message; }
        finally { Busy = false; }
    }
}
