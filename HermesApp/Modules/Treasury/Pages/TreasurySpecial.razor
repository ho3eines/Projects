@page "/treasury/special"
@inject DbService Db
@inject UserSession Session
@inject ISnackbar Snackbar

<PageTitle>عملیات ویژه — خزانه‌داری</PageTitle>

<MudText Typo="Typo.h4">بستن روز (Day Close)</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    همهٔ حرکات روز جاری را نهایی می‌کند.
</MudText>

<MudPaper Elevation="1" Class="pa-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudDatePicker Label="تاریخ روز" Culture="FaCulture" @bind-Date="_today" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.LockClock" OnClick="CloseDayAsync" Disabled="_busy">
                بستن روز
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    private static readonly CultureInfo FaCulture = CultureInfo.GetCultureInfo("fa-IR");
    private const string Schema = "treasury";

    private DateTime? _today = DateTime.Today;
    private bool _busy;

    private async Task CloseDayAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Db.ExecuteAsync(Schema, "DayClose", new
            {
                Today = _today?.Date ?? DateTime.Today,
                CreatedBy = Session.UserName
            });
            Snackbar.Add("روز بسته شد.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
