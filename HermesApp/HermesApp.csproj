<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HermesApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI: MudBlazor — user does not hand-craft CSS/design anymore -->
    <PackageReference Include="MudBlazor" Version="9.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Data access: Dapper over SQL Server, direct from the Blazor Server process -->
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
  </ItemGroup>

  <!-- Named TSQL scripts (reports-first data layer) ship with the app -->
  <ItemGroup>
    <Content Include="Data\Scripts\**\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
