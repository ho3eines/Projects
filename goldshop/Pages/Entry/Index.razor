@page "/entry"
@inject IRequestService Request
@inject IAlertService Alert

<PageTitle>ورود عملیات — طلافروشی</PageTitle>

<h1 class="h-page-title">ورود عملیات</h1>
<p class="h-lead mb-4">ثبت فاکتور فروش طلا — مالیات به‌صورت پویا از TaxRules خوانده می‌شود.</p>

<div class="h-card h-card-pad">
    <div class="row g-3">
        <div class="col-md-4 col-sm-6">
            <label class="form-label" for="cust">مشتری</label>
            <input id="cust" class="form-control" @bind="CustomerName" placeholder="نام مشتری" />
        </div>
        <div class="col-md-4 col-sm-6">
            <label class="form-label" for="item">جنس طلا</label>
            <select id="item" class="form-select" @bind="ItemCode">
                <option value="">— انتخاب —</option>
                @foreach (var g in Items) { <option value="@g.ItemCode">@g.Title</option> }
            </select>
        </div>
        <div class="col-md-2 col-sm-6">
            <label class="form-label" for="date">تاریخ</label>
            <input id="date" type="date" class="form-control" @bind="InvoiceDate" />
        </div>
        <div class="col-md-2 col-sm-6">
            <label class="form-label" for="weight">وزن (گرم)</label>
            <input id="weight" type="number" step="0.001" min="0" class="form-control" @bind="WeightGram" />
        </div>
        <div class="col-md-3 col-sm-6">
            <label class="form-label" for="price">قیمت هر گرم</label>
            <input id="price" type="number" step="1000" min="0" class="form-control" @bind="PricePerGram" />
        </div>
        <div class="col-md-3 col-sm-6">
            <label class="form-label" for="work">اجرت</label>
            <input id="work" type="number" step="1000" min="0" class="form-control" @bind="Workmanship" />
        </div>
        <div class="col-md-3 col-sm-6">
            <label class="form-label" for="profit">سود</label>
            <input id="profit" type="number" step="1000" min="0" class="form-control" @bind="Profit" />
        </div>
        <div class="col-md-3 col-sm-6 d-flex align-items-end">
            <button class="btn btn-hermes w-100" @onclick="SaveAsync" disabled="@Busy">ثبت فاکتور</button>
        </div>
        @if (Message.Length > 0) { <div class="col-12"><div class="alert alert-success mb-0">@Message</div></div> }
    </div>
</div>

@code {
    List<GoldItemRow> Items = new();
    string CustomerName = "";
    string ItemCode = "";
    DateTime InvoiceDate = DateTime.Today;
    decimal WeightGram;
    decimal PricePerGram;
    decimal Workmanship;
    decimal Profit;
    string Message = "";
    bool Busy;

    protected override async Task OnInitializedAsync()
    {
        Items = await Request.Request<GoldItemRow>("GoldItemList", new { }) ?? new();
        var price = (await Request.Request<GoldPriceRow>("GoldPriceSearch", new { SkipRows = 0, TakeSize = 10 }))?.FirstOrDefault(p => p.ItemCode == "XAU-24");
        if (price is not null)
            PricePerGram = price.PricePerGram;
    }

    async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(ItemCode) || WeightGram <= 0)
        {
            await Alert.ShowErrorAsync("طلافروشی", "جنس و وزن را وارد کنید");
            return;
        }
        Busy = true;
        Message = "";
        try
        {
            await Request.Request<object>("SaleInvoiceCreate", new
            {
                InvoiceDate,
                CustomerName = string.IsNullOrWhiteSpace(CustomerName) ? "مشتری نقدی" : CustomerName,
                ItemCode,
                WeightGram,
                PricePerGram,
                Workmanship,
                Profit,
                CreatedBy = Request.UserToken
            }, isExec: true);
            Message = "فاکتور فروش ثبت شد.";
            WeightGram = 0;
            Workmanship = 0;
            Profit = 0;
        }
        catch (Exception ex) { await Alert.ShowErrorAsync("طلافروشی", ex.Message); }
        finally { Busy = false; }
    }
}
