@page "/dashboard"
@inject IRequestService Request

<PageTitle>داشبورد — طلافروشی</PageTitle>

<h1 class="h-page-title mb-1">نمای کلی طلافروشی</h1>
<p class="h-lead mb-4">فروش امروز، قیمت‌ها و نرخ طلا.</p>

<div class="row g-3">
    <div class="col-md-3">
        <div class="h-card h-stat">
            <div><div class="k">فروش امروز</div><div class="v">@S.TodaySales</div></div>
            <div class="h-stat-ico">🧾</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="h-card h-stat">
            <div><div class="k">مبلغ فروش امروز</div><div class="v" style="font-size:1.05rem;padding-top:.4rem">@S.TodayAmount.ToString("N0")</div></div>
            <div class="h-stat-ico">﷼</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="h-card h-stat">
            <div><div class="k">قیمت‌های ثبت‌شده</div><div class="v">@S.PriceCount</div></div>
            <div class="h-stat-ico">📈</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="h-card h-stat">
            <div><div class="k">قیمت طلای ۲۴</div><div class="v" style="font-size:1.05rem;padding-top:.4rem">@S.Gold24Price.ToString("N0")</div></div>
            <div class="h-stat-ico">🥇</div>
        </div>
    </div>
</div>

@code {
    DashboardSummaryRow S = new();

    protected override async Task OnInitializedAsync()
        => S = (await Request.Request<DashboardSummaryRow>("DashboardSummary", new { }))?.FirstOrDefault() ?? new();
}
