@page "/payroll/dashboard"
@inject DbService Db
@inject ISnackbar Snackbar

<PageTitle>داشبورد — حقوق و دستمزد</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">نمای کلی حقوق و دستمزد</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4 h-stat">
                <MudText Typo="Typo.caption" Color="Color.Secondary">کارمندان فعال</MudText>
                <MudText Typo="Typo.h4">@_summary.ActiveEmployees</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4 h-stat">
                <MudText Typo="Typo.caption" Color="Color.Secondary">کل دوره‌ها</MudText>
                <MudText Typo="Typo.h4">@_summary.TotalRuns</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4 h-stat">
                <MudText Typo="Typo.caption" Color="Color.Secondary">کل پرداختی</MudText>
                <MudText Typo="Typo.h5">@_summary.TotalPaid.ToString("N0")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4 h-stat">
                <MudText Typo="Typo.caption" Color="Color.Secondary">آخرین دوره</MudText>
                <MudText Typo="Typo.h5">@_summary.LatestPeriod</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private const string Schema = "payroll";
    private bool _loading = true;
    private PayrollDashboardRow _summary = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await Db.QueryFirstOrDefaultAsync<PayrollDashboardRow>(Schema, "DashboardSummary")
                       ?? new PayrollDashboardRow();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
