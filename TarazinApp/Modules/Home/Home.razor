@page "/"
@inject UserSession Session
@inject ScriptCatalog Catalog

<PageTitle>خانه — ترازین</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">ترازین — مدیریت هوشمند کسب‌وکار</MudText>
<MudText Typo="Typo.body2" Class="mb-4" Color="Color.Secondary">
    یک پروژهٔ Blazor Server؛ هر محصول یک ماژول با اسکیمهٔ SQL مستقل. بدون وب‌سرویس، بدون کلاینت جدا.
</MudText>

@if (!Session.IsAuthenticated)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
        برای ورود به ماژول‌ها از دکمهٔ «ورود» بالا استفاده کنید.
    </MudAlert>
}

<MudGrid>
    @foreach (var m in Modules)
    {
        <MudItem xs="12" sm="6" md="4" lg="3">
            <div class="h-module-card" @onclick="() => Nav.NavigateTo(m.Url)" role="link" tabindex="0">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudText Typo="Typo.h5">@m.Icon</MudText>
                        <MudText Typo="Typo.h6" Class="mt-2">@m.Title</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@m.Lead</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary">ورود به ماژول</MudButton>
                    </MudCardActions>
                </MudCard>
            </div>
        </MudItem>
    }
</MudGrid>

<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-6">
    @Catalog.Count اسکریپت نامدار در @Catalog.Schemas.Count اسکیمه بارگذاری شده است.
</MudText>

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;

    record ModuleCard(string Icon, string Title, string Lead, string Url);

    static readonly List<ModuleCard> Modules =
    [
        new("◈", "پلتفرم مشترک", "وبسایت، اخبار، بلاگ، گالری، کاربران، ممیزی", "/central"),
        new("📒", "حسابداری", "اسناد روز، دفتر روزنامه/کل، تراز آزمایشی", "/accounting"),
        new("📦", "انبار آمل", "رسید/حواله، کارتکس، موجودی", "/inventory"),
        new("💰", "خزانه‌داری", "دریافت/پرداخت، صندوق و بانک، چک", "/treasury"),
        new("🧾", "حقوق و دستمزد", "کارمندان، فیش حقوق، نهایی‌کردن دوره", "/payroll"),
        new("🏅", "طلافروشی", "فروش روز، قیمت طلا، فاکتور", "/goldshop"),
        new("🛒", "فروشگاه", "سفارش‌ها، محصولات، مشتریان", "/store"),
    ];
}
